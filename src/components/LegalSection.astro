---
import type { ServiceData } from '../data/services/_types';
interface Props { legal: ServiceData['legal']; serviceName: string; relatedColumns?: ServiceData['relatedColumns']; }
const { legal, serviceName, relatedColumns } = Astro.props;
const legalColumn = relatedColumns?.find((c) => c.category === '法令・義務' || c.category === '法令');

// 法令名は e-Gov法令検索（政府公式DB）へリンク。告示・基準など法令でないものは素のテキスト。
function isLaw(name: string): boolean {
  return /法/.test(name) && !/基準|告示|要領|指針|ガイドライン|マニュアル/.test(name);
}
function egovUrl(name: string): string {
  // 「水道法第34条の2」→「水道法」、「○○法律（略称）」→ 括弧除去 で検索精度を上げる
  const base = name.replace(/第.*$/, '').replace(/（.*?）/g, '').trim();
  return `https://laws.e-gov.go.jp/search/elawsSearch/elaws_search/lsg0100/?keyword=${encodeURIComponent(base)}`;
}
---
<section class="sd-section gimu-section" id="legal">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">LEGAL OBLIGATION</span>
      <h2>{serviceName}の法的義務とは？</h2>
      <p>{legal.summary}</p>
    </div>
    <div class="gimu-alert">
      <div class="gimu-alert-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div>
        <div class="gimu-alert-title">{legal.alertTitle}</div>
        <div class="gimu-alert-body" set:html={legal.alertBody.replace(/(.+?罰金等)/, '<strong>$1</strong>')}></div>
      </div>
    </div>
    <div class="gimu-cards">
      {legal.cards.map((card) => (
        <article class="gimu-card">
          <div class="gimu-card-head">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <h3>{card.title}</h3>
          </div>
          <p>{card.body}</p>
          <div class="tag-list">
            {card.tags.map((t) => (<span class="tag-item">{t}</span>))}
          </div>
        </article>
      ))}
    </div>
    <dl class="legal-basis">
      <dt>関連法令</dt>
      <dd>
        {legal.legalBasis.map((law, i) => (
          <>
            {i > 0 && ' ／ '}
            {isLaw(law)
              ? <a href={egovUrl(law)} class="legal-basis-link" target="_blank" rel="noopener nofollow">{law}<span class="legal-basis-ext" aria-hidden="true"> ↗</span></a>
              : <span>{law}</span>}
          </>
        ))}
      </dd>
    </dl>
    <p class="legal-basis-note">※「関連法令」は <a href="https://laws.e-gov.go.jp/" target="_blank" rel="noopener nofollow">e-Gov法令検索（デジタル庁）</a> の該当法令へリンクしています。最新の条文は公式でご確認ください。</p>
    {legalColumn && (
      <a href={legalColumn.href} class="inline-column-cta">
        <span class="inline-column-cta-icon" aria-hidden="true">📖</span>
        <span class="inline-column-cta-body">
          <span class="inline-column-cta-label">法令・義務の詳しい解説</span>
          <span class="inline-column-cta-title">{legalColumn.title}</span>
        </span>
        <span class="inline-column-cta-arrow" aria-hidden="true"></span>
      </a>
    )}
  </div>
</section>
