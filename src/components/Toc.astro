---
/**
 * ページ内目次（TOC）
 * ServiceLP / PrefectureServiceLP 共通のセクションIDへジャンプする。
 * サーバーレンダリングのためクロール可能（AIOのアンカー引用にも有効）。
 */
interface Props { serviceName: string; }
const { serviceName } = Astro.props;

const items = [
  { href: '#cost', label: '費用相場' },
  { href: '#legal', label: '法令・義務' },
  { href: '#risk', label: '放置リスク' },
  { href: '#industry', label: '業種別ポイント' },
  { href: '#select', label: '業者選び' },
  { href: '#mistakes', label: 'よくある失敗' },
  { href: '#comparison-tips', label: '比較のコツ' },
  { href: '#faq', label: 'よくある質問' },
  { href: '#contact', label: '無料見積もり' },
];
---
<nav class="toc" aria-label={`${serviceName}のページ内目次`}>
  <div class="sd-container">
    <p class="toc-label">このページの内容</p>
    <ul class="toc-list">
      {items.map((it) => (
        <li><a href={it.href} class="toc-chip" data-scroll-to={it.href}>{it.label}</a></li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .toc {
    background: var(--gray-50, #f8fafc);
    border-bottom: 1px solid var(--gray-200, #e5e7eb);
    padding: 14px 0;
  }
  .toc-label {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--gray-500, #6b7280);
    margin: 0 0 8px;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .toc-chip {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--gray-200, #e5e7eb);
    color: var(--blue, #1565c0);
    font-size: .85rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background .15s, border-color .15s;
  }
  .toc-chip:hover {
    background: var(--blue, #1565c0);
    border-color: var(--blue, #1565c0);
    color: #fff;
  }
  /* スマホは横スクロールの1行チップ */
  @media (max-width: 640px) {
    .toc-list {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 2px;
    }
    .toc-list::-webkit-scrollbar { display: none; }
  }
</style>
