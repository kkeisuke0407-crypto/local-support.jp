---
import type { ServiceData } from '../data/services/_types';

interface Props { risks: ServiceData['risks']; serviceName: string; }
const { risks, serviceName } = Astro.props;

const icons = [
  /* 水・健康 */
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>`,
  /* 法・損害 */
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  /* コスト・設備 */
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  /* 行政・ブランド */
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
];
---
<section class="sd-section" id="risk">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">RISK</span>
      <h2>{serviceName}を放置するとどうなる？</h2>
      <p>「来年でいいか」で起きる4つのリスクを整理しました</p>
    </div>
    <div class="risk-cards">
      {risks.map((r, i) => (
        <article class="risk-card">
          <div class="risk-card-icon">
            <Fragment set:html={icons[i % icons.length]} />
            <h3>{r.title}</h3>
          </div>
          <p>{r.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
