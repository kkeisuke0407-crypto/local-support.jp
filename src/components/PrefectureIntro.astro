---
import type { Prefecture } from '../data/prefectures';
import type { ServiceData } from '../data/services/_types';
import { site } from '../data/site';
interface Props { prefecture: Prefecture; service: ServiceData; }
const { prefecture, service } = Astro.props;
const citiesText = prefecture.majorCities.join('・');
// このサービスに関係する県事情だけを出す（services 省略時は全サービス共通）
const factors = (prefecture.localFactors ?? []).filter((f) => !f.services || f.services.includes(service.slug));
// 県事情がある主要県では、全サービス共通の県紹介文（context）は出さない
const showContext = !prefecture.localFactors || prefecture.localFactors.length === 0;
---
<section class="sd-section section-white pref-intro-section">
  <div class="sd-container">
    <div class="pref-intro">
      <h2 class="pref-intro-h2">{prefecture.name}の{service.serviceName}のご依頼について</h2>
      <p class="pref-intro-region"><span class="pref-intro-region-tag">{prefecture.region}</span> 主要対応エリア：{citiesText}</p>
      {showContext && <p class="pref-intro-body">{prefecture.context}</p>}
      <p class="pref-intro-body">
        {site.name}では、{prefecture.name}内の<strong>{service.serviceName}</strong>のご依頼について、対応できる業者を運営が探し、最大5社をご紹介します。ご依頼は<strong>無料</strong>です。{prefecture.name}全域（{citiesText}など）からご相談いただけます。
      </p>
      {factors.length > 0 && (
        <div class="pref-local-factors">
          <h3 class="pref-local-factors-title">{prefecture.name}で{service.serviceName}を依頼するときに知っておきたいこと</h3>
          <ul class="pref-local-factors-list">
            {factors.map((f) => (
              <li class="pref-local-factor">
                <span class="pref-local-factor-title">{f.title}</span>
                <span class="pref-local-factor-body">{f.body}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .pref-local-factors {
    margin-top: 1.75rem;
    padding: 1.5rem;
    background: #f6f9fc;
    border: 1px solid #e2e9f0;
    border-radius: 12px;
  }
  .pref-local-factors-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.5;
  }
  .pref-local-factors-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .pref-local-factor {
    padding-left: 1.4rem;
    position: relative;
  }
  .pref-local-factor::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #2f80c4;
  }
  .pref-local-factor-title {
    display: block;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }
  .pref-local-factor-body {
    display: block;
    font-size: 0.95rem;
    line-height: 1.75;
    color: #44525e;
  }
</style>
