---
import type { Prefecture } from '../data/prefectures';
import type { ServiceData } from '../data/services/_types';
import { site } from '../data/site';
interface Props { prefecture: Prefecture; service: ServiceData; }
const { prefecture, service } = Astro.props;
const citiesText = prefecture.majorCities.join('・');
---
<section class="sd-section section-white pref-intro-section">
  <div class="sd-container">
    <div class="pref-intro">
      <h2 class="pref-intro-h2">{prefecture.name}の{service.serviceName}に対応した業者をご紹介</h2>
      <p class="pref-intro-region"><span class="pref-intro-region-tag">{prefecture.region}</span> 主要対応エリア：{citiesText}</p>
      <p class="pref-intro-body">{prefecture.context}</p>
      <p class="pref-intro-body">
        {site.name}では、{prefecture.name}内の<strong>{service.serviceName}</strong>に対応可能な業者の中から、ご依頼内容に応じて最大3社を厳選してご紹介します。お見積もり依頼は<strong>1分・完全無料</strong>。{prefecture.name}全域（{citiesText}など）に対応しています。
      </p>
    </div>
  </div>
</section>
