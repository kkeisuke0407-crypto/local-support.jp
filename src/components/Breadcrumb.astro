---
interface Item { label: string; href?: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<nav class="breadcrumb-nav" aria-label="パンくず">
  <div class="sd-container">
    <ol class="breadcrumb-list">
      {items.map((item, i) => (
        <li class="breadcrumb-item">
          {item.href && i < items.length - 1
            ? <a href={item.href}>{item.label}</a>
            : <span aria-current={i === items.length - 1 ? 'page' : undefined}>{item.label}</span>
          }
          {i < items.length - 1 && <span class="breadcrumb-sep" aria-hidden="true">›</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
.breadcrumb-nav {
  background: #f8fafc;
  border-bottom: 1px solid var(--gray-200, #e0e0e0);
  padding: 10px 0;
  font-size: .82rem;
}
.breadcrumb-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}
.breadcrumb-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--gray-600, #555);
}
.breadcrumb-item a {
  color: var(--blue, #1565c0);
  text-decoration: none;
}
.breadcrumb-item a:hover { text-decoration: underline; }
.breadcrumb-item [aria-current="page"] {
  color: var(--gray-900, #111);
  font-weight: 600;
}
.breadcrumb-sep {
  color: var(--gray-400, #aaa);
}
</style>
