---
import { serviceIndex } from '../data/site';
import { findServiceCategory } from '../data/serviceCategories';

interface Props {
  currentSlug: string;
  serviceName: string;
  prefectureSlug?: string;
  prefectureName?: string;
}

const { currentSlug, serviceName, prefectureSlug, prefectureName } = Astro.props;
const category = findServiceCategory(currentSlug);
const categoryServices = category
  ? category.serviceSlugs
      .map((slug) => serviceIndex.find((service) => service.slug === slug))
      .filter((service): service is (typeof serviceIndex)[number] => !!service && service.slug !== currentSlug)
  : [];

const title = prefectureName
  ? `${prefectureName}で${serviceName}と一緒に検討される施設管理サービス`
  : `${serviceName}と一緒に検討される施設管理サービス`;
const lead = category
  ? `${category.label}のカテゴリでは、${serviceName}とあわせて点検・清掃・修繕をまとめて見直すケースがあります。`
  : `${serviceName}とあわせて検討されやすい施設管理サービスです。`;
const hrefFor = (slug: string) => prefectureSlug ? `/${slug}/${prefectureSlug}/` : `/${slug}/`;
---
{category && categoryServices.length > 0 && (
  <section class="sd-section service-category-links" id="category-links">
    <div class="sd-container">
      <div class="service-category-box">
        <div class="section-head service-category-head">
          <span class="kicker">CATEGORY</span>
          <h2>{title}</h2>
          <p>{lead}</p>
        </div>

        <div class="service-category-meta">
          <span>{category.label}</span>
          <p>{category.description}</p>
        </div>

        <ul class="service-category-list" aria-label={`${category.label}の関連サービス`}>
          {categoryServices.map((service) => (
            <li>
              <a href={hrefFor(service.slug)}>
                <span class="service-category-short">{service.short}</span>
                <strong>{prefectureName ? `${prefectureName}の${service.name}` : service.name}</strong>
                <small>{service.description}</small>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .service-category-links {
    background: #fff;
  }

  .service-category-box {
    padding: 28px;
    border: 1px solid var(--gray-200);
    border-radius: 18px;
    background: linear-gradient(180deg, #fff 0%, #f8fafc 100%);
    box-shadow: 0 14px 36px rgba(15, 23, 42, 0.06);
  }

  .service-category-head {
    margin-bottom: 18px;
  }

  .service-category-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    padding: 12px 14px;
    background: #eff6ff;
    border-radius: 12px;
  }

  .service-category-meta span {
    flex-shrink: 0;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--blue);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .service-category-meta p {
    margin: 0;
    color: var(--gray-700);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .service-category-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
  }

  .service-category-list a {
    display: block;
    height: 100%;
    padding: 16px;
    border: 1px solid var(--gray-200);
    border-radius: 12px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s;
  }

  .service-category-list a:hover {
    border-color: var(--blue);
    box-shadow: 0 10px 22px rgba(26, 86, 219, 0.12);
    transform: translateY(-1px);
  }

  .service-category-short {
    display: inline-block;
    margin-bottom: 8px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--blue-light);
    color: var(--blue-dark);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .service-category-list strong,
  .service-category-list small {
    display: block;
  }

  .service-category-list strong {
    margin-bottom: 7px;
    color: var(--gray-900);
    font-size: 0.98rem;
    line-height: 1.45;
  }

  .service-category-list small {
    color: var(--gray-600);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .service-category-box {
      padding: 22px 18px;
    }

    .service-category-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
