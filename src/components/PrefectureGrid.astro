---
import { prefecturesData } from '../data/prefectures';
interface Props { serviceSlug: string; serviceName: string; }
const { serviceSlug, serviceName } = Astro.props;

const regions = ['北海道', '東北', '関東', '中部', '近畿', '中国', '四国', '九州', '沖縄'];
const byRegion = regions.map((region) => ({
  region,
  prefectures: prefecturesData.filter((p) => p.region === region),
})).filter((g) => g.prefectures.length > 0);
---
<section class="sd-section section-gray pref-grid-section" id="prefectures">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">AREA</span>
      <h2>都道府県から{serviceName}業者を探す</h2>
      <p>各地域に対応可能な業者をご紹介します。お住まいの都道府県を選んでください。</p>
    </div>
    <div class="pref-grid-regions">
      {byRegion.map((g) => (
        <div class="pref-grid-region">
          <h3 class="pref-grid-region-title">{g.region}</h3>
          <ul class="pref-grid-list">
            {g.prefectures.map((p) => (
              <li>
                <a href={`/${serviceSlug}/${p.slug}/`} class="pref-grid-link">{p.name}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
