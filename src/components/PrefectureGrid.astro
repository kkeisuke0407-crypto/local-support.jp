---
import { prefecturesData, PRIMARY_PREFECTURE_SLUGS } from '../data/prefectures';
import { serviceBySlug } from '../data/services';
interface Props { serviceSlug: string; serviceName: string; }
const { serviceSlug, serviceName } = Astro.props;

// インデックス対象の県だけリンクにする。noindex の県ページへ評価を流さないため（2026-09 監査 T2）
const indexed = new Set<string>([
  ...PRIMARY_PREFECTURE_SLUGS,
  ...(serviceBySlug[serviceSlug]?.additionalIndexedPrefectures ?? []),
]);

---
<section class="sd-section section-gray pref-grid-section" id="prefectures">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">AREA</span>
      <h2>都道府県から{serviceName}業者を探す</h2>
      <p>主なエリアは、地域ごとのページで詳しくご案内しています。</p>
    </div>
    <ul class="pref-grid-chips">
      {prefecturesData.filter((p) => indexed.has(p.slug)).map((p) => (
        <li><a href={`/${serviceSlug}/${p.slug}/`} class="pref-grid-chip">{p.name}</a></li>
      ))}
    </ul>
    <p class="pref-grid-other">上記以外の都道府県（北海道から沖縄まで）も、<a href="#contact">ご依頼フォーム</a>から全国どこでもご相談いただけます。</p>
  </div>
</section>
