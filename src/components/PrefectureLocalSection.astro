---
interface Props { title: string; paragraphs: string[]; }
const { title, paragraphs } = Astro.props;
---
<section class="sd-section section-tint pref-local-section">
  <div class="sd-container">
    <div class="pref-local-section-inner">
      <h2 class="pref-local-section-title">{title}</h2>
      {paragraphs.map((p) => (<p class="pref-local-section-body">{p}</p>))}
    </div>
  </div>
</section>

<style>
  .pref-local-section-inner {
    max-width: 820px;
    margin: 0 auto;
  }
  .pref-local-section-title {
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.5;
    margin: 0 0 1.2rem;
    padding-left: 0.9rem;
    border-left: 5px solid #2f80c4;
  }
  .pref-local-section-body {
    font-size: 1rem;
    line-height: 1.95;
    color: #38454f;
    margin: 0 0 1.1rem;
  }
  .pref-local-section-body:last-child {
    margin-bottom: 0;
  }
</style>
