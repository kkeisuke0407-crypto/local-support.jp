---
interface Props {
  lead: string;
  facts: { label: string; value: string }[];
  serviceName: string;
}
const { lead, facts, serviceName } = Astro.props;
---
<section class="aio-summary" aria-label={`${serviceName}の要点まとめ`}>
  <div class="sd-container">
    <div class="aio-inner">
      <p class="aio-label">📋 このページの要点</p>
      <p class="aio-lead">{lead}</p>
      <dl class="aio-facts">
        {facts.map((f) => (
          <div class="aio-fact">
            <dt class="aio-fact-label">{f.label}</dt>
            <dd class="aio-fact-value">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
.aio-summary {
  background: #e8f0fe;
  border-top: 3px solid var(--blue, #1565c0);
  padding: 28px 0;
}

.aio-inner {
  max-width: 860px;
}

.aio-label {
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .08em;
  color: var(--blue, #1565c0);
  text-transform: uppercase;
  margin: 0 0 10px;
}

.aio-lead {
  font-size: 1rem;
  line-height: 1.8;
  color: var(--gray-900, #111);
  margin: 0 0 20px;
  font-weight: 500;
}

.aio-facts {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 12px;
  margin: 0;
}

.aio-fact {
  background: #fff;
  border-radius: 8px;
  padding: 12px 16px;
  border-left: 3px solid var(--blue, #1565c0);
}

.aio-fact-label {
  font-size: .75rem;
  font-weight: 700;
  color: var(--gray-600, #555);
  margin-bottom: 4px;
}

.aio-fact-value {
  font-size: .95rem;
  font-weight: 700;
  color: var(--gray-900, #111);
  line-height: 1.4;
  margin: 0;
}

@media (max-width: 600px) {
  .aio-facts {
    grid-template-columns: 1fr 1fr;
  }
}
</style>
