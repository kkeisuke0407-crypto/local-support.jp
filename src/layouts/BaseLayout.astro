---
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  siteName?: string;
  logoSub?: string;
  ogImage?: string;
  jsonLdBlocks?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  siteName = site.name,
  logoSub = '施設管理の一括見積比較',
  ogImage = 'https://local-support.jp/og-default.svg',
  jsonLdBlocks = [],
  noindex = false,
} = Astro.props;

// Always include Organization + WebSite JSON-LD
const baseLdBlocks = [
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.org.legalName,
    alternateName: site.name,
    url: site.domain,
    logo: `${site.domain}/og-default.svg`,
    areaServed: 'JP',
  }),
  JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.domain,
    inLanguage: 'ja-JP',
    potentialAction: {
      '@type': 'SearchAction',
      target: `${site.domain}/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  }),
];
const allLdBlocks = [...baseLdBlocks, ...jsonLdBlocks];
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}

  <meta property="og:type"        content="website" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonical} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:locale"      content="ja_JP" />
  <meta property="og:site_name"   content={siteName} />
  <meta name="twitter:card"       content="summary_large_image" />

  <meta name="theme-color" content="#1a56db" />
  <link rel="icon" type="image/svg+xml" href="/og-default.svg" />
  <link rel="apple-touch-icon" href="/og-default.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;600;700;900&display=swap" rel="stylesheet" />

  <!-- Google tag (gtag.js) — Consent Mode v2 default: denied, granted on user consent -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KS0PVE3PY5"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    var stored = null;
    try { stored = localStorage.getItem('ls_consent'); } catch (e) {}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: stored === 'granted' ? 'granted' : 'denied',
    });
    gtag('js', new Date());
    gtag('config', 'G-KS0PVE3PY5');
  </script>

  {allLdBlocks.map((block) => (
    <Fragment set:html={`<script type="application/ld+json">${block}</script>`} />
  ))}
</head>
<body>

<!-- ══ HEADER ══════════════════════════════════════════════════ -->
<header class="sd-header">
  <div class="sd-header-inner">
    <a href="/" class="sd-logo">
      <div class="sd-logo-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </div>
      <div class="sd-logo-wrap">
        <span>{siteName}</span>
        <span class="sd-logo-sub">{logoSub}</span>
      </div>
    </a>
    <a href="#contact" class="sd-header-cta" data-scroll-to="#contact" data-track="header_contact">
      無料で一括見積 ›
    </a>
  </div>
</header>

<main id="main">
  <slot />
</main>

<!-- ══ FOOTER ════════════════════════════════════════════════ -->
<footer class="sd-footer">
  <div class="sd-footer-inner">
    <div class="sd-footer-logo">{siteName}</div>
    <p class="sd-footer-desc">
      施設管理・設備メンテナンスの一括見積比較サイト。受水槽清掃・アスベスト調査・ダクト清掃・シャッター点検など、登録業者から最大3社を無料でご紹介します。
      掲載情報は公開時点のものです。最新の法令・費用は各機関・業者の公式情報をご確認ください。
    </p>
    <div class="sd-footer-links">
      <a href="/">トップ</a>
      <a href="/jusuisou-seisou/">受水槽清掃</a>
      <a href="/asbestos/">アスベスト調査・除去</a>
      <a href="/duct/">ダクト清掃</a>
      <a href="/shutter/">シャッター点検・修理</a>
      <a href="/flow/">ご利用の流れ</a>
      <a href="/column/">コラム</a>
      <a href="/operator/">運営者情報</a>
      <a href="/privacy/">プライバシーポリシー</a>
      <a href="/disclosure/">ご紹介業者について</a>
    </div>
    <p class="sd-footer-copy">© 2025 {siteName}. All rights reserved.</p>
  </div>
</footer>

<!-- ══ Sticky CTA（スマホ） ════════════════════════════════════ -->
<div class="sticky-cta">
  <a href="#contact" class="sticky-btn-primary" data-scroll-to="#contact" data-track="sticky_form">無料で一括見積もり依頼 →</a>
</div>

<!-- ══ Cookie同意バナー ════════════════════════════════════════ -->
<div id="cookie-banner" class="cookie-banner" hidden>
  <p class="cookie-banner-text">
    当サイトでは、サービス改善のためにCookieを利用したアクセス解析（Google Analytics）を使用しています。詳しくは<a href="/privacy/">プライバシーポリシー</a>をご確認ください。
  </p>
  <div class="cookie-banner-actions">
    <button type="button" class="cookie-banner-btn cookie-banner-btn--accept" data-consent="granted">同意する</button>
    <button type="button" class="cookie-banner-btn cookie-banner-btn--decline" data-consent="denied">拒否する</button>
  </div>
</div>

<script is:inline src={`/app.js?v=${import.meta.env.BUILD_ID || Date.now()}`}></script>
</body>
</html>
