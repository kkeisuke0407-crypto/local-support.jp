---
import BaseLayout from './BaseLayout.astro';
import HeroWithForm from '../components/HeroWithForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import PrefectureIntro from '../components/PrefectureIntro.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import TrustBadges from '../components/TrustBadges.astro';
import LegalSection from '../components/LegalSection.astro';
import RiskCards from '../components/RiskCards.astro';
import CostTable from '../components/CostTable.astro';
import IndustrySection from '../components/IndustrySection.astro';
import SelectionChecklist from '../components/SelectionChecklist.astro';
import MistakesSection from '../components/MistakesSection.astro';
import ComparisonTipsSection from '../components/ComparisonTipsSection.astro';
import QuoteFormFull from '../components/QuoteFormFull.astro';
import FAQ from '../components/FAQ.astro';
import RelatedServices from '../components/RelatedServices.astro';
import PrefectureGrid from '../components/PrefectureGrid.astro';
import BottomCTA from '../components/BottomCTA.astro';
import AIOSummary from '../components/AIOSummary.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site';
import type { ServiceData } from '../data/services/_types';
import type { Prefecture } from '../data/prefectures';
import { isPrimaryPrefecture } from '../data/prefectures';

interface Props { data: ServiceData; prefecture: Prefecture; }
const { data, prefecture } = Astro.props;
const canonical = `${site.domain}/${data.slug}/${prefecture.slug}/`;
const cityText = prefecture.majorCities.slice(0, 3).join('・');
const title = `${prefecture.name}の${data.serviceName}｜${cityText}対応の業者を一括見積で比較`;
const description = `${prefecture.name}（${prefecture.majorCities.join('・')}など）の${data.serviceName}に対応できる業者を一括見積で比較。法定義務・費用相場・業者の選び方を解説。資格・許認可を確認した業者から最大3社をご紹介、完全無料。`;

// 主要10都府県以外は段階的公開のためnoindex（ユニークコンテンツ拡充後に解除）
const noindex = !isPrimaryPrefecture(prefecture.slug);

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: data.serviceName, item: `${site.domain}/${data.slug}/` },
    { '@type': 'ListItem', position: 3, name: prefecture.name, item: canonical },
  ],
});

const serviceLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${prefecture.name}の${data.serviceName}一括見積比較`,
  serviceType: data.serviceName,
  description: description,
  url: canonical,
  areaServed: [
    { '@type': 'AdministrativeArea', name: prefecture.name },
    ...prefecture.majorCities.map((city) => ({ '@type': 'City', name: city, containedInPlace: { '@type': 'AdministrativeArea', name: prefecture.name } })),
  ],
  provider: {
    '@type': 'Organization',
    name: site.org.legalName,
    url: site.domain,
  },
  termsOfService: `${site.domain}/disclosure/`,
  category: data.serviceName,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'JPY',
    description: '一括見積依頼・業者紹介は完全無料',
  },
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const howToLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${data.serviceName}の業者選びで確認すべきポイント`,
  description: `${prefecture.name}で${data.serviceName}業者を選ぶ際の確認手順`,
  step: data.selectionCriteria.map((c, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: c.title,
    text: c.body,
  })),
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description: description,
  dateModified: data.meta.lastUpdated,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  about: { '@type': 'Service', name: data.serviceName },
  spatialCoverage: { '@type': 'AdministrativeArea', name: prefecture.name },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.aio-summary', '.faq-q', '.faq-a'],
  },
});

const priceLd = data.costGuide.priceRange ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AggregateOffer',
  name: `${prefecture.name}の${data.serviceName}費用相場`,
  description: data.costGuide.intro,
  priceCurrency: 'JPY',
  lowPrice: String(data.costGuide.priceRange.min),
  highPrice: String(data.costGuide.priceRange.max),
  offerCount: data.costGuide.table.rows.length,
  areaServed: { '@type': 'AdministrativeArea', name: prefecture.name },
  itemOffered: {
    '@type': 'Service',
    name: data.serviceName,
    serviceType: data.serviceName,
  },
}) : null;

const jsonLdBlocks = [breadcrumbLd, serviceLd, webPageLd, faqLd, howToLd, priceLd].filter(Boolean) as string[];
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={data.siteName}
  logoSub={`${prefecture.name}の${data.serviceName}業者をご紹介`}
  ogImage={`${site.domain}/og-${data.slug}.png`}
  jsonLdBlocks={jsonLdBlocks}
  noindex={noindex}
>
  <HeroWithForm data={data} />
  <Breadcrumb items={[
    { label: 'トップ', href: '/' },
    { label: data.serviceName, href: `/${data.slug}/` },
    { label: prefecture.name },
  ]} />
  <AIOSummary lead={data.aiSummary.lead} facts={data.aiSummary.facts} serviceName={data.serviceName} />
  <TrustStrip />
  <PrefectureIntro prefecture={prefecture} service={data} />
  <ProcessSteps serviceName={data.serviceName} />
  <TrustBadges stats={data.trustStats} />
  <LegalSection legal={data.legal} serviceName={data.serviceName} relatedColumns={data.relatedColumns} />
  <RiskCards risks={data.risks} serviceName={data.serviceName} />
  <CostTable costGuide={data.costGuide} serviceName={data.serviceName} lastUpdated={data.meta.lastUpdated} relatedColumns={data.relatedColumns} />
  <IndustrySection industries={data.industries} serviceName={data.serviceName} />
  <SelectionChecklist criteria={data.selectionCriteria} serviceName={data.serviceName} />
  <MistakesSection mistakes={data.mistakes} serviceName={data.serviceName} />
  <ComparisonTipsSection tips={data.comparisonTips} serviceName={data.serviceName} />
  <QuoteFormFull data={data} />
  <FAQ faq={data.faq} serviceName={data.serviceName} />
  <PrefectureGrid serviceSlug={data.slug} serviceName={data.serviceName} />
  <RelatedServices currentSlug={data.slug} relatedSlugs={data.relatedServiceSlugs} />
  <BottomCTA serviceName={data.serviceName} />
</BaseLayout>
