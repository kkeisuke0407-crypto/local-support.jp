---
import BaseLayout from './BaseLayout.astro';
import HeroWithForm from '../components/HeroWithForm.astro';
import TrustStrip from '../components/TrustStrip.astro';
import PrefectureIntro from '../components/PrefectureIntro.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import TrustBadges from '../components/TrustBadges.astro';
import LegalSection from '../components/LegalSection.astro';
import RiskCards from '../components/RiskCards.astro';
import CostTable from '../components/CostTable.astro';
import IndustrySection from '../components/IndustrySection.astro';
import SelectionChecklist from '../components/SelectionChecklist.astro';
import MistakesSection from '../components/MistakesSection.astro';
import QuoteComparisonChecklist from '../components/QuoteComparisonChecklist.astro';
import ComparisonTipsSection from '../components/ComparisonTipsSection.astro';
import QuoteFormFull from '../components/QuoteFormFull.astro';
import FAQ from '../components/FAQ.astro';
import RelatedServices from '../components/RelatedServices.astro';
import PrefectureGrid from '../components/PrefectureGrid.astro';
import BottomCTA from '../components/BottomCTA.astro';
import AIOSummary from '../components/AIOSummary.astro';
import PrefectureLocalSection from '../components/PrefectureLocalSection.astro';
import PrefectureLocalCases from '../components/PrefectureLocalCases.astro';
import CommonGuideLinks from '../components/CommonGuideLinks.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ServiceEntryLinks from '../components/ServiceEntryLinks.astro';
import Toc from '../components/Toc.astro';
import { site } from '../data/site';
import { ogImageUrl } from '../data/ogImage';
import { quoteComparisonChecklist } from '../data/quoteComparisonChecklist';
import { buildServiceFaq } from '../data/serviceFaq';
import type { ServiceData } from '../data/services/_types';
import type { Prefecture } from '../data/prefectures';
import { isPrimaryPrefecture } from '../data/prefectures';

interface Props { data: ServiceData; prefecture: Prefecture; }
const { data, prefecture } = Astro.props;

// サービス × 都道府県の固有コンテンツ（あれば共通コンテンツに上書き／追加）
const override = data.prefectureOverrides?.[prefecture.slug];
const condensed = override?.condenseCommonSections === true;
const tocItems = condensed ? [
  { href: '#cost', label: '費用相場' },
  ...(override?.localCases ? [{ href: '#local-cases', label: '地域の相談事例' }] : []),
  { href: '#select', label: '業者選び' },
  { href: '#common-guide', label: '法令・注意点' },
  { href: '#faq', label: 'よくある質問' },
  { href: '#contact', label: '無料見積もり' },
] : undefined;
// 地域補正済みの相場表があれば差し替え
const costGuide = override?.costRows
  ? { ...data.costGuide, table: { ...data.costGuide.table, rows: override.costRows } }
  : data.costGuide;
// 共通FAQに見積比較・費用変動・業者選びのQ&Aを補完し、都道府県固有FAQも末尾に追加
const fullFaq = buildServiceFaq(data, { prefectureName: prefecture.name, additionalFaq: override?.localFaq });
// 要約版では、都道府県固有のFAQを先頭に置き、全国共通のFAQは3問に絞る（全国版と同じ本文の重複を減らす）
const faq = condensed
  ? [...(override?.localFaq ?? []), ...fullFaq.filter((f) => !(override?.localFaq ?? []).includes(f)).slice(0, 3)]
  : fullFaq;

const canonical = `${site.domain}/${data.slug}/${prefecture.slug}/`;
const cityText = prefecture.majorCities.slice(0, 3).join('・');
const title = override?.metaTitle ?? `${prefecture.name}の${data.serviceName}｜業者を一括比較｜${site.name}`;
const description = override?.metaDescription ?? `${prefecture.name}（${prefecture.majorCities.join('・')}など）の${data.serviceName}に対応できる業者を一括見積で比較。法定義務・費用相場・業者の選び方を解説。資格・許認可を確認した業者から最大5社をご紹介、完全無料。`;

// 主要都府県（全サービス共通）か、サービス別の追加インデックス県の場合はindex対象。
// それ以外は段階的公開のためnoindex（ユニークコンテンツ拡充後に解除）
const isAdditionalIndexed = data.additionalIndexedPrefectures?.includes(prefecture.slug) ?? false;
const noindex = !isPrimaryPrefecture(prefecture.slug) && !isAdditionalIndexed;

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: data.serviceName, item: `${site.domain}/${data.slug}/` },
    { '@type': 'ListItem', position: 3, name: prefecture.name, item: canonical },
  ],
});

const serviceLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonical}#service`,
  name: `${prefecture.name}の${data.serviceName}一括見積比較`,
  serviceType: data.serviceName,
  description: description,
  url: canonical,
  brand: { '@type': 'Brand', name: site.name },
  areaServed: [
    { '@type': 'AdministrativeArea', name: prefecture.name },
    ...prefecture.majorCities.map((city) => ({ '@type': 'City', name: city, containedInPlace: { '@type': 'AdministrativeArea', name: prefecture.name } })),
  ],
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'マンション管理組合・ビル管理会社・施設管理担当者',
  },
  /* Organizationエンティティは BaseLayout で @id 付き定義済み。ここでは参照のみ */
  provider: { '@id': `${site.domain}/#organization` },
  termsOfService: `${site.domain}/terms/`,
  category: data.serviceName,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'JPY',
    description: '一括見積依頼・業者紹介は完全無料',
    availability: 'https://schema.org/InStock',
    eligibleRegion: { '@type': 'AdministrativeArea', name: prefecture.name },
  },
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

// 関連法令を e-Gov法令検索の出典としてcitation化（AIO/E-E-A-T強化）
const isLaw = (n: string) => /法/.test(n) && !/基準|告示|要領|指針|ガイドライン|マニュアル/.test(n);
const egovUrl = (n: string) =>
  `https://laws.e-gov.go.jp/search/elawsSearch/elaws_search/lsg0100/?keyword=${encodeURIComponent(n.replace(/第.*$/, '').replace(/（.*?）/g, '').trim())}`;
const legalCitations = data.legal.legalBasis
  .filter(isLaw)
  .map((law) => ({ '@type': 'Legislation', name: law, url: egovUrl(law), jurisdiction: 'JP' }));

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description: description,
  dateModified: data.meta.lastUpdated,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${site.domain}/#website` },
  /* このページの主題は Service エンティティ。地域指定もここで明示 */
  mainEntity: { '@id': `${canonical}#service` },
  about: { '@id': `${canonical}#service` },
  ...(legalCitations.length ? { citation: legalCitations } : {}),
  spatialCoverage: { '@type': 'AdministrativeArea', name: prefecture.name },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.aio-summary', '.faq-q', '.faq-a'],
  },
});

// AggregateOffer（業者の費用相場）は付けない。ロカサポは売り手ではないため（2026-09 監査）

/* HowTo の代替として ItemList で「業者選びチェックリスト」を構造化。
   ItemList はHowToと違い汎用で AI Overview の引用にも使われる。 */
const checklistLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${prefecture.name}の${data.serviceName}業者選びチェックリスト`,
  description: `${prefecture.name}で${data.serviceName}業者を選ぶときに確認すべき${data.selectionCriteria.length}項目`,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: data.selectionCriteria.length,
  itemListElement: data.selectionCriteria.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.title,
    description: c.body,
  })),
});

const quoteComparisonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${prefecture.name}の${data.serviceName}見積比較チェックリスト`,
  description: `${prefecture.name}で${data.serviceName}の見積書を比較するときに確認すべき${quoteComparisonChecklist.length}項目`,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: quoteComparisonChecklist.length,
  itemListElement: quoteComparisonChecklist.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    description: `${item.check}。見落とすと${item.risk}。`,
  })),
});
const jsonLdBlocks = [breadcrumbLd, serviceLd, webPageLd, faqLd, checklistLd, condensed ? null : quoteComparisonLd].filter(Boolean) as string[];
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={data.siteName}
  logoSub={`${prefecture.name}の${data.serviceName}業者をご紹介`}
  ogImage={ogImageUrl(data.slug)}
  preloadImage={`/images/services/hero-${data.slug}.webp?v=20260529-office-cleanup`}
  jsonLdBlocks={jsonLdBlocks}
  noindex={noindex}
>
  <HeroWithForm
    data={data}
    headline={`${prefecture.name}の${data.serviceName}業者を一括比較`}
    subheadline={`${cityText}など${prefecture.name}内で、資格・許認可を確認した業者から最大5社をご紹介します。`}
  />
  <Breadcrumb items={[
    { label: 'トップ', href: '/' },
    { label: data.serviceName, href: `/${data.slug}/` },
    { label: prefecture.name },
  ]} />
  <AIOSummary lead={data.aiSummary.lead} facts={data.aiSummary.facts} serviceName={data.serviceName} />
  <ServiceEntryLinks data={data} prefectureName={prefecture.name} />
  <Toc serviceName={data.serviceName} items={tocItems} />
  <TrustStrip />
  <PrefectureIntro prefecture={prefecture} service={data} />
  {override?.localSection && (
    <PrefectureLocalSection title={override.localSection.title} paragraphs={override.localSection.paragraphs} />
  )}
  {override?.localCases && (
    <PrefectureLocalCases title={override.localCases.title} lead={override.localCases.lead} cases={override.localCases.cases} findings={override.localCases.findings} />
  )}
  <ProcessSteps serviceName={data.serviceName} />
  <TrustBadges stats={data.trustStats} />
  {condensed ? (
    <>
      <CostTable costGuide={costGuide} serviceName={data.serviceName} lastUpdated={data.meta.lastUpdated} relatedColumns={data.relatedColumns} prefecture={prefecture} />
      <SelectionChecklist criteria={data.selectionCriteria} serviceName={data.serviceName} />
      <CommonGuideLinks serviceSlug={data.slug} serviceName={data.serviceName} columns={(data.relatedColumns ?? []).slice(0, 5).map((c) => ({ href: c.href, title: c.title }))} />
    </>
  ) : (
    <>
      <LegalSection legal={data.legal} serviceName={data.serviceName} relatedColumns={data.relatedColumns} />
      <RiskCards risks={data.risks} serviceName={data.serviceName} />
      <CostTable costGuide={costGuide} serviceName={data.serviceName} lastUpdated={data.meta.lastUpdated} relatedColumns={data.relatedColumns} prefecture={prefecture} />
      <IndustrySection industries={data.industries} serviceName={data.serviceName} />
      <SelectionChecklist criteria={data.selectionCriteria} serviceName={data.serviceName} />
      <MistakesSection mistakes={data.mistakes} serviceName={data.serviceName} />
      <QuoteComparisonChecklist serviceName={data.serviceName} prefectureName={prefecture.name} />
      <ComparisonTipsSection tips={data.comparisonTips} serviceName={data.serviceName} />
    </>
  )}
  <QuoteFormFull data={data} />
  <FAQ faq={faq} serviceName={data.serviceName} />
  <PrefectureGrid serviceSlug={data.slug} serviceName={data.serviceName} />
  <RelatedServices currentSlug={data.slug} relatedSlugs={data.relatedServiceSlugs} />
  <BottomCTA serviceName={data.serviceName} />
</BaseLayout>
