---
import BaseLayout from '../../layouts/BaseLayout.astro';

const PAGE_TITLE = "アスベスト調査・除去の費用と業者を比較｜アスベスト調査ナビ";
const PAGE_DESC  = "アスベスト（石綿）の事前調査・分析・除去の費用相場、法定義務の範囲、業者の選び方を解説。建物解体・改修工事前の石綿調査義務に対応した地元業者を無料でご紹介します。";
const CANONICAL  = "https://local-support.jp/asbestos/";
const SITE_NAME  = "アスベスト調査ナビ";

const faqItems = [
  {
    q: "アスベスト調査はどのような工事前に義務になりますか？",
    a: "2022年4月以降、建築物の解体・改修を行う全ての工事の前に、有資格者（建築物石綿含有建材調査者等）による事前調査が義務付けられています（大気汚染防止法・石綿障害予防規則）。規模にかかわらず調査が必要です。"
  },
  {
    q: "アスベスト調査の費用の目安はどのくらいですか？",
    a: "現地調査費用は建物規模によって30,000〜100,000円程度、分析費用は1検体あたり10,000〜20,000円程度が目安です。除去工事が必要な場合は面積・飛散性によって100,000円〜と幅があります。正確な費用は現地調査後のお見積もりとなります。"
  },
  {
    q: "有資格者とはどのような資格ですか？",
    a: "「建築物石綿含有建材調査者」（一般・特定・一戸建て等）が主な資格です。2022年の法改正後は、この有資格者または「石綿作業主任者」が事前調査を行うことが義務付けられています。業者選びの際は資格証の提示を求めてください。"
  },
  {
    q: "アスベスト調査から除去まで、どのくらいの期間がかかりますか？",
    a: "調査のみであれば現地作業1日〜、分析結果を含めて1〜2週間程度です。除去工事が必要な場合は規模・飛散性によって大きく異なりますが、工事前の行政への届出期間（14日前まで等）も考慮したスケジュールが必要です。解体・改修工事の日程が決まったら早めにご相談ください。"
  },
  {
    q: "業者選びで何を確認すればよいですか？",
    a: "①「建築物石綿含有建材調査者」の資格保有者が在籍しているか、②分析を行う環境計量士や登録分析機関と連携しているか、③調査報告書の様式・内容が適切か、④除去工事後の最終確認（気中濃度測定等）を行うか、を確認してください。"
  },
  {
    q: "アスベスト除去の補助金はありますか？",
    a: "自治体によっては、アスベスト調査・除去費用の補助金や助成金制度があります。対象条件・補助率は自治体によって異なります。お問い合わせいただければ、施設所在地の補助金制度についても情報提供が可能です。"
  }
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});
---
<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical={CANONICAL}
  siteName={SITE_NAME}
  logoSub="費用・業者を正直に比較"
  faqJsonLd={faqJsonLd}
>

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="sd-container hero-inner">
    <div class="hero-eyebrow">建物解体・改修工事を予定している担当者向け</div>
    <h1>アスベスト調査、<em>法改正で義務が</em><br/><em>強化されました</em></h1>
    <p class="hero-sub">
      2022年4月以降、<strong>全ての解体・改修工事前に有資格者による石綿事前調査が義務</strong>になりました。<br/>
      調査費用・業者の選び方・法的要件まで、担当者の疑問をまとめて解決します。
    </p>
    <div class="hero-badges">
      <div class="hero-badge-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>2022年4月 法改正対応</span>
      </div>
      <div class="hero-badge-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
        <span>相談・見積もり無料</span>
      </div>
      <div class="hero-badge-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>全国対応</span>
      </div>
    </div>
    <a href="#contact" class="hero-cta" data-scroll-to="#contact" data-track="hero_contact">
      <span class="hero-cta-free">無料</span>
      地元業者に調査を依頼する
      <span>›</span>
    </a>
    <p class="hero-note">営業時間内（平日 9:00〜18:00）にご連絡します</p>
  </div>
  <div class="hero-wave">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="#f5f6f8"/>
    </svg>
  </div>
</section>

<!-- ══ 法定義務 ════════════════════════════════════════════════ -->
<section class="sd-section gimu-section" id="gimu">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">LEGAL OBLIGATION</span>
      <h2>石綿事前調査は「法律上の義務」です</h2>
      <p>2022年4月の法改正により、調査義務の範囲が大幅に拡大されました</p>
    </div>
    <div class="gimu-alert">
      <div class="gimu-alert-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div>
        <div class="gimu-alert-title">2022年4月以降、全ての解体・改修工事前に有資格者による事前調査が必須になりました</div>
        <div class="gimu-alert-body">
          大気汚染防止法（石綿障害予防規則）の改正により、<strong>建物規模を問わず全ての解体・改修工事前</strong>に有資格者による石綿含有建材の事前調査が義務化されました。
          調査結果の記録・保存・行政への報告も義務付けられています。
        </div>
      </div>
    </div>
    <div class="gimu-cards">
      <div class="gimu-card">
        <div class="gimu-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          対象工事
        </div>
        <p>建築物の解体工事・改修工事が対象です。外壁改修・内装リニューアル・設備更新など、建材に触れる工事は原則すべて調査が必要です。</p>
        <div class="tag-list">
          <span class="tag-item">解体工事</span>
          <span class="tag-item">外壁改修</span>
          <span class="tag-item">内装改修</span>
          <span class="tag-item">設備更新</span>
          <span class="tag-item">屋根改修</span>
        </div>
      </div>
      <div class="gimu-card">
        <div class="gimu-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          調査の流れ
        </div>
        <p>①書面調査（設計図書・施工記録の確認）、②現地調査（目視・採取）、③分析（登録分析機関への依頼）、④調査報告書の作成・保管の手順で行います。</p>
        <div class="tag-list">
          <span class="tag-item">書面調査</span>
          <span class="tag-item">現地目視調査</span>
          <span class="tag-item">試料採取・分析</span>
          <span class="tag-item">報告書作成</span>
        </div>
      </div>
      <div class="gimu-card">
        <div class="gimu-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          業者の資格要件
        </div>
        <p>「建築物石綿含有建材調査者」（一般・特定・一戸建て等）の資格保有者が事前調査を実施することが義務付けられています。資格証の確認が重要です。</p>
        <div class="tag-list">
          <span class="tag-item">建築物石綿含有建材調査者</span>
          <span class="tag-item">石綿作業主任者</span>
        </div>
      </div>
    </div>
    <p style="font-size:.8rem;color:var(--gray-500);margin-top:12px;">根拠法令：大気汚染防止法（石綿障害予防規則）</p>
  </div>
</section>

<!-- ══ 放置リスク ════════════════════════════════════════════════ -->
<div class="divider"></div>
<section class="sd-section" id="risk">
  <div class="sd-container">
    <div class="risk-label">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      調査を省略するリスク
    </div>
    <div class="section-head" style="text-align:left;margin-bottom:1.25rem;">
      <h2>調査なしで工事を始めると起きる4つのリスク</h2>
      <p>アスベスト調査の省略は法令違反となり、深刻な影響をもたらします。</p>
    </div>
    <div class="risk-cards">
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/></svg>
          罰則・工事中止命令
        </div>
        <p>事前調査を実施せずに工事を行った場合、大気汚染防止法違反として罰則（最大1年以下の懲役または100万円以下の罰金）や工事の中止命令が出る可能性があります。</p>
      </div>
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          健康被害リスク
        </div>
        <p>アスベストを含む建材を適切な防護なしに切断・破砕すると、飛散した繊維が作業員・近隣住民の肺に蓄積し、中皮腫・肺がんなどの深刻な疾病を引き起こす危険があります。</p>
      </div>
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          工事遅延・コスト増
        </div>
        <p>工事途中でアスベストが発見された場合、工事を中断して除去・処理が必要になり、大幅な工期遅延と追加費用が発生します。事前調査で把握しておけばスケジュールに組み込めます。</p>
      </div>
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          近隣トラブル・損害賠償
        </div>
        <p>アスベストが飛散した場合、近隣住民・テナント・工事関係者から損害賠償を請求されるリスクがあります。発注者・元請業者ともに責任を問われる可能性があります。</p>
      </div>
    </div>
  </div>
</section>

<!-- ══ 費用の目安 ═══════════════════════════════════════════════ -->
<div class="divider"></div>
<section class="sd-section section-white" id="cost">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">COST GUIDE</span>
      <h2>アスベスト調査・除去の費用目安</h2>
      <p>以下はあくまで参考相場です。実際の費用は現地確認後の見積もりで確定します</p>
    </div>
    <div class="cost-grid">
      <div class="cost-card">
        <div class="cost-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          現地調査費用
        </div>
        <div class="cost-card-body">
          <div class="cost-range">30,000 〜 100,000円<small>（建物規模による）</small></div>
          <div class="cost-note-list">
            <div class="cost-note-item">書面調査＋現地目視調査</div>
            <div class="cost-note-item">調査報告書の作成を含む</div>
            <div class="cost-note-item">建物規模・階数・部材数で変動</div>
          </div>
        </div>
      </div>
      <div class="cost-card">
        <div class="cost-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
          分析費用
        </div>
        <div class="cost-card-body">
          <div class="cost-range">10,000 〜 20,000円<small>（1検体あたり）</small></div>
          <div class="cost-note-list">
            <div class="cost-note-item">登録分析機関での定量・定性分析</div>
            <div class="cost-note-item">検体数は建材の種類・数による</div>
            <div class="cost-note-item">分析結果書は行政報告に必要</div>
          </div>
        </div>
      </div>
      <div class="cost-card">
        <div class="cost-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/></svg>
          除去工事費用
        </div>
        <div class="cost-card-body">
          <div class="cost-range">100,000円〜<small>（面積・飛散性による）</small></div>
          <div class="cost-note-list">
            <div class="cost-note-item">飛散性アスベストは隔離養生が必要</div>
            <div class="cost-note-item">廃棄物処理費用が別途発生</div>
            <div class="cost-note-item">除去後の気中濃度測定を推奨</div>
          </div>
        </div>
      </div>
    </div>
    <div class="cost-factors">
      <div class="cost-factors-title">費用が変わる主な要因</div>
      <div class="cost-factors-grid">
        <div class="cost-factor"><div class="cost-factor-num">1</div><span>建物の規模・構造・建築年（1975年以前は特に注意）</span></div>
        <div class="cost-factor"><div class="cost-factor-num">2</div><span>検体数・アスベスト含有建材の種類と量</span></div>
        <div class="cost-factor"><div class="cost-factor-num">3</div><span>アスベストの飛散性（レベル1〜3の区分）</span></div>
        <div class="cost-factor"><div class="cost-factor-num">4</div><span>除去工事の規模・養生の必要性・廃棄物処理</span></div>
      </div>
    </div>
    <div class="cost-note-box">
      <strong>料金の確認について：</strong>上記はあくまで参考相場です。建物の状況・対象範囲によって金額は大きく異なります。必ず現地調査後の見積もりで確認してください。
    </div>
    <div class="inline-cta" style="margin-top:28px;">
      <div class="inline-cta-text">
        <h4>解体・改修工事のご予定がある方へ</h4>
        <p>工事日程が決まったら早めのご相談が重要です。調査〜報告まで対応業者をご紹介します</p>
      </div>
      <a href="#contact" class="inline-cta-btn" data-scroll-to="#contact" data-track="cost_contact">無料で相談する ›</a>
    </div>
  </div>
</section>

<!-- ══ 工事種別 ════════════════════════════════════════════════ -->
<div class="divider"></div>
<section class="sd-section" id="kojishubetsu">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">BY PROJECT TYPE</span>
      <h2>工事種別ごとの注意点</h2>
      <p>工事の種別によって必要な調査範囲・対応が異なります</p>
    </div>
    <div class="gyoshu-grid">
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></div>
        <h3>解体工事前</h3>
        <p>建物全体の解体前は最も広範な調査が必要です。全部材を対象に書面調査・現地調査を行い、アスベスト含有建材の有無・量・飛散性を特定します。行政への届出（大防法・石防則）も必要です。</p>
        <span class="gyoshu-tag">全棟解体・部分解体</span>
      </div>
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg></div>
        <h3>改修工事前</h3>
        <p>内装改修・外壁改修・設備更新など、部分的な改修でも工事で触れる建材の事前調査が義務です。工事範囲に応じた調査報告書を作成・保管する必要があります。</p>
        <span class="gyoshu-tag">内装・外壁・設備改修</span>
      </div>
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20M4 20V8l8-6 8 6v12"/><path d="M10 20v-6h4v6"/></svg></div>
        <h3>大規模修繕時</h3>
        <p>マンション等の大規模修繕では外壁・屋根・共用部などに石綿含有建材が使用されている場合があります。修繕前の事前調査と、アスベストが確認された場合の適切な処理計画が必要です。</p>
        <span class="gyoshu-tag">マンション・ビル大規模修繕</span>
      </div>
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg></div>
        <h3>自主調査（任意）</h3>
        <p>工事予定はないが建物の状態を把握したい場合の自主調査も対応しています。特に1970〜1980年代の建築物は石綿含有建材が多く使用されており、事前把握がリスク管理に役立ちます。</p>
        <span class="gyoshu-tag">現状把握・リスク管理</span>
      </div>
    </div>
  </div>
</section>

