---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { hearingQuestions, defaultHearingQuestions } from '../../data/hearing-questions';

const title = 'お見積もり事前ヒアリング｜ロカサポ';
const description = 'ロカサポの見積もり精度を高めるための事前ヒアリングページです。';
const canonical = `${site.domain}/hearing/`;

// サービス別の質問設定をクライアントへ渡す（JSがslugに応じて動的描画）
const questionsJson = JSON.stringify({ byService: hearingQuestions, default: defaultHearingQuestions });
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="お見積もり事前ヒアリング"
  noindex={true}
>
  <link rel="stylesheet" href="/css/hearing.css" slot="head" />
  <section class="hr-section">
    <div class="sd-container">

      <div class="hr-empty" id="hr-empty">
        <h1>お見積もり事前ヒアリング</h1>
        <p>このページは、ロカサポからお送りしたメール内のリンクからアクセスしてください。</p>
        <p>URLが正しく開けない場合は <a href="mailto:support@local-support.jp">support@local-support.jp</a> までご連絡ください。</p>
      </div>

      <div class="hr-main" id="hr-main" hidden>

        <header class="hr-header">
          <p class="hr-eyebrow">お見積もり事前ヒアリング</p>
          <h1 id="hr-h1">お見積もり事前ヒアリング</h1>
          <p class="hr-lead">
            より正確なお見積もりをご用意するため、いくつかの追加情報をお伺いします。<br/>
            <strong>所要時間は約2分</strong>です。回答内容は業者選定の精度向上にのみ使用します。
          </p>
          <dl class="hr-meta">
            <div><dt>案件ID</dt><dd id="hr-id"></dd></div>
            <div><dt>サービス</dt><dd id="hr-service"></dd></div>
            <div><dt>施設の種類</dt><dd id="hr-facility"></dd></div>
            <div><dt>ご依頼者</dt><dd id="hr-requester"></dd></div>
          </dl>
        </header>

        <form class="hr-form" id="hr-form" novalidate>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hr-honeypot" aria-hidden="true" />

          <!-- 質問はサービスに応じて hearing.js が動的に描画 -->
          <div id="hr-questions"></div>

          <button type="submit" class="hr-submit" id="hr-submit">この内容で送信する</button>
          <p class="hr-submit-note">送信後、ロカサポ運営事務局でこの情報をもとに業者選定を進めます。回答内容が業者へ共有されるのは、後日あなたが業者を選定した後です。</p>
          <p class="hr-error" id="hr-error" hidden></p>
        </form>

        <div class="hr-done" id="hr-done" hidden>
          <div class="hr-done-icon">✓</div>
          <h2>ご回答ありがとうございました</h2>
          <p>いただいた情報をもとに、ロカサポ運営事務局が条件に合う業者を選定します。<br/>業者の概算見積が揃いましたら、比較ページのURLをメールでお送りします。</p>
          <p class="hr-done-note">ご質問は <a href="mailto:support@local-support.jp">support@local-support.jp</a> までご連絡ください。</p>
        </div>

      </div>
    </div>
  </section>

  <script is:inline set:html={`window.__HEARING_Q = ${questionsJson};`}></script>
  <script is:inline src="/js/hearing.js"></script>
</BaseLayout>
