---
import BaseLayout from '../../layouts/BaseLayout.astro';

const PAGE_TITLE = "シャッター点検・修理の費用と業者を比較｜シャッター点検ナビ";
const PAGE_DESC  = "防火シャッター・電動シャッターの定期点検・修理費用の相場、法定義務、業者の選び方を解説。建築基準法による点検義務に対応した地元業者を無料でご紹介します。";
const CANONICAL  = "https://local-support.jp/shutter/";
const SITE_NAME  = "シャッター点検ナビ";

const faqItems = [
  {
    q: "防火シャッターの定期点検は法律で義務ですか？",
    a: "はい。建築基準法第12条に基づく定期報告制度により、防火シャッターを含む防火設備は年1回の定期検査と特定行政庁への報告が義務付けられています。対象は一定規模以上の建築物（学校・病院・ホテル・百貨店・共同住宅等）です。"
  },
  {
    q: "シャッター点検・修理の費用の目安はどのくらいですか？",
    a: "定期点検は1台あたり5,000〜20,000円、スプリング交換などの修理は20,000〜80,000円、モーター交換は50,000〜200,000円、全交換は100,000〜500,000円程度が目安です。台数・種類・状態によって大きく異なるため、現地調査後のお見積もりとなります。"
  },
  {
    q: "電動シャッターが動かなくなりました。どうすればよいですか？",
    a: "まず安全を確認した上で、手動での開閉をお試しください（緊急時用の手動チェーンがある場合）。電源・ブレーカーの確認も行ってください。それでも動かない場合は専門業者への修理依頼が必要です。防火シャッターの場合は消防法上の観点からも早急な対応をおすすめします。"
  },
  {
    q: "定期点検は誰が行う必要がありますか？",
    a: "建築基準法第12条に基づく定期点検は「一級建築士」または「防火設備検査員」（国土交通大臣登録）が実施し、特定行政庁に報告する義務があります。資格のない業者の点検は法定報告として認められません。"
  },
  {
    q: "保守契約とはどのようなものですか？",
    a: "保守契約は定期点検・部品交換・緊急修理対応を含む年間管理契約です。定期点検費用・部品費用がまとめられ、スポット依頼より費用を抑えられるケースがあります。緊急時の対応が迅速になる点もメリットです。複数台のシャッターがある施設は特にご検討ください。"
  },
  {
    q: "古いシャッターは修理と交換、どちらが良いですか？",
    a: "一般的にシャッターの耐用年数は15〜20年程度です。スプリングやバネの交換であれば修理が経済的ですが、モーターの老朽化・本体の変形・開閉不良が頻発する場合は交換を検討してください。防火性能が要求されるシャッターは、機能低下が法令違反につながるため早めの判断が重要です。"
  }
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
});
---
<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical={CANONICAL}
  siteName={SITE_NAME}
  logoSub="費用・業者を正直に比較"
  faqJsonLd={faqJsonLd}
>

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="hero">
  <div class="sd-container hero-inner">
    <div class="hero-eyebrow">ビルオーナー・管理会社・施設管理担当者向け</div>
    <h1>防火シャッターの定期点検、<br/><em>建築基準法で義務化</em>されています</h1>
    <p class="hero-sub">
      防火シャッターは<strong>建築基準法第12条により年1回の定期検査・報告が義務</strong>です。<br/>
      点検費用・修理相場・業者の選び方まで、担当者の疑問をまとめて解決します。
    </p>
    <div class="hero-badges">
      <div class="hero-badge-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span>建築基準法対応</span>
      </div>
      <div class="hero-badge-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/></svg>
        <span>相談・見積もり無料</span>
      </div>
      <div class="hero-badge-item">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>全国対応</span>
      </div>
    </div>
    <a href="#contact" class="hero-cta" data-scroll-to="#contact" data-track="hero_contact">
      <span class="hero-cta-free">無料</span>
      地元業者に点検を依頼する
      <span>›</span>
    </a>
    <p class="hero-note">営業時間内（平日 9:00〜18:00）にご連絡します</p>
  </div>
  <div class="hero-wave">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,30 C360,60 1080,0 1440,30 L1440,60 L0,60 Z" fill="#f5f6f8"/>
    </svg>
  </div>
</section>

<!-- ══ 法定義務 ════════════════════════════════════════════════ -->
<section class="sd-section gimu-section" id="gimu">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">LEGAL OBLIGATION</span>
      <h2>防火シャッターの点検は「法律上の義務」です</h2>
      <p>建築基準法第12条の定期報告制度について確認しましょう</p>
    </div>
    <div class="gimu-alert">
      <div class="gimu-alert-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <div>
        <div class="gimu-alert-title">防火シャッターは年1回の定期検査・報告が義務（建築基準法第12条）</div>
        <div class="gimu-alert-body">
          建築基準法第12条の定期報告制度により、対象建築物の防火シャッターは<strong>年1回の定期検査と特定行政庁への報告</strong>が義務付けられています。
          検査は「一級建築士」または「防火設備検査員」が実施する必要があります。
        </div>
      </div>
    </div>
    <div class="gimu-cards">
      <div class="gimu-card">
        <div class="gimu-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          対象シャッター
        </div>
        <p>防火シャッター・防煙シャッターが主な対象です。設置されている建築物（学校・病院・ホテル・百貨店・共同住宅等、一定規模以上）全体が定期報告の対象となります。</p>
        <div class="tag-list">
          <span class="tag-item">防火シャッター</span>
          <span class="tag-item">防煙シャッター</span>
          <span class="tag-item">複合防火設備</span>
        </div>
      </div>
      <div class="gimu-card">
        <div class="gimu-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          検査内容・頻度
        </div>
        <p>年1回の定期検査では、シャッターの作動状況・感知器連動・障害物感知機能・ガイドレールの状態などを確認します。検査結果は特定行政庁に報告する必要があります。</p>
        <div class="tag-list">
          <span class="tag-item">年1回の検査・報告</span>
          <span class="tag-item">作動確認</span>
          <span class="tag-item">感知器連動確認</span>
        </div>
      </div>
      <div class="gimu-card">
        <div class="gimu-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          資格要件
        </div>
        <p>定期検査は「一級建築士」または「防火設備検査員」（国土交通大臣登録）の資格を持つ者が実施し、特定行政庁に報告しなければなりません。無資格者の点検では報告義務を果たせません。</p>
        <div class="tag-list">
          <span class="tag-item">一級建築士</span>
          <span class="tag-item">防火設備検査員</span>
          <span class="tag-item">行政報告が必要</span>
        </div>
      </div>
    </div>
    <p style="font-size:.8rem;color:var(--gray-500);margin-top:12px;">根拠法令：建築基準法第12条（定期報告制度）</p>
  </div>
</section>

<!-- ══ 放置リスク ════════════════════════════════════════════════ -->
<div class="divider"></div>
<section class="sd-section" id="risk">
  <div class="sd-container">
    <div class="risk-label">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      点検を怠るリスク
    </div>
    <div class="section-head" style="text-align:left;margin-bottom:1.25rem;">
      <h2>シャッター点検を怠ると起きる4つのリスク</h2>
      <p>防火シャッターの不備は人命・法令・費用の複合リスクを招きます。</p>
    </div>
    <div class="risk-cards">
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
          火災時の不作動
        </div>
        <p>整備不良の防火シャッターは火災時に正常に閉まらず、火炎・煙の区画遮断機能が失われます。建物内への延焼拡大を防げず、避難・消火活動に重大な支障をきたします。</p>
      </div>
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>
          法令違反・行政指導
        </div>
        <p>定期報告を怠った場合、建築基準法違反として特定行政庁から是正指導・報告命令が出る可能性があります。悪質な場合は罰則（100万円以下の罰金等）の対象になります。</p>
      </div>
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          挟まれ事故リスク
        </div>
        <p>自動閉鎖機能の不具合や障害物感知センサーの誤作動・不作動により、通行中の人が挟まれる事故が起きるリスクがあります。定期的な作動確認・センサー点検が重要です。</p>
      </div>
      <div class="risk-card">
        <div class="risk-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          修理費増大
        </div>
        <p>定期点検で早期発見できる不具合も、放置すると本体の歪み・巻取り部の破損・モーターの焼き付きなど大規模修理に発展します。早期対応が修繕費用を抑える最善策です。</p>
      </div>
    </div>
  </div>
</section>

<!-- ══ 費用の目安 ═══════════════════════════════════════════════ -->
<div class="divider"></div>
<section class="sd-section section-white" id="cost">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">COST GUIDE</span>
      <h2>シャッター点検・修理の費用目安</h2>
      <p>以下はあくまで参考相場です。実際の費用は現地確認後の見積もりで確定します</p>
    </div>
    <div class="cost-grid">
      <div class="cost-card">
        <div class="cost-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/></svg>
          定期点検
        </div>
        <div class="cost-card-body">
          <div class="cost-range">5,000 〜 20,000円<small>（1台あたり）</small></div>
          <div class="cost-note-list">
            <div class="cost-note-item">作動確認・センサー動作確認</div>
            <div class="cost-note-item">行政報告書の作成を含む</div>
            <div class="cost-note-item">台数によりまとめ割引の場合あり</div>
          </div>
        </div>
      </div>
      <div class="cost-card">
        <div class="cost-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          修理（スプリング交換等）
        </div>
        <div class="cost-card-body">
          <div class="cost-range">20,000 〜 80,000円<small>（税込・目安）</small></div>
          <div class="cost-note-list">
            <div class="cost-note-item">スプリング・ガイドレール・錠前等</div>
            <div class="cost-note-item">作業内容・部品代により変動</div>
            <div class="cost-note-item">点検時に不具合が見つかった場合</div>
          </div>
        </div>
      </div>
      <div class="cost-card">
        <div class="cost-card-head">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8m-4-4v4"/></svg>
          モーター交換・全交換
        </div>
        <div class="cost-card-body">
          <div class="cost-range">50,000 〜 500,000円<small>（内容による）</small></div>
          <div class="cost-note-list">
            <div class="cost-note-item">モーター交換：5〜20万円</div>
            <div class="cost-note-item">全交換：10〜50万円（サイズによる）</div>
            <div class="cost-note-item">メーカー・型番対応の確認が重要</div>
          </div>
        </div>
      </div>
    </div>
    <div class="cost-factors">
      <div class="cost-factors-title">費用が変わる主な要因</div>
      <div class="cost-factors-grid">
        <div class="cost-factor"><div class="cost-factor-num">1</div><span>シャッターの種類（防火・電動・手動・防煙）と台数</span></div>
        <div class="cost-factor"><div class="cost-factor-num">2</div><span>シャッターのサイズ・メーカー・型番</span></div>
        <div class="cost-factor"><div class="cost-factor-num">3</div><span>劣化・損傷の程度と修理内容</span></div>
        <div class="cost-factor"><div class="cost-factor-num">4</div><span>年間保守契約か、スポット依頼か</span></div>
      </div>
    </div>
    <div class="cost-note-box">
      <strong>料金の確認について：</strong>上記はあくまで参考相場です。シャッターの種類・状態によって金額は大きく変わります。必ず現地確認後の見積もりで確認してください。
    </div>
    <div class="inline-cta" style="margin-top:28px;">
      <div class="inline-cta-text">
        <h4>シャッターの点検・修理費用を確認したい方へ</h4>
        <p>施設の種類・設置台数をお知らせいただければ、対応可能な地元業者をご紹介します</p>
      </div>
      <a href="#contact" class="inline-cta-btn" data-scroll-to="#contact" data-track="cost_contact">無料で相談する ›</a>
    </div>
  </div>
</section>

<!-- ══ シャッター種別 ════════════════════════════════════════ -->
<div class="divider"></div>
<section class="sd-section" id="shuttertype">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">BY SHUTTER TYPE</span>
      <h2>シャッター種別ごとの特徴</h2>
      <p>シャッターの種類によって点検内容・対応が異なります</p>
    </div>
    <div class="gyoshu-grid">
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg></div>
        <h3>防火シャッター</h3>
        <p>火災時に熱感知器・煙感知器と連動して自動閉鎖する設備です。建築基準法第12条の定期報告が義務付けられており、「防火設備検査員」または「一級建築士」による検査が必要です。</p>
        <span class="gyoshu-tag">法定点検・行政報告が必要</span>
      </div>
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="3" rx="1"/><rect x="2" y="10" width="20" height="3" rx="1"/><rect x="2" y="17" width="20" height="3" rx="1"/></svg></div>
        <h3>電動シャッター</h3>
        <p>モーター駆動のシャッターです。モーター・スプロケット・ガイドレール・リミットスイッチの定期点検が重要です。停電時の手動操作（チェーン操作等）の確認も行います。</p>
        <span class="gyoshu-tag">定期メンテナンスで故障予防</span>
      </div>
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div>
        <h3>手動シャッター</h3>
        <p>手動で開閉するシャッターです。スプリングのバランス・ガイドレールの歪み・錠前の動作確認が点検の中心です。スプリングの劣化は開閉時の事故につながるため定期交換を推奨します。</p>
        <span class="gyoshu-tag">スプリング状態の確認が重要</span>
      </div>
      <div class="gyoshu-card">
        <div class="gyoshu-card-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/></svg></div>
        <h3>防煙シャッター</h3>
        <p>煙感知器と連動して煙の拡散を防ぐ設備です。防火シャッター同様に建築基準法第12条の定期報告が必要です。シャッター下部の「まくらゴム」等の密閉性確認も重要です。</p>
        <span class="gyoshu-tag">防火シャッターと同様の義務</span>
      </div>
    </div>
  </div>
</section>

<!-- ══ 業者の選び方 ══════════════════════════════════════════════ -->
<div class="divider"></div>
<section class="sd-section section-white" id="howto">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">HOW TO SELECT</span>
      <h2>業者選びで確認すべき4つのポイント</h2>
      <p>法定点検の要件を満たす業者を選ぶことが重要です</p>
    </div>
    <div class="howto-grid">
      <div class="howto-card"><div class="howto-num">CHECK 01</div><h3>一級建築士または防火設備検査員</h3><p>建築基準法第12条の定期報告には「一級建築士」または「防火設備検査員」の資格が必要です。無資格業者の点検では法定報告として認められません。資格証の確認を必ず行ってください。</p></div>
      <div class="howto-card"><div class="howto-num">CHECK 02</div><h3>メーカー対応・取扱い可否</h3><p>シャッターは製品ごとに部品・仕様が異なります。既設シャッターのメーカー・型番に対応できるか、部品の調達が可能かを事前に確認してください。特殊メーカーは対応業者が限られます。</p></div>
      <div class="howto-card"><div class="howto-num">CHECK 03</div><h3>緊急修理・対応速度</h3><p>シャッターの故障は施設の安全・セキュリティに直結します。緊急修理に対応しているか、対応時間の目安はどのくらいかを確認してください。保守契約では緊急時の優先対応が含まれる場合があります。</p></div>
      <div class="howto-card"><div class="howto-num">CHECK 04</div><h3>定期保守契約の内容</h3><p>年間保守契約では点検費用・部品費用のまとめ割引が期待できます。契約内容（点検回数・部品交換の範囲・緊急対応の有無）を明確にした書面契約を交わしてください。</p></div>
    </div>
    <div class="inline-cta" style="margin-top:32px;">
      <div class="inline-cta-text">
        <h4>シャッターの点検業者をお探しの担当者様へ</h4>
        <p>設置台数・種類・メーカーをお知らせいただければ、対応可能な地元業者をご紹介します</p>
      </div>
      <a href="#contact" class="inline-cta-btn" data-scroll-to="#contact" data-track="howto_contact">まとめて依頼する ›</a>
    </div>
  </div>
</section>

