---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFormGeneric from '../components/ContactFormGeneric.astro';
import { site, serviceIndex, prefectures } from '../data/site';

const PAGE_TITLE = `施設管理の業者選び・コスト見直し｜${site.name}（一括見積・無料）`;
const PAGE_DESC  = '受水槽清掃・消防設備点検・アスベスト調査など27分野・全国47都道府県の実績・信頼のある専門業者から最大3社を無料で一括見積比較。約60秒・5問のコスト診断つき。マンション管理組合・ビル管理会社・施設管理担当者向け。業者をお選びいただくまで業者から連絡は来ません。';
const CANONICAL  = `${site.domain}/`;
const heroImageVersion = '20260529-office-cleanup';

const websiteLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.domain,
  description: site.description,
});

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.org.legalName,
  url: site.domain,
  areaServed: 'JP',
  serviceType: '施設管理業者紹介',
});

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ロカサポが運営する施設管理サービス一覧',
  itemListElement: serviceIndex.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site.domain}/${s.slug}/`,
    name: s.name,
  })),
});

// ご依頼前のよくある不安（HTMLの dl.lp-uncertainty-list と同期して管理）
const topFaq = [
  { q: 'しつこい営業電話は来ませんか？', a: '業者をお選びいただくまで、業者からの連絡は一切来ません。選んだ後も、実績・信頼のある専門業者には「しつこい営業の禁止」を規約で義務付けています。違反があった場合は登録解除します。' },
  { q: 'なぜ無料で利用できるのですか？', a: 'ご契約が成立した際に、業者側から紹介手数料をいただく仕組みです。依頼者の方からは一切費用をいただきません。契約しなかった場合も無料です。' },
  { q: '何社から連絡が来ますか？', a: 'ご依頼者が選んだ業者のみ（最大3社まで指定可能）。一般的な一括見積サイトのように「依頼直後に5〜10社から一斉に電話」ということはありません。' },
  { q: '個人情報・施設情報はどう扱われますか？', a: '業者をお選びいただくまで、連絡先は業者に開示しません。お選びいただいた後も、選定された業者のみに必要最小限の情報を共有します。' },
  { q: 'どんな業者を紹介してくれますか？', a: '各分野で必要な登録・資格・許認可を確認した業者のみ。例：受水槽清掃なら「建築物飲料水貯水槽清掃業」の都道府県知事登録、アスベストなら「事前調査者」資格を必須としています。' },
  { q: '見積を取っただけで契約は強制されませんか？', a: '強制されません。見積取得・比較のみで終了することも可能です。違約金・キャンセル料は一切かかりません。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topFaq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: CANONICAL,
  name: PAGE_TITLE,
  description: PAGE_DESC,
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.lp-hero-h1', '.lp-section-lead', '.lp-uncertainty-item dt', '.lp-uncertainty-item dd'],
  },
});

// TOPページで紹介する代表コラム（6本ピックアップ）
const featuredColumns = [
  {
    href: '/column/shisetsu-kanri-nenkan-schedule/',
    category: '施設管理ガイド',
    title: '施設管理の年間スケジュール2026｜マンション・ビル管理担当者向け 9種の法定点検カレンダー',
    excerpt: '受水槽清掃・消防設備点検・アスベスト調査など9種の法定点検を月別カレンダーで整理。マンション管理組合・ビル管理向けピラー記事。',
  },
  {
    href: '/column/jusuisou-seisou-horei-gimu/',
    category: '受水槽清掃',
    title: '受水槽清掃の法定義務ガイド2026｜水道法・建築物衛生法の要点と違反ペナルティ',
    excerpt: '水道法第34条の2が定める年1回以上の清掃義務、建築物衛生法の追加要件、違反時の100万円以下の罰金まで施設管理担当者向けに整理。',
  },
  {
    href: '/column/asbestos-batsu/',
    category: 'アスベスト調査・除去',
    title: 'アスベスト法令違反の罰則2026｜大防法・石綿則・刑事責任の事例と回避策',
    excerpt: '事前調査未実施・無届工事・記録未提出の罰則、労働者死傷時の業務上過失致死傷罪、損害賠償事例を2026年版で整理。',
  },
  {
    href: '/column/shobo-setsubi-horei-gimu/',
    category: '消防設備点検',
    title: '消防設備点検の法定義務ガイド2026｜機器点検・総合点検の頻度と罰則',
    excerpt: '消防法第17条の3の3に基づく義務内容、機器点検（半年）・総合点検（年1）の違い、所轄消防署への報告サイクル、有資格者要件まで。',
  },
  {
    href: '/column/grease-trap-horei-gimu/',
    category: 'グリストラップ清掃',
    title: 'グリストラップ清掃の法的義務ガイド2026｜下水道法・建築基準法・廃棄物処理法の要点',
    excerpt: '下水道法（n-Hex 30mg/L）・建築基準法（阻集器の機能維持）・廃掃法（産廃マニフェスト）の3層で実質的に求められる義務を解説。',
  },
  {
    href: '/column/aircon-business-furon-tenken/',
    category: '業務用エアコン',
    title: 'フロン排出抑制法の点検義務ガイド2026｜業務用エアコン管理者が知るべき要点',
    excerpt: '簡易点検（3か月に1回）・定期点検（7.5kW以上3年／50kW以上1年）、漏洩量算定、廃棄時のフロン回収まで整理。罰則は最大1,000万円。',
  },
];
---
<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical={CANONICAL}
  siteName={site.name}
  logoSub="施設管理の業者紹介サイトを27分野で運営"
  preloadImage={`/images/brand/hero-local-support-top.webp?v=${heroImageVersion}`}
  jsonLdBlocks={[websiteLd, orgLd, itemListLd, faqLd, webPageLd]}
>

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="lp-hero" style={`--top-hero-image: url('/images/brand/hero-local-support-top.webp?v=${heroImageVersion}')`}>
  <div class="sd-container lp-hero-inner">
    <div class="lp-hero-copy">
      <p class="lp-hero-kicker">マンション管理組合・ビル管理会社・施設管理担当者の方へ</p>
      <h1 class="lp-hero-h1">施設管理の業者選び・<br class="sp-only"/>コスト見直しを、<br/><span class="lp-hero-h1-sub">実績・信頼のある専門業者の一括見積で。完全無料。</span></h1>
      <p class="lp-hero-desc">
        受水槽清掃・消防設備点検・アスベスト調査など、<br class="pc-only"/>
        <strong>27分野・全国47都道府県の実績・信頼のある専門業者</strong>から最大3社を無料でご紹介。<br class="pc-only"/>
        <strong>業者をお選びいただくまで、業者からの連絡は一切来ません。</strong>
      </p>
      <div class="lp-hero-ctas">
        <a href="/audit/" class="lp-hero-cta" data-track="hero_cta_audit">
          まず60秒で<br class="sp-only"/>コスト診断（個人情報なし）
        </a>
        <a href="#services" class="lp-hero-cta-secondary" data-track="hero_cta_services">
          サービスを選んで<br class="sp-only"/>一括見積を依頼
        </a>
      </div>
      <ul class="lp-hero-badges">
        <li>運営サービス：27分野</li>
        <li>全国47都道府県に対応</li>
        <li>資格・許認可を確認した業者のみ紹介</li>
        <li>運営：ローカル情報局</li>
      </ul>
    </div>
  </div>
</section>

<!-- ══ 6ステップ安心フロー ════════════════════════════════════════ -->
<section class="lp-flow" id="contact">
  <div class="sd-container">
    <div class="lp-section-head">
      <span class="lp-section-kicker">HOW IT WORKS</span>
      <h2 class="lp-section-title">ご依頼から契約までの流れ</h2>
      <p class="lp-section-lead">
        <strong>業者をお選びいただくまで、業者からの連絡は一切来ません。</strong><br/>
        他社の一括見積サイトと違って、「依頼した瞬間に5社から電話が鳴る」ことはありません。
      </p>
    </div>
    <ol class="lp-flow-steps">
      <li class="lp-flow-step">
        <span class="lp-flow-num">1</span>
        <div>
          <h3>ご依頼（無料・約1分）</h3>
          <p>サービスを選んで、施設情報と連絡先を入力します。費用は一切かかりません。</p>
        </div>
      </li>
      <li class="lp-flow-step">
        <span class="lp-flow-num">2</span>
        <div>
          <h3>ロカサポが実績・信頼のある専門業者へ打診</h3>
          <p>ご依頼内容に合致する実績・信頼のある専門業者へ、ロカサポからお声がけします。ご依頼者さまの連絡先は業者には渡しません。</p>
        </div>
      </li>
      <li class="lp-flow-step">
        <span class="lp-flow-num">3</span>
        <div>
          <h3>手を挙げた業者から最大5社を選定</h3>
          <p>対応可能と回答した業者の中から、資格・実績・対応エリアを確認のうえ最大5社を選定します。</p>
        </div>
      </li>
      <li class="lp-flow-step">
        <span class="lp-flow-num">4</span>
        <div>
          <h3>概算見積・実績を一覧でご確認</h3>
          <p>各社の概算見積・対応実績・資格情報を専用ページでまとめてご覧いただけます。<strong>ここまで業者からの連絡はありません。</strong></p>
        </div>
      </li>
      <li class="lp-flow-step">
        <span class="lp-flow-num">5</span>
        <div>
          <h3>お選びいただいた業者だけが連絡</h3>
          <p>詳細な見積・打ち合わせをしたい業者を選んでください（1〜3社まで）。選定された業者だけがご依頼者さまへ直接ご連絡します。</p>
        </div>
      </li>
      <li class="lp-flow-step">
        <span class="lp-flow-num">6</span>
        <div>
          <h3>比較してご契約</h3>
          <p>最終見積を比較し、納得いただける業者とご契約ください。契約しない場合も費用はかかりません。</p>
        </div>
      </li>
    </ol>
    <div class="lp-flow-ctas">
      <a href="/audit/" class="lp-flow-cta-primary" data-track="flow_cta_audit">まず60秒でコスト診断（個人情報なし）</a>
      <a href="#services" class="lp-flow-cta-secondary" data-track="flow_cta_services">サービスを選んで一括見積</a>
    </div>
  </div>
</section>

<!-- ══ ご依頼前のよくある不安 ════════════════════════════════════ -->
<section class="lp-uncertainty">
  <div class="sd-container">
    <div class="lp-section-head">
      <span class="lp-section-kicker">CONCERNS</span>
      <h2 class="lp-section-title">ご依頼前のよくある不安</h2>
      <p class="lp-section-lead">施設管理担当者の方から寄せられるご質問にお答えします。</p>
    </div>
    <dl class="lp-uncertainty-list">
      <div class="lp-uncertainty-item">
        <dt>Q. しつこい営業電話は来ませんか？</dt>
        <dd>A. <strong>業者をお選びいただくまで、業者からの連絡は一切来ません。</strong>選んだ後も、実績・信頼のある専門業者には「しつこい営業の禁止」を規約で義務付けています。違反があった場合は登録解除します。</dd>
      </div>
      <div class="lp-uncertainty-item">
        <dt>Q. なぜ無料で利用できるのですか？</dt>
        <dd>A. ご契約が成立した際に、業者側から紹介手数料をいただく仕組みです。<strong>依頼者の方からは一切費用をいただきません。</strong>契約しなかった場合も無料です。</dd>
      </div>
      <div class="lp-uncertainty-item">
        <dt>Q. 何社から連絡が来ますか？</dt>
        <dd>A. ご依頼者が選んだ業者のみ（最大3社まで指定可能）。一般的な一括見積サイトのように「依頼直後に5〜10社から一斉に電話」ということはありません。</dd>
      </div>
      <div class="lp-uncertainty-item">
        <dt>Q. 個人情報・施設情報はどう扱われますか？</dt>
        <dd>A. 業者をお選びいただくまで、連絡先は業者に開示しません。お選びいただいた後も、選定された業者のみに必要最小限の情報を共有します。詳細は<a href="/privacy/">プライバシーポリシー</a>。</dd>
      </div>
      <div class="lp-uncertainty-item">
        <dt>Q. どんな業者を紹介してくれますか？</dt>
        <dd>A. 各分野で必要な<strong>登録・資格・許認可を確認した業者のみ</strong>。例：受水槽清掃なら「建築物飲料水貯水槽清掃業」の都道府県知事登録、アスベストなら「事前調査者」資格を必須としています。</dd>
      </div>
      <div class="lp-uncertainty-item">
        <dt>Q. 見積を取っただけで契約は強制されませんか？</dt>
        <dd>A. 強制されません。<strong>見積取得・比較のみで終了することも可能です。</strong>違約金・キャンセル料は一切かかりません。</dd>
      </div>
    </dl>
  </div>
</section>

<!-- ══ サービス一覧 ════════════════════════════════════════════ -->
<section class="lp-services" id="services">
  <div class="sd-container">
    <div class="lp-section-head">
      <span class="lp-section-kicker">SERVICES</span>
      <h2 class="lp-section-title">サービスを選んで一括見積を依頼</h2>
      <p class="lp-section-lead">
        <strong>複数選択OK</strong> ✓ 気になるサービスにチェックを入れて、まとめて一括見積を依頼できます。<br/>
        どのサービスを依頼すべきか分からない方は <a href="/audit/"><strong>約60秒・5問のコスト診断</strong></a> をご利用ください。
      </p>
    </div>
    <div class="lp-service-grid">
      {serviceIndex.map((s) => (
        <div class="lp-service-card" data-service-slug={s.slug} data-service-name={s.name}>
          <label class="lp-service-pick">
            <input type="checkbox" class="lp-service-check" data-service-name={s.name} />
            <span class="lp-service-pick-label"><span class="lp-pick-off">＋ 見積リストに追加</span><span class="lp-pick-on">✓ 選択中</span></span>
          </label>
          <img class="lp-service-card-img" src={`/images/services/hero-${s.slug}.webp?v=${heroImageVersion}`} width="480" height="270" alt={`${s.name}のサービスイメージ`} loading="lazy" decoding="async" />
          <span class="lp-service-label">{s.short}</span>
          <h3>{s.name}</h3>
          <p>{s.description}</p>
          <a href={`/${s.slug}/`} class="lp-service-link">サービス詳細・単独で依頼 →</a>
        </div>
      ))}
    </div>

    <!-- ══ 複数選択一括見積フォーム ══ -->
    <div class="lp-bulkquote" id="lp-bulkquote" hidden>
      <div class="lp-bulkquote-head">
        <h3>選択したサービスで一括見積</h3>
        <p class="lp-bulkquote-count"><strong id="lp-bulk-count">0</strong> サービス選択中</p>
        <div id="lp-bulk-chips" class="lp-bulk-chips"></div>
      </div>
      <form class="qf lp-bulkquote-form" action="/api/quote" method="POST" data-redirect="/thanks/?from=bulk" novalidate>
        <input type="hidden" name="service" id="lp-bulk-service" value="" />
        <input type="hidden" name="message" id="lp-bulk-message" value="" />
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="qf-honeypot" aria-hidden="true" />

        <div class="qf-row">
          <label for="lp-bulk-company">会社名・施設名 <span class="qf-req">必須</span></label>
          <input id="lp-bulk-company" name="company" type="text" required placeholder="例：◯◯ビル管理組合" autocomplete="organization" />
        </div>
        <div class="qf-row">
          <label for="lp-bulk-prefecture">所在地（都道府県） <span class="qf-req">必須</span></label>
          <select id="lp-bulk-prefecture" name="prefecture" required autocomplete="address-level1">
            <option value="">選択してください</option>
            {prefectures.map((p) => (<option value={p}>{p}</option>))}
          </select>
        </div>
        <div class="qf-row">
          <label>希望の連絡方法 <span class="qf-req">必須</span></label>
          <div class="qf-radios">
            <label class="qf-radio"><input type="radio" name="contact_method" value="メール" required /> メール</label>
            <label class="qf-radio"><input type="radio" name="contact_method" value="電話" /> 電話</label>
            <label class="qf-radio"><input type="radio" name="contact_method" value="どちらでも" /> どちらでも</label>
          </div>
        </div>
        <div class="qf-row">
          <label for="lp-bulk-email">連絡先メール</label>
          <input id="lp-bulk-email" name="email" type="email" placeholder="例：info@example.com" autocomplete="email" />
        </div>
        <div class="qf-row">
          <label for="lp-bulk-tel">連絡先電話</label>
          <input id="lp-bulk-tel" name="tel" type="tel" placeholder="例：03-0000-0000" autocomplete="tel" />
        </div>
        <div class="qf-row">
          <label for="lp-bulk-name">ご担当者名（任意）</label>
          <input id="lp-bulk-name" name="name" type="text" placeholder="例：山田" autocomplete="name" />
        </div>
        <div class="qf-row">
          <label for="lp-bulk-note">補足メッセージ（任意）</label>
          <textarea id="lp-bulk-note" name="note" rows="3" placeholder="複数棟まとめての依頼・特殊な条件などご記入ください"></textarea>
        </div>
        <label class="qf-agree">
          <input type="checkbox" name="agree" value="1" required />
          <span><a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意して送信します</span>
        </label>
        <button type="submit" class="qf-submit" data-track="bulk_quote_submit">選択したサービスで無料一括見積を依頼</button>
      </form>
    </div>

    <!-- スクロール追従：選択サマリー -->
    <div class="lp-bulk-sticky" id="lp-bulk-sticky" hidden>
      <span><strong id="lp-bulk-count-mini">0</strong> サービス選択中</span>
      <a href="#lp-bulkquote" class="lp-bulk-sticky-cta">▶ 一括見積を依頼</a>
    </div>
  </div>
</section>

<script>
  const checks = document.querySelectorAll<HTMLInputElement>('.lp-service-check');
  const bulkSection = document.getElementById('lp-bulkquote');
  const bulkSticky = document.getElementById('lp-bulk-sticky');
  const bulkCount = document.getElementById('lp-bulk-count');
  const bulkCountMini = document.getElementById('lp-bulk-count-mini');
  const bulkChips = document.getElementById('lp-bulk-chips');
  const bulkServiceField = document.getElementById('lp-bulk-service') as HTMLInputElement;
  const bulkMessageField = document.getElementById('lp-bulk-message') as HTMLInputElement;

  function updateBulkState() {
    const selected = Array.from(checks).filter((c) => c.checked);
    const names = selected.map((c) => c.dataset.serviceName || '');
    const count = selected.length;
    if (bulkCount) bulkCount.textContent = String(count);
    if (bulkCountMini) bulkCountMini.textContent = String(count);
    if (bulkChips) bulkChips.innerHTML = names.map((n) => `<span class="lp-bulk-chip">${n}</span>`).join('');
    if (bulkServiceField) bulkServiceField.value = names.join('、');
    if (bulkMessageField) bulkMessageField.value = count
      ? `【一括見積希望サービス（${count}件）】\n${names.join('、')}\n\n上記サービスについてまとめて見積もり・相場確認を希望します。`
      : '';
    if (count > 0) {
      bulkSection?.removeAttribute('hidden');
      bulkSticky?.removeAttribute('hidden');
    } else {
      bulkSection?.setAttribute('hidden', '');
      bulkSticky?.setAttribute('hidden', '');
    }
    selected.forEach((c) => c.closest('.lp-service-card')?.classList.add('is-picked'));
    Array.from(checks).filter((c) => !c.checked).forEach((c) => c.closest('.lp-service-card')?.classList.remove('is-picked'));
  }
  checks.forEach((c) => c.addEventListener('change', updateBulkState));
</script>

