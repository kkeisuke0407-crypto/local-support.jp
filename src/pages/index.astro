---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, serviceIndex } from '../data/site';

const PAGE_TITLE = 'local-support.jp｜施設管理の一括見積比較サービス';
const PAGE_DESC  = '受水槽清掃・アスベスト調査・ダクト清掃・シャッター点検など、施設管理に必要な専門業者を一括見積で比較。登録済みの資格・許認可を持つ地元業者を最大3社ご紹介します。完全無料。';
const CANONICAL  = `${site.domain}/`;

const websiteLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.domain,
  description: site.description,
});

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.org.legalName,
  url: site.domain,
  areaServed: 'JP',
  serviceType: '施設管理業者紹介',
});

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '施設管理の一括見積比較サービス一覧',
  itemListElement: serviceIndex.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site.domain}/${s.slug}/`,
    name: s.name,
  })),
});
---
<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical={CANONICAL}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  jsonLdBlocks={[websiteLd, orgLd, itemListLd]}
>

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="lp-hero">
  <div class="sd-container lp-hero-inner">
    <p class="lp-hero-kicker">B2B施設管理の一括見積比較サービス</p>
    <h1 class="lp-hero-h1">施設管理の業者探しを、<br/>もっとかんたんに。</h1>
    <p class="lp-hero-desc">
      受水槽清掃・アスベスト調査・ダクト清掃・シャッター点検など、<br class="pc-only"/>
      施設管理に必要な専門業者を一括見積で比較できるサービスです。<br class="pc-only"/>
      登録資格を確認済みの地元業者を最大3社ご紹介。完全無料でご利用いただけます。
    </p>
    <a href="/jusuisou-seisou/" class="lp-hero-cta">無料で一括見積もりを依頼する →</a>
    <ul class="lp-hero-badges">
      <li>完全無料</li>
      <li>最大3社を厳選紹介</li>
      <li>全国47都道府県対応</li>
      <li>登録資格確認済み業者のみ</li>
    </ul>
  </div>
</section>

<!-- ══ サービス一覧 ════════════════════════════════════════════ -->
<section class="lp-services">
  <div class="sd-container">
    <h2 class="lp-section-title">取り扱いサービス</h2>
    <div class="lp-service-grid">
      {serviceIndex.map((s) => (
        <a href={`/${s.slug}/`} class="lp-service-card">
          <span class="lp-service-label">{s.short}</span>
          <h3>{s.name}</h3>
          <p>{s.description}</p>
          <span class="lp-service-link">無料で見積依頼 →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══ 3ステップ ═══════════════════════════════════════════════ -->
<section class="lp-steps">
  <div class="sd-container">
    <h2 class="lp-section-title">3ステップで業者紹介</h2>
    <ol class="lp-step-list">
      <li>
        <span class="lp-step-num">01</span>
        <h3>フォームで依頼</h3>
        <p>施設情報・要件を入力するだけ。約1分で完了します。</p>
      </li>
      <li>
        <span class="lp-step-num">02</span>
        <h3>業者を厳選紹介</h3>
        <p>資格・対応エリア・実績を確認のうえ、最大3社をご提案します。</p>
      </li>
      <li>
        <span class="lp-step-num">03</span>
        <h3>比較・ご契約</h3>
        <p>複数社の見積もりを比較して、納得のいく業者を選んでください。</p>
      </li>
    </ol>
  </div>
</section>

<!-- ══ 費用相場まとめ（AIO直接回答用） ════════════════════════ -->
<section class="lp-cost-summary">
  <div class="sd-container">
    <h2 class="lp-section-title">サービス別の費用相場</h2>
    <p class="lp-cost-lead">
      各サービスの一般的な費用レンジを一覧で比較できます。実際の金額は施設規模・地域・業者により変動します。
    </p>
    <div class="lp-cost-table-wrap">
      <table class="lp-cost-table">
        <thead>
          <tr>
            <th scope="col">サービス</th>
            <th scope="col">費用相場</th>
            <th scope="col">主な義務・推奨頻度</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><a href="/jusuisou-seisou/">受水槽清掃</a></th>
            <td>3万円〜30万円<br/><small>＋水質検査1〜2.5万円</small></td>
            <td>水道法で年1回以上義務（10m³超）</td>
          </tr>
          <tr>
            <th scope="row"><a href="/asbestos/">アスベスト調査・除去</a></th>
            <td>事前調査5〜20万円<br/>除去工事1〜10万円／㎡</td>
            <td>解体・改修工事前に有資格者調査が義務</td>
          </tr>
          <tr>
            <th scope="row"><a href="/duct/">ダクト清掃</a></th>
            <td>厨房ダクト5〜30万円<br/>空調ダクト10〜100万円</td>
            <td>厨房年1〜2回／空調2〜3年に1回推奨</td>
          </tr>
          <tr>
            <th scope="row"><a href="/shutter/">シャッター点検・修理</a></th>
            <td>点検1台1〜3万円<br/>修理2万円〜</td>
            <td>建築基準法で防火シャッター年1回義務</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="lp-cost-note">
      上記は2026年時点の一般的な相場目安です。最新かつ正確な金額は、複数業者からの見積もりでご確認ください。
    </p>
  </div>
</section>

<!-- ══ 選ばれる理由 ════════════════════════════════════════════ -->
<section class="lp-why">
  <div class="sd-container">
    <h2 class="lp-section-title">local-support.jp が選ばれる理由</h2>
    <div class="lp-why-grid">
      <div class="lp-why-card">
        <h3>登録業者のみ紹介</h3>
        <p>各分野で必要な登録・資格・許認可を確認済みの業者のみ紹介。無資格業者への発注リスクを回避できます。</p>
      </div>
      <div class="lp-why-card">
        <h3>一括見積で最大3社を比較</h3>
        <p>一度の入力で複数業者の見積もりが届きます。費用の妥当性確認と過剰請求の防止に役立ちます。</p>
      </div>
      <div class="lp-why-card">
        <h3>全国対応・地元業者ネットワーク</h3>
        <p>全国47都道府県に対応。施設所在地に近い地元業者を優先紹介するため、出張費を抑えた対応が期待できます。</p>
      </div>
      <div class="lp-why-card">
        <h3>完全無料・しつこい営業なし</h3>
        <p>依頼から紹介まですべて無料。紹介した業者には過度な営業を禁じており、安心してご利用いただけます。</p>
      </div>
    </div>
  </div>
</section>

<!-- ══ Bottom CTA ═════════════════════════════════════════════ -->
<section class="lp-cta">
  <div class="sd-container lp-cta-inner">
    <h2>まずはサービスを選んで<br/>無料一括見積</h2>
    <p>所要時間は約1分。登録業者から最大3社をご紹介します。</p>
    <div class="lp-cta-btns">
      {serviceIndex.map((s) => (
        <a href={`/${s.slug}/`} class="lp-cta-btn">{s.name}の見積依頼 →</a>
      ))}
    </div>
    <p class="lp-cta-note">完全無料 ／ 最大3社を厳選紹介 ／ 全国47都道府県対応</p>
  </div>
</section>

</BaseLayout>

<style>
/* ── Hero ── */
.lp-hero {
  background: linear-gradient(135deg, var(--blue-dark) 0%, #1a3a6b 100%);
  color: #fff;
  padding: 80px 0 72px;
  text-align: center;
}
.lp-hero-kicker {
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #93c5fd;
  margin-bottom: 16px;
}
.lp-hero-h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 900;
  line-height: 1.3;
  margin-bottom: 24px;
}
.lp-hero-desc {
  font-size: 1rem;
  line-height: 1.8;
  color: #bfdbfe;
  margin-bottom: 32px;
}
.lp-hero-cta {
  display: inline-block;
  background: var(--accent);
  color: #1a202c;
  font-weight: 700;
  font-size: 1.05rem;
  padding: 16px 40px;
  border-radius: 8px;
  transition: opacity .2s;
  margin-bottom: 24px;
}
.lp-hero-cta:hover { opacity: .85; }
.lp-hero-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  list-style: none;
  margin-top: 8px;
}
.lp-hero-badges li {
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.25);
  color: #e0f2fe;
  font-size: .78rem;
  padding: 4px 12px;
  border-radius: 99px;
}

/* ── 費用相場まとめ ── */
.lp-cost-summary {
  padding: 64px 0;
  background: #fff;
}
.lp-cost-lead {
  text-align: center;
  color: var(--gray-700);
  font-size: .95rem;
  margin: -16px auto 28px;
  max-width: 720px;
  line-height: 1.8;
}
.lp-cost-table-wrap {
  max-width: 900px;
  margin: 0 auto;
  overflow-x: auto;
}
.lp-cost-table {
  width: 100%;
  border-collapse: collapse;
  font-size: .92rem;
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: 12px;
  overflow: hidden;
}
.lp-cost-table thead { background: var(--blue-light); }
.lp-cost-table th, .lp-cost-table td {
  padding: 16px 18px;
  text-align: left;
  border-bottom: 1px solid var(--gray-200);
  vertical-align: top;
}
.lp-cost-table thead th { color: var(--blue-dark); font-weight: 800; }
.lp-cost-table tbody th { width: 200px; font-weight: 700; }
.lp-cost-table tbody th a { color: var(--blue); text-decoration: underline; }
.lp-cost-table td { color: var(--gray-700); line-height: 1.65; }
.lp-cost-table td small { font-size: .82em; color: var(--gray-500); }
.lp-cost-table tbody tr:last-child th,
.lp-cost-table tbody tr:last-child td { border-bottom: none; }
.lp-cost-note {
  text-align: center;
  font-size: .82rem;
  color: var(--gray-500);
  margin-top: 18px;
}
@media (max-width: 640px) {
  .lp-cost-table { font-size: .85rem; }
  .lp-cost-table th, .lp-cost-table td { padding: 12px 10px; }
  .lp-cost-table tbody th { width: 30%; }
}

/* ── Section共通 ── */
.lp-section-title {
  font-size: 1.4rem;
  font-weight: 800;
  text-align: center;
  margin-bottom: 36px;
  color: var(--gray-900);
}

/* ── Services ── */
.lp-services {
  padding: 64px 0;
  background: var(--gray-100);
}
.lp-service-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}
.lp-service-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: var(--radius);
  padding: 28px 24px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-200);
  transition: box-shadow .2s, transform .2s;
}
.lp-service-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.lp-service-label {
  font-size: .72rem;
  font-weight: 700;
  color: var(--blue);
  background: var(--blue-light);
  padding: 3px 10px;
  border-radius: 99px;
  align-self: flex-start;
  margin-bottom: 12px;
}
.lp-service-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; color: var(--gray-900); }
.lp-service-card p { font-size: .85rem; color: var(--gray-500); line-height: 1.6; flex: 1; margin-bottom: 16px; }
.lp-service-link { font-size: .85rem; font-weight: 700; color: var(--blue); margin-top: auto; }

/* ── Steps ── */
.lp-steps { padding: 64px 0; background: #fff; }
.lp-step-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 32px;
  list-style: none;
  counter-reset: none;
  text-align: center;
}
.lp-step-num {
  display: block;
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--blue-light);
  line-height: 1;
  margin-bottom: 12px;
}
.lp-step-list h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
.lp-step-list p { font-size: .875rem; color: var(--gray-500); line-height: 1.7; }

/* ── Why ── */
.lp-why { padding: 64px 0; background: var(--gray-100); }
.lp-why-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}
.lp-why-card {
  background: #fff;
  border-radius: var(--radius);
  padding: 28px 24px;
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--gray-200);
}
.lp-why-card h3 { font-size: .95rem; font-weight: 700; margin-bottom: 8px; color: var(--blue-dark); }
.lp-why-card p { font-size: .85rem; color: var(--gray-500); line-height: 1.7; }

/* ── CTA ── */
.lp-cta {
  background: var(--blue-dark);
  padding: 64px 0;
  color: #fff;
  text-align: center;
}
.lp-cta-inner h2 { font-size: 1.6rem; font-weight: 800; margin-bottom: 12px; }
.lp-cta-inner > p { color: #bfdbfe; margin-bottom: 28px; font-size: .95rem; }
.lp-cta-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-bottom: 16px; }
.lp-cta-btn {
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.3);
  color: #fff;
  font-size: .9rem;
  font-weight: 700;
  padding: 12px 24px;
  border-radius: 8px;
  transition: background .2s;
}
.lp-cta-btn:hover { background: rgba(255,255,255,.22); }
.lp-cta-note { font-size: .78rem; color: #93c5fd; }

/* ── Util ── */
.pc-only { display: none; }
@media (min-width: 768px) { .pc-only { display: inline; } }
</style>
