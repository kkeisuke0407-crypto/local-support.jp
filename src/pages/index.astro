---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import TrustBadges from '../components/TrustBadges.astro';
import FAQ from '../components/FAQ.astro';
import { site, serviceIndex, prefectures } from '../data/site';

const PAGE_TITLE = '施設管理の一括見積比較｜受水槽・アスベスト・ダクト・シャッター｜local-support.jp';
const PAGE_DESC  = '受水槽清掃・アスベスト調査・ダクト清掃・シャッター点検など、施設管理の業者探しを一括見積で。登録業者から最大3社を厳選紹介・完全無料。全国47都道府県対応のB2B向け業者紹介サービス。';
const CANONICAL  = `${site.domain}/`;

const faqItems = [
  {
    q: '一括見積の利用に費用はかかりますか？',
    a: '完全無料です。お見積もり依頼・業者紹介・ご相談まで、すべてのサービスを無料でご利用いただけます。紹介した業者と契約された後も、当サイトへの手数料は発生しません。',
  },
  {
    q: '何社から見積もりが取れますか？',
    a: 'サービス内容・所在地に応じて、対応可能な登録業者の中から最大3社を厳選してご紹介します。複数社の見積もりを比較することで、費用の妥当性確認と過剰請求の回避ができます。',
  },
  {
    q: '対応エリアはどこですか？',
    a: '全国47都道府県に対応しています。施設所在地に近い地元の登録業者を優先的にご紹介するため、迅速な対応・出張費の抑制が期待できます。',
  },
  {
    q: 'しつこい営業電話は来ませんか？',
    a: 'いいえ、来ません。ご紹介する業者は事前に審査済みで、しつこい営業を行わないことを利用規約で求めています。万一そのような対応があれば、こちらへご報告いただければ業者登録の停止対応をいたします。',
  },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
});

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: CANONICAL },
  ],
});

const updatedJa = new Date(site.lastUpdated).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical={CANONICAL}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  jsonLdBlocks={[breadcrumbLd, faqLd]}
>

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="hero hero--b2b">
  <div class="sd-container-wide hero-grid">
    <div class="hero-copy">
      <div class="hero-eyebrow">マンション・ビル・工場の管理担当者の方へ</div>
      <h1 class="hero-h1">施設管理の業者探し、ぜんぶお任せください</h1>
      <h2 class="hero-h2">受水槽・アスベスト・ダクト・シャッターなど 一括見積で最大3社をご紹介・完全無料</h2>
      <ul class="hero-bullets">
        <li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>完全無料・しつこい営業なし</span></li>
        <li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>登録資格を確認済みの業者のみ紹介</span></li>
        <li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>全国47都道府県・複数施設まとめてOK</span></li>
        <li><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>最大3社を厳選紹介・比較検討に最適</span></li>
      </ul>
      <dl class="hero-stats">
        {site.stats.map((s) => (
          <div class="hero-stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
      <p class="hero-meta"><time datetime={site.lastUpdated}>最終更新：{updatedJa}</time> ／ 運営：{site.name}</p>
    </div>
    <div class="hero-form">
      <aside class="qf-compact" aria-label="無料一括見積もり依頼フォーム">
        <div class="qf-compact-head">
          <span class="qf-compact-badge">完全無料</span>
          <h3>30秒で無料一括見積</h3>
          <p>必要なサービスを選んで送信</p>
        </div>
        {/* TODO: バックエンド未接続 — 送信時は /thanks/ にリダイレクト */}
        <form class="qf qf--compact" action="#" method="POST" data-service="top" data-redirect="/thanks/?service=top" novalidate>
          <div class="qf-row">
            <label for="top-service">ご相談内容 <span class="qf-req">必須</span></label>
            <select id="top-service" name="service" required>
              <option value="">選択してください</option>
              {serviceIndex.map((s) => (<option value={s.name}>{s.name}</option>))}
              <option value="その他・複数">その他・複数まとめて</option>
            </select>
          </div>
          <div class="qf-row">
            <label for="top-company">会社名・施設名 <span class="qf-req">必須</span></label>
            <input id="top-company" name="company" type="text" required placeholder="例：◯◯ビル管理組合" />
          </div>
          <div class="qf-row">
            <label for="top-prefecture">所在地（都道府県） <span class="qf-req">必須</span></label>
            <select id="top-prefecture" name="prefecture" required>
              <option value="">選択してください</option>
              {prefectures.map((p) => (<option value={p}>{p}</option>))}
            </select>
          </div>
          <div class="qf-row">
            <label for="top-email">連絡先メール <span class="qf-req">必須</span></label>
            <input id="top-email" name="email" type="email" required placeholder="例：info@example.com" />
          </div>
          <button type="submit" class="qf-submit" data-track="top_hero_form_submit">無料で見積依頼する →</button>
          <p class="qf-note">入力情報は業者紹介のみに使用します</p>
        </form>
      </aside>
    </div>
  </div>
</section>

<!-- ══ サービス一覧 ════════════════════════════════════════════ -->
<section class="sd-section section-white" id="services">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">SERVICES</span>
      <h2>取り扱いサービス｜B2B施設管理の一括見積</h2>
      <p>各分野の登録業者から最大3社を厳選紹介します</p>
    </div>
    <div class="service-grid">
      {serviceIndex.map((s) => (
        <a href={`/${s.slug}/`} class="service-card">
          <div class="service-card-tag">{s.short}</div>
          <h3>{s.name}</h3>
          <p>{s.description}</p>
          <span class="service-card-link">詳しく見る →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<ProcessSteps />

<TrustBadges stats={site.stats} />

<!-- ══ Why us ══════════════════════════════════════════════════ -->
<section class="sd-section section-white" id="why">
  <div class="sd-container">
    <div class="section-head">
      <span class="kicker">WHY US</span>
      <h2>local-support.jp が選ばれる理由</h2>
      <p>B2B施設管理に特化した一括見積比較サービスです</p>
    </div>
    <div class="why-grid">
      <article class="why-card">
        <h3>登録業者のみ紹介</h3>
        <p>各分野で必要な登録・資格・許認可を確認済みの業者のみご紹介。無資格業者への発注リスクを回避できます。</p>
      </article>
      <article class="why-card">
        <h3>一括見積で最大3社を比較</h3>
        <p>一度の入力で複数業者からお見積もりが届きます。同じ条件で比較できるため、費用妥当性の確認に最適です。</p>
      </article>
      <article class="why-card">
        <h3>全国対応・地元業者ネットワーク</h3>
        <p>全国47都道府県に対応。施設所在地に近い地元業者を優先紹介するため、出張費を抑え迅速な対応が期待できます。</p>
      </article>
    </div>
  </div>
</section>

<FAQ faq={faqItems} serviceName="施設管理の一括見積" />

<!-- ══ Bottom CTA ═════════════════════════════════════════════ -->
<section class="cta-section" id="contact">
  <div class="sd-container">
    <div class="cta-inner">
      <h2>まずはサービスを選んで<br/>無料一括見積</h2>
      <p>所要時間は約1分。登録業者から最大3社を厳選してご紹介します。</p>
      <div class="cta-buttons">
        {serviceIndex.map((s) => (
          <a class="cta-btn-secondary" href={`/${s.slug}/`}>{s.short}の見積依頼 →</a>
        ))}
      </div>
      <p class="cta-note">完全無料／最大3社を厳選紹介／全国47都道府県対応</p>
    </div>
  </div>
</section>

</BaseLayout>
