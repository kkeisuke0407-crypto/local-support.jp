---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFormGeneric from '../components/ContactFormGeneric.astro';
import { site, serviceIndex } from '../data/site';

const PAGE_TITLE = `${site.name}｜施設管理サービス事業の運営者ハブ`;
const PAGE_DESC  = 'ロカサポ（運営：ローカル情報局）は、受水槽清掃・消防設備点検・アスベスト調査など9つの施設管理サービス分野で業者紹介サイトを運営しています。各サービスの一覧、お役立ち情報、取材・提携のお問い合わせはこちらから。';
const CANONICAL  = `${site.domain}/`;

const websiteLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.domain,
  description: site.description,
});

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.org.legalName,
  url: site.domain,
  areaServed: 'JP',
  serviceType: '施設管理業者紹介',
});

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ロカサポが運営する施設管理サービス一覧',
  itemListElement: serviceIndex.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site.domain}/${s.slug}/`,
    name: s.name,
  })),
});

// TOPページで紹介する代表コラム（6本ピックアップ）
const featuredColumns = [
  {
    href: '/column/shisetsu-kanri-nenkan-schedule/',
    category: '施設管理ガイド',
    title: '施設管理の年間スケジュール2026｜マンション・ビル管理担当者向け 9種の法定点検カレンダー',
    excerpt: '受水槽清掃・消防設備点検・アスベスト調査など9種の法定点検を月別カレンダーで整理。マンション管理組合・ビル管理向けピラー記事。',
  },
  {
    href: '/column/jusuisou-seisou-horei-gimu/',
    category: '受水槽清掃',
    title: '受水槽清掃の法定義務ガイド2026｜水道法・建築物衛生法の要点と違反ペナルティ',
    excerpt: '水道法第34条の2が定める年1回以上の清掃義務、建築物衛生法の追加要件、違反時の100万円以下の罰金まで施設管理担当者向けに整理。',
  },
  {
    href: '/column/asbestos-batsu/',
    category: 'アスベスト調査・除去',
    title: 'アスベスト法令違反の罰則2026｜大防法・石綿則・刑事責任の事例と回避策',
    excerpt: '事前調査未実施・無届工事・記録未提出の罰則、労働者死傷時の業務上過失致死傷罪、損害賠償事例を2026年版で整理。',
  },
  {
    href: '/column/shobo-setsubi-horei-gimu/',
    category: '消防設備点検',
    title: '消防設備点検の法定義務ガイド2026｜機器点検・総合点検の頻度と罰則',
    excerpt: '消防法第17条の3の3に基づく義務内容、機器点検（半年）・総合点検（年1）の違い、所轄消防署への報告サイクル、有資格者要件まで。',
  },
  {
    href: '/column/grease-trap-horei-gimu/',
    category: 'グリストラップ清掃',
    title: 'グリストラップ清掃の法的義務ガイド2026｜下水道法・建築基準法・廃棄物処理法の要点',
    excerpt: '下水道法（n-Hex 30mg/L）・建築基準法（阻集器の機能維持）・廃掃法（産廃マニフェスト）の3層で実質的に求められる義務を解説。',
  },
  {
    href: '/column/aircon-business-furon-tenken/',
    category: '業務用エアコン',
    title: 'フロン排出抑制法の点検義務ガイド2026｜業務用エアコン管理者が知るべき要点',
    excerpt: '簡易点検（3か月に1回）・定期点検（7.5kW以上3年／50kW以上1年）、漏洩量算定、廃棄時のフロン回収まで整理。罰則は最大1,000万円。',
  },
];
---
<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical={CANONICAL}
  siteName={site.name}
  logoSub="施設管理サービス事業の運営者ハブ"
  jsonLdBlocks={[websiteLd, orgLd, itemListLd]}
>

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="lp-hero">
  <div class="sd-container lp-hero-inner">
    <div class="lp-hero-copy">
      <p class="lp-hero-kicker">ローカル情報局が運営する施設管理サービスハブ</p>
      <h1 class="lp-hero-h1">{site.name}<br/><span class="lp-hero-h1-sub">— 施設管理の業者選びを、もっとかんたんに。</span></h1>
      <p class="lp-hero-desc">
        受水槽清掃・消防設備点検・アスベスト調査など、<br class="pc-only"/>
        <strong>9つの施設管理サービス分野で業者紹介サイトを運営</strong>しています。<br class="pc-only"/>
        お見積もり依頼は各サービスサイトから、取材・提携のご相談はこのページ下部のフォームへ。
      </p>
      <div class="lp-hero-ctas">
        <a href="#services" class="lp-hero-cta">運営サービス一覧を見る ↓</a>
        <a href="#contact" class="lp-hero-cta-secondary">取材・提携のお問い合わせ</a>
      </div>
      <ul class="lp-hero-badges">
        <li>運営サービス：9分野</li>
        <li>全国47都道府県対応</li>
        <li>資格・許認可確認済み業者のみ紹介</li>
      </ul>
    </div>
    <figure class="lp-hero-visual">
      <img src="/images/brand/hero-local-support-top.webp" width="1600" height="900" alt="施設管理担当者と点検スタッフがタブレットで点検内容を確認している様子" decoding="async" fetchpriority="high" />
    </figure>
  </div>
</section>

<!-- ══ サービス一覧 ════════════════════════════════════════════ -->
<section class="lp-services" id="services">
  <div class="sd-container">
    <div class="lp-section-head">
      <span class="lp-section-kicker">SERVICES</span>
      <h2 class="lp-section-title">運営しているサービスサイト</h2>
      <p class="lp-section-lead">
        各サービスごとに専門サイトを運営しています。お見積もり依頼は各サイトのフォームよりお願いいたします。
      </p>
    </div>
    <div class="lp-service-grid">
      {serviceIndex.map((s) => (
        <a href={`/${s.slug}/`} class="lp-service-card">
          <img class="lp-service-card-img" src={`/images/services/hero-${s.slug}.webp`} width="480" height="270" alt="" loading="lazy" decoding="async" />
          <span class="lp-service-label">{s.short}</span>
          <h3>{s.name}</h3>
          <p>{s.description}</p>
          <span class="lp-service-link">サービスサイトを見る →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══ 運営方針 ════════════════════════════════════════════════ -->
<section class="lp-about">
  <div class="sd-container">
    <div class="lp-section-head">
      <span class="lp-section-kicker">ABOUT</span>
      <h2 class="lp-section-title">{site.name}について</h2>
      <p class="lp-section-lead">
        マンション管理組合・ビル管理会社・店舗オーナーが業者選びで迷わない情報を、運営者の責任で発信しています。
      </p>
    </div>
    <div class="lp-about-grid">
      <div class="lp-about-card">
        <h3>登録業者のみ紹介</h3>
        <p>各分野で必要な登録・資格・許認可を確認済みの業者のみ紹介。無資格業者への発注リスクを回避できます。</p>
      </div>
      <div class="lp-about-card">
        <h3>一括見積で最大3社を比較</h3>
        <p>一度の入力で複数業者の見積もりが届きます。費用の妥当性確認と過剰請求の防止に役立ちます。</p>
      </div>
      <div class="lp-about-card">
        <h3>全国対応・地元業者ネットワーク</h3>
        <p>全国47都道府県に対応。施設所在地に近い地元業者を優先紹介するため、出張費を抑えた対応が期待できます。</p>
      </div>
      <div class="lp-about-card">
        <h3>完全無料・しつこい営業なし</h3>
        <p>依頼から紹介まですべて無料。紹介した業者には過度な営業を禁じており、安心してご利用いただけます。</p>
      </div>
    </div>
  </div>
</section>

<!-- ══ 最新コラム ══════════════════════════════════════════════ -->
<section class="lp-columns">
  <div class="sd-container">
    <div class="lp-section-head">
      <span class="lp-section-kicker">COLUMN</span>
      <h2 class="lp-section-title">お役立ち情報・コラム</h2>
      <p class="lp-section-lead">
        施設管理に関わる法令・費用相場・業者選びの実務情報を発信しています。
      </p>
    </div>
    <ul class="lp-column-list">
      {featuredColumns.map((c) => (
        <li class="lp-column-item">
          <a href={c.href} class="lp-column-link">
            <span class="lp-column-cat">{c.category}</span>
            <h3 class="lp-column-title">{c.title}</h3>
            <p class="lp-column-excerpt">{c.excerpt}</p>
            <span class="lp-column-arrow">続きを読む →</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="lp-columns-more">
      <a href="/column/" class="lp-columns-more-link">コラム一覧をすべて見る →</a>
    </div>
  </div>
</section>

<!-- ══ お問い合わせ ════════════════════════════════════════════ -->
<ContactFormGeneric />

</BaseLayout>

<style>
/* ── Hero ── */
.lp-hero {
  background: linear-gradient(135deg, var(--blue-dark) 0%, #1a3a6b 100%);
  color: #fff;
  padding: 72px 0;
  overflow: hidden;
}
.lp-hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr);
  gap: 40px;
  align-items: center;
}
.lp-hero-copy {
  text-align: left;
}
.lp-hero-kicker {
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #93c5fd;
  margin-bottom: 16px;
}
.lp-hero-h1 {
  font-size: clamp(1.8rem, 4vw, 2.8rem);
  font-weight: 900;
  line-height: 1.3;
  margin-bottom: 24px;
}
.lp-hero-h1-sub {
  display: block;
  font-size: clamp(0.95rem, 2vw, 1.2rem);
  font-weight: 600;
  color: #cbe1ff;
  margin-top: 8px;
}
.lp-hero-desc {
  font-size: 1rem;
  line-height: 1.8;
  color: #bfdbfe;
  margin-bottom: 32px;
}
.lp-hero-desc strong { color: #fff; }
.lp-hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: flex-start;
  margin-bottom: 24px;
}
.lp-hero-cta {
  display: inline-block;
  background: var(--accent);
  color: #1a202c;
  font-weight: 700;
  font-size: 1.05rem;
  padding: 14px 32px;
  border-radius: 8px;
  transition: opacity .2s;
  text-decoration: none;
}
.lp-hero-cta:hover { opacity: .85; }
.lp-hero-cta-secondary {
  display: inline-block;
  background: transparent;
  color: #fff;
  border: 1.5px solid rgba(255,255,255,.6);
  font-weight: 600;
  font-size: .98rem;
  padding: 13px 28px;
  border-radius: 8px;
  transition: background .2s;
  text-decoration: none;
}
.lp-hero-cta-secondary:hover { background: rgba(255,255,255,.12); }
.lp-hero-badges {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8px;
  list-style: none;
  margin: 8px 0 0;
  padding: 0;
}
.lp-hero-badges li {
  background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.25);
  color: #e0f2fe;
  font-size: .78rem;
  padding: 4px 12px;
  border-radius: 99px;
}
.lp-hero-visual {
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 22px 70px rgba(0,0,0,.32);
  border: 1px solid rgba(255,255,255,.18);
  margin: 0;
}
.lp-hero-visual img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

/* ── Section共通 ── */
.lp-section-head {
  text-align: center;
  margin-bottom: 32px;
}
.lp-section-kicker {
  display: inline-block;
  font-size: .75rem;
  font-weight: 800;
  letter-spacing: .12em;
  color: var(--blue);
  margin-bottom: 8px;
}
.lp-section-title {
  font-size: clamp(1.4rem, 3vw, 1.9rem);
  font-weight: 900;
  color: var(--gray-900);
  margin-bottom: 12px;
}
.lp-section-lead {
  font-size: .95rem;
  color: var(--gray-700);
  line-height: 1.8;
  max-width: 720px;
  margin: 0 auto;
}

/* ── サービス一覧 ── */
.lp-services {
  padding: 72px 0;
  background: #fff;
}
.lp-service-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
  max-width: 1100px;
  margin: 0 auto;
}
.lp-service-card {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: 12px;
  padding: 0 0 22px;
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: box-shadow .2s, transform .2s, border-color .2s;
}
.lp-service-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--blue-light); }
.lp-service-card-img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  background: var(--gray-100);
  margin-bottom: 18px;
}
.lp-service-label {
  display: inline-block;
  background: var(--blue-light);
  color: var(--blue-dark);
  font-size: .72rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 99px;
  letter-spacing: .04em;
  width: fit-content;
  margin: 0 22px 12px;
}
.lp-service-card h3 { font-size: 1rem; font-weight: 700; margin: 0 22px 8px; color: var(--gray-900); }
.lp-service-card p { font-size: .85rem; color: var(--gray-500); line-height: 1.6; flex: 1; margin: 0 22px 16px; }
.lp-service-link { font-size: .85rem; font-weight: 700; color: var(--blue); margin: 0 22px; }

/* ── ロカサポについて ── */
.lp-about {
  padding: 72px 0;
  background: var(--gray-100);
}
.lp-about-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 18px;
  max-width: 1000px;
  margin: 0 auto;
}
.lp-about-card {
  background: #fff;
  border-radius: 12px;
  padding: 24px 22px;
  border: 1px solid var(--gray-200);
}
.lp-about-card h3 {
  font-size: 1rem;
  font-weight: 800;
  color: var(--gray-900);
  margin-bottom: 10px;
}
.lp-about-card p { font-size: .88rem; line-height: 1.75; color: var(--gray-700); }

/* ── コラム ── */
.lp-columns {
  padding: 72px 0;
  background: #fff;
}
.lp-column-list {
  list-style: none;
  padding: 0;
  margin: 0 auto;
  max-width: 1000px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}
.lp-column-item {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: 12px;
  overflow: hidden;
  transition: box-shadow .2s, transform .2s;
}
.lp-column-item:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.lp-column-link {
  display: block;
  padding: 20px 22px;
  text-decoration: none;
  color: inherit;
  height: 100%;
}
.lp-column-cat {
  display: inline-block;
  background: var(--blue-light);
  color: var(--blue-dark);
  font-size: .7rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 99px;
  letter-spacing: .04em;
  margin-bottom: 10px;
}
.lp-column-title {
  font-size: .98rem;
  font-weight: 800;
  color: var(--gray-900);
  line-height: 1.5;
  margin-bottom: 10px;
}
.lp-column-excerpt {
  font-size: .85rem;
  color: var(--gray-600);
  line-height: 1.7;
  margin-bottom: 12px;
}
.lp-column-arrow {
  font-size: .82rem;
  font-weight: 700;
  color: var(--blue);
}
.lp-columns-more {
  text-align: center;
  margin-top: 32px;
}
.lp-columns-more-link {
  display: inline-block;
  padding: 12px 28px;
  background: var(--gray-100);
  border: 1px solid var(--gray-200);
  border-radius: 99px;
  color: var(--gray-800);
  font-weight: 700;
  font-size: .92rem;
  text-decoration: none;
  transition: background .2s;
}
.lp-columns-more-link:hover { background: var(--gray-200); }

@media (max-width: 640px) {
  .lp-hero { padding: 56px 0 48px; }
  .lp-hero-inner { grid-template-columns: 1fr; gap: 28px; }
  .lp-hero-copy { text-align: center; }
  .lp-hero-badges { justify-content: center; }
  .lp-services, .lp-about, .lp-columns { padding: 48px 0; }
  .lp-hero-ctas { flex-direction: column; align-items: stretch; }
  .lp-hero-cta, .lp-hero-cta-secondary { text-align: center; }
}
</style>
