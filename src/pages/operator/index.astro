---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { allServices } from '../../data/services';

const title = `運営者情報｜${site.name}`;
const description = `${site.name} の運営者情報・運営方針・お問い合わせ方法。施設管理の一括見積比較サービスの運営体制と、ご紹介の前に確認していることについてご案内します。`;
const canonical = `${site.domain}/operator/`;
const serviceCount = allServices.length;

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: '運営者情報', item: canonical },
  ],
});

const orgLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.org.legalName,
  alternateName: site.name,
  url: site.domain,
  logo: `${site.domain}/og-default.png`,
  areaServed: { '@type': 'Country', name: 'Japan' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    availableLanguage: ['ja'],
    areaServed: 'JP',
  },
  description: `施設管理・設備メンテナンスの一括見積比較サービスを運営。法定点検・衛生清掃・修繕工事・エネルギー設備・防犯設備など${serviceCount}分野で、施設管理担当者と登録・資格を有する専門業者をつなぐB2B紹介サービス。`,
  knowsAbout: allServices.map((s) => s.serviceName),
  subOrganization: {
    '@type': 'Organization',
    name: site.author.name,
    url: `${site.domain}/author/`,
  },
});
---
<BaseLayout title={title} description={description} canonical={canonical} siteName={site.name} jsonLdBlocks={[breadcrumbLd, orgLd]}>
  <section class="hero hero--simple">
    <div class="sd-container">
      <h1 class="hero-h1">運営者情報</h1>
      <p class="hero-sub-simple">施設管理の一括見積比較サービスの運営体制とご紹介方針</p>
    </div>
  </section>

  <section class="sd-section section-white">
    <div class="sd-container">

      <div class="op-block">
        <h2 class="op-h2">サービス概要</h2>
        <table class="info-table">
          <tbody>
            <tr><th>サービス名</th><td>{site.name}（ロカサポ / local-support.jp）</td></tr>
            <tr><th>お問い合わせ</th><td>support@local-support.jp（ロカサポ運営事務局）</td></tr>
            <tr><th>記事の作成</th><td><a href="/author/">{site.author.name}</a></td></tr>
            <tr><th>運営組織</th><td>{site.org.legalName}</td></tr>
            <tr><th>事業内容</th><td>施設管理・設備メンテナンス業者の紹介サービス（一括見積比較）</td></tr>
            <tr><th>対応エリア</th><td>全国47都道府県</td></tr>
            <tr>
              <th>取扱サービス</th>
              <td>
                <ul class="op-service-list">
                  {allServices.map((s) => (
                    <li><a href={`/${s.slug}/`}>{s.serviceName}</a></li>
                  ))}
                </ul>
              </td>
            </tr>
            <tr><th>利用料金</th><td>ご依頼者様は無料（ご相談・業者のご紹介・連絡先の共有まで）</td></tr>
            <tr><th>お問い合わせ</th><td>各サービスページのお問い合わせフォームよりご連絡ください</td></tr>
          </tbody>
        </table>
      </div>

      <div class="op-block">
        <h2 class="op-h2">運営方針</h2>
        <p class="op-lead">
          {site.name} は、<strong>施設管理担当者の業者選び負担を軽減する</strong>ことを目的に運営しています。
          受水槽清掃やアスベスト調査、消防設備点検などには法令上の点検・清掃の義務があり、アスベストの事前調査や一定の建物の消防設備点検のように、有資格者が行う必要がある作業もあります。
          本サービスでは、業者の資格・登録の有無を確認してご紹介することで、施設管理者が安心して業者を比較・選定できる環境を提供します。
        </p>
      </div>

      <div class="op-block">
        <h2 class="op-h2">ご紹介の前に確認していること</h2>
        <p class="op-lead">ご依頼ごとに、次の項目を確認してからご紹介します。</p>
        <ul class="op-list">
          <li><strong>対応エリアと対応の可否</strong>：物件の所在地と依頼内容に対応できるかを、業者に直接確認</li>
          <li><strong>法令上の資格・登録</strong>：建築物飲料水貯水槽清掃業の都道府県知事登録、建築物石綿含有建材調査者、消防設備士など、必要な資格・登録を業者の公開情報と回答で確認</li>
          <li><strong>会社の所在地・連絡先</strong>：業者のWebサイトなどの公開情報で確認</li>
          <li><strong>対応条件</strong>：現地調査の要否と費用、対応時間帯、報告書の発行など、回答のあった条件を比較ページに掲載</li>
        </ul>
        <p class="op-lead">確認は業者の公開情報と回答にもとづくもので、業者の品質や工事の結果を保証するものではありません。</p>
      </div>

      <div class="op-block">
        <h2 class="op-h2">情報の正確性について</h2>
        <p class="op-lead">
          本サイトに掲載している<strong>法令情報・費用相場・業者選びの基準は公開時点のもの</strong>です。
          法令は改正されること、費用相場は地域・業者・施設状況により変動することがあるため、最終的な判断は管轄行政（保健所・水道局・労働基準監督署など）の最新情報、および複数の業者見積もりに基づいて行ってください。
          記事は施設管理・設備メンテナンス業界の実務情報を参考に作成しており、最終更新日を各ページに明示しています。
        </p>
      </div>

      <div class="op-block">
        <h2 class="op-h2">お問い合わせ</h2>
        <p class="op-lead">
          サービスに関するお問い合わせは、各サービスのお問い合わせフォーム、または以下からお寄せください。
        </p>
        <ul class="op-contact-list">
          {allServices.map((s) => (
            <li><a href={`/${s.slug}/#contact`}>{s.serviceName}に関するお問い合わせ</a></li>
          ))}
        </ul>
        <p class="op-note">業者掲載のご相談・取材・その他のお問い合わせは、上記いずれかのフォームに「その他のお問い合わせ」とご記入のうえご連絡ください。</p>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.info-table { width: 100%; border-collapse: collapse; font-size: .95rem; }
.info-table th, .info-table td { padding: 14px 16px; border-bottom: 1px solid var(--gray-200); text-align: left; }
.info-table th { width: 200px; color: var(--gray-700); font-weight: 600; background: var(--gray-100); }

.op-block { margin-bottom: 48px; max-width: 860px; }
.op-block:last-child { margin-bottom: 0; }
.op-h2 {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--gray-900);
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--blue);
}
.op-lead {
  font-size: .95rem;
  line-height: 1.85;
  color: var(--gray-700);
  margin-bottom: 16px;
}
.op-list {
  font-size: .92rem;
  line-height: 1.85;
  color: var(--gray-700);
  padding-left: 22px;
  margin-bottom: 12px;
}
.op-list li { margin-bottom: 8px; }
.op-list a { color: var(--blue); text-decoration: underline; }
.op-service-list,
.op-contact-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 8px;
}
.op-service-list a,
.op-contact-list a {
  display: block;
  padding: 10px 12px;
  border: 1px solid var(--gray-200);
  border-radius: 8px;
  background: var(--gray-100);
  color: var(--blue);
  font-size: .88rem;
  font-weight: 700;
  line-height: 1.5;
  text-decoration: none;
}
.op-service-list a:hover,
.op-contact-list a:hover { background: var(--blue-light); }
.op-note {
  font-size: .82rem;
  color: var(--gray-500);
  background: var(--gray-100);
  border-radius: 8px;
  padding: 12px 16px;
}

@media (max-width: 640px) {
  /* 狭い画面では横スクロール可能にして表崩れを防ぐ */
  .info-table { display: block; overflow-x: auto; white-space: nowrap; }
  .info-table th { width: 120px; padding: 12px 10px; font-size: .85rem; white-space: normal; }
  .info-table td { padding: 12px 10px; font-size: .9rem; white-space: normal; }
}
</style>
