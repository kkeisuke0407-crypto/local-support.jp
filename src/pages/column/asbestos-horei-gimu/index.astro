---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = 'アスベスト法令義務ガイド2026｜大気汚染防止法・石綿障害予防規則の要点と違反ペナルティ';
const description = '2022年4月の大気汚染防止法改正で報告義務化、2023年10月で有資格者必須に。アスベスト調査・除去を規制する大防法・石綿障害予防規則・建築物石綿含有建材調査者制度を施設管理担当者向けに整理。違反時の罰則・届出書類・労基署対応のポイントまで2026年最新版で解説します。';
const canonical = `${site.domain}/column/asbestos-horei-gimu/`;
const published = '2026-05-27';
const modified = '2026-05-27';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: 'アスベスト法令義務ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 4700,
  articleSection: '法令・義務',
  keywords: 'アスベスト,石綿,大気汚染防止法,石綿障害予防規則,建築物石綿含有建材調査者,事前調査,法定義務,2026',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: {
    '@type': 'Organization',
    name: site.org.legalName,
    url: site.domain,
    logo: { '@type': 'ImageObject', url: `${site.domain}/og-default.png` },
  },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-asbestos.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: 'アスベスト調査・除去' },
  citation: [
    { '@type': 'Legislation', name: '大気汚染防止法' },
    { '@type': 'Legislation', name: '石綿障害予防規則' },
  ],
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'アスベスト事前調査は法律で義務ですか？', acceptedAnswer: { '@type': 'Answer', text: 'はい。大気汚染防止法および石綿障害予防規則により、建築物・工作物の解体・改修工事を行う発注者・施工業者は、工事着手前にアスベスト含有の有無を事前調査することが義務付けられています。2022年4月以降は一定規模以上の工事で結果の電子報告が、2023年10月以降は建築物石綿含有建材調査者等の有資格者による調査が必須です。' } },
    { '@type': 'Question', name: '報告義務が発生する工事の規模は？', acceptedAnswer: { '@type': 'Answer', text: '①建築物の解体工事で床面積80m²以上、②建築物の改修工事で請負金額100万円以上（税込）、③工作物の解体・改修工事で請負金額100万円以上のいずれかに該当する場合、事前調査結果を労働基準監督署と都道府県等に電子報告する義務があります（石綿事前調査結果報告システムを使用）。' } },
    { '@type': 'Question', name: '建築物石綿含有建材調査者の資格は誰が必要？', acceptedAnswer: { '@type': 'Answer', text: '2023年10月1日以降に着手するすべての事前調査は、「建築物石綿含有建材調査者」（一般・特定・一戸建て等の区分あり）または同等の資格を有する者が実施しなければなりません。発注者は、調査を委託する業者にこの資格者が在籍しているかを必ず確認してください。' } },
    { '@type': 'Question', name: '違反した場合の罰則は？', acceptedAnswer: { '@type': 'Answer', text: '大気汚染防止法違反では作業基準遵守違反で3か月以下の懲役または30万円以下の罰金、報告義務違反では30万円以下の罰金。石綿障害予防規則・労働安全衛生法違反では6か月以下の懲役または50万円以下の罰金が科される可能性があります。重大な飛散事故では業務上過失致傷罪・損害賠償責任に発展する例もあります。' } },
    { '@type': 'Question', name: 'みなし含有での除去は法令違反になりませんか？', acceptedAnswer: { '@type': 'Answer', text: 'なりません。事前調査で「分析を行わずアスベスト含有とみなして除去する」ことは大防法・石綿則上認められています。ただし、その場合の除去工法・養生・廃棄物処理はアスベスト含有を前提とした基準を満たす必要があり、結果として工事費が上振れする傾向があります。' } },
    { '@type': 'Question', name: '記録の保存期間はどれくらいですか？', acceptedAnswer: { '@type': 'Answer', text: '事前調査結果記録（写真・記録書類）は工事終了後3年間、石綿則による作業記録は40年間（労働者の健康管理のため長期保存）が義務付けられています。発注者側も、解体・改修工事の事前調査記録は所有期間中の保管が望ましいとされます。' } },
    { '@type': 'Question', name: "アスベスト事前調査の結果報告はどこに提出しますか？", acceptedAnswer: { '@type': 'Answer', text: "解体・改修工事の発注者は調査結果を書面で工事業者に提供する義務があります。また工事規模によっては都道府県知事・労働基準監督署への届出が必要です。" } },
    { '@type': 'Question', name: "2023年改正大気汚染防止法で何が変わりましたか？", acceptedAnswer: { '@type': 'Answer', text: "2023年10月から、解体・改修工事前に建築物石綿含有建材調査者等の有資格者による事前調査が義務化されました。調査結果の記録・保存・発注者への説明義務も強化されています。" } },
    { '@type': 'Question', name: "アスベスト工事の届出義務はいつ必要ですか？", acceptedAnswer: { '@type': 'Answer', text: "大気汚染防止法により、特定粉じん排出等作業（吹付け石綿等レベル1・2の除去）は工事開始の14日前までに都道府県知事への届出が必要です。労働安全衛生法上の届出義務も別途発生します。" } },
    { '@type': 'Question', name: "小規模工事でもアスベスト調査は必要ですか？", acceptedAnswer: { '@type': 'Answer', text: "解体・改修の規模を問わず、アスベスト含有が疑われる建材がある場合は事前調査が必要です。「小規模だから不要」という例外規定はありません。" } },
    { '@type': 'Question', name: "自分でアスベスト除去はできますか？", acceptedAnswer: { '@type': 'Answer', text: "レベル1・2（吹付け石綿・断熱材等）は専門業者による施工が法令上義務付けられています。無資格者が取り扱うと大気汚染防止法・労働安全衛生法違反になります。レベル3でも廃棄物処理法上の特別管理産業廃棄物として適正処理が必要です。" } }
  
  ],
});
