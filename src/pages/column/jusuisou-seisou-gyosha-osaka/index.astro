---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '大阪で受水槽清掃の業者を選ぶ｜小規模受水槽の指導・法定検査の手数料・見積りの確認点';
const description = '大阪府内で受水槽清掃の業者を選ぶ施設管理者向けに、水道法・建築物衛生法と大阪市・大阪府の小規模受水槽の指導、大阪府内の簡易専用水道の法定検査の手数料（地域別）、登録制度の考え方、見積りで確認したい点を、公的資料と公開情報で確認して整理しました。';
const canonical = `${site.domain}/column/jusuisou-seisou-gyosha-osaka/`;
const published = '2026-07-16';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '大阪の受水槽清掃 業者選び', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '業者選び',
  keywords: '受水槽清掃,大阪,業者,小規模受水槽,指導要綱,簡易専用水道,法定検査,手数料',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
});

const faqItems = [
  { q: '大阪で10m³以下の受水槽にも清掃は必要ですか？', a: '水道法の簡易専用水道には当たりませんが、大阪市は指導要綱を定めて簡易専用水道に準じた管理をお願いしており、大阪府は「大阪府小規模受水槽水道衛生管理指導要領」で受水槽・高置水槽の清掃を毎年1回以上行うよう呼びかけています。条例による義務ではなく指導ですが、衛生上、年1回の清掃が勧められています。' },
  { q: '大阪府内の法定検査の手数料はいくらですか？', a: '検査機関と地域によって異なります。たとえば関西環境開発センターの料金表（2025年4月から）では、大阪市を含む大阪府北部で、高置水槽がある施設は19,800円、ない施設は17,600円、堺市を含む大阪府南部では22,000円・19,800円（いずれも税込）です。' },
  { q: '清掃業者は登録業者でないといけませんか？', a: '法律上、登録業者への依頼は義務ではありません。建築物飲料水貯水槽清掃業の登録は、基準を満たす事業者が受けることができる任意の制度です（建築物衛生法第12条の2）。登録には機械器具・作業監督者・従事者研修などの基準があるため、比べるときの目安になります。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>大阪の受水槽清掃 業者選び</span>
        </nav>
        <span class="cl-cat">受水槽清掃</span>
        <h1 class="cl-title">大阪で受水槽清掃の業者を選ぶ｜小規模受水槽の指導・法定検査の手数料・見積りの確認点</h1>
        <p class="cl-lead">
          大阪府内の受水槽は、水道法・建築物衛生法に加えて、<strong>10m³以下の小規模な受水槽にも大阪市・大阪府の指導</strong>があります。この記事では、大阪で清掃業者を選ぶときに知っておきたい決まり、<strong>法定検査の手数料（地域別）</strong>、登録制度の考え方、見積りで確認したい点を、公的資料と公開情報で確認して整理します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年7月16日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 大阪で受水槽清掃の業者はどう選べばよいですか？</p>
        <p class="cl-qa-a">A. <strong>①自分の受水槽にどの決まりが当てはまるか確認 ②容量・高置水槽・水質検査・時間帯をそろえて見積りを比べる ③登録の有無を目安として確認</strong>の順が確実です。10m³超なら、清掃とは別に年1回の法定検査（例：大阪市内で17,600〜19,800円）も必要です。</p>
        <p class="cl-qa-src">※水道法・建築物衛生法、大阪市・大阪府・関西環境開発センターの公開情報による（2026年9月確認）</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#rules">大阪の受水槽に関わる決まり</a></li>
          <li><a href="#kensa">法定検査の手数料（地域別）</a></li>
          <li><a href="#registry">登録制度の考え方</a></li>
          <li><a href="#choose">見積りで確認したいこと</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="rules" class="cl-section">
        <h2>大阪の受水槽に関わる決まり</h2>
        <div class="cl-table-wrap">
          <table class="cl-table cl-table--wrap">
            <caption>大阪府内の受水槽に関わる主な決まり</caption>
            <thead><tr><th>区分</th><th>対象</th><th>主な内容</th></tr></thead>
            <tbody>
              <tr><th scope="row">簡易専用水道（水道法）</th><td>水道水だけが水源で、受水槽の有効容量の合計が10m³を超えるもの</td><td>清掃：毎年1回以上／登録検査機関などの検査：毎年1回以上</td></tr>
              <tr><th scope="row">特定建築物（建築物衛生法）</th><td>事務所・店舗などの用途部分が延べ3,000m²以上（学校は8,000m²以上）</td><td>貯水槽の清掃：1年以内ごとに1回／帳簿書類の5年保存</td></tr>
              <tr><th scope="row">大阪市の小規模受水槽</th><td>有効容量10m³以下</td><td>指導要綱にもとづき、簡易専用水道に準じた管理をお願い</td></tr>
              <tr><th scope="row">大阪府の小規模受水槽水道</th><td>規模の小さい受水槽方式の水道</td><td>「大阪府小規模受水槽水道衛生管理指導要領」にもとづき、受水槽・高置水槽の清掃を毎年1回以上、点検と不備の改善、蛇口の水の色・濁り・臭い・味の確認を1週間に1回以上</td></tr>
            </tbody>
          </table>
        </div>
        <p>大阪市・大阪府の小規模受水槽の定めは<strong>条例による義務ではなく、指導要綱・指導要領による管理のお願い</strong>です。ただし、衛生上は年1回の清掃が勧められています。自分の建物が対象かは<a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a>と、所在地の保健所で確認してください。</p>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/332AC0000000177" rel="noopener" target="_blank">水道法</a>・<a href="https://laws.e-gov.go.jp/law/346M50000100002" rel="noopener" target="_blank">建築物衛生法施行規則</a>（e-Gov法令検索）／<a href="https://www.city.osaka.lg.jp/suido/page/0000137963.html" rel="noopener" target="_blank">大阪市水道局「適正な貯水槽水道の管理をお願いします」</a>／<a href="https://www.pref.osaka.lg.jp/o100150/shijonawatehoken/kankyo/syoukibo.html" rel="noopener" target="_blank">大阪府「ビル・マンションの受水槽の適正な管理を」</a>（いずれも2026年9月確認）</p>
      </section>

      <section id="kensa" class="cl-section">
        <h2>法定検査の手数料（地域別）</h2>
        <p>有効容量10m³超の簡易専用水道は、清掃とは別に、<strong>登録検査機関などの検査を毎年1回以上</strong>受ける必要があり、受けないと100万円以下の罰金の対象です（水道法第34条の2第2項・第54条）。手数料は検査機関と地域で異なります。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>関西環境開発センターの簡易専用水道検査の手数料（税込・2025年4月から）</caption>
            <thead><tr><th>地域</th><th>高置水槽あり<br/>（受水槽1基）</th><th>高置水槽なし<br/>（受水槽1基）</th></tr></thead>
            <tbody>
              <tr><th scope="row">大阪府北部（大阪市・豊中・吹田・東大阪など）</th><td>19,800円</td><td>17,600円</td></tr>
              <tr><th scope="row">大阪府南部（堺・岸和田・富田林など）</th><td>22,000円</td><td>19,800円</td></tr>
              <tr><th scope="row">書類検査</th><td>3,300円</td><td>3,300円</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cl-note">出典：<a href="https://www.bmkkc.or.jp/relays/download/131/654/35/2826/?file=/files/libs/2826//202504150921062644.pdf" rel="noopener" target="_blank">一般社団法人関西環境開発センター「簡易専用水道検査料金表（市町村別）」</a>（2026年9月確認）。休日の検査は別途休日出張料。ほかの検査機関もあるため、所在地の保健所で確認できます。</p>
      </section>

      <section id="registry" class="cl-section">
        <h2>登録制度の考え方</h2>
        <p>建築物衛生法の「建築物飲料水貯水槽清掃業」の登録は、基準を満たす事業者が営業所ごとに受けることができる<strong>任意の制度</strong>です（第12条の2）。登録していない業者に頼んではいけないという規定はありませんが、登録には専用の機械器具、講習を修了した作業監督者、従事者の研修などが必要なため、比べるときの目安になります。</p>
        <p>業者に登録番号と作業を担当する営業所を聞き、見積書・契約書に記載してもらうと確認しやすくなります。登録状況は、登録を行った自治体の担当部署で確認できます。制度の詳細は<a href="/column/jusuisou-seisou-shikaku/">貯水槽清掃の資格で見る業者選び</a>で解説しています。</p>
      </section>

      <section id="choose" class="cl-section">
        <h2>見積りで確認したいこと</h2>
        <ul>
          <li><strong>水槽の構成</strong>：受水槽と高置水槽それぞれの容量・数・設置場所（屋上・地下ピットなど）を伝える</li>
          <li><strong>作業時間帯</strong>：営業時間中の断水を避けたい場合は、夜間・休日・早朝の割増の有無と率を確認する</li>
          <li><strong>搬入の条件</strong>：高層の建物で屋上に高置水槽がある場合は、機材の搬入経路やエレベーターの使用条件を事前に伝える</li>
          <li><strong>含まれるもの</strong>：水質検査、報告書、出張費・駐車場代、入居者への告知</li>
          <li><strong>法定検査</strong>：10m³超なら、検査の申込みを誰が行うか</li>
        </ul>
        <p>料金の例は<a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</a>、確認項目の全体は<a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト｜見積り前に確認したい8項目</a>にまとめています。</p>
      </section>

      <div class="cl-cta">
        <h2>大阪の受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/osaka/">大阪の清掃業者を探す</a>
      </div>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          {faqItems.map((f) => (<div class="cl-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
        </dl>
      </section>

      <aside class="cl-related">
        <h2 class="cl-related-h">関連サービス・コラム</h2>
        <ul>
          <li><a href="/jusuisou-seisou/osaka/">大阪府の受水槽清掃</a></li>
          <li><a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a></li>
          <li><a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場</a></li>
          <li><a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト</a></li>
          <li><a href="/column/jusuisou-seisou-gyosha-tokyo/">東京で受水槽清掃の業者を選ぶ</a></li>
        </ul>
      </aside>

      <aside class="cl-glossary-block">
        <h2 class="cl-glossary-h">📖 この記事に出てくる主な用語</h2>
        <ul class="cl-glossary-list">
          <li><a href="/glossary/#kanni-senyou-suido">簡易専用水道</a></li>
          <li><a href="/glossary/#kenchiku-suiso-seisogyo">建築物飲料水貯水槽清掃業</a></li>
          <li><a href="/glossary/#tokutei-kenchikubutsu">特定建築物</a></li>
          <li><a href="/glossary/#koukasuisou">高架水槽</a></li>
        </ul>
        <p class="cl-glossary-more"><a href="/glossary/">施設管理用語集をすべて見る</a></p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
