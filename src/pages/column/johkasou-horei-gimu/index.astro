---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '浄化槽法の保守点検・清掃義務ガイド2026｜年1回の法定検査と管理者責任';
const description = '浄化槽法に基づく保守点検（4ヶ月〜年1回）・清掃（年1回）・法定検査（第7条・第11条検査）の義務を整理。設置者・管理者の責任、保守点検業者の登録要件、市町村清掃許可、違反時の100万円以下の罰金まで施設管理担当者向けに2026年版で解説。';
const canonical = `${site.domain}/column/johkasou-horei-gimu/`;
const published = '2026-06-05';
const modified = '2026-06-05';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '浄化槽法の保守点検・清掃義務ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5400,
  articleSection: '法令・義務',
  keywords: '浄化槽法,保守点検,清掃,法定検査,第7条検査,第11条検査,管理者責任,2026',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-johkasou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '浄化槽清掃・保守点検' },
  citation: [
    { '@type': 'Legislation', name: '浄化槽法第7条（設置後の水質検査）' },
    { '@type': 'Legislation', name: '浄化槽法第10条（保守点検・清掃義務）' },
    { '@type': 'Legislation', name: '浄化槽法第11条（定期水質検査）' },
    { '@type': 'Legislation', name: '浄化槽法第48条（罰則）' },
  ],
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '浄化槽の保守点検は誰の義務ですか？', acceptedAnswer: { '@type': 'Answer', text: '浄化槽の設置者・管理者（所有者・建物管理者）に義務があります。賃貸物件ではオーナー（建物所有者）が一次責任者で、入居者（テナント）が代わりに発注する場合は契約書での明示が必要です。実施は都道府県知事登録の保守点検業者に委託します。' } },
    { '@type': 'Question', name: '保守点検と清掃の違いは？', acceptedAnswer: { '@type': 'Answer', text: '保守点検は機器の作動確認・調整・薬剤補充（4ヶ月〜年1回）。清掃は汚泥・スカム（浮き渣）の引抜き・処分（原則年1回以上）。実施業者の資格が異なり、保守点検は都道府県知事登録業者、清掃は市町村長許可業者と分かれています。両方を1社でこなす場合もあります。' } },
    { '@type': 'Question', name: '第7条検査と第11条検査の違いは？', acceptedAnswer: { '@type': 'Answer', text: '第7条検査は設置完了後3〜8ヶ月以内の1回限りの設置状況検査（正しく機能しているかの初期確認）。第11条検査は使用開始翌年から毎年1回実施する定期水質検査。両方とも都道府県知事指定の検査機関（指定検査機関）が実施。保守点検業者の作業とは別の制度です。' } },
    { '@type': 'Question', name: '保守点検の頻度はどのくらいですか？', acceptedAnswer: { '@type': 'Answer', text: '浄化槽の種類・規模で異なります。一般家庭の合併処理浄化槽（5〜10人槽）は4ヶ月に1回。小規模事業所の合併処理浄化槽（11〜50人槽）は3ヶ月に1回。中・大規模浄化槽（51人槽以上）は週1回〜2週間に1回など、規模に応じて頻度が上がります。詳細は浄化槽法施行規則別表に定められています。' } },
    { '@type': 'Question', name: '清掃を怠ると何が起きますか？', acceptedAnswer: { '@type': 'Answer', text: '汚泥蓄積による放流水質の悪化、悪臭・害虫発生、配管詰まり、最終的には浄化槽の機能停止が起きます。法令上は浄化槽法第48条により100万円以下の罰金の対象。水質汚濁が発生した場合は水質汚濁防止法による行政指導・損害賠償リスクも生じます。' } },
    { '@type': 'Question', name: '記録の保管期間は？', acceptedAnswer: { '@type': 'Answer', text: '保守点検記録・清掃記録・法定検査結果書は3年間保管が義務（浄化槽法施行規則第6条・第8条）。指定検査機関への報告（第11条検査結果）や保健所立入検査時の提示資料として必要です。電子データでの保管も可能です。' } },
    { '@type': 'Question', name: '違反するとどうなりますか？', acceptedAnswer: { '@type': 'Answer', text: '保守点検・清掃の未実施は浄化槽法第48条により100万円以下の罰金。法定検査未受検は30万円以下の過料。重大な水質汚濁を発生させた場合は水質汚濁防止法上の刑事責任（懲役または罰金）に発展する可能性があります。設置届出義務違反は10万円以下の過料が別途あります。' } },
    { '@type': 'Question', name: '小規模浄化槽は緩い基準ですか？', acceptedAnswer: { '@type': 'Answer', text: '法令上の義務（保守点検・清掃・検査）は規模問わず全浄化槽が対象です。一般家庭の5〜10人槽でも、4ヶ月に1回の保守点検・年1回の清掃・年1回の第11条検査は必須。「小さいから不要」という例外規定はありません。' } },
    { '@type': 'Question', name: '指定検査機関はどう選びますか？', acceptedAnswer: { '@type': 'Answer', text: '指定検査機関は都道府県ごとに1〜数法人が指定されており、選択の余地はありません。所在地の都道府県の指定検査機関（〇〇県浄化槽協会等）が自動的に検査担当となります。保守点検・清掃業者は競争的に選択できますが、第11条検査機関は固定です。' } }
  ],
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${site.domain}/#website` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-johkasou.png` },
});

---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}
>
  <article class="cl-article">

    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a>
          <span aria-hidden="true">›</span>
          <a href="/column/">コラム</a>
          <span aria-hidden="true">›</span>
          <span>浄化槽法の保守点検・清掃義務ガイド</span>
        </nav>
        <span class="cl-cat">法令・義務</span>
        <h1 class="cl-title">浄化槽法の保守点検・清掃義務ガイド2026｜年1回の法定検査と管理者責任</h1>
        <p class="cl-lead">
          浄化槽を設置している建物の管理者は、<strong>浄化槽法により保守点検・清掃・法定水質検査の3つの義務</strong>があります。本記事では、保守点検と清掃の頻度・実施業者の資格、第7条検査・第11条検査の違い、記録保管義務、違反時の100万円以下の罰金リスクまで、施設管理担当者向けに2026年版で整理しました。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月5日</time>
          <span>最終更新：2026年6月5日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a>（{site.author.role}）</span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 浄化槽の保守点検・清掃義務はどこまでが必要ですか？</p>
        <p class="cl-qa-a">A. <strong>保守点検（4ヶ月〜年1回・都道府県知事登録業者）、清掃（年1回以上・市町村長許可業者）、第11条法定検査（年1回・指定検査機関）の3つすべて</strong>が義務。違反は100万円以下の罰金、検査未受検は30万円以下の過料。</p>
        <p class="cl-qa-src">※浄化槽法第10条・第11条・第48条（2026年4月時点）</p>
      </div>

      <ColumnCtaCard serviceSlug="johkasou" serviceName="浄化槽清掃・保守点検" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#scope">対象となる浄化槽（合併処理・単独処理）</a></li>
          <li><a href="#hoshu">保守点検（4ヶ月〜年1回）</a></li>
          <li><a href="#cleaning">清掃（年1回以上）</a></li>
          <li><a href="#test7">第7条検査（設置後検査）</a></li>
          <li><a href="#test11">第11条検査（定期水質検査）</a></li>
          <li><a href="#records">記録の保管・行政への報告</a></li>
          <li><a href="#penalties">違反時の罰則</a></li>
          <li><a href="#tips">実務上のポイント</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>3つの義務</strong>：保守点検（年数回・登録業者）＋清掃（年1回・市町村許可業者）＋法定水質検査（年1回・指定検査機関）</li>
            <li><strong>管理者責任</strong>：設置者・管理者が3つの義務すべての発注・記録保管・行政報告の責任を負う</li>
            <li><strong>違反リスク</strong>：100万円以下の罰金（第48条）、検査未受検は30万円以下の過料、水質汚濁発生時は刑事責任の可能性</li>
          </ul>
        </div>
      </section>

      <section id="scope" class="cl-section">
        <h2>対象となる浄化槽（合併処理・単独処理）</h2>
        <p>浄化槽法の義務対象は、下水道整備区域外の建物に設置されている<strong>すべての浄化槽</strong>です。合併処理浄化槽（トイレ＋生活雑排水を処理）と、単独処理浄化槽（トイレのみ処理・現在新設不可）の両方が対象となります。</p>

        <h3>合併処理浄化槽の規模区分</h3>
        <ul>
          <li><strong>小規模（5〜10人槽）</strong>：戸建住宅・小規模店舗</li>
          <li><strong>中規模（11〜50人槽）</strong>：小規模アパート・事業所</li>
          <li><strong>中・大規模（51〜500人槽）</strong>：マンション・宿泊施設・福祉施設</li>
          <li><strong>大規模（501人槽以上）</strong>：大型施設・工業団地・観光施設</li>
        </ul>

        <h3>単独処理浄化槽について</h3>
        <p>2001年4月以降、単独処理浄化槽の新設は法令上禁止されており、既存設置分のみが残っています。<strong>既存の単独処理浄化槽も同じく保守点検・清掃義務がある</strong>ことに留意が必要です。多くの自治体で合併処理浄化槽への切替補助制度（30〜100万円程度）が用意されています。</p>

        <h3>下水道整備区域に建物がある場合</h3>
        <p>下水道整備区域内では、原則として下水道接続が必要で、浄化槽を継続使用する場合は自治体への届出が必要です。下水道接続後は浄化槽法の義務はなくなり、下水道法の管理対象となります。</p>
      </section>

      <section id="hoshu" class="cl-section">
        <h2>保守点検（4ヶ月〜年1回）</h2>
        <p>保守点検は<strong>都道府県知事登録の保守点検業者</strong>が実施する、浄化槽の作動状態の確認・調整・薬剤補充等の作業です。浄化槽法施行規則別表第1に基づき、規模・処理方式によって頻度が定められています。</p>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>保守点検の頻度（浄化槽法施行規則別表第1抜粋）</caption>
            <thead><tr><th>処理方式</th><th>規模</th><th>頻度</th></tr></thead>
            <tbody>
              <tr><th scope="row">合併処理浄化槽（分離接触ばっ気方式等）</th><td>20人槽以下</td><td>4ヶ月に1回以上</td></tr>
              <tr><th scope="row">合併処理浄化槽（分離接触ばっ気方式等）</th><td>21〜50人槽</td><td>3ヶ月に1回以上</td></tr>
              <tr><th scope="row">合併処理浄化槽（その他）</th><td>51人槽以上</td><td>2週間〜週1回（処理方式・規模による）</td></tr>
              <tr><th scope="row">単独処理浄化槽</th><td>全規模</td><td>4ヶ月〜6ヶ月に1回</td></tr>
            </tbody>
          </table>
        </div>

        <h3>保守点検業者の資格要件</h3>
        <ul>
          <li>都道府県知事登録の保守点検業者であること</li>
          <li>浄化槽管理士（国家資格）の在籍</li>
          <li>所定の機材・薬剤を保有</li>
        </ul>

        <h3>保守点検の主な作業内容</h3>
        <ol>
          <li>各部屋の汚泥・スカム蓄積状況の目視確認</li>
          <li>送風機・ポンプ等の機器作動確認</li>
          <li>水位・流量・透視度の測定</li>
          <li>消毒剤の補充</li>
          <li>異常時の応急処置・調整</li>
          <li>記録票への記入と建物管理者への報告</li>
        </ol>
      </section>

      <section id="cleaning" class="cl-section">
        <h2>清掃（年1回以上）</h2>
        <p>清掃は<strong>市町村長許可の浄化槽清掃業者</strong>が実施する、汚泥・スカム（浮き渣）の引抜き・処分作業です。年1回以上の実施が原則ですが、規模・使用状況に応じて頻度が上がる場合があります。</p>

        <h3>清掃業者の許可要件</h3>
        <p>清掃業は<strong>市町村長の許可制</strong>です（廃棄物処理法と浄化槽法の二重許可）。保守点検業（都道府県知事登録）とは別の制度のため、同じ業者が両方を兼業する場合もあれば、別々の業者が分担する場合もあります。</p>

        <h3>清掃の主な作業内容</h3>
        <ol>
          <li>汚泥・スカム・中間水の引抜き</li>
          <li>各槽の内部洗浄</li>
          <li>機器の洗浄・点検</li>
          <li>引抜き量・処分先の記録</li>
          <li>マニフェスト発行（産業廃棄物として処分）</li>
        </ol>

        <h3>清掃時の留意点</h3>
        <ul>
          <li>清掃時は浄化槽の使用停止が必要（半日〜1日程度）</li>
          <li>マンション・宿泊施設では事前告知（入居者・利用者）</li>
          <li>引抜き汚泥は産業廃棄物として適正処分（マニフェスト保存5年間）</li>
        </ul>
      </section>

      <section id="test7" class="cl-section">
        <h2>第7条検査（設置後検査）</h2>
        <p>第7条検査は<strong>浄化槽の設置完了後3〜8ヶ月以内</strong>に1回だけ実施される検査です。新築時・浄化槽更新時に該当します。</p>

        <h3>検査の目的</h3>
        <p>浄化槽が設計通り・適切に設置・施工されているかの初期確認。設置工事の不備（配管接続誤り・浄化槽容量不足など）を早期発見するためのものです。</p>

        <h3>検査機関と費用</h3>
        <ul>
          <li>都道府県知事指定の検査機関（〇〇県浄化槽協会等）が実施</li>
          <li>費用は1〜3万円程度（規模・地域による）</li>
          <li>建築工事の発注書類に含まれているか確認が必要</li>
        </ul>

        <h3>検査結果の取扱い</h3>
        <p>検査結果は<strong>「適正」「不適正」「おおむね適正」</strong>の3区分で判定されます。不適正の場合は施工業者への手直し依頼が必要で、放置すると保健所からの行政指導・改善命令の対象となります。</p>
      </section>

      <section id="test11" class="cl-section">
        <h2>第11条検査（定期水質検査）</h2>
        <p>第11条検査は<strong>使用開始翌年から毎年1回実施</strong>する定期水質検査です。保守点検業者の作業とは別制度で、第三者機関（指定検査機関）が客観的に水質・機器を確認します。</p>

        <h3>検査内容</h3>
        <ul>
          <li>放流水のBOD・COD・SS等の水質測定</li>
          <li>浄化槽全体の運転状況確認</li>
          <li>保守点検・清掃記録の確認</li>
          <li>設置者・管理者への結果報告</li>
        </ul>

        <h3>第11条検査の特徴</h3>
        <ul>
          <li>都道府県指定の検査機関のみが実施可能（業者選択の余地なし）</li>
          <li>費用は1〜5万円程度（規模・地域による）</li>
          <li>検査結果は保健所に保管され、保健所立入時の確認資料になる</li>
          <li>未受検は浄化槽法第48条の2による30万円以下の過料</li>
        </ul>

        <h3>受検漏れが多い実態</h3>
        <p>環境省の集計によると、第11条検査の<strong>全国受検率は約60%（2024年時点）</strong>と、義務にもかかわらず受検漏れが多いのが実情です。設置者が義務を知らない・指定検査機関からの通知を放置している等が主因。保健所からの指導が来てから慌てるケースが多発しています。</p>
      </section>

      <section id="records" class="cl-section">
        <h2>記録の保管・行政への報告</h2>
        <p>保守点検・清掃・法定検査の記録は<strong>3年間保管</strong>が義務付けられています（浄化槽法施行規則第6条・第8条）。</p>

        <h3>保管すべき書類</h3>
        <ul>
          <li>保守点検記録票（年数回分）</li>
          <li>清掃記録票・マニフェスト（年1回以上）</li>
          <li>第11条検査結果書（年1回）</li>
          <li>業者の登録証・許可証コピー</li>
          <li>修繕・改修記録（実施があった場合）</li>
        </ul>

        <h3>保健所立入検査での確認</h3>
        <p>保健所職員が浄化槽設置施設を立入検査する場合があり、上記書類の提示を求められます。<strong>記録不備は行政指導の対象</strong>となり、改善報告書の提出が必要になります。</p>

        <h3>電子保管の活用</h3>
        <p>近年は保守点検業者が点検記録をクラウド上で管理し、施設管理担当者がいつでも参照できるシステムが普及しています。紙の記録票の紛失リスクを避けられるため、電子保管を業者と相談する価値があります。</p>
      </section>

      <section id="penalties" class="cl-section">
        <h2>違反時の罰則</h2>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>浄化槽法の主な罰則</caption>
            <thead><tr><th>違反内容</th><th>罰則</th></tr></thead>
            <tbody>
              <tr><th scope="row">保守点検・清掃義務違反</th><td>100万円以下の罰金（第48条）</td></tr>
              <tr><th scope="row">第7条検査未受検</th><td>30万円以下の過料（第48条の2）</td></tr>
              <tr><th scope="row">第11条検査未受検</th><td>30万円以下の過料（第48条の2）</td></tr>
              <tr><th scope="row">設置届出義務違反</th><td>10万円以下の過料</td></tr>
              <tr><th scope="row">無資格業者への委託</th><td>100万円以下の罰金</td></tr>
              <tr><th scope="row">水質汚濁発生</th><td>水質汚濁防止法上の刑事責任（懲役または罰金）</td></tr>
            </tbody>
          </table>
        </div>

        <h3>違反発覚のパターン</h3>
        <ul>
          <li>保健所の定期立入検査</li>
          <li>指定検査機関からの未受検通知の放置発覚</li>
          <li>近隣からの臭気・水質汚染の苦情通報</li>
          <li>浄化槽機能停止による水質事故発生</li>
          <li>建物売却時の引継ぎでの不備発覚</li>
        </ul>
      </section>

      <section id="tips" class="cl-section">
        <h2>実務上のポイント</h2>

        <h3>保守点検と清掃の業者を確定する</h3>
        <p>保守点検（都道府県知事登録）と清掃（市町村長許可）は別資格のため、<strong>1社で両方対応できるか、2社に分けるか</strong>を確定する必要があります。多くの地域では兼業業者が主流で、1社契約が便利です。委託前に「保守点検登録業者番号」「市町村清掃許可番号」の両方を確認してください。</p>

        <h3>年間契約で実施漏れを防ぐ</h3>
        <p>保守点検は年数回、清掃は年1回、第11条検査も年1回と頻度が異なる作業を、別々に発注すると実施漏れが発生しやすくなります。<strong>「年間管理契約」</strong>を結んで業者側にスケジュール管理を任せると、漏れなく実施できます。</p>

        <h3>指定検査機関からの通知を見逃さない</h3>
        <p>第11条検査は指定検査機関から「検査受検のお願い」通知が来ます。<strong>この通知を放置すると未受検扱い</strong>になり、過料の対象になります。事務担当者の異動・移転時に通知が迷子になりやすいので、施設管理担当者の連絡先を最新に保ってください。</p>

        <h3>合併処理浄化槽への切替補助を活用</h3>
        <p>古い単独処理浄化槽を所有している場合、<strong>合併処理浄化槽への切替補助金</strong>が多くの自治体で用意されています。30〜100万円程度の補助が一般的。水質改善・維持コスト削減のメリットがあり、長期的にはROIが高い投資です。</p>
      </section>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          <div class="cl-faq-item">
            <dt>浄化槽の保守点検は誰の義務ですか？</dt>
            <dd>浄化槽の設置者・管理者（所有者・建物管理者）に義務があります。賃貸物件ではオーナーが一次責任者です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>保守点検と清掃の違いは？</dt>
            <dd>保守点検は機器の作動確認・調整（4ヶ月〜年1回・登録業者）。清掃は汚泥引抜き（年1回以上・市町村許可業者）。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>第7条検査と第11条検査の違いは？</dt>
            <dd>第7条検査は設置後3〜8ヶ月以内の1回限り。第11条検査は使用開始翌年から毎年1回の定期水質検査です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>記録の保管期間は？</dt>
            <dd>保守点検記録・清掃記録・法定検査結果書は3年間保管が義務です（浄化槽法施行規則）。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>違反した場合の罰則は？</dt>
            <dd>保守点検・清掃義務違反は100万円以下の罰金（第48条）、検査未受検は30万円以下の過料です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>指定検査機関はどう選びますか？</dt>
            <dd>都道府県ごとに指定されており、選択の余地はありません。所在地の指定検査機関が自動的に検査担当となります。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>合併処理浄化槽への切替に補助金はありますか？</dt>
            <dd>多くの自治体で30〜100万円程度の補助があります。所在地の水道局・環境課にご確認ください。</dd>
          </div>
        </dl>
      </section>

