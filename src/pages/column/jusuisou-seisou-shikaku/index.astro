---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '貯水槽清掃の資格で見る業者選び｜登録制度・作業監督者・確認のしかた';
const description = '貯水槽（受水槽）清掃を依頼する施設管理者向けに、建築物衛生法の「建築物飲料水貯水槽清掃業」の登録制度を条文で確認して解説。登録は任意の制度であること、登録に必要な機械器具・作業監督者・従事者研修の要件、登録の確かめ方、登録の有無にかかわらず見積りで確認したい点をまとめました。';
const canonical = `${site.domain}/column/jusuisou-seisou-shikaku/`;
const published = '2026-06-16';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '貯水槽清掃の資格で見る業者選び', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '業者選び',
  keywords: '貯水槽清掃,資格,建築物飲料水貯水槽清掃業,登録,貯水槽清掃作業監督者,業者選び',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
});

const faqItems = [
  { q: '貯水槽清掃は登録業者でないと頼めませんか？', a: '法律上、登録業者への依頼は義務ではありません。建築物衛生法の「建築物飲料水貯水槽清掃業」の登録は、基準を満たす事業者が都道府県知事の登録を受けることができる任意の制度です（第12条の2）。ただし、登録には機械器具・作業監督者・従事者研修などの基準があるため、業者を比べるときの目安になります。' },
  { q: '貯水槽清掃作業監督者とは何ですか？', a: '登録を受ける事業者が置く、清掃作業を監督する人です。厚生労働大臣の登録を受けた機関が行う講習を修了し、修了から6年を経過していないことなどが要件です（建築物衛生法施行規則第28条）。発注者が取得する資格ではありません。' },
  { q: '発注する側に資格は必要ですか？', a: '不要です。ただし、簡易専用水道の設置者や特定建築物所有者等には、清掃や検査を行わせ、記録を残す義務があります。委託先の作業内容と報告書を確認しておきましょう。' },
  { q: '業者が登録しているかはどう確認しますか？', a: '業者に登録番号を聞き、見積書や契約書に記載してもらうのが確実です。登録は営業所ごとに都道府県知事が行い、有効期間は6年です（第12条の2）。登録状況は、その営業所の所在地の都道府県などの担当部署で確認できます。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>貯水槽清掃の資格で見る業者選び</span>
        </nav>
        <span class="cl-cat">業者選び</span>
        <h1 class="cl-title">貯水槽清掃の資格で見る業者選び｜登録制度・作業監督者・確認のしかた</h1>
        <p class="cl-lead">
          貯水槽清掃の業者には、建築物衛生法の<strong>「建築物飲料水貯水槽清掃業」の登録制度</strong>があります。登録は<strong>義務ではなく任意の制度</strong>ですが、機械器具や作業監督者などの基準を満たしていることの目安になります。この記事では、条文をもとに登録の要件と確かめ方を整理します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月16日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 貯水槽清掃の業者に資格は必要ですか？</p>
        <p class="cl-qa-a">A. <strong>法律上、登録や資格がないと清掃を請け負えないわけではありません。</strong>建築物衛生法の「建築物飲料水貯水槽清掃業」の登録は、基準を満たす事業者が受けることが<strong>できる</strong>任意の制度です。登録には専用の機械器具、講習を修了した作業監督者、従事者の研修などが必要なため、業者を比べるときの目安になります。</p>
        <p class="cl-qa-src">※建築物衛生法第12条の2、同法施行規則第28条（e-Gov法令検索で2026年9月確認）</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#registration">登録制度のしくみ</a></li>
          <li><a href="#requirements">登録に必要な要件</a></li>
          <li><a href="#check">登録の確かめ方</a></li>
          <li><a href="#estimate">登録の有無にかかわらず確認したいこと</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>登録は任意</strong>：法律上、登録業者への依頼は義務ではない（建築物衛生法第12条の2）</li>
            <li><strong>登録の中身</strong>：専用の機械器具・保管庫、講習修了の作業監督者、従事者の研修、作業方法の基準（施行規則第28条）</li>
            <li><strong>確認のしかた</strong>：登録番号を見積書に記載してもらう。登録の有無にかかわらず、作業内容と報告書の中身を確認する</li>
          </ul>
        </div>
      </section>

      <section id="registration" class="cl-section">
        <h2>登録制度のしくみ</h2>
        <p>建築物衛生法第12条の2は、建築物の清掃や貯水槽の清掃などの事業を営む者が、営業所ごとに、その所在地の<strong>都道府県知事の登録を受けることができる</strong>と定めています。登録を受けるかどうかは事業者の任意で、登録していない業者が清掃を請け負うことを禁じる規定はありません。</p>
        <ul>
          <li><strong>登録の単位</strong>：営業所ごと</li>
          <li><strong>有効期間</strong>：6年（第12条の2第4項）</li>
          <li><strong>表示</strong>：登録を受けた営業所は「登録建築物飲料水貯水槽清掃業」と表示できます（第12条の3）</li>
        </ul>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/345AC1000000020" rel="noopener" target="_blank">建築物における衛生的環境の確保に関する法律</a>（e-Gov法令検索、2026年9月確認）</p>
      </section>

      <section id="requirements" class="cl-section">
        <h2>登録に必要な要件</h2>
        <p>都道府県知事は、営業所の機械器具や従事者の資格などが基準に適合すると認めるときに登録します。貯水槽清掃業の基準は次のとおりです（施行規則第28条）。</p>
        <div class="cl-table-wrap">
          <table class="cl-table cl-table--wrap">
            <caption>建築物飲料水貯水槽清掃業の登録基準</caption>
            <thead><tr><th>項目</th><th>内容</th></tr></thead>
            <tbody>
              <tr><th scope="row">機械器具</th><td>揚水ポンプ、高圧洗浄機、残水処理機、換気ファン、防水型照明器具、色度計・濁度計・残留塩素測定器（貯水槽清掃の専用のもの）</td></tr>
              <tr><th scope="row">保管庫</th><td>機械器具を適切に保管できる専用の保管庫</td></tr>
              <tr><th scope="row">作業監督者</th><td>厚生労働大臣の登録を受けた機関の講習（または再講習）を修了し、修了から6年を経過していない人など</td></tr>
              <tr><th scope="row">従事者の研修</th><td>清掃方法・塗装方法・消毒方法と作業の安全・衛生についての定期的な研修を修了していること</td></tr>
              <tr><th scope="row">作業方法</th><td>清掃作業と機械器具の維持管理の方法が、厚生労働大臣が定める基準に適合していること</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/346M50000100002" rel="noopener" target="_blank">建築物における衛生的環境の確保に関する法律施行規則</a>第28条（e-Gov法令検索、2026年9月確認）</p>
      </section>

      <section id="check" class="cl-section">
        <h2>登録の確かめ方</h2>
        <ol>
          <li><strong>登録番号を聞く</strong>：見積書・契約書に登録番号を記載してもらう</li>
          <li><strong>どの営業所の登録か確認する</strong>：登録は営業所ごと。実際に作業する営業所の登録かを確認する</li>
          <li><strong>有効期間を確認する</strong>：有効期間は6年。登録の年月日も聞いておく</li>
          <li><strong>必要なら行政で確認する</strong>：登録を行った都道府県などの担当部署で登録状況を確認できます</li>
        </ol>
      </section>

      <section id="estimate" class="cl-section">
        <h2>登録の有無にかかわらず確認したいこと</h2>
        <p>登録は目安の一つです。見積りの段階では、次の点も確認しておくと、作業内容の違いが分かりやすくなります。</p>
        <ul>
          <li><strong>作業の範囲</strong>：受水槽だけか、高置水槽も含むか。水槽の数（2槽式など）</li>
          <li><strong>清掃後の水質確認</strong>：水質検査の有無と項目数、結果の書面</li>
          <li><strong>報告書</strong>：清掃前後の写真付きの報告書が出るか。清掃の記録は法定検査や立入検査で確認されることがあります</li>
          <li><strong>断水と告知</strong>：断水時間の見込み、入居者・利用者への告知を誰が行うか</li>
          <li><strong>追加費用</strong>：出張費、夜間・休日の割増、補修が必要になった場合の扱い</li>
        </ul>
        <p>費用の目安は<a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</a>、法律上の義務と罰則は<a href="/column/jusuisou-seisou-batsu/">受水槽清掃を怠るとどうなる？水道法・建築物衛生法の罰則と、指示・命令の流れ</a>で確認できます。</p>
      </section>

      <div class="cl-cta">
        <h2>受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/">無料で清掃業者を探す</a>
      </div>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          {faqItems.map((f) => (<div class="cl-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
        </dl>
      </section>

      <div class="cl-pref-links">
        <h2 class="cl-pref-h">エリア別の受水槽清掃業者を探す</h2>
        <ul class="cl-pref-list">
          <li><a href="/jusuisou-seisou/tokyo/">東京都</a></li>
          <li><a href="/jusuisou-seisou/osaka/">大阪府</a></li>
          <li><a href="/jusuisou-seisou/kanagawa/">神奈川県</a></li>
          <li><a href="/jusuisou-seisou/aichi/">愛知県</a></li>
          <li><a href="/jusuisou-seisou/saitama/">埼玉県</a></li>
          <li><a href="/jusuisou-seisou/fukuoka/">福岡県</a></li>
        </ul>
        <p class="cl-pref-more"><a href="/jusuisou-seisou/">全国の対応業者を見る</a></p>
      </div>

      <aside class="cl-related">
        <h2 class="cl-related-h">関連サービス・コラム</h2>
        <ul>
          <li><a href="/jusuisou-seisou/">受水槽清掃の業者を一括見積比較</a></li>
          <li><a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト</a></li>
          <li><a href="/column/jusuisou-seisou-horei-gimu/">受水槽清掃の法定義務ガイド</a></li>
          <li><a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場</a></li>
        </ul>
      </aside>

      <aside class="cl-glossary-block">
        <h2 class="cl-glossary-h">📖 この記事に出てくる主な用語</h2>
        <ul class="cl-glossary-list">
          <li><a href="/glossary/#kenchiku-suiso-seisogyo">建築物飲料水貯水槽清掃業</a></li>
          <li><a href="/glossary/#suido-ho">水道法</a></li>
          <li><a href="/glossary/#biru-kan-ho">建築物衛生法（ビル管法）</a></li>
          <li><a href="/glossary/#kanni-senyou-suido">簡易専用水道</a></li>
        </ul>
        <p class="cl-glossary-more"><a href="/glossary/">施設管理用語集をすべて見る</a></p>
      </aside>
    </div>
  </article>
</BaseLayout>

