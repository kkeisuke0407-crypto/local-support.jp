---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = "ダクト清掃を怠ると…厨房火災と消防法違反のリスク2026｜火災事例と保険免責";
const description = "厨房ダクト未清掃が原因の火災事例・消防法上の防火管理義務違反の罰則・火災保険の免責事由を解説。グリス蓄積による火災メカニズム・実際の出火件数・損害額・賠償責任まで2026年版で施設管理者向けに整理。";
const canonical = `${site.domain}/column/duct-batsu/`;
const published = '2026-05-27';
const modified = '2026-05-27';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: "ダクト清掃の違反・火災", item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 3200,
  articleSection: "違反・罰則",
  keywords: "ダクト清掃,火災,消防法違反,防火管理,保険免責,損害賠償,2026",
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@type': 'Organization', name: site.org.legalName, url: site.domain, logo: { '@type': 'ImageObject', url: `${site.domain}/og-default.png` } },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-duct.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: "ダクト清掃" },
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: "清掃証明書がないと火災保険は出ませんか？", acceptedAnswer: { '@type': 'Answer', text: "完全に出ない訳ではありませんが、管理義務違反の証拠として保険会社から免責主張を受けやすくなります。少なくとも直近3〜5年分の清掃記録は確実に保管してください。" } },
    { '@type': 'Question', name: "テナント側と建物オーナーで責任はどう分かれますか？", acceptedAnswer: { '@type': 'Answer', text: "厨房を使用するテナントが防火管理義務を負うのが原則ですが、共用ダクト部分はオーナー責任となる場合があります。賃貸借契約書で清掃義務の帰属を明確化しておきましょう。" } },
    { '@type': 'Question', name: "消防署の立入検査で何を見られますか？", acceptedAnswer: { '@type': 'Answer', text: "①防火管理者選任届、②消防計画、③ダクト・グリスフィルターの状況、④清掃記録（直近実施日）、⑤防火ダンパーの作動状況、が主な確認項目です。" } },
    { '@type': 'Question', name: "小規模店舗でも防火管理義務はありますか？", acceptedAnswer: { '@type': 'Answer', text: "収容人員30人未満は防火管理者選任義務はありませんが、ダクトの維持管理は店舗運営者の責務として残ります。失火時の責任を免れる訳ではありません。" } },
    { '@type': 'Question', name: "火災を起こしてしまった場合の初動は？", acceptedAnswer: { '@type': 'Answer', text: "①119番通報と初期消火、②従業員・客の避難誘導、③保険会社への速報、④消防署への事後協力、⑤書類（清掃記録・契約書・保険証券）の整理、の順で対応してください。" } },
    { '@type': 'Question', name: "隣接テナントへの賠償責任はありますか？", acceptedAnswer: { '@type': 'Answer', text: "失火責任法により「軽過失」は免責されますが、「重過失」（清掃を著しく怠った場合等）は隣接テナントへの賠償責任が発生します。判例では数百万〜数千万円の賠償命令例があります。" } }
  ],
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.faq-q', '.faq-a'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-default.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified}
