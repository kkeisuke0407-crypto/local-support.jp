---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = 'マンションの受水槽清掃ガイド｜管理組合の義務・費用の例・理事会と住民周知の進め方';
const description = 'マンション管理組合・賃貸オーナー向けに、受水槽清掃の法律上の義務（10m³超の簡易専用水道、10m³以下の条例・指導）、公開料金表で見る費用の例、理事会での進め方、住民へのお知らせの文例、管理会社に委託している場合の確認点を、条文と公開資料で確認して整理しました。';
const canonical = `${site.domain}/column/jusuisou-seisou-mansion/`;
const published = '2026-06-14';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: 'マンションの受水槽清掃', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '施設管理ガイド',
  keywords: 'マンション,受水槽清掃,管理組合,理事会,住民周知,断水,簡易専用水道,費用',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
});

const faqItems = [
  { q: 'マンションの受水槽清掃はいくらかかりますか？', a: '受水槽の容量で決まります。アパート・マンション向けに料金表を公開している清掃会社の例では、受水槽5トンで42,000円、10トンで47,000円（税抜・水質検査込み・出張諸経費6,500円別）、高置水槽は3トンまで16,000円です（たてものサービス）。容量は水槽の銘板で確認できます。' },
  { q: '清掃中の断水はどのくらいですか？', a: '同じ会社の案内では、一般的なアパート・マンション（3〜10トン程度）でおおむね2〜3時間とされています。水槽の大きさや汚れで変わるため、見積りの段階で見込みを確認してください。' },
  { q: '10m³以下の小さな受水槽でも清掃は必要ですか？', a: '水道法の簡易専用水道（10m³超）には当たりませんが、東京都の条例のように小規模な受水槽にも清掃を求める自治体や、大阪府・大阪市のように指導要領・要綱で年1回の清掃をお願いしている自治体があります。所在地の保健所で確認してください。' },
  { q: '管理会社に委託していれば、組合は何もしなくてよいですか？', a: '水道法の義務を負うのは簡易専用水道の「設置者」で、管理会社に委託しても義務を負う人は変わりません。清掃の報告書や法定検査の結果を毎年受け取り、理事会で確認しておくと安心です。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>マンションの受水槽清掃</span>
        </nav>
        <span class="cl-cat">受水槽清掃</span>
        <h1 class="cl-title">マンションの受水槽清掃ガイド｜管理組合の義務・費用の例・理事会と住民周知の進め方</h1>
        <p class="cl-lead">
          マンションの受水槽清掃は、<strong>法律上の義務</strong>に加えて、<strong>理事会での決定</strong>と<strong>住民への断水のお知らせ</strong>が欠かせません。この記事では、管理組合・オーナーが押さえておきたい義務、公開料金表で見る費用の例、理事会と住民周知の進め方を整理します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月14日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. マンションの受水槽清掃は、何をすればよいですか？</p>
        <p class="cl-qa-a">A. 受水槽の有効容量が10m³を超えるなら、<strong>毎年1回以上の清掃と、登録検査機関などの検査（毎年1回以上）</strong>が水道法で必要です。10m³以下でも自治体の条例や指導で清掃が求められることがあります。費用は容量で決まり、公開料金表の例では<strong>10トンで47,000円（税抜・水質検査込み、出張費別）</strong>です。</p>
        <p class="cl-qa-src">※水道法第34条の2・施行規則第55条・第56条、たてものサービスの公開料金表による（2026年9月確認）</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#duty">管理組合の義務</a></li>
          <li><a href="#cost">費用の例</a></li>
          <li><a href="#riji">理事会での進め方</a></li>
          <li><a href="#notice">住民へのお知らせ（文例）</a></li>
          <li><a href="#kanri">管理会社に委託している場合</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="duty" class="cl-section">
        <h2>管理組合の義務</h2>
        <ul>
          <li><strong>有効容量10m³超（簡易専用水道）</strong>：水槽の掃除を毎年1回以上（水道法施行規則第55条）、登録検査機関などの検査を毎年1回以上（同第56条）。検査を受けないと100万円以下の罰金の対象です（水道法第54条）</li>
          <li><strong>有効容量10m³以下</strong>：水道法の簡易専用水道には当たりませんが、東京都の条例（特定小規模貯水槽水道等）や、大阪府・大阪市の指導要領・要綱のように、清掃を求める自治体があります</li>
        </ul>
        <p>義務を負うのは簡易専用水道の<strong>設置者</strong>で、マンションでは多くの場合、管理組合（賃貸マンションではオーナー）です。自分のマンションがどれに当たるかは<a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a>で確認できます。怠った場合の流れは<a href="/column/jusuisou-seisou-batsu/">受水槽清掃を怠るとどうなる？水道法・建築物衛生法の罰則と、指示・命令の流れ</a>で解説しています。</p>
      </section>

      <section id="cost" class="cl-section">
        <h2>費用の例</h2>
        <p>アパート・マンションの共用部の管理を専門にする清掃会社の公開料金表（税抜・水質検査10項目込み）の例です。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>たてものサービスの受水槽清掃の料金（単位：円・税抜）</caption>
            <thead><tr><th>容量</th><th>受水槽</th><th>高置水槽</th></tr></thead>
            <tbody>
              <tr><th scope="row">3トンまで</th><td>40,000</td><td>16,000</td></tr>
              <tr><th scope="row">5トン</th><td>42,000</td><td>20,000</td></tr>
              <tr><th scope="row">10トン</th><td>47,000</td><td>30,000</td></tr>
              <tr><th scope="row">15トン</th><td>57,000</td><td>別途見積り</td></tr>
              <tr><th scope="row">20トン</th><td>67,000</td><td>別途見積り</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cl-note">出典：<a href="https://www.tatemono-s.jp/category/1502322.html" rel="noopener" target="_blank">たてものサービス（東京都）「貯水槽・受水槽清掃の料金表」</a>（2026年9月確認）。別途、出張諸経費6,500円。2槽式・複数基は1槽33,000円（税抜）から見積り。</p>
        <p>容量は水槽の銘板で確認できます。10m³超の場合は、清掃とは別に法定検査の手数料（例：1系統17,600〜22,000円）もかかります。ほかの会社の例は<a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</a>にまとめています。</p>
      </section>

      <section id="riji" class="cl-section">
        <h2>理事会での進め方</h2>
        <p>業者の選定や費用の支出は、管理規約や細則に沿って理事会などで決めます。一般的な進め方の例です。</p>
        <ol>
          <li><strong>条件をそろえる</strong>：受水槽・高置水槽の容量と数、希望時期、断水できる時間帯を整理する</li>
          <li><strong>見積りを比べる</strong>：水質検査・報告書・出張費・告知の代行が含まれるか、税抜か税込かをそろえて比べる</li>
          <li><strong>決めたことを記録する</strong>：業者名・金額・実施予定日を議事録に残す</li>
          <li><strong>結果を保管する</strong>：清掃の報告書と、10m³超なら法定検査の結果を組合で保管する</li>
        </ol>
        <p>比べるときの項目は<a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト｜見積り前に確認したい8項目</a>にまとめています。</p>
      </section>

      <section id="notice" class="cl-section">
        <h2>住民へのお知らせ（文例）</h2>
        <p>清掃中は多くの場合断水になります。日時・断水の時間帯・事前の準備をお知らせし、掲示板への掲示や各戸への配布で周知します。告知を業者が代行する会社もあるため、見積りの段階で確認しておきましょう。</p>
        <div class="cl-callout">
          <p><strong>【受水槽清掃のお知らせ（文例）】</strong></p>
          <p>居住者各位</p>
          <p>下記のとおり受水槽の清掃を行います。作業中は断水となりますので、ご協力をお願いいたします。</p>
          <ul>
            <li>実施日：○月○日（○）</li>
            <li>断水時間：○時○分〜○時○分（作業の状況により前後します）</li>
            <li>作業会社：○○株式会社</li>
            <li>お願い：断水時間中に使う飲み水・調理用の水は、事前にご用意ください</li>
            <li>清掃後、しばらく水が濁る場合があります。その際は少し水を流してからお使いください</li>
          </ul>
          <p>○○マンション管理組合（連絡先：○○）</p>
        </div>
      </section>

      <section id="kanri" class="cl-section">
        <h2>管理会社に委託している場合</h2>
        <p>管理会社に清掃の手配を委託していても、水道法の義務を負う設置者は変わりません。毎年、次の点を確認しておくと安心です。</p>
        <ul>
          <li><strong>清掃の報告書</strong>：実施日・作業内容・清掃前後の写真が載っているか</li>
          <li><strong>法定検査の結果</strong>：10m³超なら、登録検査機関などの検査を受け、結果が届いているか</li>
          <li><strong>金額の内訳</strong>：清掃・水質検査・出張費などの内訳が分かるか</li>
          <li><strong>指摘事項</strong>：清掃や検査で見つかった不具合と、その後の対応</li>
        </ul>
      </section>

      <div class="cl-cta">
        <h2>マンションの受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/">無料で清掃業者を探す</a>
      </div>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          {faqItems.map((f) => (<div class="cl-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
        </dl>
      </section>

      <div class="cl-pref-links">
        <h2 class="cl-pref-h">エリア別の受水槽清掃業者を探す</h2>
        <ul class="cl-pref-list">
          <li><a href="/jusuisou-seisou/tokyo/">東京都</a></li>
          <li><a href="/jusuisou-seisou/osaka/">大阪府</a></li>
          <li><a href="/jusuisou-seisou/kanagawa/">神奈川県</a></li>
          <li><a href="/jusuisou-seisou/aichi/">愛知県</a></li>
          <li><a href="/jusuisou-seisou/saitama/">埼玉県</a></li>
          <li><a href="/jusuisou-seisou/fukuoka/">福岡県</a></li>
        </ul>
        <p class="cl-pref-more"><a href="/jusuisou-seisou/">全国の対応業者を見る</a></p>
      </div>

      <aside class="cl-related">
        <h2 class="cl-related-h">関連サービス・コラム</h2>
        <ul>
          <li><a href="/jusuisou-seisou/">受水槽清掃の業者を一括見積比較</a></li>
          <li><a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a></li>
          <li><a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場</a></li>
          <li><a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト</a></li>
          <li><a href="/column/jusuisou-seisou-batsu/">受水槽清掃の罰則と、指示・命令の流れ</a></li>
        </ul>
      </aside>

      <aside class="cl-glossary-block">
        <h2 class="cl-glossary-h">📖 この記事に出てくる主な用語</h2>
        <ul class="cl-glossary-list">
          <li><a href="/glossary/#kanni-senyou-suido">簡易専用水道</a></li>
          <li><a href="/glossary/#jusuisou">受水槽／貯水槽</a></li>
          <li><a href="/glossary/#koukasuisou">高架水槽</a></li>
        </ul>
        <p class="cl-glossary-more"><a href="/glossary/">施設管理用語集をすべて見る</a></p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
