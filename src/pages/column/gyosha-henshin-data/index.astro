---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { site } from '../../../data/site';

const title = '業者に問い合わせても返事が来ない？施設管理の業者266社に問い合わせた実データ';
const description = '点検・清掃・工事の業者266社に問い合わせたところ、返信があったのは4社に1社（26%）。返信する会社の78%は当日か翌日に返してきました。サービス別・連絡手段別の返信率、返事を待つ目安、業者探しで返信をもらうコツを、ロカサポの実際の問い合わせ記録から集計しました。';
const canonical = `${site.domain}/column/gyosha-henshin-data/`;
const published = '2026-09-25';
const modified = '2026-09-25';

const faqItems = [
  {
    q: '業者に見積もりや問い合わせを送って、返事が来ないのは普通ですか？',
    a: '珍しくありません。ロカサポが2026年6〜9月に施設管理の業者266社へ問い合わせた記録では、連絡がついた250社のうち返信があったのは66社（26%）でした。4社のうち3社からは、断りの連絡も含めて何の返事もなかったことになります。',
  },
  {
    q: '業者からの返事は何日くらい待てばよいですか？',
    a: '3日を目安に、次の業者に当たるのがおすすめです。返信の日付が分かる51件のうち、78%（40件）は問い合わせの当日か翌日に届いていました。4日目以降に届いたのは10件で、2週間以上かかったものもあります。期限がある場合は、待つより先に別の業者へ並行して問い合わせたほうが確実です。',
  },
  {
    q: 'メールと問い合わせフォームでは、どちらが返事をもらいやすいですか？',
    a: 'ロカサポの記録では、問い合わせフォームからの返信率が36%（94社中34社）、メールが18%（152社中28社）でした。ただしメールの宛先には公的な登録簿に載っている代表アドレスが多く、フォームのある会社はWebでの受付に慣れている可能性があるため、連絡手段だけの差とは言い切れません。業者のサイトに問い合わせフォームがあれば、そちらを使うのが無難です。',
  },
  {
    q: '何社くらいに問い合わせれば、対応してくれる業者が見つかりますか？',
    a: 'ロカサポの記録では、「対応できる」と答えたのは連絡がついた250社のうち32社（13%）で、1件の相談あたり平均13社に問い合わせて、対応できる業者は平均1.7社でした。サービスや地域で差が大きく、看板点検や建築物の定期調査のように返信率が10%台のサービスもあります。相見積もりを取りたいなら、最初から10社前後に当たるつもりで始めると安心です。',
  },
  {
    q: 'このデータを引用してもよいですか？',
    a: '出典として「ロカサポ（local-support.jp）」とこのページへのリンクを明記していただければ、記事や資料で自由に引用いただけます。',
  },
];

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '業者266社に問い合わせた実データ', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5000,
  articleSection: '施設管理ガイド',
  keywords: '業者,見積もり,返事が来ない,返信率,問い合わせ,相見積もり,施設管理,点検業者,業者探し',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-default.png`, width: 1200, height: 630 },
});

const datasetLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: '施設管理の業者への問い合わせと返信の記録（2026年6〜9月）',
  description: '施設管理の業者紹介サービス「ロカサポ」が、2026年6月19日から9月24日までに受けた19件の相談で、点検・清掃・工事の業者266社へ送った問い合わせと、その返信の有無・返信までの日数・回答内容を集計したもの。サービス別・連絡手段別の返信率を含む。',
  url: canonical,
  temporalCoverage: '2026-06-19/2026-09-24',
  spatialCoverage: { '@type': 'Place', name: '日本' },
  creator: { '@id': `${site.domain}/#organization` },
  variableMeasured: ['問い合わせ数', '返信率', '対応可能と回答した割合', '返信までの日数', 'サービス別返信率', '連絡手段別返信率'],
  isAccessibleForFree: true,
  inLanguage: 'ja-JP',
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-default.png` },
});
---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, datasetLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>業者266社に問い合わせた実データ</span>
        </nav>
        <span class="cl-cat">施設管理ガイド</span>
        <h1 class="cl-title">業者に問い合わせても返事が来ない？施設管理の業者266社に問い合わせた実データ</h1>
        <p class="cl-lead">
          「見積もりを頼んだのに返事が来ない」「何社に連絡すれば足りるのか分からない」。施設の点検や清掃の業者を探していると、こうした壁によく当たります。ロカサポでは依頼者の代わりに業者へ問い合わせをしており、その記録が<strong>266社分</strong>たまりました。この記事では、<strong>何割の業者が返事をくれるのか、何日待てばよいか、どうすれば返事をもらいやすいか</strong>を、実際の数字で整理します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年9月25日</time>
          <span>最終更新：2026年9月25日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a>（{site.author.role}）</span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 業者に問い合わせると、どのくらい返事が来るものですか？</p>
        <p class="cl-qa-a">A. <strong>返事が来るのは4社に1社（26%）でした。</strong>連絡がついた250社のうち返信は66社、「対応できる」と答えたのは32社（13%）。返信する会社の78%は当日か翌日に返してくるため、<strong>3日たって返事がなければ次の業者に当たる</strong>のが現実的です。</p>
        <p class="cl-qa-src">※ロカサポが2026年6月19日〜9月24日に受けた19件の相談で、業者266社へ送った問い合わせの集計（2026年9月時点）。</p>
      </div>

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#method">調べ方</a></li>
          <li><a href="#rate">返事が来たのは4社に1社</a></li>
          <li><a href="#speed">返事は「当日か翌日」に集中する</a></li>
          <li><a href="#service">サービスによって返信率は5倍違う</a></li>
          <li><a href="#channel">フォームとメールで返信率に差</a></li>
          <li><a href="#tips">返事をもらうための5つのコツ</a></li>
          <li><a href="#limits">このデータの注意点</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>返信率</strong>：連絡がついた250社のうち、返事があったのは66社（26%）。対応できると答えたのは32社（13%）</li>
            <li><strong>スピード</strong>：返信の78%は当日か翌日。3日を過ぎたら、待つより次の業者に当たる</li>
            <li><strong>差</strong>：害虫駆除は47%が返信する一方、看板点検は10%。サービスによって何社に当たるべきかが大きく変わる</li>
          </ul>
        </div>
      </section>

      <section id="method" class="cl-section">
        <h2>調べ方</h2>
        <p>ロカサポは、施設の点検・清掃・工事などを探している事業者や管理者から相談を受け、条件に合いそうな業者に「この案件に対応できるか」を問い合わせています。この記事の数字は、その問い合わせの記録をそのまま集計したものです。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>集計の対象</caption>
            <tbody>
              <tr><th scope="row">期間</th><td>2026年6月19日〜9月24日（問い合わせを送った日）</td></tr>
              <tr><th scope="row">相談の件数</th><td>19件（消防設備点検、害虫駆除、看板点検、受水槽清掃、エレベーター保守、建築物の定期調査など）</td></tr>
              <tr><th scope="row">問い合わせた業者</th><td>266社（うち宛先不明・送信エラー・電話不通の16社を除く<strong>250社</strong>を集計の母数にしています）</td></tr>
              <tr><th scope="row">連絡手段</th><td>メール152社、問い合わせフォーム94社、そのほか4社</td></tr>
              <tr><th scope="row">「返信あり」の定義</th><td>対応できる・辞退する・資料がほしいなど、内容を問わず何らかの返事があったもの（自動返信は含めない）</td></tr>
              <tr><th scope="row">業者の選び方</th><td>物件の所在地から通える範囲で、そのサービスを扱っている会社。公的な登録簿、業界団体の会員名簿、各社のWebサイトから探しました</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="rate" class="cl-section">
        <h2>返事が来たのは4社に1社</h2>
        <p>連絡がついた250社のうち、何らかの返事があったのは<strong>66社（26%）</strong>でした。残りの184社からは、断りの連絡も含めて返事がありませんでした。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>問い合わせへの回答の内訳（母数：連絡がついた250社）</caption>
            <thead><tr><th>回答</th><th>社数</th><th>割合</th></tr></thead>
            <tbody>
              <tr><th scope="row">対応できる</th><td>32社</td><td><span class="cl-bar" style="--w:13%"></span>13%</td></tr>
              <tr><th scope="row">辞退・対象外</th><td>26社</td><td><span class="cl-bar" style="--w:10%"></span>10%</td></tr>
              <tr><th scope="row">そのほかの返事（資料請求・担当者から連絡予定など）</th><td>8社</td><td><span class="cl-bar" style="--w:3%"></span>3%</td></tr>
              <tr><th scope="row">返事なし</th><td>184社</td><td><span class="cl-bar cl-bar--muted" style="--w:74%"></span>74%</td></tr>
            </tbody>
          </table>
        </div>
        <p>相談1件あたりに直すと、<strong>平均13社に問い合わせて、対応できると答えた業者は平均1.7社</strong>です。「3社から相見積もりを取りたい」と思って3〜4社に連絡しても、1社も返事が来ないことは十分にありえます。</p>
        <p>辞退の理由として多かったのは、「対応エリアの外」「人手が足りず新規の受付を止めている」「その設備や作業は扱っていない」の3つでした。辞退の連絡をくれる会社は、条件が合えば次の機会に頼れる相手でもあります。</p>
      </section>

      <section id="speed" class="cl-section">
        <h2>返事は「当日か翌日」に集中する</h2>
        <p>返信の日付が分かる51件で、問い合わせから返事までの日数を数えました。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>問い合わせから返信までの日数（返信51件）</caption>
            <thead><tr><th>日数</th><th>件数</th><th>割合</th></tr></thead>
            <tbody>
              <tr><th scope="row">当日</th><td>26件</td><td><span class="cl-bar" style="--w:51%"></span>51%</td></tr>
              <tr><th scope="row">翌日</th><td>14件</td><td><span class="cl-bar" style="--w:27%"></span>27%</td></tr>
              <tr><th scope="row">2〜3日後</th><td>1件</td><td><span class="cl-bar" style="--w:2%"></span>2%</td></tr>
              <tr><th scope="row">4〜7日後</th><td>5件</td><td><span class="cl-bar" style="--w:10%"></span>10%</td></tr>
              <tr><th scope="row">8〜14日後</th><td>4件</td><td><span class="cl-bar" style="--w:8%"></span>8%</td></tr>
              <tr><th scope="row">15日以上</th><td>1件</td><td><span class="cl-bar" style="--w:2%"></span>2%</td></tr>
            </tbody>
          </table>
        </div>
        <p>返事をくれる会社の<strong>およそ4社に3社は、当日か翌日</strong>に返しています。2〜3日後の返信はほとんどなく、それより遅いものは1〜2週間後にぽつぽつ届く形でした。遅い返信には、こちらから再送や確認の連絡を入れたあとに届いたものが目立ちました。</p>
        <p>つまり、<strong>3日たっても返事がない業者は、しばらく返事が来ないと考えて次に当たる</strong>のが効率的です。報告期限や工事日程が決まっているなら、最初から複数社に並行して問い合わせてください。</p>
      </section>

      <section id="service" class="cl-section">
        <h2>サービスによって返信率は5倍違う</h2>
        <p>同じように問い合わせても、サービスによって返信率に大きな差がありました。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>サービス別の返信率（母数：連絡がついた社数）</caption>
            <thead><tr><th>サービス</th><th>問い合わせ</th><th>返信</th><th>返信率</th></tr></thead>
            <tbody>
              <tr><th scope="row"><a href="/pest-control/">害虫駆除</a></th><td>30社</td><td>14社</td><td><span class="cl-bar" style="--w:47%"></span>47%</td></tr>
              <tr><th scope="row"><a href="/shobo-setsubi/">消防設備点検</a>・<a href="/bouka-tenken/">防火対象物点検</a></th><td>46社</td><td>16社</td><td><span class="cl-bar" style="--w:35%"></span>35%</td></tr>
              <tr><th scope="row">受水槽清掃・ダクト清掃・太陽光パネル清掃・オフィス移転</th><td>46社</td><td>15社</td><td><span class="cl-bar" style="--w:33%"></span>33%</td></tr>
              <tr><th scope="row"><a href="/jikayou-denki/">キュービクル点検</a>・エレベーター保守・フロン点検</th><td>49社</td><td>12社</td><td><span class="cl-bar" style="--w:24%"></span>24%</td></tr>
              <tr><th scope="row">建築物の定期調査</th><td>31社</td><td>4社</td><td><span class="cl-bar" style="--w:13%"></span>13%</td></tr>
              <tr><th scope="row"><a href="/signboard-inspection/">看板・屋外広告物点検</a></th><td>48社</td><td>5社</td><td><span class="cl-bar" style="--w:10%"></span>10%</td></tr>
            </tbody>
          </table>
        </div>
        <h3>返事をもらいやすいサービス：害虫駆除・消防設備点検</h3>
        <p>害虫駆除や消防設備点検は、点検や駆除そのものを本業にしている専門会社が多く、問い合わせ窓口も整っています。飲食店や事務所からの依頼に慣れていて、「対応できるか」の判断が早いのも特徴です。</p>
        <h3>返事をもらいにくいサービス：看板点検・建築物の定期調査</h3>
        <p>看板の点検は、看板を作って取り付ける会社が本業のかたわらで受けていることが多く、点検だけの問い合わせに答える体制がない会社が目立ちました。建築物の定期調査も返信率は10%台にとどまりました。調査の担い手は建築士事務所が中心で、設計の仕事と並行して受けているため、新しい問い合わせに手が回りにくいと考えられます。</p>
        <p>こうしたサービスでは、<strong>20社以上に当たってようやく1〜2社</strong>という前提で動く必要があります。</p>
      </section>

      <section id="channel" class="cl-section">
        <h2>フォームとメールで返信率に差</h2>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>連絡手段別の返信率</caption>
            <thead><tr><th>連絡手段</th><th>問い合わせ</th><th>返信</th><th>返信率</th></tr></thead>
            <tbody>
              <tr><th scope="row">問い合わせフォーム</th><td>94社</td><td>34社</td><td><span class="cl-bar" style="--w:36%"></span>36%</td></tr>
              <tr><th scope="row">メール</th><td>152社</td><td>28社</td><td><span class="cl-bar" style="--w:18%"></span>18%</td></tr>
            </tbody>
          </table>
        </div>
        <p>問い合わせフォームからの返信率は、メールのおよそ2倍でした。ただし、この差がすべて連絡手段によるものとは言えません。メールの宛先には公的な登録簿に載っている代表アドレスが多く含まれ、ふだん確認されていないアドレスもあったと考えられます。一方でフォームを用意している会社は、Webからの問い合わせを受ける体制がもともと整っている会社です。</p>
        <p>それでも、<strong>業者のWebサイトに問い合わせフォームがあるなら、フォームから送る</strong>ほうが返事をもらえる見込みは高いと言えます。</p>
      </section>

      <section id="tips" class="cl-section">
        <h2>返事をもらうための5つのコツ</h2>
        <p>266社への問い合わせで分かったことを、業者を自分で探すときのコツにまとめました。</p>
        <ol>
          <li><strong>最初から10社前後に当たる</strong>：返信率26%、対応できるのは13%です。3社から比べたいなら、10社以上に問い合わせるつもりで始めてください</li>
          <li><strong>3日で見切って、次に進む</strong>：返信の78%は当日か翌日に届きます。3日待って返事がなければ、並行して別の業者に当たりましょう</li>
          <li><strong>フォームがあればフォームで送る</strong>：代表メールより、問い合わせフォームのほうが担当者に届きやすい傾向がありました</li>
          <li><strong>物件の近くに拠点がある会社から当たる</strong>：辞退の理由で多かったのは「対応エリアの外」でした。所在地の市区町村や隣の市に拠点がある会社を優先すると、無駄打ちが減ります</li>
          <li><strong>最初の問い合わせは短く、期限を書く</strong>：建物の種類・所在地・やりたいこと・期限の4点があれば、業者は対応できるかを判断できます。細かい条件は、対応できると返事をくれた会社と詰めれば十分です</li>
        </ol>
      </section>

      <div class="cl-cta">
        <h2>業者に当たる手間を、まるごと任せませんか</h2>
