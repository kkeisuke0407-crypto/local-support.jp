---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = 'エレベーター保守点検の法定義務ガイド2026｜建築基準法第12条と所有者責任';
const description = 'エレベーター（昇降機）に課された建築基準法第12条による定期検査報告（年1回）・保守点検（月1回が標準）の義務を整理。一次下請（メーカー系）vs 独立系（メンテナンス業者）の選択肢、フルメンテナンス契約とPOG契約の違い、違反時の100万円以下の罰金、事故時の所有者責任まで2026年版で施設管理担当者向けに解説。';
const canonical = `${site.domain}/column/elevator-hoshu-horei-gimu/`;
const published = '2026-06-05';
const modified = '2026-06-05';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: 'エレベーター保守点検の法定義務ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5400,
  articleSection: '法令・義務',
  keywords: 'エレベーター保守点検,建築基準法第12条,昇降機,定期検査報告,POG契約,フルメンテナンス,2026',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-elevator-hoshu.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: 'エレベーター保守点検' },
  citation: [
    { '@type': 'Legislation', name: '建築基準法第12条第3項（昇降機の定期検査）' },
    { '@type': 'Legislation', name: '建築基準法施行令第129条の3〜第129条の13' },
    { '@type': 'Legislation', name: '建築基準法第101条（罰則）' },
  ],
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'エレベーターの保守点検は法律で義務ですか？', acceptedAnswer: { '@type': 'Answer', text: '建築基準法第12条第3項により、すべてのエレベーター（昇降機）所有者・管理者に「定期検査報告」が義務付けられています（年1回）。法令上は「保守点検」と「定期検査報告」は別概念ですが、実務では月1回の保守点検により安全性を維持し、年1回の定期検査で第三者検査を受ける運用が標準です。' } },
    { '@type': 'Question', name: '定期検査と保守点検の違いは？', acceptedAnswer: { '@type': 'Answer', text: '定期検査は建築基準法に基づく年1回の法定検査で、特定の有資格者（昇降機等検査員等）が実施し特定行政庁に報告。保守点検は所有者・管理者の自主的な維持管理活動で、法令上の頻度規定はないが業界標準で月1回が一般的。両者は実施者・頻度・報告先が異なる別制度です。' } },
    { '@type': 'Question', name: 'POG契約とフルメンテナンス契約の違いは？', acceptedAnswer: { '@type': 'Answer', text: 'POG契約（Parts, Oil and Grease）は基本的な点検・調整のみで、部品交換・修理は別料金。月額費用は安いが、突発的な高額負担リスクがある。フルメンテナンス契約は部品交換・修理を含む包括契約。月額費用が高い分、長期的なコスト予測が立てやすく、突発負担リスクが少ない。' } },
    { '@type': 'Question', name: '保守点検業者は誰でも選べますか？', acceptedAnswer: { '@type': 'Answer', text: 'はい、所有者・管理者の判断で業者選択可能。設置メーカーの一次下請（メーカー系）と、複数メーカー機種に対応する独立系メンテナンス業者の2系統があり、独立系は月額料金が30〜50%安い傾向。ただし古い機種や特殊機種では、メーカー系のほうが部品調達・技術情報の優位性があります。' } },
    { '@type': 'Question', name: '違反した場合の罰則は？', acceptedAnswer: { '@type': 'Answer', text: '定期検査報告の未実施・虚偽報告は100万円以下の罰金（建築基準法第101条）。重大な事故（人身事故）が発生した場合は業務上過失致死傷罪（刑法）の対象。所有者・管理者個人への責任追及の可能性があります。特定行政庁の改善命令違反は別途罰則（1年以下の懲役または100万円以下の罰金）があります。' } },
    { '@type': 'Question', name: '昇降機等検査員とは何ですか？', acceptedAnswer: { '@type': 'Answer', text: '建築基準法に基づく定期検査報告を実施できる国家資格者。「特定建築物調査員」「昇降機等検査員」「建築設備検査員」などの資格があり、エレベーターは「昇降機等検査員」または「特定建築物調査員」が実施します。エレベーター業者の多くが資格者を社内に抱えています。' } },
    { '@type': 'Question', name: 'エレベーターの法定耐用年数はありますか？', acceptedAnswer: { '@type': 'Answer', text: '建築基準法上の明確な耐用年数規定はありませんが、税法上の法定耐用年数（17年）が一つの目安。実務では「20年で大規模修繕（リニューアル）の検討開始」「30年で全交換」が一般的なサイクル。古いエレベーターほど部品調達が困難になり、保守費用が上昇するため、計画的な更新が重要です。' } },
    { '@type': 'Question', name: '記録の保管期間は？', acceptedAnswer: { '@type': 'Answer', text: '定期検査報告書の控え・保守点検記録は3年間保管が義務付けられています。事故・故障時の管理状況の証明資料として重要なため、可能な限り長期保管（永久保存）が推奨されます。電子データでの保管も可能です。' } },
    { '@type': 'Question', name: '小規模建物のエレベーターも対象ですか？', acceptedAnswer: { '@type': 'Answer', text: 'はい、すべてのエレベーターが対象です。3階建ての小規模ビルでも、住宅用エレベーター（ホームエレベーター）でも、建築基準法第12条の対象。小規模だから対象外という例外規定はありません。マンション・ビル・店舗・工場等、用途に関わらず点検報告義務があります。' } }
  ],
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${site.domain}/#website` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-elevator-hoshu.png` },
});

---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}
>
  <article class="cl-article">

    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a>
          <span aria-hidden="true">›</span>
          <a href="/column/">コラム</a>
          <span aria-hidden="true">›</span>
          <span>エレベーター保守点検の法定義務ガイド</span>
        </nav>
        <span class="cl-cat">法令・義務</span>
        <h1 class="cl-title">エレベーター保守点検の法定義務ガイド2026｜建築基準法第12条と所有者責任</h1>
        <p class="cl-lead">
          エレベーター（昇降機）の所有者・管理者には、<strong>建築基準法第12条第3項により「定期検査報告」（年1回）が義務付けられて</strong>います。本記事では、定期検査と保守点検の違い、業界標準の月1回保守点検、POG契約とフルメンテナンス契約の選び方、メーカー系と独立系業者の比較、違反時の罰則・事故時の所有者責任まで、施設管理担当者向けに2026年版で整理しました。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月5日</time>
          <span>最終更新：2026年6月5日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a>（{site.author.role}）</span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. エレベーターの法定義務は何ですか？</p>
        <p class="cl-qa-a">A. <strong>建築基準法第12条第3項により年1回の「定期検査報告」が義務</strong>。昇降機等検査員等の有資格者が実施し、特定行政庁に報告。違反は100万円以下の罰金。実務では月1回の保守点検（法令義務ではないが業界標準）を併用するのが標準。</p>
        <p class="cl-qa-src">※建築基準法第12条第3項・第101条（2026年4月時点）</p>
      </div>

      <ColumnCtaCard serviceSlug="elevator-hoshu" serviceName="エレベーター保守点検" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#scope">対象設備（昇降機の範囲）</a></li>
          <li><a href="#difference">定期検査と保守点検の違い</a></li>
          <li><a href="#contract">POG契約 vs フルメンテナンス契約</a></li>
          <li><a href="#vendor">メーカー系 vs 独立系業者</a></li>
          <li><a href="#periodic">定期検査の内容</a></li>
          <li><a href="#monthly">月次保守点検の内容</a></li>
          <li><a href="#penalties">違反時の罰則と事故責任</a></li>
          <li><a href="#tips">実務上のポイント</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>対象</strong>：すべてのエレベーター（昇降機）。マンション・ビル・店舗・工場・住宅問わず</li>
            <li><strong>義務</strong>：年1回の定期検査報告（建築基準法）。実務では月1回の保守点検（業界標準）も併用</li>
            <li><strong>違反リスク</strong>：100万円以下の罰金。重大な人身事故時は業務上過失致死傷罪、所有者個人への責任追及の可能性</li>
          </ul>
        </div>
      </section>

      <section id="scope" class="cl-section">
        <h2>対象設備（昇降機の範囲）</h2>
        <p>建築基準法上の「昇降機」は、人または貨物を運搬するすべての機械装置を指します。</p>

        <h3>対象となる昇降機の種類</h3>
        <ul>
          <li><strong>エレベーター</strong>：乗用・人荷共用・貨物用・自動車用</li>
          <li><strong>エスカレーター</strong>：駅・商業施設・公共施設のもの</li>
          <li><strong>小荷物専用昇降機（ダムウェーター）</strong>：料理店等の食事運搬用</li>
        </ul>

        <h3>用途別の典型例</h3>
        <ul>
          <li>マンション（4階建以上が一般的）</li>
          <li>事務所ビル（小規模ビルから超高層まで）</li>
          <li>商業施設・百貨店・スーパー</li>
          <li>病院・福祉施設・介護施設</li>
          <li>ホテル・旅館</li>
          <li>工場・物流倉庫（フォークリフトが入る大型貨物用）</li>
          <li>住宅用エレベーター（ホームエレベーター）</li>
        </ul>

        <h3>対象外</h3>
        <p>建築基準法上の対象外は、「特殊な機械（産業用ロボットアーム等）」や「人が乗らない自動倉庫の搬送装置」など、極めて限定的です。<strong>一般的なエレベーター・エスカレーターはすべて対象</strong>と理解してください。</p>
      </section>

      <section id="difference" class="cl-section">
        <h2>定期検査と保守点検の違い</h2>
        <p>「定期検査」と「保守点検」は混同されやすいですが、明確に異なる制度です。</p>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>定期検査と保守点検の比較</caption>
            <thead><tr><th>項目</th><th>定期検査</th><th>保守点検</th></tr></thead>
            <tbody>
              <tr><th scope="row">根拠</th><td>建築基準法第12条第3項</td><td>業界標準・自主管理</td></tr>
              <tr><th scope="row">頻度</th><td>年1回（自治体により6ヶ月〜1年）</td><td>月1回（標準）</td></tr>
              <tr><th scope="row">実施者</th><td>昇降機等検査員等の有資格者</td><td>保守点検業者の技術者</td></tr>
              <tr><th scope="row">報告先</th><td>特定行政庁（自治体）</td><td>所有者・管理者のみ（行政報告なし）</td></tr>
              <tr><th scope="row">目的</th><td>法令適合性の第三者確認</td><td>故障予防・安全性維持</td></tr>
              <tr><th scope="row">罰則</th><td>未実施・虚偽報告は100万円以下の罰金</td><td>法令罰則なし（事故時の責任問題はあり）</td></tr>
            </tbody>
          </table>
        </div>

        <h3>定期検査は第三者検査</h3>
        <p>定期検査の特徴は<strong>「保守点検業者ではない第三者」</strong>が検査することです。保守点検業者の自社検査では客観性が担保されないため、別の有資格者が検査し、特定行政庁に報告する仕組みになっています。</p>

        <h3>実務上は保守点検業者が両方を担うことが多い</h3>
        <p>実務上は<strong>保守点検業者が昇降機等検査員資格を社内に抱え、定期検査も併せて実施</strong>するケースが多くなっています。利益相反の懸念はありますが、効率上一般化しています。第三者検査の徹底を望む所有者は、保守点検と定期検査を別業者に発注することも可能です。</p>
      </section>

      <section id="contract" class="cl-section">
        <h2>POG契約 vs フルメンテナンス契約</h2>
        <p>エレベーターの保守契約は<strong>大きく2種類</strong>に分かれます。費用構造・リスク負担が大きく異なるため、建物特性に応じた選択が重要です。</p>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>POG契約とフルメンテナンス契約の比較</caption>
            <thead><tr><th>項目</th><th>POG契約</th><th>フルメンテナンス契約</th></tr></thead>
            <tbody>
              <tr><th scope="row">月額費用</th><td>2〜8万円程度</td><td>4〜15万円程度</td></tr>
              <tr><th scope="row">含まれる内容</th><td>基本点検・調整、消耗品（オイル・グリス・パーツ一部）</td><td>左記＋部品交換・修理・基本的な改修</td></tr>
              <tr><th scope="row">突発負担</th><td>部品交換・修理時に別途請求（数万〜数百万円）</td><td>原則なし（一部例外あり）</td></tr>
              <tr><th scope="row">予算管理</th><td>年間費用が読みにくい</td><td>年間費用が固定で読みやすい</td></tr>
              <tr><th scope="row">適合建物</th><td>新しいエレベーター（設置10年未満）</td><td>古いエレベーター（10年超）、予算管理重視の管理組合</td></tr>
            </tbody>
          </table>
        </div>

        <h3>POG契約のメリット・デメリット</h3>
        <p><strong>メリット</strong>：新しいエレベーター（10年未満）は故障リスクが低く、POG契約のほうが総額で安く済みます。<br /><strong>デメリット</strong>：古くなると部品交換が頻発し、年間負担が読めない。特に管理組合・マンションでは予算超過のトラブル原因になります。</p>

        <h3>フルメンテナンス契約のメリット・デメリット</h3>
        <p><strong>メリット</strong>：突発負担なしで年間費用が固定。予算管理が容易。古いエレベーター・マンション管理組合に最適。<br /><strong>デメリット</strong>：月額費用がPOGより1.5〜2倍高い。新しいエレベーターでは過剰投資になる場合もあります。</p>

        <h3>選択の目安</h3>
        <p>一般的な目安は<strong>「設置10年未満→POG、10年超→フルメンテナンス」</strong>。ただし建物用途・利用頻度・予算管理方針により判断が異なります。マンション管理組合では予算管理が重要なため、設置初期からフルメンテナンスを選ぶ事例も増えています。</p>
      </section>

      <section id="vendor" class="cl-section">
        <h2>メーカー系 vs 独立系業者</h2>
        <p>エレベーター保守点検業者は、設置メーカーの一次下請（メーカー系）と、独立系メンテナンス業者の2系統に分かれます。</p>

        <h3>メーカー系業者の特徴</h3>
        <ul>
          <li>三菱電機ビルテクノサービス、日立ビルシステム、東芝エレベーター、フジテック、オーチス等</li>
          <li>設置メーカーの一次下請として技術情報・部品調達に優位性</li>
          <li>古い機種・特殊機種への対応力が高い</li>
          <li>月額料金が独立系より30〜50%高い傾向</li>
          <li>大規模建物・特殊機種の点検に強い</li>
        </ul>

        <h3>独立系業者の特徴</h3>
        <ul>
          <li>ジャパンエレベーターサービス、SECエレベーター等</li>
          <li>複数メーカー機種に対応</li>
          <li>月額料金がメーカー系より30〜50%安い</li>
          <li>マンション・小規模ビルへの対応に強い</li>
          <li>古い特殊機種や新型機種では部品調達の課題がある場合あり</li>
        </ul>

        <h3>選択の判断軸</h3>
        <ul>
          <li><strong>新しい標準的なエレベーター</strong>：独立系で十分（コスト優位）</li>
          <li><strong>古い・特殊機種</strong>：メーカー系の技術力が必要</li>
          <li><strong>大規模リニューアル予定</strong>：メーカー系のほうが工事まで一貫対応可能</li>
          <li><strong>予算最優先のマンション管理組合</strong>：独立系で大幅コスト削減</li>
        </ul>
      </section>

      <section id="periodic" class="cl-section">
        <h2>定期検査の内容</h2>
        <p>定期検査は<strong>建築基準法第12条第3項に基づく法定検査</strong>で、年1回（自治体により6ヶ月〜1年）実施されます。</p>

        <h3>主な検査項目</h3>
        <ol>
          <li>かご（人が乗る部分）の構造・寸法・荷重表示</li>
          <li>戸（扉）の開閉・施錠装置の作動</li>
          <li>かご床と乗場床のレベル合わせ</li>
          <li>非常停止装置・非常通報装置の作動</li>
          <li>ブレーキ・ガバナー（調速機）の動作</li>
          <li>主索（ワイヤーロープ）の摩耗・損傷</li>
          <li>巻上機・電動機の状態</li>
          <li>電気設備・配線の絶縁状態</li>
          <li>地震時管制運転装置の作動</li>
          <li>火災時管制運転装置の作動</li>
        </ol>

        <h3>定期検査結果の報告</h3>
        <p>検査結果は<strong>「特定行政庁」（自治体の建築部局）</strong>に「定期検査報告書」として提出。判定は「指摘なし」「要是正」「既存不適格」等の区分で行われます。要是正があれば、所定期間内の改善と改善報告書の提出が必要です。</p>

        <h3>検査費用</h3>
        <p>建物規模・エレベーター台数により異なりますが、おおよそ<strong>1台あたり3万〜10万円</strong>が中心レンジ。保守点検契約に含まれているケースが多いです。</p>
      </section>

      <section id="monthly" class="cl-section">
        <h2>月次保守点検の内容</h2>
        <p>月次保守点検は法令義務ではありませんが、業界標準として月1回の実施が定着しています。</p>

        <h3>主な点検項目</h3>
        <ol>
          <li>かご・乗場の運転状況確認</li>
          <li>扉の開閉動作確認・調整</li>
          <li>運転中の異音・振動の確認</li>
          <li>かご床と乗場床のレベル確認</li>
          <li>機械室内の機器の目視確認</li>
          <li>主索・ロープの摩耗確認</li>
          <li>制御盤・配線の状態確認</li>
          <li>注油・グリスアップ（消耗品の補充）</li>
          <li>清掃・劣化部品の点検</li>
        </ol>

        <h3>遠隔監視システム</h3>
        <p>近年は<strong>「遠隔監視システム」</strong>が普及し、24時間体制でエレベーターの運転状況・故障兆候を監視しています。異常検知時は自動で業者に通報が入り、緊急対応・早期修理に繋がります。月次点検との組み合わせで、故障の予防と早期対応の両立が可能です。</p>

        <h3>故障時の駆けつけ時間</h3>
        <p>業界標準は<strong>30分〜1時間</strong>での現地到着。閉じ込め事故の場合は最優先で対応されます。契約時に「故障時の駆けつけ時間SLA（サービスレベル合意）」を確認しておくと、緊急時の不安を減らせます。</p>
      </section>

      <section id="penalties" class="cl-section">
        <h2>違反時の罰則と事故責任</h2>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>建築基準法（昇降機関連）の主な罰則</caption>
            <thead><tr><th>違反内容</th><th>罰則</th></tr></thead>
            <tbody>
              <tr><th scope="row">定期検査報告未実施</th><td>100万円以下の罰金（第101条）</td></tr>
              <tr><th scope="row">虚偽報告</th><td>100万円以下の罰金</td></tr>
              <tr><th scope="row">特定行政庁の改善命令違反</th><td>1年以下の懲役または100万円以下の罰金</td></tr>
              <tr><th scope="row">無資格者による定期検査</th><td>100万円以下の罰金</td></tr>
              <tr><th scope="row">人身事故発生（管理不備）</th><td>業務上過失致死傷罪（刑法・5年以下の懲役または100万円以下の罰金）</td></tr>
            </tbody>
          </table>
        </div>

        <h3>事故時の所有者責任</h3>
        <p>エレベーター事故は<strong>所有者責任</strong>が問われます。保守点検業者に委託していても、所有者が点検記録を確認せず故障兆候を放置していた場合、共同責任を問われます。重大な人身事故では、所有者個人への刑事責任追及・民事賠償請求がともに発生します。</p>

        <h3>違反発覚のパターン</h3>
        <ul>
          <li>特定行政庁からの定期検査報告督促</li>
          <li>建物売却・改修時の調査</li>
          <li>事故発生時の調査</li>
          <li>利用者からの行政への通報</li>
        </ul>
      </section>

      <section id="tips" class="cl-section">
        <h2>実務上のポイント</h2>

        <h3>契約見直しは更新時期がチャンス</h3>
        <p>エレベーター保守契約は<strong>1〜3年の自動更新</strong>が一般的。更新時期に他社見積もりを取得すれば、現契約業者にも値下げ交渉できます。マンション管理組合では総会前に複数社見積もりを取得し、比較検討するのが標準的なプラクティスです。</p>

        <h3>独立系への切替で大幅コスト削減</h3>
        <p>メーカー系から独立系への切替で<strong>月額料金が30〜50%削減</strong>できる事例が多くあります。古い機種・特殊機種では切替が困難な場合もあるため、事前に独立系業者の対応可否を確認してください。</p>

        <h3>遠隔監視システムの導入を検討</h3>
        <p>遠隔監視システムの導入は、故障兆候の早期発見・故障時の迅速対応に有効です。月額数千円〜数万円の追加費用ですが、緊急対応時の不安解消・閉じ込め事故対応の迅速化に直結します。</p>

        <h3>エレベーター更新の長期計画</h3>
        <p>築20〜25年でリニューアル（部分更新）、30年超で全交換が一般的なサイクル。<strong>古いエレベーターは部品調達が困難になり保守費用が上昇</strong>するため、計画的な長期予算化が重要です。マンション管理組合では修繕積立金の計画にエレベーター更新を組み込んでください。</p>
      </section>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          <div class="cl-faq-item">
            <dt>エレベーターの保守点検は法律で義務ですか？</dt>
            <dd>建築基準法第12条第3項により年1回の「定期検査報告」が義務。実務では月1回の保守点検（業界標準）も併用するのが標準です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>定期検査と保守点検の違いは？</dt>
            <dd>定期検査は年1回の法定検査（特定行政庁に報告）。保守点検は月1回の自主管理（業界標準）。実施者・頻度・報告先が異なります。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>POG契約とフルメンテナンス契約の違いは？</dt>
            <dd>POGは基本点検のみで部品交換は別料金、月額が安い。フルメンテナンスは部品交換含む包括契約で月額が高いが予算管理しやすい。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>保守点検業者は誰でも選べますか？</dt>
            <dd>はい、所有者の判断で選択可能。メーカー系（一次下請）と独立系の2系統があり、独立系は月額が30〜50%安い傾向です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>違反した場合の罰則は？</dt>
            <dd>定期検査報告未実施は100万円以下の罰金。重大事故時は業務上過失致死傷罪の対象になります。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>エレベーターの法定耐用年数はありますか？</dt>
            <dd>建築基準法上の明確な規定はないが、税法上17年。実務では20年でリニューアル検討、30年で全交換が一般的サイクルです。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>記録の保管期間は？</dt>
            <dd>定期検査報告書の控え・保守点検記録は3年間保管が義務。事故時の管理状況の証明資料として長期保管が推奨されます。</dd>
          </div>
        </dl>
      </section>

