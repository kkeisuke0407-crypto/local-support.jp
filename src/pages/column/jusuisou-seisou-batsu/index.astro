---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '受水槽清掃を怠るとどうなる？水道法・建築物衛生法の罰則と、指示・命令の流れ';
const description = '受水槽の清掃や法定検査を怠った場合に、行政から何を求められ、どの段階で罰則の対象になるのかを、水道法・建築物衛生法の条文で確認して整理。簡易専用水道（10m³超）と特定建築物それぞれの流れ、罰則の一覧、清掃が遅れていると気づいたときの対応までまとめました。';
const canonical = `${site.domain}/column/jusuisou-seisou-batsu/`;
const published = '2026-05-27';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '受水槽清掃の違反・罰則', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '法令・義務',
  keywords: '受水槽清掃,罰則,水道法,簡易専用水道,給水停止命令,建築物衛生法,特定建築物,改善命令,法定検査',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
});

const faqItems = [
  { q: '受水槽の清掃をしないと、すぐに罰金になりますか？', a: '清掃をしなかったこと自体に、すぐ罰金が科される規定はありません。簡易専用水道（有効容量10m³超）の場合は、都道府県知事等から清掃などの措置を指示され（水道法第36条第3項）、従わないと給水停止を命じられることがあり（第37条）、この命令に違反すると1年以下の拘禁刑又は100万円以下の罰金です（第53条）。一方、年1回の法定検査を受けないことは、それだけで100万円以下の罰金の対象です（第54条）。' },
  { q: '受水槽清掃を1年以上行っていません。どうすればよいですか？', a: 'まず清掃業者に清掃を依頼し、10m³超の受水槽であれば登録検査機関などの法定検査も受けてください。保健所などから指導を受けている場合は、その内容と期限に沿って対応し、分からない点は保健所に相談してください。' },
  { q: '保健所などから指示や指導を受けました。どう対応すべきですか？', a: '書面に書かれた内容と期限を確認し、期限内に清掃などの措置を行って、求められた方法で報告してください。期限に間に合わない事情がある場合は、早めに指示を出した窓口へ相談してください。' },
  { q: '法律上の責任は誰が負いますか？', a: '水道法では簡易専用水道の「設置者」、建築物衛生法では「特定建築物所有者等」（所有者のほか、維持管理の権原を持つ占有者など）が義務を負います。管理会社に業務を委託していても、義務を負う人が変わるわけではないため、委託先の実施状況と記録を確認しておきましょう。' },
  { q: '10m³以下の受水槽は罰則の対象になりますか？', a: '水道法の簡易専用水道には当たらないため、この記事の水道法の罰則は適用されません。ただし自治体の条例で管理や清掃を定めている場合があります。対象かどうかは「受水槽の義務チェック」で確認できます。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>受水槽清掃の違反・罰則</span>
        </nav>
        <span class="cl-cat">受水槽清掃</span>
        <h1 class="cl-title">受水槽清掃を怠るとどうなる？水道法・建築物衛生法の罰則と、指示・命令の流れ</h1>
        <p class="cl-lead">
          受水槽の清掃を怠ったからといって、すぐに罰金になるわけではありません。多くの場合は<strong>行政からの指示や命令があり、それに従わないときに罰則の対象</strong>になります。一方で、<strong>年1回の法定検査を受けないことは、それだけで罰則の対象</strong>です。この記事では、水道法と建築物衛生法の条文をもとに、その流れと罰則を整理します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年5月27日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 受水槽清掃を怠るとどうなりますか？</p>
        <p class="cl-qa-a">A. 有効容量10m³超の受水槽（簡易専用水道）では、<strong>都道府県知事等から清掃などを指示され、従わないと給水停止を命じられることがあります。この命令に違反すると1年以下の拘禁刑又は100万円以下の罰金</strong>です。また、<strong>年1回の法定検査を受けないと100万円以下の罰金</strong>です。</p>
        <p class="cl-qa-src">※水道法第36条・第37条・第53条・第54条（e-Gov法令検索で2026年9月確認）</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#kani">簡易専用水道（10m³超）の場合</a></li>
          <li><a href="#tokutei">特定建築物（建築物衛生法）の場合</a></li>
          <li><a href="#penalties">罰則の一覧</a></li>
          <li><a href="#other">罰則以外のリスク</a></li>
          <li><a href="#late">清掃が遅れていると気づいたら</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>清掃を怠った場合</strong>：まず行政から指示・命令がある。命令に従わないと罰則（簡易専用水道は1年以下の拘禁刑又は100万円以下の罰金）</li>
            <li><strong>法定検査を受けない場合</strong>：それだけで100万円以下の罰金（簡易専用水道）</li>
            <li><strong>特定建築物</strong>：帳簿の不備・報告の拒否・改善命令違反などは30万円以下の罰金</li>
          </ul>
        </div>
      </section>

      <section id="kani" class="cl-section">
        <h2>簡易専用水道（10m³超）の場合</h2>
        <p>水道から受けた水だけを受水槽にためて使う施設で、受水槽の有効容量が10m³を超えるものが「簡易専用水道」です。設置者には次の2つが義務付けられています。</p>
        <ul>
          <li><strong>管理</strong>：水槽の掃除を毎年1回以上定期に行うことなど（水道法第34条の2第1項、施行規則第55条）</li>
          <li><strong>検査</strong>：登録検査機関などの検査を毎年1回以上定期に受けること（第34条の2第2項、施行規則第56条）</li>
        </ul>
        <h3>清掃などの管理を怠った場合の流れ</h3>
        <ol>
          <li><strong>報告の求め・立入検査</strong>：都道府県知事等は、管理について報告を求めたり、職員が施設に立ち入って施設・水質・帳簿書類を検査したりできます（第39条第3項）</li>
          <li><strong>清掃などの指示</strong>：管理が基準に適合していないと認められると、期間を定めて清掃その他の必要な措置を指示されることがあります（第36条第3項）</li>
          <li><strong>給水停止命令</strong>：指示に従わず、給水を続けることが利用者の利益を損なうと認められると、指示された事項を行うまで給水を停止するよう命じられることがあります（第37条）</li>
          <li><strong>罰則</strong>：給水停止命令に違反すると、1年以下の拘禁刑又は100万円以下の罰金です（第53条第10号）</li>
        </ol>
        <p>一方、<strong>年1回の法定検査を受けないこと</strong>は、指示や命令を経ずに、それ自体が100万円以下の罰金の対象です（第54条第8号）。</p>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/332AC0000000177" rel="noopener" target="_blank">水道法</a>・<a href="https://laws.e-gov.go.jp/law/332M50000100045" rel="noopener" target="_blank">水道法施行規則</a>（e-Gov法令検索、2026年9月確認）。都道府県知事の権限は、市や特別区では市長・区長が行う場合があります。</p>
      </section>

      <section id="tokutei" class="cl-section">
        <h2>特定建築物（建築物衛生法）の場合</h2>
        <p>延べ面積3,000m²以上の事務所・店舗・ホテルなど（学校は8,000m²以上）の「特定建築物」は、建築物衛生法の建築物環境衛生管理基準に従って維持管理する必要があり、<strong>貯水槽の清掃を1年以内ごとに1回</strong>定期に行います（施行規則第4条）。</p>
        <ol>
          <li><strong>報告の求め・立入検査</strong>：都道府県知事等は、特定建築物所有者等に報告を求めたり、職員が立ち入って設備・帳簿書類・維持管理の状況を検査したりできます（第11条）</li>
          <li><strong>改善命令・使用停止</strong>：管理基準に従った維持管理がされておらず、人の健康を損なうおそれのある事態などがあると認められると、改善などの措置を命じられたり、設備の使用停止・制限を受けたりすることがあります（第12条）</li>
          <li><strong>罰則</strong>：改善命令や処分への違反は30万円以下の罰金です（第16条第5号）</li>
        </ol>
        <p>また、維持管理の状況を記載した帳簿書類を備えない・記載しない・虚偽の記載をすることや、報告の拒否・虚偽の報告・立入検査の拒否も、30万円以下の罰金の対象です（第16条第3号・第4号）。帳簿書類は5年間保存します（施行規則第20条）。</p>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/345AC1000000020" rel="noopener" target="_blank">建築物における衛生的環境の確保に関する法律</a>・<a href="https://laws.e-gov.go.jp/law/346M50000100002" rel="noopener" target="_blank">同法施行規則</a>（e-Gov法令検索、2026年9月確認）</p>
      </section>

      <section id="penalties" class="cl-section">
        <h2>罰則の一覧</h2>
        <div class="cl-table-wrap">
          <table class="cl-table cl-table--wrap">
            <caption>受水槽の管理に関わる主な罰則</caption>
            <thead><tr><th>違反</th><th>罰則</th><th>根拠</th></tr></thead>
            <tbody>
              <tr><th scope="row">簡易専用水道の法定検査を受けない</th><td>100万円以下の罰金</td><td>水道法第54条</td></tr>
              <tr><th scope="row">給水停止命令に違反</th><td>1年以下の拘禁刑又は100万円以下の罰金</td><td>水道法第53条</td></tr>
              <tr><th scope="row">簡易専用水道の報告をしない・虚偽の報告・立入検査の拒否</th><td>30万円以下の罰金</td><td>水道法第55条</td></tr>
              <tr><th scope="row">特定建築物の帳簿書類の不備・虚偽記載</th><td>30万円以下の罰金</td><td>建築物衛生法第16条</td></tr>
              <tr><th scope="row">特定建築物の報告をしない・虚偽の報告・立入検査の拒否</th><td>30万円以下の罰金</td><td>建築物衛生法第16条</td></tr>
              <tr><th scope="row">特定建築物の改善命令・使用停止処分に違反</th><td>30万円以下の罰金</td><td>建築物衛生法第16条</td></tr>
            </tbody>
          </table>
        </div>
        <p>いずれも、法人の従業者などが違反した場合は、その法人にも罰金刑が科されます（水道法第56条、建築物衛生法第17条）。</p>
      </section>

      <section id="other" class="cl-section">
        <h2>罰則以外のリスク</h2>
        <p>清掃や点検を怠って水質に問題が起きると、利用者の健康に影響が出るおそれがあり、民事上の損害賠償責任を問われる可能性もあります。給水停止を命じられれば、建物の利用そのものに支障が出ます。</p>
        <p>給水栓の水に色・濁り・臭い・味などの異常を認めたときは必要な水質検査を行い（施行規則第55条第3号）、健康を害するおそれがあると知ったときは、直ちに給水を停止して関係者に知らせる必要があります（同第4号）。</p>
      </section>

      <section id="late" class="cl-section">
        <h2>清掃が遅れていると気づいたら</h2>
        <ol>
          <li><strong>清掃を手配する</strong>：受水槽の容量・高置水槽の有無を伝えて清掃業者に依頼する</li>
          <li><strong>法定検査を受ける</strong>：10m³超なら、登録検査機関などの検査を申し込む（地域の検査機関は保健所で確認できます）</li>
          <li><strong>記録をそろえる</strong>：清掃の報告書、点検の記録、図面を保管する。特定建築物は帳簿書類を5年間保存</li>
          <li><strong>指導を受けていれば期限を守る</strong>：分からない点は指示を出した窓口に相談する</li>
        </ol>
        <p>清掃の費用は<a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</a>、自分の建物が対象かは<a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a>で確認できます。</p>
      </section>

      <div class="cl-cta">
        <h2>受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/">無料で清掃業者を探す</a>
      </div>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          {faqItems.map((f) => (<div class="cl-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
        </dl>
      </section>

      <div class="cl-pref-links">
        <h2 class="cl-pref-h">エリア別の受水槽清掃業者を探す</h2>
        <ul class="cl-pref-list">
          <li><a href="/jusuisou-seisou/tokyo/">東京都</a></li>
          <li><a href="/jusuisou-seisou/osaka/">大阪府</a></li>
          <li><a href="/jusuisou-seisou/kanagawa/">神奈川県</a></li>
          <li><a href="/jusuisou-seisou/aichi/">愛知県</a></li>
          <li><a href="/jusuisou-seisou/saitama/">埼玉県</a></li>
          <li><a href="/jusuisou-seisou/fukuoka/">福岡県</a></li>
        </ul>
        <p class="cl-pref-more"><a href="/jusuisou-seisou/">全国の対応業者を見る</a></p>
      </div>

      <aside class="cl-related">
        <h2 class="cl-related-h">関連サービス・コラム</h2>
        <ul>
          <li><a href="/jusuisou-seisou/">受水槽清掃の業者を一括見積比較</a></li>
          <li><a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a></li>
          <li><a href="/column/jusuisou-seisou-horei-gimu/">受水槽清掃の法定義務ガイド</a></li>
          <li><a href="/column/jusuisou-seisou-tenken/">受水槽の点検・法定検査ガイド</a></li>
          <li><a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場</a></li>
        </ul>
      </aside>

      <aside class="cl-glossary-block">
        <h2 class="cl-glossary-h">📖 この記事に出てくる主な用語</h2>
        <ul class="cl-glossary-list">
          <li><a href="/glossary/#suido-ho">水道法</a></li>
          <li><a href="/glossary/#biru-kan-ho">建築物衛生法（ビル管法）</a></li>
          <li><a href="/glossary/#kanni-senyou-suido">簡易専用水道</a></li>
          <li><a href="/glossary/#jusuisou">受水槽／貯水槽</a></li>
          <li><a href="/glossary/#tokutei-kenchikubutsu">特定建築物</a></li>
        </ul>
        <p class="cl-glossary-more"><a href="/glossary/">施設管理用語集（49語）をすべて見る</a></p>
      </aside>
    </div>
  </article>
</BaseLayout>

