---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = 'フロン排出抑制法の点検義務ガイド2026｜業務用エアコン・冷凍冷蔵設備の管理者責任';
const description = '業務用エアコン・冷凍冷蔵設備に義務付けられたフロン類の簡易点検（3ヶ月に1回）・定期点検（年1回または3年に1回）の対象機器・実施者要件・記録保存義務を整理。漏洩量算定報告・廃棄時のフロン回収・違反時の罰金リスクまで施設管理担当者向けに2026年最新版で解説。';
const canonical = `${site.domain}/column/furon-tenken-horei-gimu/`;
const published = '2026-06-05';
const modified = '2026-06-05';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: 'フロン排出抑制法の点検義務ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5200,
  articleSection: '法令・義務',
  keywords: 'フロン排出抑制法,業務用エアコン,簡易点検,定期点検,管理者責任,漏洩量算定,フロン類,2026',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-furon-tenken.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: 'フロン排出抑制法定期点検' },
  citation: [
    { '@type': 'Legislation', name: 'フロン排出抑制法第16条（管理者の判断基準）' },
    { '@type': 'Legislation', name: 'フロン排出抑制法第19条（点検記録の保存）' },
    { '@type': 'Legislation', name: 'フロン排出抑制法第41条（充填回収業者の登録）' },
  ],
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'フロン排出抑制法の点検は誰が対象ですか？', acceptedAnswer: { '@type': 'Answer', text: '業務用の第一種特定製品（業務用エアコン・業務用冷凍冷蔵機器）を所有・管理する事業者が対象です。家庭用エアコンや車載用は対象外。第一種特定製品には、業務用エアコン・店舗用冷凍冷蔵庫・スーパーマーケットの冷蔵ショーケース・コンビニの冷凍設備・食品工場の冷凍冷蔵設備などが含まれます。' } },
    { '@type': 'Question', name: '簡易点検と定期点検の違いは？', acceptedAnswer: { '@type': 'Answer', text: '簡易点検は管理者自身が実施する目視確認（3ヶ月に1回以上、全機器対象）。定期点検は十分な知見を有する者（資格者）が実施する詳細点検で、機器の規模に応じて頻度が異なります。7.5kW以上50kW未満は3年に1回、50kW以上は1年に1回が必須です。' } },
    { '@type': 'Question', name: '点検記録はどのくらい保存しますか？', acceptedAnswer: { '@type': 'Answer', text: '点検結果・整備記録（フロン類の充填・回収量含む）は機器を廃棄するまで保存が義務付けられています。機器を売却・譲渡する場合は、新しい管理者に記録を引き継ぐ必要があります。' } },
    { '@type': 'Question', name: 'フロン類の漏洩量算定報告はいつ必要ですか？', acceptedAnswer: { '@type': 'Answer', text: '事業者全体でのフロン類の漏洩量がCO2換算で年間1,000トン以上の場合、国（経済産業省・環境省）への報告が義務付けられています。スーパーマーケット・大型物流倉庫・食品工場など、冷凍冷蔵設備を大量保有する事業者が主な対象です。' } },
    { '@type': 'Question', name: '違反した場合の罰則は？', acceptedAnswer: { '@type': 'Answer', text: '主な罰則は、点検義務違反・記録保存義務違反で50万円以下の罰金、漏洩量算定報告義務違反で10万円以下の過料、廃棄時のフロン類引取義務違反で50万円以下の罰金、無登録業者への充填回収委託で1年以下の懲役または50万円以下の罰金。重大な違反は環境省・経済産業省の指導対象となります。' } },
    { '@type': 'Question', name: '機器廃棄時のフロン回収はどうしますか？', acceptedAnswer: { '@type': 'Answer', text: '都道府県知事の登録を受けた「第一種フロン類充填回収業者」に委託する必要があります。回収後は行程管理票（A・B票）を業者から受領し、3年間保存。廃棄物処理業者と兼業の業者は処理マニフェストも別途必要です。' } },
    { '@type': 'Question', name: '点検は社内の従業員が実施できますか？', acceptedAnswer: { '@type': 'Answer', text: '簡易点検は管理者本人（社内の従業員）が実施できます。定期点検は「フロン類の取扱いについて十分な知見を有する者」が必要で、具体的には冷媒フロン類取扱技術者・高圧ガス保安法の冷凍機械責任者・日本冷凍空調学会の認定資格者などが該当します。' } },
    { '@type': 'Question', name: '点検記録のテンプレートはありますか？', acceptedAnswer: { '@type': 'Answer', text: '経済産業省・環境省が公開している「フロン排出抑制法の手引き」に標準テンプレートが掲載されています。業界団体も独自テンプレートを公開。クラウド型の点検記録システムを利用すれば自動で記録・保存できます。' } },
    { '@type': 'Question', name: '中古機器を購入した場合の対応は？', acceptedAnswer: { '@type': 'Answer', text: '中古機器を取得した時点で新たな管理者になり、その時点から点検義務が発生します。前管理者から点検記録の引継ぎを受けることが原則。引継ぎが受けられない場合は新規取扱として記録を開始してください。' } }
  ],
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${site.domain}/#website` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-furon-tenken.png` },
});

---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}
>
  <article class="cl-article">

    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a>
          <span aria-hidden="true">›</span>
          <a href="/column/">コラム</a>
          <span aria-hidden="true">›</span>
          <span>フロン排出抑制法の点検義務ガイド</span>
        </nav>
        <span class="cl-cat">法令・義務</span>
        <h1 class="cl-title">フロン排出抑制法の点検義務ガイド2026｜業務用エアコン・冷凍冷蔵設備の管理者責任</h1>
        <p class="cl-lead">
          業務用エアコンや冷凍冷蔵設備を保有する事業者は、<strong>フロン排出抑制法により点検・記録・報告の義務</strong>があります。本記事では、簡易点検と定期点検の違い、対象機器の判定、頻度・実施者要件、記録保存期間、漏洩量算定報告の必要条件、違反時の罰則まで、施設管理担当者向けに2026年版で整理しました。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月5日</time>
          <span>最終更新：2026年6月5日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a>（{site.author.role}）</span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. フロン排出抑制法の点検義務は誰に課されますか？</p>
        <p class="cl-qa-a">A. <strong>業務用エアコン・業務用冷凍冷蔵機器（第一種特定製品）を所有・管理する事業者</strong>。簡易点検は3ヶ月に1回（管理者本人実施可）、定期点検は7.5kW以上で3年に1回、50kW以上で年1回（有資格者実施）。違反は50万円以下の罰金。</p>
        <p class="cl-qa-src">※フロン排出抑制法（2026年4月時点）</p>
      </div>

      <ColumnCtaCard serviceSlug="furon-tenken" serviceName="フロン排出抑制法定期点検" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#scope">対象機器の判定（第一種特定製品とは）</a></li>
          <li><a href="#simple">簡易点検（3ヶ月に1回）の内容</a></li>
          <li><a href="#regular">定期点検（年1回・3年に1回）の内容</a></li>
          <li><a href="#records">点検記録の保存・引き継ぎ</a></li>
          <li><a href="#emission">フロン類の漏洩量算定報告</a></li>
          <li><a href="#disposal">廃棄時のフロン回収義務</a></li>
          <li><a href="#penalties">違反時の罰則と監督官庁</a></li>
          <li><a href="#tips">実務上のポイント</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>対象</strong>：業務用エアコン・冷凍冷蔵機器を持つすべての事業者（家庭用は対象外）</li>
            <li><strong>義務</strong>：簡易点検3ヶ月に1回（管理者実施可）＋定期点検（規模に応じて年1回または3年に1回・有資格者）</li>
            <li><strong>違反リスク</strong>：50万円以下の罰金。漏洩量算定報告も別途義務（年間CO2換算1,000トン以上）</li>
          </ul>
        </div>
      </section>

      <section id="scope" class="cl-section">
        <h2>対象機器の判定（第一種特定製品とは）</h2>
        <p>フロン排出抑制法の点検義務は、<strong>「第一種特定製品」</strong>と呼ばれる業務用の冷媒機器に課されます。家庭用エアコン・自動車のエアコンは対象外で、別法令（家電リサイクル法・自動車リサイクル法）で規制されています。</p>

        <h3>第一種特定製品に該当する機器</h3>
        <ul>
          <li><strong>業務用エアコン</strong>：店舗・オフィス・工場・倉庫などに設置された業務用空調機（家庭用と業務用の区別は出力ではなく用途。賃貸オフィスや店舗で使用されるものは業務用扱い）</li>
          <li><strong>業務用冷凍冷蔵機器</strong>：スーパーマーケット・コンビニのショーケース、業務用冷蔵庫・冷凍庫、製氷機、ビールサーバー（業務用）</li>
          <li><strong>大規模冷凍設備</strong>：食品工場・物流倉庫の冷凍設備、製薬工場・化学工場の冷却設備</li>
          <li><strong>その他</strong>：自動販売機（冷却機能付き）、業務用除湿機など</li>
        </ul>

        <h3>対象外となる機器</h3>
        <ul>
          <li>家庭用エアコン（家電リサイクル法対象）</li>
          <li>カーエアコン（自動車リサイクル法対象）</li>
          <li>フロン類以外の冷媒（自然冷媒：CO2・アンモニア・炭化水素など）を使用する機器</li>
        </ul>

        <h3>機器規模の判定基準</h3>
        <p>定期点検の頻度を決める「圧縮機定格出力」は、機器の銘板（製造プレート）に記載されています。<strong>業務用エアコンは多くが7.5kW未満</strong>で簡易点検のみが必要（定期点検義務なし）、<strong>冷凍冷蔵設備の多くは7.5kW以上</strong>で定期点検が必要となります。複数機器を1つのシステムとして連結している場合、合計出力で判定する場合があるため、業者に確認してください。</p>
      </section>

      <section id="simple" class="cl-section">
        <h2>簡易点検（3ヶ月に1回）の内容</h2>
        <p>簡易点検は<strong>管理者本人（社内の従業員等）が実施可能</strong>な目視確認です。3ヶ月に1回以上、すべての第一種特定製品を対象に実施します。</p>

        <h3>確認項目</h3>
        <ol>
          <li><strong>異常音・振動の有無</strong>：機器の運転音・振動が普段と違うか</li>
          <li><strong>油にじみ・油漏れの有無</strong>：機器周辺・配管接続部に油状の痕跡がないか</li>
          <li><strong>機器の損傷・劣化</strong>：腐食・変形・破損・カバーの破れ等</li>
          <li><strong>霜付き・氷結の異常</strong>：冷却器に異常な霜付き・氷結がないか（冷凍冷蔵機器）</li>
          <li><strong>冷暖能力の異常低下</strong>：体感での性能変化（業務用エアコン）</li>
          <li><strong>水漏れ・結露の異常</strong>：通常と異なる水漏れ・結露の発生</li>
        </ol>

        <h3>点検記録の作成</h3>
        <p>点検実施日・点検者氏名・確認した項目と結果を記録します。<strong>異常がなかった場合も「異常なし」の記録が必要</strong>です。記録漏れは違反扱いになるため、定期的なルーティンとして月次業務に組み込むのが実務上の標準です。</p>
      </section>

      <section id="regular" class="cl-section">
        <h2>定期点検（年1回・3年に1回）の内容</h2>
        <p>定期点検は<strong>「フロン類の取扱いについて十分な知見を有する者」</strong>が実施する詳細点検です。機器の規模に応じて頻度が異なります。</p>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>定期点検の頻度（圧縮機定格出力別）</caption>
            <thead><tr><th>機器区分</th><th>圧縮機定格出力</th><th>点検頻度</th></tr></thead>
            <tbody>
              <tr><th scope="row">業務用エアコン</th><td>7.5kW未満</td><td>定期点検義務なし（簡易点検のみ）</td></tr>
              <tr><th scope="row">業務用エアコン</th><td>7.5kW以上50kW未満</td><td>3年に1回以上</td></tr>
              <tr><th scope="row">業務用エアコン</th><td>50kW以上</td><td>1年に1回以上</td></tr>
              <tr><th scope="row">冷凍冷蔵機器</th><td>7.5kW以上</td><td>1年に1回以上</td></tr>
            </tbody>
          </table>
        </div>

        <h3>定期点検の実施者要件</h3>
        <p>「十分な知見を有する者」として、以下のいずれかの資格者または同等の知見を有する者が実施します。</p>
        <ul>
          <li>第一種・第二種冷媒フロン類取扱技術者（日本冷凍空調学会・日本冷凍空調工業会認定）</li>
          <li>高圧ガス保安法の冷凍機械責任者（一種・二種・三種）</li>
          <li>日本冷凍空調学会・日本冷凍空調工業会の認定資格者</li>
          <li>業界団体が認定するフロン類取扱資格者</li>
        </ul>

        <h3>定期点検の確認内容</h3>
        <ol>
          <li>簡易点検の全項目（より精密に）</li>
          <li>専用機器（電子式漏れ検知器・赤外線検知器・蛍光剤）による漏洩点検</li>
          <li>圧力・温度・電流値の測定と前回データとの比較</li>
          <li>冷媒充填量の確認</li>
          <li>制御系統・センサーの作動確認</li>
        </ol>
      </section>

      <section id="records" class="cl-section">
        <h2>点検記録の保存・引き継ぎ</h2>
        <p>点検記録は<strong>機器を廃棄するまで保存</strong>する義務があります。機器の譲渡・売却時は新管理者に記録を引き継ぐ必要があり、引き継ぎを怠ると違反扱いとなります。</p>

        <h3>記録すべき内容</h3>
        <ul>
          <li>点検実施日・点検者氏名（資格情報含む）</li>
          <li>点検結果（異常の有無・修繕内容）</li>
          <li>フロン類の充填・回収量（kg単位）</li>
          <li>機器の使用状況の変化</li>
          <li>機器の特定情報（製造番号・設置場所・型番）</li>
        </ul>

        <h3>記録の電子化と保存方法</h3>
        <p>紙の記録簿だけでなく、<strong>クラウドベースの点検管理システム</strong>（フロン点検アプリ・Excel管理シートなど）の利用が一般化しています。多数機器を保有する事業者では、QRコードで機器を識別し、スマートフォンで簡易点検を実施できるシステムが効率的です。</p>

        <h3>引き継ぎが滞ったときの対応</h3>
        <p>機器を中古で取得した場合や、企業統合・店舗移転で記録の所在が不明になった場合は、<strong>新たな管理者として記録を開始</strong>し、過去の状況については「不明・調査中」と明記しておきます。後日記録が見つかれば追加保管します。</p>
      </section>

      <section id="emission" class="cl-section">
        <h2>フロン類の漏洩量算定報告</h2>
        <p>事業者全体での<strong>フロン類年間漏洩量がCO2換算で1,000トン以上</strong>の場合、国（経済産業省・環境省）への報告義務が発生します。</p>

        <h3>対象事業者</h3>
        <ul>
          <li>大規模スーパーマーケットチェーン</li>
          <li>大型物流倉庫運営事業者（冷凍冷蔵物流）</li>
          <li>大手食品メーカー（冷凍食品・冷蔵食品）</li>
          <li>大規模事業所を運営する事業者（ホテルチェーン・複合商業施設など）</li>
        </ul>

        <h3>漏洩量の算定方法</h3>
        <p>フロン類の充填量から回収量を差し引いた値が漏洩量となります。冷媒の種類に応じてCO2換算係数（GWP値）を乗じてCO2換算量を計算。<strong>R-410A（GWP=2,090）・R-404A（GWP=3,922）</strong>などの高GWP冷媒は少量の漏洩でも報告基準に達しやすくなります。</p>

        <h3>報告期限と提出先</h3>
        <p>毎年7月末までに、<strong>環境省・経済産業省の共通電子報告システム</strong>で報告します。地方自治体への重複報告は不要です。</p>
      </section>

      <section id="disposal" class="cl-section">
        <h2>廃棄時のフロン回収義務</h2>
        <p>機器を廃棄する際は、フロン類を大気放出してはならず、<strong>登録業者によるフロン回収</strong>が義務付けられています。</p>

        <h3>廃棄時の手続き</h3>
        <ol>
          <li>第一種フロン類充填回収業者（都道府県知事登録業者）への委託</li>
          <li>業者による現場でのフロン類回収作業</li>
          <li>業者から「行程管理票（A・B票）」を受領</li>
          <li>機器自体は産業廃棄物として別途処理（マニフェスト発行）</li>
        </ol>

        <h3>建物解体時の特別ルール</h3>
        <p>建物解体時に内蔵されている空調機器・冷凍冷蔵設備のフロン類は、<strong>建設業者ではなく所有者（建物管理者）の責任で回収</strong>する必要があります。解体工事の発注前に、フロン回収業者への事前手配を済ませてください。解体業者にまとめて任せた場合、フロン類の不適切処理が発覚すると所有者責任が問われます。</p>

        <h3>行程管理票の保存</h3>
        <p>業者から受領した行程管理票（A・B票）は<strong>3年間保存</strong>が義務付けられています。電子マニフェスト（JWNETなど）を利用すると自動で保存されます。</p>
      </section>

      <section id="penalties" class="cl-section">
        <h2>違反時の罰則と監督官庁</h2>
        <p>違反時は経済産業省・環境省・都道府県の指導を経て、最終的に罰則が科される可能性があります。</p>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>主な違反内容と罰則</caption>
            <thead><tr><th>違反内容</th><th>罰則</th><th>監督官庁</th></tr></thead>
            <tbody>
              <tr><th scope="row">点検義務違反・記録保存義務違反</th><td>50万円以下の罰金</td><td>都道府県知事</td></tr>
              <tr><th scope="row">漏洩量算定報告義務違反</th><td>10万円以下の過料</td><td>経済産業省・環境省</td></tr>
              <tr><th scope="row">廃棄時のフロン類引取義務違反</th><td>50万円以下の罰金</td><td>都道府県知事</td></tr>
              <tr><th scope="row">無登録業者への充填回収委託</th><td>1年以下の懲役または50万円以下の罰金</td><td>都道府県知事</td></tr>
              <tr><th scope="row">フロン類の意図的な放出</th><td>1年以下の懲役または50万円以下の罰金</td><td>都道府県知事</td></tr>
            </tbody>
          </table>
        </div>

        <h3>違反発覚のきっかけ</h3>
        <ul>
          <li>都道府県・自治体の立入検査（特に大規模事業者）</li>
          <li>フロン類充填回収業者からの通報・不適切処理発覚</li>
          <li>解体工事・移転工事での記録不備の発覚</li>
          <li>従業員・元従業員からの告発（労働基準監督署経由）</li>
          <li>環境省の漏洩量報告システムでの未報告</li>
        </ul>
      </section>

      <section id="tips" class="cl-section">
        <h2>実務上のポイント</h2>

        <h3>機器一覧の整備が点検義務遵守の出発点</h3>
        <p>多数の機器を保有する事業者では、<strong>機器台帳の整備</strong>が点検義務遵守の出発点になります。機器ごとに「製造番号・型番・設置場所・出力・前回点検日・次回点検予定日」を一覧化し、定期的に更新する仕組みを作ってください。</p>

        <h3>業者との契約で定期点検まで含める</h3>
        <p>業務用エアコン・冷凍冷蔵設備の保守契約には、<strong>「フロン排出抑制法定期点検」を含むかどうか</strong>を契約書で明示してください。一般的な保守契約は機械的故障の対応のみで、フロン点検は別途有料という業者が大半。年間契約に含めれば点検計画を業者側で管理してもらえます。</p>

        <h3>店舗・支店ごとに点検担当者を割り当てる</h3>
        <p>複数店舗・複数事業所を保有する事業者では、<strong>店長・支店長クラスを簡易点検の現場責任者</strong>に指定するのが実務上の標準です。本社の総務・施設管理部門だけで管理しようとすると点検漏れが頻発するため、現場ごとの責任体制が重要です。</p>

        <h3>クラウド型点検システムの導入が効率的</h3>
        <p>業務用エアコン・冷凍冷蔵設備を多数保有する企業では、<strong>クラウド型のフロン点検システム</strong>（スマホアプリ＋クラウド管理）の導入が業務効率を大きく向上させます。月額数千円〜数万円の費用で、点検漏れの自動通知・記録の電子保存・引き継ぎの簡略化が可能です。</p>
      </section>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          <div class="cl-faq-item">
            <dt>フロン排出抑制法の点検は誰が対象ですか？</dt>
            <dd>業務用の第一種特定製品（業務用エアコン・業務用冷凍冷蔵機器）を所有・管理する事業者が対象です。家庭用エアコンや車載用は対象外。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>簡易点検と定期点検の違いは？</dt>
            <dd>簡易点検は管理者自身が3ヶ月に1回実施する目視確認（全機器対象）。定期点検は資格者が機器の規模に応じて実施する詳細点検（7.5kW以上で3年または1年に1回）。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>点検記録はどのくらい保存しますか？</dt>
            <dd>機器を廃棄するまで保存が義務付けられています。譲渡・売却時は新管理者に記録を引き継ぐ必要があります。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>違反した場合の罰則は？</dt>
            <dd>点検義務違反・記録保存義務違反は50万円以下の罰金、漏洩量算定報告義務違反は10万円以下の過料が科されます。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>機器廃棄時のフロン回収はどうしますか？</dt>
            <dd>都道府県知事の登録を受けた「第一種フロン類充填回収業者」に委託します。回収後は行程管理票（A・B票）を3年間保存。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>点検は社内の従業員が実施できますか？</dt>
            <dd>簡易点検は管理者本人が実施可能。定期点検は「フロン類の取扱いについて十分な知見を有する者」（冷媒フロン類取扱技術者など）が必要です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>漏洩量算定報告はいつ必要ですか？</dt>
            <dd>事業者全体でのフロン類の漏洩量がCO2換算で年間1,000トン以上の場合、国（経済産業省・環境省）への報告が必要。スーパーマーケット・物流倉庫などが主な対象です。</dd>
          </div>
        </dl>
      </section>

