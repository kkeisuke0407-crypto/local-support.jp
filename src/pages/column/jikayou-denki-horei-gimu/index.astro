---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '自家用電気工作物の保安点検義務ガイド2026｜電気事業法による設置者責任とキュービクル点検';
const description = '高圧600V超のキュービクル等を持つ事業所に課された電気事業法の保安規程・電気主任技術者選任・月次点検・年次点検・経済産業省への手続きを整理。違反時の300万円以下の罰金、感電事故時の刑事責任、外部委託承認制度の活用まで2026年最新版で解説。';
const canonical = `${site.domain}/column/jikayou-denki-horei-gimu/`;
const published = '2026-06-05';
const modified = '2026-06-05';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '自家用電気工作物の保安点検義務ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5500,
  articleSection: '法令・義務',
  keywords: '自家用電気工作物,電気事業法,キュービクル,保安規程,電気主任技術者,月次点検,年次点検,2026',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jikayou-denki.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '自家用電気工作物点検（キュービクル点検）' },
  citation: [
    { '@type': 'Legislation', name: '電気事業法第38条（自家用電気工作物の定義）' },
    { '@type': 'Legislation', name: '電気事業法第42条（保安規程）' },
    { '@type': 'Legislation', name: '電気事業法第43条（主任技術者選任）' },
    { '@type': 'Legislation', name: '電気事業法第115条（罰則）' },
  ],
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '自家用電気工作物とは何ですか？', acceptedAnswer: { '@type': 'Answer', text: '電力会社から600V超の高圧・特別高圧で受電する電気設備を所有する事業所の電気設備全般を指します。代表例はキュービクル式高圧受電設備（パッケージ変電所）。ビル・工場・スーパー・コンビニ・大規模マンション・病院・学校など、ある程度の規模の事業所はほぼ該当します。' } },
    { '@type': 'Question', name: '保安規程の届出はいつ必要ですか？', acceptedAnswer: { '@type': 'Answer', text: '自家用電気工作物の設置工事開始前（送電前）に経済産業大臣（産業保安監督部）への届出が必要です。保安規程には組織体制・点検計画・事故時対応などを記載。設置後の変更時も変更届出が必要です。' } },
    { '@type': 'Question', name: '電気主任技術者は社内に置く必要がありますか？', acceptedAnswer: { '@type': 'Answer', text: '原則として社内選任（自社雇用）が必要です。ただし「外部委託承認制度」により、要件を満たす場合は電気保安法人（電気管理技術者）への外部委託が認められています。年間複数千万kWh規模の大規模事業所では社内選任、中小規模では外部委託が一般的です。' } },
    { '@type': 'Question', name: '月次点検と年次点検の違いは？', acceptedAnswer: { '@type': 'Answer', text: '月次点検は毎月（または隔月）の通電状態での目視・測定（計器値・温度・異音等）。年次点検は年1回の停電を伴う精密点検（絶縁抵抗測定・接地抵抗測定・保護継電器試験・遮断器動作試験等）。月次のみ実施・年次未実施は重大な保安違反です。' } },
    { '@type': 'Question', name: '違反した場合の罰則は？', acceptedAnswer: { '@type': 'Answer', text: '保安規程違反・主任技術者未選任は300万円以下の罰金（電気事業法第115条）。感電死傷事故が発生すれば業務上過失致死傷罪（刑法）の対象。経済産業省の電気事業法上の指導・改善命令も別途あります。重大事故時は責任者個人への刑事責任追及の可能性もあります。' } },
    { '@type': 'Question', name: 'キュービクルの法定耐用年数はありますか？', acceptedAnswer: { '@type': 'Answer', text: '電気事業法上の明確な耐用年数規定はありませんが、JIS C 4620（キュービクル式高圧受電設備）では更新目安として20年〜25年が示されています。実務的には20年を過ぎたら年次点検結果を見ながら段階的な更新計画を立てるのが標準的。30年超は故障リスクが急増します。' } },
    { '@type': 'Question', name: '電気主任技術者が辞めたらどうしますか？', acceptedAnswer: { '@type': 'Answer', text: '速やかに後任を選任し、選任届出を経済産業省に提出する必要があります。一時的な不在は許容されません。後任が見つかるまでは外部委託（電気管理技術者契約）への切替も可能です。空白期間は保安リスクが極めて高いため、退職予告から早期の対応が必要です。' } },
    { '@type': 'Question', name: '記録の保管期間は？', acceptedAnswer: { '@type': 'Answer', text: '保安規程に基づく点検記録・事故報告書・主任技術者の業務日誌は3年間保管が義務（電気事業法施行規則）。電気保安法人に外部委託している場合も、受託業者経由で記録の写しを保管する必要があります。' } },
    { '@type': 'Question', name: '小規模事業所でも対象ですか？', acceptedAnswer: { '@type': 'Answer', text: '高圧（600V超）で受電している場合は規模を問わず対象。一般家庭・小規模店舗で低圧受電のみの場合は対象外。コンビニ・小規模スーパーでも50kW以上の電力需要があれば高圧受電→自家用電気工作物に該当することが多いです。' } }
  ],
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${site.domain}/#website` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jikayou-denki.png` },
});

---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}
>
  <article class="cl-article">

    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a>
          <span aria-hidden="true">›</span>
          <a href="/column/">コラム</a>
          <span aria-hidden="true">›</span>
          <span>自家用電気工作物の保安点検義務ガイド</span>
        </nav>
        <span class="cl-cat">法令・義務</span>
        <h1 class="cl-title">自家用電気工作物の保安点検義務ガイド2026｜電気事業法による設置者責任とキュービクル点検</h1>
        <p class="cl-lead">
          高圧（600V超）で受電する事業所のキュービクル等は<strong>「自家用電気工作物」</strong>として、電気事業法による保安規程・電気主任技術者選任・月次点検・年次点検の義務があります。本記事では、対象設備の判定、保安体制の選択肢（社内選任 vs 外部委託）、点検の具体内容、違反時の300万円以下の罰金リスクまで、施設管理担当者向けに2026年版で整理しました。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月5日</time>
          <span>最終更新：2026年6月5日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a>（{site.author.role}）</span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. キュービクル等の自家用電気工作物の保安義務は？</p>
        <p class="cl-qa-a">A. <strong>保安規程の届出＋電気主任技術者の選任＋月次点検（通電中）＋年次点検（停電伴う精密）が必須</strong>。外部委託（電気保安法人）も可能だが要件あり。違反は300万円以下の罰金。</p>
        <p class="cl-qa-src">※電気事業法第42条・第43条・第115条（2026年4月時点）</p>
      </div>

      <ColumnCtaCard serviceSlug="jikayou-denki" serviceName="自家用電気工作物点検" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#scope">対象設備の判定（自家用電気工作物の範囲）</a></li>
          <li><a href="#regulation">保安規程と届出</a></li>
          <li><a href="#engineer">電気主任技術者の選任</a></li>
          <li><a href="#outsource">外部委託承認制度（電気保安法人）</a></li>
          <li><a href="#monthly">月次点検（通電中）</a></li>
          <li><a href="#annual">年次点検（停電を伴う精密点検）</a></li>
          <li><a href="#penalties">違反時の罰則と監督官庁</a></li>
          <li><a href="#tips">実務上のポイント</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>対象</strong>：高圧（600V超）受電のキュービクル・自家発電設備等を持つ事業所すべて</li>
            <li><strong>義務</strong>：保安規程届出＋主任技術者選任＋月次点検＋年次点検（停電伴う）＋事故報告</li>
            <li><strong>違反リスク</strong>：300万円以下の罰金、感電事故発生時は業務上過失致死傷罪、経産省の改善命令</li>
          </ul>
        </div>
      </section>

      <section id="scope" class="cl-section">
        <h2>対象設備の判定（自家用電気工作物の範囲）</h2>
        <p>「自家用電気工作物」は、電気事業法第38条に基づき、<strong>電気事業者（電力会社）以外が設置する電気工作物のうち、一定規模以上のもの</strong>を指します。実務上は<strong>「高圧600V超で受電している事業所すべて」</strong>と理解すれば概ね正しいです。</p>

        <h3>典型的な対象設備</h3>
        <ul>
          <li>キュービクル式高圧受電設備（パッケージ変電所）</li>
          <li>受変電設備（受電盤・変圧器・配電盤一式）</li>
          <li>自家発電設備（非常用発電機・コジェネレーション）</li>
          <li>太陽光発電設備（10kW以上の事業用）</li>
          <li>蓄電池設備（一定容量以上）</li>
        </ul>

        <h3>典型的な対象事業所</h3>
        <ul>
          <li>中規模以上の事務所ビル（5階建以上が目安）</li>
          <li>工場・物流倉庫（生産機械等の電力消費が大きい）</li>
          <li>大規模商業施設・スーパー・百貨店</li>
          <li>病院・福祉施設（医療機器・空調の電力消費）</li>
          <li>学校・研究施設</li>
          <li>大規模マンション（共用部の電力消費）</li>
          <li>ホテル・宿泊施設</li>
        </ul>

        <h3>対象外となるケース</h3>
        <ul>
          <li>一般家庭（低圧契約）</li>
          <li>小規模事業所（電力契約50kW未満の低圧受電）</li>
          <li>小規模太陽光発電（10kW未満）</li>
        </ul>
      </section>

      <section id="regulation" class="cl-section">
        <h2>保安規程と届出</h2>
        <p>自家用電気工作物の設置者は、<strong>事業所ごとに「保安規程」を作成し、経済産業大臣（産業保安監督部）に届出</strong>する義務があります（電気事業法第42条）。</p>

        <h3>保安規程の記載事項</h3>
        <ol>
          <li>保安組織体制（責任者・主任技術者・実務担当者の役職）</li>
          <li>主任技術者の職務範囲・権限</li>
          <li>点検計画（月次・年次の具体的スケジュール）</li>
          <li>運転操作の手順・記録方法</li>
          <li>事故発生時の対応手順・連絡体制</li>
          <li>従事者の教育・訓練計画</li>
          <li>記録の保管方法・期間</li>
        </ol>

        <h3>届出のタイミング</h3>
        <ul>
          <li><strong>設置工事開始前</strong>：保安規程の初回届出</li>
          <li><strong>変更時</strong>：組織変更・点検計画変更時の変更届出</li>
          <li><strong>主任技術者変更時</strong>：選任・解任の届出</li>
          <li><strong>使用前自主検査</strong>：設備使用開始前の検査結果届出</li>
        </ul>

        <h3>届出書類のテンプレート</h3>
        <p>経済産業省の各産業保安監督部のWebサイトで標準フォーマットが公開されています。電気保安法人や電気管理技術者に作成を委託するのが実務上は標準で、自社作成は誤記による不受理リスクがあります。</p>
      </section>

      <section id="engineer" class="cl-section">
        <h2>電気主任技術者の選任</h2>
        <p>自家用電気工作物の設置者は、<strong>電気主任技術者を選任</strong>する必要があります（電気事業法第43条）。電力会社から受電する電圧によって必要な資格区分が異なります。</p>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>受電電圧と必要な主任技術者資格</caption>
            <thead><tr><th>受電電圧</th><th>必要な資格</th></tr></thead>
            <tbody>
              <tr><th scope="row">5万V未満（高圧6.6kV含む）</th><td>第三種電気主任技術者以上</td></tr>
              <tr><th scope="row">17万V未満</th><td>第二種電気主任技術者以上</td></tr>
              <tr><th scope="row">17万V以上</th><td>第一種電気主任技術者</td></tr>
            </tbody>
          </table>
        </div>

        <h3>選任方式の選択肢</h3>
        <ul>
          <li><strong>専任</strong>：その事業所専属の主任技術者（自社雇用）</li>
          <li><strong>兼任</strong>：複数事業所を一人の主任技術者が兼任（経産省承認）</li>
          <li><strong>外部委託</strong>：電気保安法人・電気管理技術者への委託</li>
        </ul>

        <h3>主任技術者の責任範囲</h3>
        <p>主任技術者は<strong>「保安監督」</strong>の責任を負います。具体的には、保安規程の遵守確認、点検作業の実施・指揮、事故時の応急処置の指示、経産省・電力会社への報告対応など。事故が発生した場合、主任技術者個人にも管理責任が問われる可能性があります。</p>
      </section>

      <section id="outsource" class="cl-section">
        <h2>外部委託承認制度（電気保安法人）</h2>
        <p>中小規模の事業所では、社内に電気主任技術者を抱える人件費が大きな負担になります。そこで活用されるのが<strong>「外部委託承認制度」</strong>です。</p>

        <h3>外部委託の要件</h3>
        <ul>
          <li>受電電圧7,000V以下、契約電力2,000kW未満（電気保安法人なら2,000kW以上も可）</li>
          <li>非常用予備発電設備の出力1,000kW未満</li>
          <li>太陽電池発電設備の出力2,000kW未満</li>
          <li>その他、経済産業省令で定める基準を満たすこと</li>
        </ul>

        <h3>委託先の選択肢</h3>
        <ul>
          <li><strong>電気保安法人</strong>：法人として保安業務を提供。複数の電気管理技術者を抱え、安定供給が可能</li>
          <li><strong>電気管理技術者</strong>：個人として保安業務を提供。費用が安いが、退職・廃業リスクあり</li>
        </ul>

        <h3>委託料金の相場</h3>
        <p>受電電力・点検頻度・地域により異なりますが、おおよそ<strong>月額2万円〜10万円</strong>が中心レンジ。社内主任技術者の人件費（年600万円超）と比べると圧倒的に安価なため、中小規模事業所では外部委託が標準となっています。</p>

        <h3>外部委託の手続き</h3>
        <ol>
          <li>電気保安法人・電気管理技術者と委託契約締結</li>
          <li>経済産業大臣への外部委託承認申請</li>
          <li>承認後、保安規程の変更届出</li>
          <li>運用開始</li>
        </ol>
      </section>

      <section id="monthly" class="cl-section">
        <h2>月次点検（通電中）</h2>
        <p>月次点検は<strong>毎月（または保安規程に基づき隔月）に実施する通電中の点検</strong>です。電気を止めずに目視・測定で異常の有無を確認します。</p>

        <h3>主な点検項目</h3>
        <ol>
          <li>計器値の読取（電圧・電流・電力）</li>
          <li>変圧器・遮断器の温度測定（赤外線サーモグラフィ）</li>
          <li>異常音・振動・においの確認</li>
          <li>絶縁油の漏れ・劣化の目視</li>
          <li>盤面・端子部の汚れ・腐食状況</li>
          <li>接地線の接続状態</li>
          <li>非常用照明・換気装置の作動確認</li>
        </ol>

        <h3>月次点検の実施者</h3>
        <p>原則として電気主任技術者または保安規程で定められた実務担当者が実施。外部委託の場合は委託先の電気管理技術者が訪問して実施します。</p>

        <h3>記録の作成</h3>
        <p>点検実施日・点検者氏名・測定値・異常の有無を点検記録票に記入。<strong>異常がなくても記録は必要</strong>です。記録は3年間保管します。</p>
      </section>

      <section id="annual" class="cl-section">
        <h2>年次点検（停電を伴う精密点検）</h2>
        <p>年次点検は<strong>年1回、設備を停電させて実施する精密点検</strong>です。月次点検では確認できない絶縁性能・保護動作を詳細に検査します。</p>

        <h3>主な点検項目</h3>
        <ol>
          <li>絶縁抵抗測定（メガー試験）</li>
          <li>接地抵抗測定</li>
          <li>保護継電器の動作試験（過電流・地絡）</li>
          <li>遮断器・断路器の動作試験</li>
          <li>変圧器の絶縁油試験（必要に応じて）</li>
          <li>電線・端子の締付け確認・増締め</li>
          <li>盤内清掃・換気フィルタ交換</li>
          <li>蓄電池・無停電電源装置（UPS）の試験</li>
        </ol>

        <h3>停電作業の事前準備</h3>
        <ul>
          <li>停電日時の利用者への事前告知（1〜2週間前）</li>
          <li>業務継続のための代替手段（バックアップ電源・営業時間調整）</li>
          <li>電力会社への停電作業届出（必要に応じて）</li>
          <li>従業員への当日対応指示</li>
        </ul>

        <h3>年次点検の費用</h3>
        <p>事業所規模・受電電圧・点検範囲により異なりますが、<strong>10万円〜100万円程度</strong>が中心レンジ。大規模設備や特殊機器を含む場合はさらに高額になります。電気保安法人との年間契約に含まれている場合と別途精算の場合があるため、契約書を確認してください。</p>
      </section>

      <section id="penalties" class="cl-section">
        <h2>違反時の罰則と監督官庁</h2>

        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>電気事業法の主な罰則</caption>
            <thead><tr><th>違反内容</th><th>罰則</th></tr></thead>
            <tbody>
              <tr><th scope="row">保安規程未届出・主任技術者未選任</th><td>300万円以下の罰金（第115条）</td></tr>
              <tr><th scope="row">点検義務違反・記録不備</th><td>30万円以下の罰金</td></tr>
              <tr><th scope="row">事故報告義務違反</th><td>30万円以下の罰金</td></tr>
              <tr><th scope="row">経産省の改善命令違反</th><td>1年以下の懲役または100万円以下の罰金</td></tr>
              <tr><th scope="row">感電死傷事故発生</th><td>業務上過失致死傷罪（刑法第211条・5年以下の懲役または100万円以下の罰金）</td></tr>
            </tbody>
          </table>
        </div>

        <h3>監督官庁</h3>
        <p>電気事業法の所管は<strong>経済産業省（産業保安監督部）</strong>です。各地域に北海道・東北・関東東北・中部近畿・中国四国・九州・那覇の産業保安監督部があり、所管事業所に対する立入検査・指導を行います。</p>

        <h3>違反発覚のパターン</h3>
        <ul>
          <li>定期立入検査（数年に1回）</li>
          <li>感電・火災事故発生時の調査</li>
          <li>電気保安法人からの保安規程未遵守の通報</li>
          <li>建物売却・改修時の調査での記録不備発覚</li>
          <li>従業員・元従業員からの告発</li>
        </ul>
      </section>

      <section id="tips" class="cl-section">
        <h2>実務上のポイント</h2>

        <h3>外部委託の選択が中小事業所の現実解</h3>
        <p>自社で電気主任技術者を雇用する人件費（年600〜1,000万円）を考えると、<strong>中小規模の事業所は外部委託が圧倒的に有利</strong>です。月額2万〜10万円で同等の保安体制が構築できます。電気保安法人は信頼性が高く、廃業リスクも低いため、長期契約に適しています。</p>

        <h3>キュービクルの更新計画を立てる</h3>
        <p>キュービクルの法定耐用年数規定はありませんが、JIS C 4620では更新目安20〜25年が示されています。<strong>築20年以上のキュービクル</strong>は年次点検時に詳細な劣化診断を依頼し、更新計画を立て始めるのが安全です。30年を過ぎると故障による停電リスクが急増し、緊急対応のコストが計画更新の数倍に達する場合もあります。</p>

        <h3>停電作業日の業務影響を最小化する</h3>
        <p>年次点検時の停電は事業継続への影響が大きいため、<strong>休日・夜間に実施</strong>するのが基本。多くの電気保安法人は土日・深夜の作業に対応します。割増料金がかかりますが、業務継続への影響と比較すれば妥当な投資です。</p>

        <h3>事故報告の迅速化</h3>
        <p>電気事故が発生した場合、<strong>速報（24時間以内）・詳細報告（30日以内）</strong>を経産省（産業保安監督部）に提出する義務があります。報告遅れは別途違反になるため、事故発生時の連絡体制を保安規程で明確化しておくことが重要です。</p>
      </section>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          <div class="cl-faq-item">
            <dt>自家用電気工作物とは何ですか？</dt>
            <dd>電力会社から600V超の高圧・特別高圧で受電する事業所の電気設備全般。キュービクル・受変電設備・自家発電設備等が該当します。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>保安規程の届出はいつ必要ですか？</dt>
            <dd>設置工事開始前（送電前）に経済産業大臣（産業保安監督部）への届出が必要です。設置後の変更時も変更届出が必要です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>電気主任技術者は社内に置く必要がありますか？</dt>
            <dd>原則は社内選任。ただし外部委託承認制度により電気保安法人・電気管理技術者への委託が可能。中小規模事業所では外部委託が一般的です。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>月次点検と年次点検の違いは？</dt>
            <dd>月次点検は通電中の目視・測定（計器値・温度・異音）。年次点検は停電を伴う精密点検（絶縁抵抗測定・保護継電器試験等）。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>違反した場合の罰則は？</dt>
            <dd>保安規程違反・主任技術者未選任は300万円以下の罰金。感電死傷事故が発生すれば業務上過失致死傷罪の対象になります。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>キュービクルの更新時期は？</dt>
            <dd>法定耐用年数はないが、JIS C 4620では20〜25年が更新目安。30年超は故障リスクが急増するため計画更新が推奨されます。</dd>
          </div>
          <div class="cl-faq-item">
            <dt>記録の保管期間は？</dt>
            <dd>点検記録・事故報告書・主任技術者業務日誌は3年間保管が義務付けられています。</dd>
          </div>
        </dl>
      </section>

