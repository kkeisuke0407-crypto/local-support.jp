---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LegalDutySeries from '../../../components/LegalDutySeries.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '害虫駆除の法的義務ガイド｜建築物衛生法・食品衛生法(HACCP)の防除義務と罰則';
const description = '業務用害虫駆除（PCO）の法的義務を2026年最新版で解説。特定建築物に6か月ごとの生息状況調査を課す建築物衛生法、食品事業者にそ族・昆虫対策を求める食品衛生法(HACCP)、建築物ねずみ昆虫等防除業の登録、違反時の罰則、5年間の記録保存義務まで施設管理担当者向けにまとめました。';
const canonical = `${site.domain}/column/pest-control-horei-gimu/`;
const published = '2026-07-01';
const modified = '2026-07-01';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '害虫駆除の法的義務ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5600,
  articleSection: '法令・義務',
  keywords: '害虫駆除,法的義務,建築物衛生法,食品衛生法,HACCP,ねずみ昆虫等防除,特定建築物,IPM,建築物ねずみ昆虫等防除業,罰則,2026',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-pest-control.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '害虫駆除', serviceType: '建築物ねずみ昆虫等防除' },
  citation: [
    { '@type': 'Legislation', name: '建築物における衛生的環境の確保に関する法律（建築物衛生法）', url: 'https://elaws.e-gov.go.jp/document?lawid=345AC0000000020' },
    { '@type': 'Legislation', name: '食品衛生法', url: 'https://elaws.e-gov.go.jp/document?lawid=322AC0000000233' },
  ],
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '害虫駆除は法律で義務づけられていますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '建物や業種によります。延床面積3,000m²以上の特定建築物は建築物衛生法により、6か月以内ごとに1回、ねずみ・昆虫等の生息状況調査を行い、必要に応じて防除することが義務づけられています。また飲食店・食品工場など食品を扱う事業者は、2021年6月完全義務化のHACCPに沿った衛生管理の一環として、そ族（ねずみ）・昆虫の防除を継続的に行う必要があります。',
      },
    },
    {
      '@type': 'Question',
      name: '特定建築物とは何ですか？害虫駆除の義務はどう違いますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '特定建築物とは、延床面積3,000m²以上（学校教育法上の学校は8,000m²以上）で、事務所・店舗・百貨店・ホテル・集会場などの用途に使われる建築物です。特定建築物では建築物環境衛生管理基準に基づき、6か月以内ごとの生息状況調査と、統一的・計画的な防除（IPM＝総合的有害生物管理の考え方に基づく）が義務づけられ、その記録を5年間保存する必要があります。',
      },
    },
    {
      '@type': 'Question',
      name: '小さな飲食店でも害虫駆除の義務はありますか？',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '特定建築物に該当しない小規模店舗でも、食品を扱う場合は食品衛生法（HACCPに沿った衛生管理）により、そ族・昆虫の防除が求められます。具体的には、生息調査を年2回以上（発生しやすい環境では月1回以上）行い、発生を認めた場合に駆除を実施し、その記録を残すことが一般衛生管理の基準として定められています。',
      },
    },
    {
      '@type': 'Question',
