---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { columns, type ColumnItem } from '../../data/columns';

const title = `コラム｜施設管理・設備メンテナンスの実務情報｜${site.name}`;
const description = '受水槽清掃・アスベスト調査・ダクト清掃・シャッター点検・消防設備点検・グリストラップ清掃・業務用エアコン・害虫駆除・看板点検など、施設管理に関わる費用相場・法定義務・業者選びの実務情報をカテゴリ別にまとめたコラムです。施設管理担当者向け。';
const canonical = `${site.domain}/column/`;

const categoryMeta: Record<string, { description: string; serviceHref?: string; hubHref?: string }> = {
  '施設管理ガイド': {
    description: '複数の法定点検・清掃・報告を年間で管理するための横断ガイドです。',
    hubHref: '/category/legal-inspection/',
  },
  '受水槽清掃': {
    description: '費用相場、法定義務、業者選び、補助金、罰則まで受水槽管理の実務を整理しています。',
    serviceHref: '/jusuisou-seisou/',
    hubHref: '/category/legal-inspection/',
  },
  'アスベスト調査・除去': {
    description: '事前調査・除去費用、法令義務、補助金、違反リスクを施設管理者向けに整理しています。',
    serviceHref: '/asbestos/',
    hubHref: '/category/repair-construction/',
  },
  'ダクト清掃': {
    description: '厨房・空調ダクトの費用、消防法との関係、補助金、経費処理、火災リスクを解説しています。',
    serviceHref: '/duct/',
    hubHref: '/category/hygiene-cleaning/',
  },
  '消防設備点検': {
    description: '消防設備点検の法定義務、点検頻度、報告、費用相場を確認できます。',
    serviceHref: '/shobo-setsubi/',
    hubHref: '/category/legal-inspection/',
  },
  'グリストラップ清掃': {
    description: '飲食店・厨房施設向けに、清掃費用、法令、廃棄物処理、HACCP対応を整理しています。',
    serviceHref: '/grease-trap/',
    hubHref: '/category/hygiene-cleaning/',
  },
  '業務用エアコン': {
    description: '業務用エアコンの洗浄・修理費用とフロン排出抑制法の点検義務を確認できます。',
    serviceHref: '/aircon-business/',
    hubHref: '/category/hygiene-cleaning/',
  },
  '害虫駆除': {
    description: '業務用害虫駆除の費用相場と、食品事業者のHACCP対応・防除記録を整理しています。',
    serviceHref: '/pest-control/',
    hubHref: '/category/hygiene-cleaning/',
  },
  '看板点検': {
    description: '屋外広告物・看板点検の費用相場、条例対応、落下事故リスクを確認できます。',
    serviceHref: '/signboard-inspection/',
    hubHref: '/category/legal-inspection/',
  },
  'シャッター点検・修理': {
    description: '防火シャッター・電動シャッターの点検修理費用、定期検査義務、罰則を整理しています。',
    serviceHref: '/shutter/',
    hubHref: '/category/repair-construction/',
  },
  '特殊建築物': {
    description: '建築基準法第12条に基づく特殊建築物定期調査の対象・頻度・報告義務を確認できます。',
    serviceHref: '/tokushu-kenchiku/',
    hubHref: '/category/legal-inspection/',
  },
  'エレベーター': {
    description: '昇降機の定期検査報告、保守点検契約、所有者責任を整理しています。',
    serviceHref: '/elevator-hoshu/',
    hubHref: '/category/legal-inspection/',
  },
  '防火対象物点検': {
    description: '消防法に基づく防火対象物点検の対象施設、報告サイクル、特例認定制度を解説しています。',
    serviceHref: '/bouka-tenken/',
    hubHref: '/category/legal-inspection/',
  },
  '自家用電気': {
    description: 'キュービクルなど自家用電気工作物の保安規程、主任技術者、月次・年次点検を確認できます。',
    serviceHref: '/jikayou-denki/',
    hubHref: '/category/legal-inspection/',
  },
  '浄化槽': {
    description: '浄化槽法に基づく保守点検・清掃・法定検査の義務と管理者責任を整理しています。',
    serviceHref: '/johkasou/',
    hubHref: '/category/legal-inspection/',
  },
  'フロン点検': {
    description: '業務用エアコン・冷凍冷蔵設備の簡易点検、定期点検、記録保存義務を確認できます。',
    serviceHref: '/furon-tenken/',
    hubHref: '/category/legal-inspection/',
  },
};

const groupedColumns = Object.entries(
  columns.reduce<Record<string, ColumnItem[]>>((acc, column) => {
    acc[column.category] = acc[column.category] ?? [];
    acc[column.category].push(column);
    return acc;
  }, {})
).map(([category, items], index) => ({
  id: `category-${index + 1}`,
  category,
  items,
  ...categoryMeta[category],
}));

const themeGroups = [
  {
    id: 'cost',
    label: '費用相場・見積',
    description: '費用レンジ、追加費用、見積書の見方を先に確認したい方向け。',
    items: columns.filter((c) => /費用相場|費用は経費|補助金|助成金/.test(c.title)),
  },
  {
    id: 'law',
    label: '法令・義務',
    description: '法定点検、行政報告、記録保存、管理者責任を把握したい方向け。',
    items: columns.filter((c) => /法定義務|法令義務|点検義務|保守点検|安全点検|法的義務/.test(c.title)),
  },
  {
    id: 'risk',
    label: '罰則・事故リスク',
    description: '未対応時の罰則、行政指導、事故・保険免責リスクを確認したい方向け。',
    items: columns.filter((c) => /罰則|怠る|違反|リスク|火災/.test(c.title)),
  },
  {
    id: 'operation',
    label: '年間管理・業者選び',
    description: '年間スケジュール、業者選定、HACCP記録など運用面を整えたい方向け。',
    items: columns.filter((c) => /年間|業者選び|チェックポイント|HACCP/.test(c.title)),
  },
].filter((theme) => theme.items.length > 0);

const latestColumns = [...columns]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 6);

const formatDate = (date: string) => date.replaceAll('-', '/');

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: canonical },
  ],
});

const collectionPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@id': `${site.domain}/#website` },
  about: groupedColumns.map((group) => ({
    '@type': 'Thing',
    name: group.category,
    description: group.description,
  })),
  mainEntity: {
    '@type': 'ItemList',
    name: `${site.name} コラム一覧`,
    numberOfItems: columns.length,
    itemListElement: columns.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${site.domain}${c.href}`,
      name: c.title,
    })),
  },
});
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理・設備メンテナンスの実務情報"
  jsonLdBlocks={[breadcrumbLd, collectionPageLd]}
>
  <section class="column-hero">
    <div class="sd-container">
      <nav class="column-crumbs" aria-label="パンくず">
        <a href="/">トップ</a>
        <span aria-hidden="true">›</span>
        <span>コラム</span>
      </nav>
      <p class="column-eyebrow">施設管理の実務ガイド</p>
      <h1>コラム</h1>
      <p class="column-lead">
        施設管理・設備メンテナンスに関わる費用相場、法定義務、業者選び、罰則リスクをカテゴリ別に整理しました。
        必要なサービスの実務情報から、見積依頼前の確認事項までまとめて確認できます。
      </p>
      <div class="column-stats" aria-label="コラム概要">
        <span><strong>{columns.length}</strong>記事</span>
        <span><strong>{groupedColumns.length}</strong>カテゴリ</span>
        <span><strong>{themeGroups.length}</strong>テーマ</span>
      </div>
    </div>
  </section>

  <section class="column-section column-section--nav">
    <div class="sd-container">
      <div class="column-section-head">
        <p class="column-section-kicker">カテゴリから探す</p>
        <h2>サービス別に記事を確認する</h2>
        <p>費用・法令・業者選びの記事を、対象サービスごとにまとめています。</p>
      </div>
      <div class="category-nav-grid">
        {groupedColumns.map((group) => (
          <a href={`#${group.id}`} class="category-nav-card">
            <span>{group.category}</span>
            <strong>{group.items.length}記事</strong>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="column-section">
    <div class="sd-container">
      <div class="column-section-head">
        <p class="column-section-kicker">テーマ別入口</p>
        <h2>知りたい内容から探す</h2>
        <p>費用、法令、リスク、運用の観点で横断的に確認できます。</p>
      </div>
      <div class="theme-grid">
        {themeGroups.map((theme) => (
          <article class="theme-card">
            <div class="theme-card-head">
              <span>{theme.items.length}記事</span>
              <h3>{theme.label}</h3>
              <p>{theme.description}</p>
            </div>
            <ul>
              {theme.items.slice(0, 4).map((item) => (
                <li><a href={item.href}>{item.title}</a></li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="column-section column-section--latest">
    <div class="sd-container">
      <div class="column-section-head">
        <p class="column-section-kicker">新着記事</p>
        <h2>最近追加した実務ガイド</h2>
      </div>
      <ul class="latest-list">
        {latestColumns.map((item) => (
          <li>
            <a href={item.href}>
              <span>{item.category}</span>
              <strong>{item.title}</strong>
              <time datetime={item.date}>{formatDate(item.date)}</time>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="column-section column-section--groups">
    <div class="sd-container">
      <div class="column-section-head">
        <p class="column-section-kicker">全記事一覧</p>
        <h2>カテゴリ別コラム</h2>
        <p>各カテゴリのサービスLPやカテゴリハブにも移動できます。</p>
      </div>

      <div class="column-groups">
        {groupedColumns.map((group) => (
          <section id={group.id} class="column-group" aria-labelledby={`${group.id}-title`}>
            <div class="column-group-head">
              <div>
                <p>{group.items.length}記事</p>
                <h3 id={`${group.id}-title`}>{group.category}</h3>
                <span>{group.description}</span>
              </div>
              <div class="column-group-links">
                {group.serviceHref && <a href={group.serviceHref}>サービスページを見る</a>}
                {group.hubHref && <a href={group.hubHref}>カテゴリハブを見る</a>}
              </div>
            </div>

            <ul class="col-list">
              {group.items.map((c) => (
                <li class="col-item">
                  <a href={c.href} class="col-link">
                    <div class="col-meta">
                      <span class="col-cat">{c.category}</span>
                      <time datetime={c.date} class="col-date">{formatDate(c.date)}</time>
                    </div>
                    <h4 class="col-title">{c.title}</h4>
                    <p class="col-excerpt">{c.excerpt}</p>
                    <span class="col-arrow">続きを読む</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.column-hero {
  padding: 52px 0 58px;
  background: linear-gradient(135deg, #0f2742 0%, #1a56db 100%);
  color: #fff;
}
.column-crumbs {
  margin-bottom: 18px;
  color: #bfdbfe;
  font-size: .78rem;
}
.column-crumbs a { color: #bfdbfe; text-decoration: underline; }
.column-crumbs span { margin: 0 6px; opacity: .78; }
.column-eyebrow {
  display: inline-flex;
  margin: 0 0 12px;
  padding: 5px 12px;
  border: 1px solid rgba(255, 255, 255, .24);
  border-radius: 999px;
  background: rgba(255, 255, 255, .12);
  color: #dbeafe;
  font-size: .76rem;
  font-weight: 900;
  letter-spacing: .08em;
}
.column-hero h1 {
  margin: 0 0 14px;
  color: #fff;
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.25;
}
.column-lead {
  max-width: 820px;
  margin: 0 0 22px;
  color: #e0f2fe;
  font-size: 1rem;
  line-height: 1.9;
}
.column-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.column-stats span {
  display: inline-flex;
  align-items: baseline;
  gap: 5px;
  padding: 9px 14px;
  border-radius: 12px;
  background: rgba(255, 255, 255, .12);
  border: 1px solid rgba(255, 255, 255, .2);
  color: #dbeafe;
  font-size: .84rem;
}
.column-stats strong {
  color: #fff;
  font-size: 1.15rem;
}
.column-section {
  padding: 46px 0;
  background: #fff;
}
.column-section--nav,
.column-section--latest {
  background: #f8fbff;
}
.column-section--groups {
  padding-bottom: 76px;
}
.column-section-head {
  max-width: 780px;
  margin-bottom: 22px;
}
.column-section-kicker {
  margin: 0 0 8px;
  color: var(--blue);
  font-size: .76rem;
  font-weight: 900;
  letter-spacing: .08em;
}
.column-section-head h2 {
  margin: 0 0 8px;
  color: var(--gray-900);
  font-size: clamp(1.45rem, 3vw, 2rem);
  line-height: 1.45;
}
.column-section-head p {
  margin: 0;
  color: var(--gray-700);
  font-size: .94rem;
  line-height: 1.8;
}
.category-nav-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 12px;
}
.category-nav-card {
  display: flex;
  min-height: 86px;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px;
  padding: 16px;
  border: 1px solid var(--gray-200);
  border-radius: 14px;
  background: #fff;
  color: inherit;
  text-decoration: none;
  transition: box-shadow .2s, transform .2s;
}
.category-nav-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.category-nav-card span {
  color: var(--gray-900);
  font-size: .92rem;
  font-weight: 900;
  line-height: 1.45;
}
.category-nav-card strong {
  color: var(--blue);
  font-size: .78rem;
}
.theme-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 16px;
}
.theme-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 20px;
  border: 1px solid rgba(26, 86, 219, .14);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 10px 28px rgba(15, 23, 42, .05);
}
.theme-card-head span {
  display: inline-flex;
  margin-bottom: 8px;
  padding: 4px 9px;
  border-radius: 999px;
  background: var(--blue-light);
  color: var(--blue-dark);
  font-size: .72rem;
  font-weight: 900;
}
.theme-card h3 {
  margin: 0 0 8px;
  color: var(--gray-900);
  font-size: 1.05rem;
}
.theme-card p {
  margin: 0;
  color: var(--gray-700);
  font-size: .84rem;
  line-height: 1.75;
}
.theme-card ul,
.latest-list,
.col-list {
  list-style: none;
  padding: 0;
  margin: 0;
}
.theme-card ul {
  display: grid;
  gap: 8px;
}
.theme-card li a {
  display: block;
  color: var(--blue);
  font-size: .84rem;
  font-weight: 700;
  line-height: 1.65;
  text-decoration: none;
}
.theme-card li a:hover { text-decoration: underline; }
.latest-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 12px;
}
.latest-list a {
  display: grid;
  gap: 7px;
  height: 100%;
  padding: 18px;
  border: 1px solid var(--gray-200);
  border-radius: 14px;
  background: #fff;
  color: inherit;
  text-decoration: none;
}
.latest-list a:hover { box-shadow: var(--shadow-md); }
.latest-list span {
  color: var(--blue);
  font-size: .72rem;
  font-weight: 900;
}
.latest-list strong {
  color: var(--gray-900);
  font-size: .93rem;
  line-height: 1.55;
}
.latest-list time {
  color: var(--gray-500);
  font-size: .75rem;
}
.column-groups {
  display: grid;
  gap: 28px;
}
.column-group {
  scroll-margin-top: 90px;
  padding: 24px;
  border: 1px solid var(--gray-200);
  border-radius: 18px;
  background: #fff;
}
.column-group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}
.column-group-head p {
  margin: 0 0 6px;
  color: var(--blue);
  font-size: .74rem;
  font-weight: 900;
}
.column-group-head h3 {
  margin: 0 0 8px;
  color: var(--gray-900);
  font-size: 1.25rem;
}
.column-group-head span {
  display: block;
  max-width: 680px;
  color: var(--gray-700);
  font-size: .88rem;
  line-height: 1.75;
}
.column-group-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
}
.column-group-links a {
  display: inline-flex;
  justify-content: center;
  min-width: 148px;
  padding: 9px 12px;
  border-radius: 999px;
  background: var(--gray-100);
  color: var(--blue);
  font-size: .78rem;
  font-weight: 900;
  text-decoration: none;
}
.column-group-links a:hover {
  background: var(--blue-light);
}
.col-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 16px;
}
.col-item {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: 12px;
  overflow: hidden;
  transition: box-shadow .2s, transform .2s;
}
.col-item:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.col-link {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 22px;
  color: inherit;
  text-decoration: none;
}
.col-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin-bottom: 10px;
}
.col-cat {
  background: var(--blue-light);
  color: var(--blue-dark);
  font-size: .72rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 99px;
  letter-spacing: .04em;
}
.col-date {
  font-size: .78rem;
  color: var(--gray-500);
}
.col-title {
  font-size: 1rem;
  font-weight: 800;
  color: var(--gray-900);
  line-height: 1.55;
  margin: 0 0 10px;
}
.col-excerpt {
  color: var(--gray-700);
  font-size: .86rem;
  line-height: 1.8;
  margin: 0 0 14px;
}
.col-arrow {
  margin-top: auto;
  color: var(--blue);
  font-size: .84rem;
  font-weight: 800;
}
@media (max-width: 760px) {
  .column-hero { padding: 40px 0 44px; }
  .column-section { padding: 36px 0; }
  .column-group { padding: 18px; }
  .column-group-head {
    flex-direction: column;
  }
  .column-group-links {
    width: 100%;
    justify-content: flex-start;
  }
  .column-group-links a {
    min-width: 0;
    flex: 1 1 150px;
  }
}
@media (max-width: 600px) {
  .col-link { padding: 18px; }
  .col-title { font-size: .96rem; }
}
</style>
