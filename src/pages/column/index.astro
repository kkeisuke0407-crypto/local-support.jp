---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const title = `コラム｜施設管理・設備メンテナンスの実務情報｜${site.name}`;
const description = '受水槽清掃・アスベスト調査・ダクト清掃・シャッター点検・消防設備点検・グリストラップ清掃・業務用エアコン・害虫駆除・看板点検など、施設管理に関わる費用相場・法定義務・業者選びの実務情報をまとめたコラムです。施設管理担当者向け。';
const canonical = `${site.domain}/column/`;

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: canonical },
  ],
});

interface ColumnItem {
  href: string;
  category: string;
  title: string;
  excerpt: string;
  date: string;
}

const columns: ColumnItem[] = [
  {
    href: '/column/jusuisou-seisou-hiyo-sohba/',
    category: '受水槽清掃',
    title: '受水槽清掃の費用相場2026｜規模別の料金・追加費用・業者選びの完全ガイド',
    excerpt: '受水槽清掃の費用相場を規模別に解説。水質検査・排水処理・高所作業などの付帯費用、自治体別の運用差、業者選びのチェックポイントまでをまとめた施設管理担当者向け完全ガイド。',
    date: '2026-05-26',
  },
  {
    href: '/column/jusuisou-seisou-horei-gimu/',
    category: '受水槽清掃',
    title: '受水槽清掃の法定義務ガイド2026｜水道法・建築物衛生法の要点と違反ペナルティ',
    excerpt: '水道法第34条の2が定める年1回以上の清掃義務と、建築物衛生法の特定建築物追加要件を整理。違反時の罰則・年間管理スケジュール・保存すべき書類一覧まで解説。',
    date: '2026-05-26',
  },
  {
    href: '/column/jusuisou-seisou-gyosha-sentaku/',
    category: '受水槽清掃',
    title: '受水槽清掃の業者選び完全ガイド2026｜資格・実績・見積書で失敗しない10のチェックポイント',
    excerpt: '建築物飲料水貯水槽清掃業の登録確認から水質検査・廃棄物マニフェスト・清掃証明書の発行まで、見積もり段階で必ず確認すべき10項目を解説した施設管理担当者向けガイド。',
    date: '2026-05-27',
  },
  {
    href: '/column/shobo-setsubi-horei-gimu/',
    category: '消防設備点検',
    title: '消防設備点検の法定義務ガイド2026｜機器点検・総合点検の頻度と罰則をまるごと解説',
    excerpt: '消防法第17条の3の3に基づく消防設備点検の義務を施設管理担当者向けに解説。機器点検（半年）・総合点検（年1）の違い、所轄消防署への報告サイクル、有資格者要件、違反時の30万円以下の罰金までまとめました。',
    date: '2026-05-26',
  },
  {
    href: '/column/grease-trap-horei-gimu/',
    category: 'グリストラップ清掃',
    title: 'グリストラップ清掃の法的義務ガイド2026｜下水道法・建築基準法・廃棄物処理法の要点',
    excerpt: '飲食店・厨房施設のグリストラップ清掃を規制する下水道法・水質汚濁防止法・建築基準法・廃棄物処理法を整理。清掃頻度の業界標準、産業廃棄物の取扱い、マニフェスト発行・保管義務、違反時のリスクを解説。',
    date: '2026-05-26',
  },
  {
    href: '/column/aircon-business-furon-tenken/',
    category: '業務用エアコン',
    title: 'フロン排出抑制法の点検義務ガイド2026｜業務用エアコン管理者が知るべき簡易点検・定期点検の要点',
    excerpt: '業務用エアコン・冷凍冷蔵機器の管理者に課されるフロン排出抑制法上の点検義務を解説。3か月に1回の簡易点検、規模別の定期点検（7.5kW以上3年・50kW以上1年）、漏洩量算定・国への報告、廃棄時のフロン回収までを整理。',
    date: '2026-05-26',
  },
  {
    href: '/column/pest-control-haccp/',
    category: '害虫駆除',
    title: 'HACCP制度化で必須になった害虫対策ガイド2026｜飲食・食品事業者の防除記録の作り方',
    excerpt: '2021年6月から原則すべての食品事業者にHACCPに沿った衛生管理が義務化。一般衛生管理の一項目「そ族・昆虫対策」について月次モニタリング・記録様式・保健所立入時に求められる書類の整え方を整理。',
    date: '2026-05-26',
  },
  {
    href: '/column/signboard-inspection-horei-gimu/',
    category: '看板点検',
    title: '看板の安全点検は法的義務？2026年版｜屋外広告物条例と落下事故の管理者責任',
    excerpt: '屋外広告物法および各自治体の条例に基づく看板・サインの安全点検義務を解説。有資格者点検の義務化、許可更新時の報告書、民法第717条の工作物責任、過去の重大事故事例までを整理。',
    date: '2026-05-26',
  },
  {
    href: '/column/shobo-setsubi-hiyo-sohba/',
    category: '消防設備点検',
    title: '消防設備点検の費用相場2026｜建物規模・契約形態・是正工事の単価をまるごと解説',
    excerpt: '消防設備点検の費用相場を共同住宅・オフィス・商業施設・ホテル・工場の建物規模別に整理。機器点検・総合点検・所轄消防署への報告までの年間契約料金、是正工事の単価、複数物件契約での割引まで解説。',
    date: '2026-05-26',
  },
  {
    href: '/column/grease-trap-hiyo-sohba/',
    category: 'グリストラップ清掃',
    title: 'グリストラップ清掃の費用相場2026｜店舗規模別・頻度別の料金ガイドと追加コストの見抜き方',
    excerpt: 'グリストラップ清掃の費用相場を店舗規模別・清掃頻度別に整理。バスケット清掃・全槽清掃・配管高圧洗浄の単価、汚泥産廃処分費の内訳、月間契約と単発のコスト差まで解説。',
    date: '2026-05-26',
  },
  {
    href: '/column/aircon-business-hiyo-sohba/',
    category: '業務用エアコン',
    title: '業務用エアコン洗浄・修理の費用相場2026｜分解洗浄・修理・入替の判断基準',
    excerpt: '業務用エアコンの洗浄・修理・入替の費用相場を機種・規模別に解説。フィルター清掃・熱交換器洗浄・完全分解洗浄の単価、修理（軽微〜重整備）の費用レンジ、入替判断基準、緊急修理の追加コストまで。',
    date: '2026-05-26',
  },
  {
    href: '/column/pest-control-hiyo-sohba/',
    category: '害虫駆除',
    title: '業務用害虫駆除（PCO）の費用相場2026｜業種別・契約形態別の料金ガイド',
    excerpt: '飲食店・食品工場・ホテル・福祉施設の業務用害虫駆除（PCO）の費用相場を業種別・契約形態別に整理。月次モニタリング契約・スポット駆除・トコジラミ・大型施設対応の料金まで解説。',
    date: '2026-05-26',
  },
  {
    href: '/column/signboard-inspection-hiyo-sohba/',
    category: '看板点検',
    title: '看板点検の費用相場2026｜サイズ別・高所作業車込みの料金と補修工事の単価',
    excerpt: '看板・屋外広告物点検の費用相場をサイズ別（壁面・屋上広告塔・突き出し看板）に整理。高所作業車・足場の手配費用、電飾サインの電気点検追加コスト、点検後の補修工事単価まで解説。',
    date: '2026-05-26',
  },
  {
    href: '/column/asbestos-hiyo-sohba/',
    category: 'アスベスト調査・除去',
    title: 'アスベスト調査・除去の費用相場2026｜事前調査5〜20万円・除去工事1〜10万円/㎡を規模別に解説',
    excerpt: 'アスベスト事前調査・除去工事の費用相場を規模別に解説。レベル1〜3の工法差、自治体補助金活用、業者選びのポイントまでを整理した施設管理担当者向けガイド。',
    date: '2026-05-27',
  },
  {
    href: '/column/asbestos-horei-gimu/',
    category: 'アスベスト調査・除去',
    title: 'アスベスト法令義務ガイド2026｜大気汚染防止法・石綿障害予防規則の要点と違反ペナルティ',
    excerpt: '2022年4月の報告義務化・2023年10月の有資格者必須化を中心に、アスベスト対策の法的義務を整理。違反罰則・届出書類・労基署対応のポイントまで解説。',
    date: '2026-05-27',
  },
  {
    href: '/column/duct-hiyo-sohba/',
    category: 'ダクト清掃',
    title: 'ダクト清掃の費用相場2026｜厨房5〜30万円・空調10〜100万円を規模・種別ごとに解説',
    excerpt: '厨房排気ダクト・空調ダクト清掃の費用相場を規模別に解説。清掃工法の違い、付帯費用の内訳、清掃頻度の判断基準、業者選びのポイントまで整理した施設管理担当者向けガイド。',
    date: '2026-05-27',
  },
  {
    href: '/column/duct-horei-gimu/',
    category: 'ダクト清掃',
    title: 'ダクト清掃の法令義務ガイド2026｜消防法・建築物衛生法の要点と火災時の管理責任',
    excerpt: '消防法の防火管理義務と建築物衛生法の空調管理基準を整理。消防署立入検査での確認ポイント、火災保険との関係、清掃証明書の保管まで解説。',
    date: '2026-05-27',
  },
  {
    href: '/column/shutter-hiyo-sohba/',
    category: 'シャッター点検・修理',
    title: 'シャッター点検・修理の費用相場2026｜点検1〜3万円・修理2万円〜を種別・規模ごとに解説',
    excerpt: '防火シャッター・電動シャッターの点検・修理費用を種別ごとに解説。部品交換・交換費用の目安、業者選びで確認すべき資格要件まで整理した施設管理担当者向けガイド。',
    date: '2026-05-27',
  },
  {
    href: '/column/shutter-horei-gimu/',
    category: 'シャッター点検・修理',
    title: 'シャッター点検の法令義務ガイド2026｜建築基準法第12条・防火設備検査の要点と罰則',
    excerpt: '建築基準法第12条に基づく防火シャッターの定期検査義務を解説。対象建物・資格要件・報告書提出先・100万円以下の罰金リスクまでまとめました。',
    date: '2026-05-27',
  },
];

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${site.name} コラム一覧`,
  itemListElement: columns.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${site.domain}${c.href}`,
    name: c.title,
  })),
});
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理・設備メンテナンスの実務情報"
  jsonLdBlocks={[breadcrumbLd, itemListLd]}
>
  <section class="hero hero--simple">
    <div class="sd-container">
      <h1 class="hero-h1">コラム</h1>
      <p class="hero-sub-simple">施設管理・設備メンテナンスに関わる費用相場・法定義務・業者選びの実務情報</p>
    </div>
  </section>

  <section class="sd-section section-white">
    <div class="sd-container">
      <ul class="col-list">
        {columns.map((c) => (
          <li class="col-item">
            <a href={c.href} class="col-link">
              <div class="col-meta">
                <span class="col-cat">{c.category}</span>
                <time datetime={c.date} class="col-date">{c.date.replaceAll('-', '/')}</time>
              </div>
              <h2 class="col-title">{c.title}</h2>
              <p class="col-excerpt">{c.excerpt}</p>
              <span class="col-arrow">続きを読む →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
.col-list {
  list-style: none;
  padding: 0;
  max-width: 880px;
  margin: 0 auto;
  display: grid;
  gap: 20px;
}
.col-item {
  background: #fff;
  border: 1px solid var(--gray-200);
  border-radius: 12px;
  overflow: hidden;
  transition: box-shadow .2s, transform .2s;
}
.col-item:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.col-link {
  display: block;
  padding: 24px 28px;
  color: inherit;
}
.col-meta {
  display: flex;
  gap: 12px;
  align-items: center;
  margin-bottom: 10px;
}
.col-cat {
  background: var(--blue-light);
  color: var(--blue-dark);
  font-size: .72rem;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 99px;
  letter-spacing: .04em;
}
.col-date {
  font-size: .78rem;
  color: var(--gray-500);
}
.col-title {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--gray-900);
  line-height: 1.55;
  margin-bottom: 10px;
}
.col-excerpt {
  font-size: .88rem;
  color: var(--gray-700);
  line-height: 1.8;
  margin-bottom: 12px;
}
.col-arrow {
  font-size: .85rem;
  font-weight: 700;
  color: var(--blue);
}
@media (max-width: 600px) {
  .col-link { padding: 18px 20px; }
  .col-title { font-size: .98rem; }
}
</style>
