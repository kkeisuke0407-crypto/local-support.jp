---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '消防設備点検の費用相場｜公開料金表で見る建物の用途・面積別の目安';
const description = '消防設備点検の費用を、点検会社が公開している料金表をもとに整理。延べ面積と用途（マンション・事務所・商業施設・倉庫）別の点検1回あたりの目安、年間契約と単発の違い、実際の建物の年間費用の例、見積りで追加になりやすい費用までまとめています。';
const canonical = `${site.domain}/column/shobo-setsubi-hiyo-sohba/`;
const published = '2026-05-26';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '消防設備点検の費用相場ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '費用相場',
  keywords: '消防設備点検,費用,相場,料金表,機器点検,総合点検,年間契約,スポット点検,マンション,事務所',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-shobo-setsubi.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '消防設備点検' },
});

const faqItems = [
  { q: '消防設備点検の費用は年間でどのくらいですか？', a: '建物の面積・用途・設備で大きく変わります。大阪の点検会社（日消システムズ）が公開している例では、延べ300㎡・約10戸のマンションで年間5万円、1,600㎡の事務所ビルで年間11万円、1,200㎡の病院（診療所）で年間15万円でした（機器点検・総合点検・消防署への提出代行の合計）。' },
  { q: '年間契約と単発（スポット）の依頼、どちらが得ですか？', a: '同じ点検会社の公開例では、単発の総合点検は、年間契約の総合点検より1回あたり2〜5割ほど高く設定されていました。また法令では機器点検を6か月ごと、総合点検を1年ごとに行う必要があるため、単発の総合点検1回だけでは点検の義務を満たせません。' },
  { q: '見積りに含まれていないことが多い費用は？', a: '公開されている料金表では、消防署への報告書の提出代行（5,000〜10,000円の例）、交通費・諸経費、不在による再点検、休日・夜間の作業、消火器・避難器具以外の設備の点検などが別料金になっている例があります。見積りを比べるときは、含まれる範囲をそろえてください。' },
  { q: '点検後の是正工事（修理・交換）は別料金ですか？', a: '点検と是正工事は、別の見積り・別の契約になるのが一般的です。点検をした業者に工事を頼む義務はないため、金額が大きい場合はほかの業者の見積りと比べてから決められます。' },
  { q: '消防設備点検は自分でできますか？', a: '延べ面積1,000㎡以上の特定防火対象物、特定一階段等防火対象物などは、消防設備士または消防設備点検資格者による点検が必要です（消防法施行令第36条）。それ以外の建物は関係者が自ら点検することもできますが、試験器や報告書の様式が必要なため、業者に頼むのが一般的です。自分の建物がどちらに当たるかは「消防点検の義務チェック」で確認できます。' },
  { q: '共同住宅の点検費用は誰が負担しますか？', a: '共用部の点検費用は、管理組合が管理費から支出するのが一般的です。住戸内の感知器などの扱いは管理規約によって異なるため、規約を確認してください。' },
  { q: '年度の途中から契約できますか？', a: 'できます。前の業者の最後の点検から間が空きすぎないように日程を決め、前回の点検報告書を新しい業者に渡すと状況を把握してもらいやすくなります。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-shobo-setsubi.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>消防設備点検の費用相場ガイド</span>
        </nav>
        <span class="cl-cat">費用相場</span>
        <h1 class="cl-title">消防設備点検の費用相場｜公開料金表で見る建物の用途・面積別の目安</h1>
        <p class="cl-lead">
          消防設備点検の費用は、<strong>建物の面積・用途・設置されている設備・契約の形</strong>で大きく変わります。この記事では、<strong>点検会社が公開している料金表</strong>をもとに、点検1回あたりの目安、実際の建物の年間費用の例、年間契約と単発の違い、見積りで追加になりやすい費用を整理しました。数字はすべて出典を示しています。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年5月26日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 消防設備点検の費用はいくらですか？</p>
        <p class="cl-qa-a">A. <strong>点検会社が公開している料金表の例では、点検1回あたり、マンション・非商業施設で、延べ300㎡以下なら1〜2万円、1,000〜2,000㎡なら5〜8万円です。</strong>商業施設は同じ面積でも高めです。法令どおり機器点検と総合点検を行う年間では、おおよそ1回分の2倍に、消防署への提出代行費（5,000〜10,000円の例）が加わります。</p>
        <p class="cl-qa-src">※<a href="https://www.jafs.co.jp/tenken2.html" rel="noopener" target="_blank">日消システムズ（大阪府）の公開料金表</a>による（2026年9月確認）。地域・設備・業者で変わるため、正式な金額は業者の見積りでご確認ください。</p>
      </div>

      <ColumnCtaCard serviceSlug="shobo-setsubi" serviceName="消防設備点検" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#base-cost">延べ面積・用途別の目安（点検1回あたり）</a></li>
          <li><a href="#examples">実際の建物の年間費用の例</a></li>
          <li><a href="#others">ほかの点検会社の公開料金</a></li>
          <li><a href="#extras">見積りで追加になりやすい費用</a></li>
          <li><a href="#contract">年間契約と単発の違い</a></li>
          <li><a href="#zesei">是正工事の費用</a></li>
          <li><a href="#cheap">安すぎる見積りの注意点</a></li>
          <li><a href="#tips">見積比較のコツ</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>1回あたり</strong>：延べ300㎡以下で1〜2万円、1,000〜2,000㎡で5〜8万円（マンション・非商業施設の例）。商業施設は高め</li>
            <li><strong>年間</strong>：機器点検と総合点検でおおよそ1回分の2倍＋提出代行費。例：1,600㎡の事務所ビルで年間11万円</li>
            <li><strong>比べ方</strong>：提出代行・交通費・再点検などが含まれるかで金額が変わる。範囲をそろえて見積りを比べる</li>
          </ul>
        </div>
      </section>

      <section id="base-cost" class="cl-section">
        <h2>延べ面積・用途別の目安（点検1回あたり）</h2>
        <p>大阪府の点検会社・日消システムズが公開している目安価格です。<strong>総合点検1回の料金</strong>で、法令どおり機器点検と総合点検を行う年間契約では、おおよそこの2倍になると案内されています。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>点検1回あたりの目安価格（単位：円）</caption>
            <thead><tr><th>延べ面積</th><th>マンション</th><th>非商業施設</th><th>商業施設</th><th>倉庫・作業所</th></tr></thead>
            <tbody>
              <tr><th scope="row">〜300㎡</th><td>1万〜2万</td><td>1万〜2万</td><td>1万〜3万</td><td>1万〜3万</td></tr>
              <tr><th scope="row">300〜500㎡</th><td>2万〜4万</td><td>2万〜4万</td><td>2万〜5万</td><td>2万〜4万</td></tr>
              <tr><th scope="row">500〜1,000㎡</th><td>3万〜6万</td><td>3万〜6万</td><td>5万〜10万</td><td>4万〜8万</td></tr>
              <tr><th scope="row">1,000〜2,000㎡</th><td>5万〜8万</td><td>5万〜8万</td><td>8万〜15万</td><td>8万〜15万</td></tr>
              <tr><th scope="row">2,000〜3,000㎡</th><td>6万〜10万</td><td>6万〜10万</td><td>10万〜30万</td><td>10万〜20万</td></tr>
              <tr><th scope="row">3,000〜5,000㎡</th><td>8万〜20万</td><td>8万〜20万</td><td>16万〜40万</td><td>12万〜30万</td></tr>
              <tr><th scope="row">5,000〜10,000㎡</th><td>15万〜30万</td><td>15万〜30万</td><td>30万〜60万</td><td>20万〜45万</td></tr>
              <tr><th scope="row">10,000〜25,000㎡</th><td>30万〜60万</td><td>30万〜60万</td><td>50万〜100万</td><td>40万〜80万</td></tr>
              <tr><th scope="row">25,000㎡以上</th><td>50万〜</td><td>50万〜</td><td>100万〜</td><td>80万〜</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cl-note">出典：<a href="https://www.jafs.co.jp/tenken2.html" rel="noopener" target="_blank">日消システムズ「消防点検の参考費用」</a>（令和4年5月価格改訂、2026年9月確認）。料金の幅は、設置されている設備と数量の違いによるものとされています。交通費・諸経費と、消防署への提出費（5,000〜10,000円）は含まれていません。</p>
      </section>

      <section id="examples" class="cl-section">
        <h2>実際の建物の年間費用の例</h2>
        <p>同じ点検会社が公開している、建物ごとの年間契約（法定点検）と単発（スポット）の価格例です。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>年間契約と単発の価格例（単位：円）</caption>
            <thead><tr><th>建物</th><th>機器点検</th><th>総合点検</th><th>提出代行</th><th>年間合計</th><th>単発の総合点検</th></tr></thead>
            <tbody>
              <tr><th scope="row">マンション 300㎡（約10戸・入室なし）</th><td>20,000</td><td>25,000</td><td>5,000</td><td>50,000</td><td>35,000</td></tr>
              <tr><th scope="row">グループホーム 250㎡</th><td>25,000</td><td>30,000</td><td>5,000</td><td>60,000</td><td>45,000</td></tr>
              <tr><th scope="row">カラオケビル 700㎡</th><td>50,000</td><td>65,000</td><td>5,000</td><td>120,000</td><td>80,000</td></tr>
              <tr><th scope="row">作業所・工場・倉庫 800㎡</th><td>45,000</td><td>60,000</td><td>5,000</td><td>110,000</td><td>75,000</td></tr>
              <tr><th scope="row">病院（診療所）1,200㎡</th><td>65,000</td><td>80,000</td><td>5,000</td><td>150,000</td><td>100,000</td></tr>
              <tr><th scope="row">事務所ビル 1,600㎡</th><td>50,000</td><td>55,000</td><td>5,000</td><td>110,000</td><td>75,000</td></tr>
              <tr><th scope="row">マンション 1,700㎡（20戸）</th><td>40,000</td><td>45,000</td><td>5,000</td><td>90,000</td><td>60,000</td></tr>
              <tr><th scope="row">テナントビル 1,800㎡</th><td>75,000</td><td>90,000</td><td>5,000</td><td>160,000</td><td>110,000</td></tr>
              <tr><th scope="row">マンション 5,200㎡（130戸）</th><td>100,000</td><td>120,000</td><td>5,000</td><td>225,000</td><td>150,000</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cl-note">出典：<a href="https://www.jafs.co.jp/tenken2.html" rel="noopener" target="_blank">日消システムズ「各種建物の費用について」</a>（2026年9月確認）。単発の欄は総合点検1回のみの価格で、機器点検と提出代行は含みません。</p>
      </section>

      <section id="others" class="cl-section">
        <h2>ほかの点検会社の公開料金</h2>
        <p>ほかの点検会社も料金の目安を公開しています。<strong>1回分か年間かの記載がないもの</strong>もあるため、条件をそろえて比べるための参考にしてください。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>公開されている料金の例</caption>
            <thead><tr><th>点検会社</th><th>建物</th><th>料金</th></tr></thead>
            <tbody>
              <tr><th scope="row" rowspan="4"><a href="https://shoubou-teq.com/equipment/periodic-inspection/" rel="noopener" target="_blank">消防テック</a>（東京都）</th><td>オフィスビル・雑居ビル（1,000㎡未満）</td><td>39,000円（1室3,900円〜）</td></tr>
              <tr><td>マンション</td><td>45,000円〜71,500円（設備により）</td></tr>
              <tr><td>老人ホーム</td><td>45,500円〜65,000円（設備により）</td></tr>
              <tr><td>店舗</td><td>23,400円〜39,000円（設備により）</td></tr>
              <tr><th scope="row" rowspan="4"><a href="https://www.buil-repo.com/fireserviceact/price/" rel="noopener" target="_blank">ビューローベリタス</a></th><td>共同住宅（延床3,000㎡の例）</td><td>220,000円（税込）</td></tr>
              <tr><td>物販量販店・事務所ビル（同）</td><td>231,000円（税込）</td></tr>
              <tr><td>複合用途（同）</td><td>250,800円（税込）</td></tr>
              <tr><td>福祉施設（同）</td><td>275,000円（税込）</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cl-note">※いずれも各社の公開ページの記載どおり（2026年9月確認）。1回分か年間かは各社のページに明記がありません。</p>
      </section>

      <section id="extras" class="cl-section">
        <h2>見積りで追加になりやすい費用</h2>
        <p>公開されている料金表の注記には、次のような費用が別になると書かれています。見積りを比べるときは、これらが含まれているかをそろえてください。</p>
        <ul>
          <li><strong>消防署への報告書の提出代行</strong>：5,000〜10,000円（日消システムズ）。提出代行を別料金とする会社もあります（東和総合サービス）</li>
          <li><strong>交通費・諸経費</strong>：別途（日消システムズ）。東京23区・大阪市内以外は追加になる例もあります（東和総合サービス）</li>
          <li><strong>不在による再点検</strong>：別途（日消システムズ）</li>
          <li><strong>休日・夜間の作業日の指定</strong>：別途（日消システムズ）</li>
          <li><strong>消火器・避難器具以外の設備の点検</strong>：追加になる料金体系の例があります（東和総合サービス）</li>
          <li><strong>点検のお知らせの掲示・予備日の設定</strong>：追加になる例があります（東和総合サービス）</li>
        </ul>
        <p class="cl-note">出典：<a href="https://www.jafs.co.jp/tenken2.html" rel="noopener" target="_blank">日消システムズ</a>／<a href="https://www.to-wa.info/contents/3923/" rel="noopener" target="_blank">東和総合サービス「消防設備点検の費用とは？」</a>（2026年9月確認）</p>
      </section>

      <section id="contract" class="cl-section">
        <h2>年間契約と単発の違い</h2>
        <p>上の例では、単発（スポット）の総合点検は、年間契約の総合点検より<strong>1回あたり2〜5割ほど高く</strong>設定されていました（例：1,600㎡の事務所ビルで55,000円→75,000円）。</p>
        <p>また、法令では機器点検を6か月ごと、総合点検を1年ごとに行う必要があります。<strong>単発の総合点検1回だけでは点検の義務を満たせない</strong>ため、単発は消防署から点検を求められたときなどの臨時の対応と考え、継続する場合は年間契約で見積りを取るのが基本です。</p>
      </section>

      <section id="zesei" class="cl-section">
        <h2>是正工事の費用</h2>
        <p>点検で不良が見つかった設備の修理・交換（是正工事）は、点検とは別の見積り・別の契約になるのが一般的です。金額は機器の種類・メーカー・数量で大きく変わるため、ここでは目安を載せていません。</p>
        <ul>
          <li>点検の見積りを取るときに、主な部品や作業の単価表を出してもらう</li>
          <li>是正の提案には、写真・測定値・該当する基準を付けてもらう</li>
          <li>点検した業者に工事を頼む義務はないので、金額が大きいときはほかの業者の見積りと比べる</li>
        </ul>
      </section>

      <section id="cheap" class="cl-section">
        <h2>安すぎる見積りの注意点</h2>
        <p>ほかより極端に安い見積りは、必要な項目が抜けていないか確認してください。</p>
        <ul>
          <li><strong>資格者が点検するか</strong>：延べ面積1,000㎡以上の特定防火対象物などは、消防設備士または消防設備点検資格者の点検が必要です（消防法施行令第36条）</li>
          <li><strong>報告書の提出まで含むか</strong>：提出代行が別料金になっていないか</li>
          <li><strong>機器点検と総合点検の両方か</strong>：総合点検だけ、機器点検だけの見積りになっていないか</li>
          <li><strong>記録の中身</strong>：点検票・写真・測定値が残るか</li>
        </ul>
      </section>

      <section id="tips" class="cl-section">
        <h2>見積比較のコツ</h2>
        <ol>
          <li><strong>範囲をそろえる</strong>：「機器点検（6か月ごと）＋総合点検（1年ごと）＋消防署への提出代行」をセットで見積りを依頼する</li>
          <li><strong>別料金になる項目を確認する</strong>：交通費・再点検・休日夜間・設備の追加</li>
          <li><strong>資格者の在籍と資格の種類を確認する</strong>：建物の設備に必要な類の消防設備士がいるか</li>
          <li><strong>是正工事の単価表を先にもらう</strong>：点検費用が同じでも、是正の単価で総額が変わる</li>
          <li><strong>解約・更新の条件を確認する</strong>：自動更新の有無、解約の予告期間</li>
        </ol>
      </section>

