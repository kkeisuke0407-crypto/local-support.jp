---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '受水槽清掃は年1回が義務｜水道法・ビル管法の対象と罰則';
const description = '有効容量10m³を超える受水槽（簡易専用水道）は、水道法で年1回以上の清掃と登録検査機関などの検査が義務です。延べ面積3,000m²以上の事務所・店舗などの特定建築物は、建築物衛生法でも清掃・水質検査・帳簿の保存が必要です。10m³以下の条例・指導、怠った場合の流れと罰則まで、条文で確認して整理しました。';
const canonical = `${site.domain}/column/jusuisou-seisou-horei-gimu/`;
const published = '2026-05-26';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '受水槽清掃の法定義務', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '法令・義務',
  keywords: '受水槽清掃,義務,水道法,簡易専用水道,建築物衛生法,特定建築物,法定検査,小規模貯水槽,罰則',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
  citation: [
    { '@type': 'Legislation', name: '水道法', url: 'https://laws.e-gov.go.jp/law/332AC0000000177' },
    { '@type': 'Legislation', name: '水道法施行規則', url: 'https://laws.e-gov.go.jp/law/332M50000100045' },
    { '@type': 'Legislation', name: '建築物における衛生的環境の確保に関する法律', url: 'https://laws.e-gov.go.jp/law/345AC1000000020' },
    { '@type': 'Legislation', name: '建築物における衛生的環境の確保に関する法律施行規則', url: 'https://laws.e-gov.go.jp/law/346M50000100002' },
  ],
});

const faqItems = [
  { q: '受水槽清掃は法律で義務ですか？', a: '有効容量10m³を超える受水槽（簡易専用水道）は、水道法第34条の2により、水槽の掃除を毎年1回以上行い（施行規則第55条）、登録検査機関などの検査を毎年1回以上受ける（第56条）必要があります。延べ面積3,000m²以上の事務所・店舗などの特定建築物も、建築物衛生法で貯水槽の清掃を1年以内ごとに1回行います。' },
  { q: '10m³以下の受水槽は対象外ですか？', a: '水道法の簡易専用水道には当たりませんが、自治体によって定めがあります。たとえば東京都は条例で特定小規模貯水槽水道等に清掃などを求め、大阪府・大阪市は指導要領・要綱で年1回の清掃をお願いしています。所在地の保健所で確認してください。' },
  { q: '清掃業者は登録業者でなければいけませんか？', a: '法律上、登録業者への依頼は義務ではありません。建築物飲料水貯水槽清掃業の登録は、基準を満たす事業者が受けることができる任意の制度です（建築物衛生法第12条の2）。登録には機械器具・作業監督者・従事者研修の基準があるため、業者を比べるときの目安になります。' },
  { q: '記録はどのくらい保存しますか？', a: '特定建築物では、維持管理の状況を記載した帳簿書類を5年間保存する必要があります（建築物衛生法施行規則第20条）。簡易専用水道の法定検査では、水槽の清掃記録などの整理保存状況が確認されるため、清掃の報告書は継続して保管しておきましょう。' },
  { q: '義務を怠るとどうなりますか？', a: '簡易専用水道では、都道府県知事等から清掃などの措置を指示され（水道法第36条第3項）、従わないと給水停止を命じられることがあり（第37条）、命令違反は1年以下の拘禁刑又は100万円以下の罰金です（第53条）。法定検査を受けない場合は100万円以下の罰金です（第54条）。特定建築物では、改善命令違反や帳簿の不備などが30万円以下の罰金です（建築物衛生法第16条）。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>受水槽清掃の法定義務</span>
        </nav>
        <span class="cl-cat">受水槽清掃</span>
        <h1 class="cl-title">受水槽清掃は年1回が義務｜水道法・ビル管法の対象と罰則</h1>
        <p class="cl-lead">
          受水槽の清掃には、<strong>水道法（簡易専用水道）</strong>と<strong>建築物衛生法（特定建築物）</strong>の2つの法律が関わり、10m³以下の小さな受水槽には<strong>自治体の条例や指導</strong>があります。この記事では、どの受水槽に何が求められるのかと、怠った場合の流れを、条文で確認して整理します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年5月26日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 受水槽清掃は法律で義務ですか？</p>
        <p class="cl-qa-a">A. <strong>有効容量10m³を超える受水槽（簡易専用水道）は、水道法で「水槽の掃除を毎年1回以上」と「登録検査機関などの検査を毎年1回以上」が義務</strong>です。延べ面積3,000m²以上の事務所・店舗などの特定建築物は、建築物衛生法でも貯水槽の清掃を1年以内ごとに1回行います。</p>
        <p class="cl-qa-src">※水道法第34条の2、同法施行規則第55条・第56条、建築物衛生法施行規則第4条（e-Gov法令検索で2026年9月確認）</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#overview">対象と義務の全体像</a></li>
          <li><a href="#suido">水道法（簡易専用水道）</a></li>
          <li><a href="#biru">建築物衛生法（特定建築物）</a></li>
          <li><a href="#jichitai">10m³以下の受水槽（自治体の条例・指導）</a></li>
          <li><a href="#penalty">怠った場合の流れと罰則</a></li>
          <li><a href="#gyosha">清掃業者について</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="overview" class="cl-section">
        <h2>対象と義務の全体像</h2>
        <div class="cl-table-wrap">
          <table class="cl-table cl-table--wrap">
            <caption>受水槽の清掃・検査に関わる主な決まり</caption>
            <thead><tr><th>区分</th><th>対象</th><th>主な義務</th></tr></thead>
            <tbody>
              <tr><th scope="row">簡易専用水道（水道法）</th><td>水道水だけが水源で、受水槽の有効容量の合計が10m³を超えるもの</td><td>水槽の掃除：毎年1回以上／登録検査機関などの検査：毎年1回以上／異常時の水質検査・給水停止</td></tr>
              <tr><th scope="row">特定建築物（建築物衛生法）</th><td>事務所・店舗・旅館などの用途部分の延べ面積が3,000m²以上（学校教育法第1条の学校などは8,000m²以上）</td><td>貯水槽の清掃：1年以内ごとに1回／遊離残留塩素の検査：7日以内ごとに1回／水質検査：6か月以内ごとに1回など／帳簿書類の5年保存</td></tr>
              <tr><th scope="row">10m³以下の受水槽</th><td>水道法の簡易専用水道に当たらないもの</td><td>自治体の条例・指導による（東京都の条例、大阪府・大阪市の指導要領・要綱など）</td></tr>
            </tbody>
          </table>
        </div>
        <p>自分の建物がどれに当たるかは<a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a>で確認できます。</p>
      </section>

      <section id="suido" class="cl-section">
        <h2>水道法（簡易専用水道）</h2>
        <p>水道から受けた水だけを水源とし、受水槽の有効容量の合計が10m³を超えるものが「簡易専用水道」です。設置者は、国土交通省令の基準に従って管理し（第34条の2第1項）、定期に検査を受けなければなりません（同第2項）。</p>
        <h3>管理の基準（施行規則第55条）</h3>
        <ol>
          <li>水槽の掃除を毎年1回以上定期に行う</li>
          <li>水槽の点検など、有害物や汚水などで水が汚染されるのを防ぐ措置を講じる</li>
          <li>給水栓の水の色・濁り・臭い・味などに異常を認めたときは、必要な水質検査を行う</li>
          <li>水が人の健康を害するおそれがあると知ったときは、直ちに給水を停止し、関係者に周知する</li>
        </ol>
        <h3>検査（施行規則第56条）</h3>
        <p>地方公共団体の機関、または国土交通大臣及び環境大臣の登録を受けた者の検査を、<strong>毎年1回以上</strong>定期に受けます。清掃会社が行う清掃後の水質検査とは別のものです。検査の中身は<a href="/column/jusuisou-seisou-tenken/">受水槽の点検・法定検査ガイド</a>で解説しています。</p>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/332AC0000000177" rel="noopener" target="_blank">水道法</a>・<a href="https://laws.e-gov.go.jp/law/332M50000100045" rel="noopener" target="_blank">水道法施行規則</a>（e-Gov法令検索、2026年9月確認）</p>
      </section>

      <section id="biru" class="cl-section">
        <h2>建築物衛生法（特定建築物）</h2>
        <p>興行場・百貨店・店舗・事務所・旅館などの用途に使う部分の延べ面積が3,000m²以上の建築物（学校教育法第1条の学校などは8,000m²以上）が「特定建築物」です（施行令第1条）。特定建築物所有者等は、建築物環境衛生管理基準に従って維持管理します。</p>
        <ul>
          <li><strong>貯水槽の清掃</strong>：1年以内ごとに1回（施行規則第4条）</li>
          <li><strong>遊離残留塩素の検査</strong>：7日以内ごとに1回（同）</li>
          <li><strong>水質検査</strong>：定められた項目を6か月以内ごとに1回など（同）</li>
          <li><strong>帳簿書類</strong>：維持管理の状況を記載した帳簿書類を備え、5年間保存（法第10条、施行規則第20条）</li>
          <li><strong>届出・管理技術者</strong>：特定建築物の届出（法第5条）と、建築物環境衛生管理技術者の選任（法第6条）</li>
        </ul>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/345AC1000000020" rel="noopener" target="_blank">建築物における衛生的環境の確保に関する法律</a>・<a href="https://laws.e-gov.go.jp/law/345CO0000000304" rel="noopener" target="_blank">同法施行令</a>・<a href="https://laws.e-gov.go.jp/law/346M50000100002" rel="noopener" target="_blank">同法施行規則</a>（e-Gov法令検索、2026年9月確認）</p>
      </section>

      <section id="jichitai" class="cl-section">
        <h2>10m³以下の受水槽（自治体の条例・指導）</h2>
        <p>10m³以下の受水槽は水道法の簡易専用水道には当たりませんが、自治体によって定めがあります。</p>
        <ul>
          <li><strong>東京都</strong>：条例で、有効容量10m³以下で学校・病院・社会福祉施設などに給水するもの、または5m³を超えるものを「特定小規模貯水槽水道等」とし、清掃（1年に1回以上）、管理状況の検査・点検（1年に1回以上）、記録の保存などを求めています。都の保健所の管内が対象で、特別区などは区の条例によります</li>
          <li><strong>大阪市</strong>：指導要綱を定め、簡易専用水道に準じた管理をお願いしています</li>
          <li><strong>大阪府</strong>：「大阪府小規模受水槽水道衛生管理指導要領」で、受水槽・高置水槽の清掃を毎年1回以上行うよう呼びかけています</li>
        </ul>
        <p>ほかの地域も、所在地の保健所で確認してください。</p>
        <p class="cl-note">出典：<a href="https://www.hokeniryo.metro.tokyo.lg.jp/shisetsu/jigyosyo/hokenjyo/tamafuchu/eisei/suidou/chosuisou/shoukibo" rel="noopener" target="_blank">東京都多摩府中保健所「小規模貯水槽水道等」</a>／<a href="https://www.city.osaka.lg.jp/suido/page/0000137963.html" rel="noopener" target="_blank">大阪市水道局</a>／<a href="https://www.pref.osaka.lg.jp/o100150/shijonawatehoken/kankyo/syoukibo.html" rel="noopener" target="_blank">大阪府</a>（いずれも2026年9月確認）</p>
      </section>

      <section id="penalty" class="cl-section">
        <h2>怠った場合の流れと罰則</h2>
        <h3>簡易専用水道</h3>
        <ol>
          <li>都道府県知事等は、管理について報告を求めたり、立入検査をしたりできます（第39条第3項）</li>
          <li>管理が基準に適合していないと、清掃その他の必要な措置を指示されることがあります（第36条第3項）</li>
          <li>指示に従わず、給水を続けることが利用者の利益を損なうと認められると、給水停止を命じられることがあります（第37条）</li>
          <li>給水停止命令に違反すると、1年以下の拘禁刑又は100万円以下の罰金です（第53条）</li>
        </ol>
        <p>また、<strong>年1回の法定検査を受けないと100万円以下の罰金</strong>（第54条）、報告をしない・虚偽の報告・立入検査の拒否は30万円以下の罰金です（第55条）。</p>
        <h3>特定建築物</h3>
        <p>管理基準に従った維持管理がされておらず、人の健康を損なうおそれのある事態などがあると、改善命令や設備の使用停止・制限を受けることがあります（第12条）。改善命令などへの違反、帳簿書類の不備・虚偽記載、報告の拒否・立入検査の拒否、届出をしないことなどは、30万円以下の罰金です（第16条）。</p>
        <p>流れの詳細は<a href="/column/jusuisou-seisou-batsu/">受水槽清掃を怠るとどうなる？水道法・建築物衛生法の罰則と、指示・命令の流れ</a>で解説しています。</p>
      </section>

      <section id="gyosha" class="cl-section">
        <h2>清掃業者について</h2>
        <p>建築物衛生法には「建築物飲料水貯水槽清掃業」の登録制度がありますが、基準を満たす事業者が受けることができる<strong>任意の制度</strong>です（第12条の2）。登録していない業者に頼んではいけないという規定はありません。ただし、登録には専用の機械器具、講習を修了した作業監督者、従事者の研修などが必要なため（施行規則第28条）、業者を比べるときの目安になります。</p>
        <p>見積りで確認したい点は<a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト｜見積り前に確認したい8項目</a>、費用の例は<a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</a>にまとめています。</p>
      </section>

      <div class="cl-cta">
        <h2>受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/">無料で清掃業者を探す</a>
      </div>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          {faqItems.map((f) => (<div class="cl-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
        </dl>
      </section>

      <div class="cl-pref-links">
        <h2 class="cl-pref-h">エリア別の受水槽清掃業者を探す</h2>
        <ul class="cl-pref-list">
          <li><a href="/jusuisou-seisou/tokyo/">東京都</a></li>
          <li><a href="/jusuisou-seisou/osaka/">大阪府</a></li>
          <li><a href="/jusuisou-seisou/kanagawa/">神奈川県</a></li>
          <li><a href="/jusuisou-seisou/aichi/">愛知県</a></li>
          <li><a href="/jusuisou-seisou/saitama/">埼玉県</a></li>
          <li><a href="/jusuisou-seisou/fukuoka/">福岡県</a></li>
        </ul>
        <p class="cl-pref-more"><a href="/jusuisou-seisou/">全国の対応業者を見る</a></p>
      </div>

      <aside class="cl-related">
        <h2 class="cl-related-h">関連サービス・コラム</h2>
        <ul>
