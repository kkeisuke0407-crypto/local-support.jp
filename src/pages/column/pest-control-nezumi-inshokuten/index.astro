            <tbody>
              <tr>
                <th scope="row">小規模飲食店（〜30坪）</th>
                <td>30,000〜60,000円</td>
                <td>40,000〜90,000円</td>
                <td>現地調査・毒餌設置・粘着トラップ・応急封鎖</td>
              </tr>
              <tr>
                <th scope="row">中規模飲食店（30〜80坪）</th>
                <td>50,000〜100,000円</td>
                <td>70,000〜150,000円</td>
