import { site } from '../../../data/site';

const title = 'フロン排出抑制法の点検義務ガイド2026｜業務用エアコン管理者が知るべき簡易点検・定期点検の要点';
const description = '業務用エアコン・冷凍冷蔵機器の管理者に課されるフロン排出抑制法上の点検義務を解説。3か月に1回の簡易点検、規模別の定期点検（7.5kW以上3年・50kW以上1年）、漏洩量算定・国への報告、廃棄時のフロン回収まで、施設管理者向けに整理しました。';
const canonical = `${site.domain}/column/aircon-business-furon-tenken/`;
const published = '2026-05-26';
const modified = '2026-05-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: 'フロン排出抑制法の点検義務ガイド', item: canonical },
