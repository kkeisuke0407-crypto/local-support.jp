---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '受水槽清掃の業者選びチェックリスト｜見積り前に確認したい8項目';
const description = '受水槽清掃の業者を選ぶときに、見積りの段階で確認しておきたい8項目を整理。作業範囲、料金の内訳、清掃後の水質検査、報告書、断水と告知、作業時間帯、建築物飲料水貯水槽清掃業の登録（任意の制度）、清掃とは別に受ける法定検査まで、条文と公開資料で確認した内容でまとめました。';
const canonical = `${site.domain}/column/jusuisou-seisou-gyosha-sentaku/`;
const published = '2026-05-27';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '受水槽清掃の業者選びチェックリスト', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '業者選び',
  keywords: '受水槽清掃,業者選び,見積り,チェックリスト,水質検査,報告書,建築物飲料水貯水槽清掃業,法定検査',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
});

const faqItems = [
  { q: '業者選びで一番大事なことは何ですか？', a: '同じ条件で見積りを取り、含まれる作業をそろえて比べることです。容量・高置水槽の有無・水質検査・報告書・出張費・作業時間帯が業者ごとに違うと、金額だけでは比べられません。' },
  { q: '登録業者でないと頼めませんか？', a: '法律上、登録業者への依頼は義務ではありません。建築物飲料水貯水槽清掃業の登録は、基準を満たす事業者が受けることができる任意の制度です（建築物衛生法第12条の2）。登録には機械器具・作業監督者・従事者研修の基準があるため、比べるときの目安になります。' },
  { q: '清掃業者の水質検査と、法定検査は同じものですか？', a: '別のものです。清掃後の水質検査は、清掃会社が清掃料金に含めるか別料金で行うのが一般的です。これとは別に、有効容量10m³超の受水槽（簡易専用水道）は、登録検査機関などの検査を毎年1回以上受ける必要があります（水道法第34条の2第2項）。' },
  { q: '清掃の記録はどのくらい保管すればよいですか？', a: '特定建築物では、維持管理の状況を記載した帳簿書類を5年間保存する必要があります（建築物衛生法施行規則第20条）。簡易専用水道の法定検査では、水槽の清掃記録などの整理保存状況も確認されます。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>受水槽清掃の業者選びチェックリスト</span>
        </nav>
        <span class="cl-cat">業者選び</span>
        <h1 class="cl-title">受水槽清掃の業者選びチェックリスト｜見積り前に確認したい8項目</h1>
        <p class="cl-lead">
          受水槽清掃は、業者によって<strong>含まれる作業や料金の決め方</strong>が違います。見積りの段階で確認する項目をそろえておくと、金額だけでなく中身で比べられます。この記事では、見積り前に確認したい8項目を整理しました。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年5月27日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 受水槽清掃の業者は何を見て選べばよいですか？</p>
        <p class="cl-qa-a">A. <strong>①作業範囲 ②料金の内訳と税 ③清掃後の水質検査 ④報告書 ⑤断水と告知 ⑥作業時間帯と割増 ⑦建築物飲料水貯水槽清掃業の登録 ⑧法定検査との関係</strong>の8項目を、同じ条件で確認して比べます。登録は義務ではありませんが、比べるときの目安になります。</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#list">8項目のチェックリスト</a></li>
          <li><a href="#range">① 作業範囲</a></li>
          <li><a href="#price">② 料金の内訳と税</a></li>
          <li><a href="#water">③ 清掃後の水質検査</a></li>
          <li><a href="#report">④ 報告書</a></li>
          <li><a href="#dansui">⑤ 断水と告知</a></li>
          <li><a href="#time">⑥ 作業時間帯と割増</a></li>
          <li><a href="#touroku">⑦ 建築物飲料水貯水槽清掃業の登録</a></li>
          <li><a href="#kensa">⑧ 法定検査との関係</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="list" class="cl-section">
        <h2>8項目のチェックリスト</h2>
        <div class="cl-table-wrap">
          <table class="cl-table cl-table--wrap">
            <caption>見積り前に確認したい8項目</caption>
            <thead><tr><th>項目</th><th>確認すること</th></tr></thead>
            <tbody>
              <tr><th scope="row">① 作業範囲</th><td>受水槽だけか、高置水槽も含むか。水槽の数（2槽式など）と設置場所</td></tr>
              <tr><th scope="row">② 料金の内訳と税</th><td>清掃・水質検査・出張費が分かれているか。税抜か税込か</td></tr>
              <tr><th scope="row">③ 清掃後の水質検査</th><td>含まれるか、別料金か。項目数</td></tr>
              <tr><th scope="row">④ 報告書</th><td>清掃前後の写真付きの報告書が出るか</td></tr>
              <tr><th scope="row">⑤ 断水と告知</th><td>断水時間の見込み、告知を誰が行うか</td></tr>
              <tr><th scope="row">⑥ 作業時間帯と割増</th><td>夜間・休日・早朝の割増の有無と率</td></tr>
              <tr><th scope="row">⑦ 登録</th><td>建築物飲料水貯水槽清掃業の登録の有無と登録番号（任意の制度）</td></tr>
              <tr><th scope="row">⑧ 法定検査</th><td>10m³超なら、清掃とは別に登録検査機関の検査を受けること</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section id="range" class="cl-section">
        <h2>① 作業範囲</h2>
        <p>料金は受水槽の容量で決まることが多く、屋上に高置水槽があれば別に加算されます。2槽式や複数基の水槽、地下ピットの下や地下埋設の水槽は、別途見積りとしている会社もあります（たてものサービスの料金表）。見積りを頼むときは、<strong>水槽ごとの容量・数・設置場所</strong>を伝えましょう。容量は水槽の銘板で確認できます。</p>
      </section>

      <section id="price" class="cl-section">
        <h2>② 料金の内訳と税</h2>
        <p>公開されている料金表を見ると、<strong>税抜の会社と税込の会社</strong>があり、水質検査や出張費を含むかも会社によって異なります。総額で比べるには、内訳と税の扱いをそろえる必要があります。容量別の料金例は<a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</a>にまとめています。</p>
      </section>

      <section id="water" class="cl-section">
        <h2>③ 清掃後の水質検査</h2>
        <p>清掃後の水質検査は、清掃料金に含む会社（10項目込み）と、別料金の会社（10項目8,000円・税抜、11項目7,260円・税込など）があります。<strong>含まれるかどうかと項目数</strong>を確認し、結果を書面で受け取れるかも聞いておきましょう。</p>
        <p class="cl-note">出典：<a href="https://www.tatemono-s.jp/category/1502322.html" rel="noopener" target="_blank">たてものサービス</a>／<a href="https://www.koei-tec.jp/service/tyosui/" rel="noopener" target="_blank">光栄テクノサービス</a>／<a href="https://www.1974.co.jp/water-tank-cleaning" rel="noopener" target="_blank">福岡ビル開発</a>の公開料金表（2026年9月確認）</p>
      </section>

      <section id="report" class="cl-section">
        <h2>④ 報告書</h2>
        <p>清掃の記録は、簡易専用水道の法定検査で整理保存状況が確認され、特定建築物では帳簿書類として5年間保存する必要があります（建築物衛生法施行規則第20条）。<strong>実施日・作業内容・清掃前後の写真・水質確認の結果</strong>が載った報告書が出るかを確認しましょう。</p>
      </section>

      <section id="dansui" class="cl-section">
        <h2>⑤ 断水と告知</h2>
        <p>清掃中は多くの場合断水になります。公開情報の例では、一般的なアパート・マンション（3〜10トン程度）でおおむね2〜3時間とされています（たてものサービス）。<strong>断水時間の見込み</strong>と、<strong>入居者・利用者への告知を業者が行うか</strong>を確認してください。</p>
      </section>

      <section id="time" class="cl-section">
        <h2>⑥ 作業時間帯と割増</h2>
        <p>夜間・休日・早朝の作業は割増になる会社があります（例：夜間50%増・休日25%増／福岡ビル開発）。営業時間中の断水を避けたい施設は、<strong>時間帯を決めてから</strong>見積りを取ると比べやすくなります。</p>
      </section>

      <section id="touroku" class="cl-section">
        <h2>⑦ 建築物飲料水貯水槽清掃業の登録</h2>
        <p>建築物衛生法には「建築物飲料水貯水槽清掃業」の登録制度があります。基準を満たす事業者が営業所ごとに都道府県知事の登録を<strong>受けることができる</strong>任意の制度で（第12条の2）、登録していない業者に頼んではいけないという規定はありません。</p>
        <p>登録には、専用の機械器具（揚水ポンプ・高圧洗浄機・残水処理機・色度計・濁度計・残留塩素測定器など）、講習を修了した作業監督者、従事者の研修などが必要です（施行規則第28条）。<strong>比べるときの目安</strong>として、登録の有無と登録番号を聞いておくとよいでしょう。詳しくは<a href="/column/jusuisou-seisou-shikaku/">貯水槽清掃の資格で見る業者選び</a>で解説しています。</p>
      </section>

      <section id="kensa" class="cl-section">
        <h2>⑧ 法定検査との関係</h2>
        <p>有効容量10m³超の受水槽（簡易専用水道）は、清掃とは別に、<strong>登録検査機関などの検査を毎年1回以上</strong>受ける必要があり、受けないと100万円以下の罰金の対象です（水道法第34条の2第2項・第54条）。清掃業者が行う水質検査とは別のものなので、検査の申込みを誰が行うかも確認しておきましょう。</p>
        <p>義務と罰則の流れは<a href="/column/jusuisou-seisou-batsu/">受水槽清掃を怠るとどうなる？水道法・建築物衛生法の罰則と、指示・命令の流れ</a>で解説しています。</p>
      </section>

      <div class="cl-cta">
        <h2>受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/">無料で清掃業者を探す</a>
      </div>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          {faqItems.map((f) => (<div class="cl-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
        </dl>
      </section>

      <div class="cl-pref-links">
        <h2 class="cl-pref-h">エリア別の受水槽清掃業者を探す</h2>
        <ul class="cl-pref-list">
          <li><a href="/jusuisou-seisou/tokyo/">東京都</a></li>
          <li><a href="/jusuisou-seisou/osaka/">大阪府</a></li>
          <li><a href="/jusuisou-seisou/kanagawa/">神奈川県</a></li>
          <li><a href="/jusuisou-seisou/aichi/">愛知県</a></li>
          <li><a href="/jusuisou-seisou/saitama/">埼玉県</a></li>
          <li><a href="/jusuisou-seisou/fukuoka/">福岡県</a></li>
        </ul>
        <p class="cl-pref-more"><a href="/jusuisou-seisou/">全国の対応業者を見る</a></p>
      </div>

      <aside class="cl-related">
        <h2 class="cl-related-h">関連サービス・コラム</h2>
        <ul>
          <li><a href="/jusuisou-seisou/">受水槽清掃の業者を一括見積比較</a></li>
          <li><a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場</a></li>
          <li><a href="/column/jusuisou-seisou-shikaku/">貯水槽清掃の資格で見る業者選び</a></li>
          <li><a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a></li>
          <li><a href="/column/jusuisou-seisou-batsu/">受水槽清掃の罰則と、指示・命令の流れ</a></li>
        </ul>
      </aside>

      <aside class="cl-glossary-block">
        <h2 class="cl-glossary-h">📖 この記事に出てくる主な用語</h2>
        <ul class="cl-glossary-list">
          <li><a href="/glossary/#kenchiku-suiso-seisogyo">建築物飲料水貯水槽清掃業</a></li>
          <li><a href="/glossary/#kanni-senyou-suido">簡易専用水道</a></li>
          <li><a href="/glossary/#jusuisou">受水槽／貯水槽</a></li>
          <li><a href="/glossary/#koukasuisou">高架水槽</a></li>
          <li><a href="/glossary/#tokutei-kenchikubutsu">特定建築物</a></li>
        </ul>
        <p class="cl-glossary-more"><a href="/glossary/">施設管理用語集をすべて見る</a></p>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
