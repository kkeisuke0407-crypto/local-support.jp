---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用';
const description = '受水槽清掃の費用を、清掃会社が公開している料金表をもとに容量別に整理。高置水槽・水質検査・出張費・夜間休日の割増など追加になりやすい費用、清掃とは別にかかる法定検査の手数料、水道法・建築物衛生法の義務まで、条文と公開資料で確認した内容でまとめました。';
const canonical = `${site.domain}/column/jusuisou-seisou-hiyo-sohba/`;
const published = '2026-05-26';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '受水槽清掃の費用相場', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '費用相場',
  keywords: '受水槽清掃,貯水槽清掃,費用,相場,料金表,容量,高置水槽,水質検査,簡易専用水道,法定検査',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
});

const faqItems = [
  { q: '受水槽清掃の費用はいくらですか？', a: '容量で決まります。料金を公開している清掃会社3社の例では、10㎥で44,000〜62,370円、20㎥で64,000〜89,760円でした（税抜・税込の別や、水質検査を含むかは会社によって異なります）。高置水槽がある場合は別に加算されます。' },
  { q: '清掃のほかにかかる費用はありますか？', a: '有効容量10㎥を超える受水槽（簡易専用水道）は、清掃とは別に、登録検査機関の検査を年1回受ける必要があります。手数料は検査機関によって異なり、三重県環境保全事業団では受水槽1系統ごとに22,000円（税込）です。' },
  { q: '清掃は登録業者に頼まないといけませんか？', a: '法律上、登録業者への依頼は義務ではありません。建築物衛生法の「建築物飲料水貯水槽清掃業」の登録は、基準を満たす事業者が受けることができる任意の制度です（第12条の2）。ただし、機械器具や従事者の資格などの基準を満たしていることの目安になるため、業者を比べるときの判断材料になります。' },
  { q: '清掃を怠るとどうなりますか？', a: '簡易専用水道の場合、都道府県知事等から清掃などの措置を指示されることがあり（水道法第36条第3項）、従わないと給水停止を命じられることがあります（第37条）。この命令に違反すると1年以下の拘禁刑又は100万円以下の罰金です（第53条）。また、年1回の法定検査を受けないと100万円以下の罰金です（第54条）。' },
  { q: '清掃中の断水はどのくらいですか？', a: '公開情報の例では、一般的なアパート・マンション（3〜10トン程度）でおおむね2〜3時間とされています（たてものサービス）。水槽の大きさや汚れで変わるため、見積りの段階で断水時間の見込みを確認し、入居者への告知の方法も決めておきましょう。' },
  { q: '10㎥以下の受水槽にも清掃の義務はありますか？', a: '水道法の簡易専用水道には当たりませんが、自治体の条例で管理や清掃を定めている場合があります。東京都などの例は「受水槽の義務チェック」で確認できます。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>受水槽清掃の費用相場</span>
        </nav>
        <span class="cl-cat">費用相場</span>
        <h1 class="cl-title">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</h1>
        <p class="cl-lead">
          受水槽清掃の費用は、<strong>受水槽の容量</strong>でほぼ決まり、そこに<strong>高置水槽・水質検査・出張費・作業時間帯</strong>の条件が加わります。この記事では、<strong>清掃会社が公開している料金表</strong>をもとに容量別の目安を整理し、清掃とは別にかかる法定検査の手数料と、法律上の義務もあわせて確認します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年5月26日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 受水槽清掃の費用はいくらですか？</p>
        <p class="cl-qa-a">A. <strong>料金を公開している清掃会社3社の例では、10㎥で44,000〜62,370円、20㎥で64,000〜89,760円でした。</strong>税抜・税込の別や水質検査を含むかは会社で異なり、高置水槽があれば別に加算されます。有効容量10㎥を超える受水槽は、清掃とは別に<strong>年1回の法定検査の手数料</strong>（例：1系統22,000円）もかかります。</p>
        <p class="cl-qa-src">※各社の公開料金表による（2026年9月確認）。出典は各表の下に記載しています。地域・設備・業者で変わるため、正式な金額は業者の見積りでご確認ください。</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#base-cost">容量別の清掃料金（公開料金表の例）</a></li>
          <li><a href="#koukasuisou">高置水槽・2槽式など、水槽が複数ある場合</a></li>
          <li><a href="#extras">見積りで追加になりやすい費用</a></li>
          <li><a href="#kensa">清掃とは別にかかる法定検査の手数料</a></li>
          <li><a href="#law">法律上の義務と、怠った場合</a></li>
          <li><a href="#gyosha">業者の登録について</a></li>
          <li><a href="#tips">見積比較のコツ</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>清掃料金</strong>：公開料金表の例で、10㎥が44,000〜62,370円、20㎥が64,000〜89,760円。2社は10㎥を超えると1㎥ごとに2,000円加算</li>
            <li><strong>別にかかる費用</strong>：高置水槽、水質検査、出張費・交通費、夜間・休日の割増。10㎥超なら年1回の法定検査（例：1系統22,000円）</li>
            <li><strong>比べ方</strong>：容量・高置水槽の有無・水質検査の有無・時間帯をそろえ、税抜か税込かも確認して比べる</li>
          </ul>
        </div>
      </section>

      <section id="base-cost" class="cl-section">
        <h2>容量別の清掃料金（公開料金表の例）</h2>
        <p>料金を公開している清掃会社3社の、受水槽1基を清掃する場合の料金です。受水槽の容量は、水槽の縦×横×高さで計算するとしている会社があります（光栄テクノサービス）。容量が分からない場合は、水槽の銘板で確認できます。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>受水槽清掃1回の料金（単位：円）</caption>
            <thead><tr><th>容量</th><th>光栄テクノサービス<br/>（税抜・水質検査別）</th><th>たてものサービス<br/>（税抜・水質検査込）</th><th>福岡ビル開発<br/>（税込・水質検査別）</th></tr></thead>
            <tbody>
              <tr><th scope="row">10㎥</th><td>44,000</td><td>47,000</td><td>62,370</td></tr>
              <tr><th scope="row">15㎥</th><td>54,000</td><td>57,000</td><td>76,560</td></tr>
              <tr><th scope="row">20㎥</th><td>64,000</td><td>67,000</td><td>89,760</td></tr>
              <tr><th scope="row">30㎥</th><td colspan="2">2社とも10㎥を超えると1㎥ごとに2,000円加算（表は20㎥まで）</td><td>113,520</td></tr>
              <tr><th scope="row">50㎥</th><td colspan="2">同上</td><td>151,800</td></tr>
              <tr><th scope="row">100㎥</th><td colspan="2">同上</td><td>224,400</td></tr>
            </tbody>
          </table>
        </div>
        <p class="cl-note">出典：<a href="https://www.koei-tec.jp/service/tyosui/" rel="noopener" target="_blank">光栄テクノサービス「貯水槽清掃・ポンプ点検 価格表」</a>（年1回定期清掃の1回あたり。交通費別）／<a href="https://www.tatemono-s.jp/category/1502322.html" rel="noopener" target="_blank">たてものサービス（東京都）「貯水槽・受水槽清掃の料金表」</a>（水質検査10項目込み。出張諸経費6,500円別）／<a href="https://www.1974.co.jp/water-tank-cleaning" rel="noopener" target="_blank">福岡ビル開発（福岡市）「貯水槽清掃料金表」</a>（受水槽のみ・圧力タンク方式及び圧送式給水設備の表。容積は有効容積ではない）。いずれも2026年9月確認。</p>
        <p>3社とも、容量が大きくなるほど1㎥あたりの金額は下がる料金体系です。税抜か税込か、水質検査や出張費を含むかで比べる前提が変わるため、<strong>条件をそろえた総額で比べる</strong>ことが大切です。</p>
      </section>

      <section id="koukasuisou" class="cl-section">
        <h2>高置水槽・2槽式など、水槽が複数ある場合</h2>
        <p>屋上に高置水槽（高架水槽）がある建物では、受水槽とは別に高置水槽の清掃料金が加算されます。</p>
        <ul>
          <li><strong>光栄テクノサービス</strong>：高架水槽3トンまで8,000円、10トンで22,000円（税抜）。高架水槽のみの清掃は受水槽の価格表と同額</li>
          <li><strong>たてものサービス</strong>：高置水槽3トンまで16,000円、10トンで30,000円（税抜）。2槽式や複数基の水槽は1槽あたり33,000円（税抜）から見積り</li>
          <li><strong>福岡ビル開発</strong>：副受水槽の清掃は別途見積り</li>
        </ul>
        <p>また、地下ピットの下に設置された水槽や、地下埋設型の水槽は別途見積りとしている会社があります（たてものサービス）。</p>
      </section>

      <section id="extras" class="cl-section">
        <h2>見積りで追加になりやすい費用</h2>
        <ul>
          <li><strong>水質検査</strong>：清掃料金に含む会社と別の会社があります。別の場合の例は、10項目8,000円（光栄テクノサービス、税抜）、11項目7,260円・16項目12,100円（福岡ビル開発、税込）</li>
          <li><strong>出張費・交通費</strong>：出張諸経費6,500円（たてものサービス、税抜）、交通費は別途（光栄テクノサービス）</li>
          <li><strong>夜間・休日の作業</strong>：夜間は50%増、休日は25%増（福岡ビル開発）。休日・夜間・早朝は割増（光栄テクノサービス）</li>
          <li><strong>水槽の構造・立地・作業の難しさ</strong>：別途見積りになる場合があります（福岡ビル開発）</li>
          <li><strong>部品の補修・交換、塗装</strong>：清掃とは別の見積りです（福岡ビル開発）</li>
        </ul>
        <p class="cl-note">出典は上表と同じ（2026年9月確認）。</p>
      </section>

      <section id="kensa" class="cl-section">
        <h2>清掃とは別にかかる法定検査の手数料</h2>
        <p>有効容量10㎥を超える受水槽（簡易専用水道）の設置者は、清掃とは別に、<strong>国土交通大臣及び環境大臣の登録を受けた検査機関などの検査</strong>を毎年1回以上受ける必要があります（水道法第34条の2第2項、同法施行規則第56条）。清掃会社が行う清掃後の水質検査とは別のものです。</p>
        <p>手数料は検査機関によって異なります。たとえば三重県環境保全事業団（岐阜県・愛知県・三重県・滋賀県・奈良県・和歌山県を担当）では、<strong>現場検査が受水槽1系統ごとに22,000円（税込）</strong>、特定建築物だけが選べる書類検査が4,400円（税込）です。地域の検査機関は、管轄の保健所で確認できます。</p>
        <p class="cl-note">出典：<a href="https://www.mec.or.jp/k_bunseki/cate/suido/kansen/" rel="noopener" target="_blank">三重県環境保全事業団「簡易専用水道検査」</a>（2026年9月確認）。清掃と検査の違いは<a href="/column/jusuisou-seisou-tenken/">受水槽の点検・法定検査ガイド</a>で解説しています。</p>
      </section>

      <section id="law" class="cl-section">
        <h2>法律上の義務と、怠った場合</h2>
        <div class="cl-table-wrap">
          <table class="cl-table cl-table--wrap">
            <caption>受水槽の清掃・検査の主な義務</caption>
            <thead><tr><th>対象</th><th>義務</th><th>根拠</th></tr></thead>
            <tbody>
              <tr><th scope="row">簡易専用水道（有効容量10㎥超）</th><td>水槽の掃除を毎年1回以上</td><td>水道法第34条の2第1項、施行規則第55条</td></tr>
              <tr><th scope="row">簡易専用水道（有効容量10㎥超）</th><td>登録検査機関などの検査を毎年1回以上</td><td>水道法第34条の2第2項、施行規則第56条</td></tr>
              <tr><th scope="row">特定建築物（建築物衛生法）</th><td>貯水槽の清掃を1年以内ごとに1回</td><td>建築物衛生法施行規則第4条</td></tr>
              <tr><th scope="row">10㎥以下の受水槽</th><td>自治体の条例による</td><td>各自治体の条例</td></tr>
            </tbody>
          </table>
        </div>
        <p>簡易専用水道で清掃などの管理が基準に合っていないと、都道府県知事等から<strong>清掃などの措置を指示</strong>されることがあります（水道法第36条第3項）。指示に従わず、給水を続けることが利用者の利益を損なうと認められると、<strong>給水停止を命じられる</strong>ことがあり（第37条）、この命令に違反すると1年以下の拘禁刑又は100万円以下の罰金です（第53条）。また、<strong>年1回の法定検査を受けないと100万円以下の罰金</strong>です（第54条）。</p>
        <p>自分の建物がどれに当たるかは<a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a>で確認できます。</p>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/332AC0000000177" rel="noopener" target="_blank">水道法</a>・<a href="https://laws.e-gov.go.jp/law/332M50000100045" rel="noopener" target="_blank">水道法施行規則</a>・<a href="https://laws.e-gov.go.jp/law/346M50000100002" rel="noopener" target="_blank">建築物衛生法施行規則</a>（e-Gov法令検索、2026年9月確認）</p>
      </section>

      <section id="gyosha" class="cl-section">
        <h2>業者の登録について</h2>
        <p>建築物衛生法には「<strong>建築物飲料水貯水槽清掃業</strong>」の登録制度があります。機械器具や従事者の資格などの基準を満たす事業者が、営業所ごとに都道府県知事の登録を<strong>受けることができる</strong>制度で（第12条の2）、登録は義務ではありません。</p>
        <p>ただ、基準を満たしていることの目安になるため、業者を比べるときは登録の有無と登録番号を確認しておくと安心です。</p>
      </section>

      <section id="tips" class="cl-section">
        <h2>見積比較のコツ</h2>
        <ol>
          <li><strong>条件をそろえる</strong>：受水槽の容量、高置水槽の有無と容量、水槽の数（2槽式か）、設置場所（地下ピットなど）を伝えて見積りを依頼する</li>
          <li><strong>含まれるものを確かめる</strong>：水質検査、出張費・交通費、報告書の発行が含まれるか。税抜か税込か</li>
          <li><strong>時間帯を決めておく</strong>：夜間・休日を指定すると割増になる会社があります</li>
          <li><strong>断水と告知</strong>：断水時間の見込みと、入居者・利用者への告知を誰が行うか</li>
          <li><strong>法定検査を忘れない</strong>：10㎥超なら、清掃とは別に登録検査機関の検査を年1回受ける</li>
        </ol>
      </section>

      <div class="cl-cta">
        <h2>受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/">無料で清掃業者を探す</a>
