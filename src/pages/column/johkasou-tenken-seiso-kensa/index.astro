---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '浄化槽の保守点検・清掃・法定検査の違い｜頻度・7条検査と11条検査・3つの義務';
const description = '浄化槽の「保守点検」「清掃」「法定検査」の違いを戸建てオーナー・施設管理者向けに解説。それぞれの目的・頻度・担当者、7条検査と11条検査の違い、保守点検と法定検査が別物である理由、3つの義務を怠った場合のリスクまで2026年版で整理しました。';
const canonical = `${site.domain}/column/johkasou-tenken-seiso-kensa/`;
const published = '2026-06-16';
const modified = '2026-06-16';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '浄化槽の保守点検・清掃・法定検査の違い', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5200,
  articleSection: '浄化槽',
  keywords: '浄化槽 保守点検,清掃,法定検査,7条検査,11条検査,頻度,3つの義務,違い,浄化槽法,2026',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-johkasou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '浄化槽清掃・保守点検', serviceType: '浄化槽の維持管理' },
  citation: [
