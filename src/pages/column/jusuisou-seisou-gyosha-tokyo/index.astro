---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '東京で受水槽清掃の業者を選ぶ｜都の条例・登録営業所の調べ方・法定検査・料金の例';
const description = '東京都内で受水槽清掃の業者を選ぶ施設管理者向けに、水道法・建築物衛生法と東京都の小規模貯水槽の条例、東京都健康安全研究センターの登録営業所一覧での確かめ方、都内の簡易専用水道の法定検査、公開料金表の例、見積りで確認したい点を、公的資料と公開情報で確認して整理しました。';
const canonical = `${site.domain}/column/jusuisou-seisou-gyosha-tokyo/`;
const published = '2026-06-19';
const modified = '2026-09-26';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '東京の受水槽清掃 業者選び', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: published, dateModified: modified,
  inLanguage: 'ja-JP', url: canonical, mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  articleSection: '業者選び',
  keywords: '受水槽清掃,東京,業者,登録営業所,東京都健康安全研究センター,小規模貯水槽水道,簡易専用水道,法定検査',
  author: { '@type': 'Organization', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '受水槽清掃' },
});

const faqItems = [
  { q: '東京都で登録している清掃業者はどう調べますか？', a: '東京都健康安全研究センターが「建築物事業登録営業所の一覧」を公開しており、建築物飲料水貯水槽清掃業の登録営業所をPDF・CSVで確認できます。登録は任意の制度ですが、機械器具や作業監督者などの基準を満たしている目安になります。' },
  { q: '10m³以下の受水槽でも清掃は必要ですか？', a: '水道法の簡易専用水道には当たりませんが、東京都の条例では、学校・病院・社会福祉施設などに給水するもの、または有効容量が5m³を超えるものを「特定小規模貯水槽水道等」とし、清掃（1年に1回以上）などを求めています。都の条例は都の保健所の管内が対象で、特別区などは区の条例によるため、所在地の保健所で確認してください。' },
  { q: '東京都内の法定検査はどこに頼めますか？', a: '有効容量10m³超の簡易専用水道は、登録検査機関などの検査を毎年1回以上受けます。たとえば日本建築衛生管理教育センターは東京都内（島しょを除く）で検査を行っています（料金は問い合わせ）。地域の検査機関は所在地の保健所で確認できます。' },
  { q: '夜間や休日に清掃してもらえますか？', a: '対応する業者は多くありますが、夜間・休日は割増になる会社があります。営業時間中の断水を避けたい施設は、希望の時間帯を伝えたうえで見積りを取り、割増の有無と率を確認してください。' },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
});
const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-jusuisou-seisou.png` },
});

---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified} title={title} description={description} canonical={canonical} siteName={site.name} logoSub="施設管理の一括見積比較" jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd]}>
  <article class="cl-article">
    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a><span aria-hidden="true">›</span>
          <a href="/column/">コラム</a><span aria-hidden="true">›</span>
          <span>東京の受水槽清掃 業者選び</span>
        </nav>
        <span class="cl-cat">受水槽清掃</span>
        <h1 class="cl-title">東京で受水槽清掃の業者を選ぶ｜都の条例・登録営業所の調べ方・法定検査・料金の例</h1>
        <p class="cl-lead">
          東京都内の受水槽は、水道法・建築物衛生法に加えて、<strong>10m³以下の小規模な受水槽にも東京都や区の条例</strong>の定めがあります。この記事では、東京で清掃業者を選ぶときに役立つ<strong>登録営業所の調べ方、法定検査、料金の例、見積りで確認したい点</strong>を、公的資料と公開情報で確認して整理します。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月19日</time>
          <span>最終更新：2026年9月26日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a></span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 東京で受水槽清掃の業者はどう選べばよいですか？</p>
        <p class="cl-qa-a">A. <strong>①自分の受水槽にどの決まりが当てはまるか確認 ②東京都健康安全研究センターの一覧で登録営業所かを確認 ③容量・高置水槽・水質検査・時間帯をそろえて見積りを比べる</strong>の順が確実です。10m³超なら、清掃とは別に年1回の法定検査も必要です。</p>
        <p class="cl-qa-src">※水道法・建築物衛生法、東京都保健医療局・東京都健康安全研究センターの公開情報による（2026年9月確認）</p>
      </div>

      <ColumnCtaCard serviceSlug="jusuisou-seisou" serviceName="受水槽清掃" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">この記事の目次</h2>
        <ol>
          <li><a href="#rules">東京の受水槽に関わる決まり</a></li>
          <li><a href="#registry">登録営業所の調べ方</a></li>
          <li><a href="#kensa">都内の法定検査</a></li>
          <li><a href="#price">料金の例</a></li>
          <li><a href="#choose">見積りで確認したいこと</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="rules" class="cl-section">
        <h2>東京の受水槽に関わる決まり</h2>
        <div class="cl-table-wrap">
          <table class="cl-table cl-table--wrap">
            <caption>東京都内の受水槽に関わる主な決まり</caption>
            <thead><tr><th>区分</th><th>対象</th><th>主な内容</th></tr></thead>
            <tbody>
              <tr><th scope="row">簡易専用水道（水道法）</th><td>水道水だけが水源で、受水槽の有効容量の合計が10m³を超えるもの</td><td>清掃：毎年1回以上／登録検査機関などの検査：毎年1回以上</td></tr>
              <tr><th scope="row">特定建築物（建築物衛生法）</th><td>事務所・店舗などの用途部分が延べ3,000m²以上（学校は8,000m²以上）</td><td>貯水槽の清掃：1年以内ごとに1回／帳簿書類の5年保存</td></tr>
              <tr><th scope="row">特定小規模貯水槽水道等（東京都条例）</th><td>有効容量10m³以下で、学校・病院・社会福祉施設等に給水するもの、または5m³を超えるもの</td><td>清掃：1年に1回以上／管理状況の検査・点検：1年に1回以上／記録の保存・保健所への届出</td></tr>
            </tbody>
          </table>
        </div>
        <p>東京都の条例は<strong>都の保健所の管内</strong>を対象とするもので、特別区などは区の条例で定めている場合があります。自分の建物がどれに当たるかは<a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a>で確認でき、最終的には所在地の保健所に確認してください。</p>
        <p class="cl-note">出典：<a href="https://laws.e-gov.go.jp/law/332AC0000000177" rel="noopener" target="_blank">水道法</a>・<a href="https://laws.e-gov.go.jp/law/346M50000100002" rel="noopener" target="_blank">建築物衛生法施行規則</a>（e-Gov法令検索）／<a href="https://www.hokeniryo.metro.tokyo.lg.jp/shisetsu/jigyosyo/hokenjyo/tamafuchu/eisei/suidou/chosuisou/shoukibo" rel="noopener" target="_blank">東京都多摩府中保健所「小規模貯水槽水道等」</a>（いずれも2026年9月確認）</p>
      </section>

      <section id="registry" class="cl-section">
        <h2>登録営業所の調べ方</h2>
        <p>建築物衛生法の「建築物飲料水貯水槽清掃業」の登録は、基準を満たす事業者が営業所ごとに受けることができる<strong>任意の制度</strong>です（第12条の2）。登録していない業者に頼んではいけないという規定はありませんが、登録には専用の機械器具、講習を修了した作業監督者、従事者の研修などが必要なため、比べるときの目安になります。</p>
        <p>東京都知事の登録を受けた営業所は、<strong>東京都健康安全研究センターの「建築物事業登録営業所の一覧」</strong>で確認できます。業種ごとにPDF・CSVが公開されており、貯水槽清掃は「建築物飲料水貯水槽清掃業」の一覧です。</p>
        <ol>
          <li>業者に登録番号と、作業を担当する営業所を聞く</li>
          <li>一覧で、その営業所が載っているかを確認する</li>
          <li>見積書・契約書に登録番号を記載してもらう</li>
        </ol>
        <p class="cl-note">出典：<a href="https://www.tmiph.metro.tokyo.lg.jp/k_kenchiku/list/" rel="noopener" target="_blank">東京都健康安全研究センター「建築物事業登録営業所の一覧」</a>（令和8年8月31日現在の一覧、2026年9月確認）。制度の詳細は<a href="/column/jusuisou-seisou-shikaku/">貯水槽清掃の資格で見る業者選び</a>で解説しています。</p>
      </section>

      <section id="kensa" class="cl-section">
        <h2>都内の法定検査</h2>
        <p>有効容量10m³超の簡易専用水道は、清掃とは別に、<strong>登録検査機関などの検査を毎年1回以上</strong>受ける必要があり、受けないと100万円以下の罰金の対象です（水道法第34条の2第2項・第54条）。</p>
        <p>たとえば公益財団法人日本建築衛生管理教育センターは、東京都内（島しょを除く）で簡易専用水道の検査を行っています。検査員が訪問して給水設備の管理状況、給水栓の水質（臭気・味・色・濁りなど）と残留塩素、図面や水槽の清掃記録などの整理保存状況を確認する「施設検査」と、特定建築物内の施設が選べる「書類検査」があり、料金は問い合わせとなっています。</p>
        <p class="cl-note">出典：<a href="https://www.jahmec.or.jp/kensa/kansui.html" rel="noopener" target="_blank">日本建築衛生管理教育センター「簡易専用水道検査」</a>（2026年9月確認）。ほかの検査機関もあるため、所在地の保健所で確認できます。</p>
      </section>

      <section id="price" class="cl-section">
        <h2>料金の例</h2>
        <p>東京都内の清掃会社で料金表を公開している例として、たてものサービスの料金表（税抜・水質検査10項目込み）では、受水槽10トンで47,000円、20トンで67,000円、高置水槽は3トンまで16,000円、10トンで30,000円です。別途、出張諸経費6,500円がかかります。</p>
        <p class="cl-note">出典：<a href="https://www.tatemono-s.jp/category/1502322.html" rel="noopener" target="_blank">たてものサービス「貯水槽・受水槽清掃の料金表」</a>（2026年9月確認）。ほかの会社の例との比較は<a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場｜公開料金表で見る容量別の目安と追加費用</a>にまとめています。</p>
      </section>

      <section id="choose" class="cl-section">
        <h2>見積りで確認したいこと</h2>
        <ul>
          <li><strong>水槽の構成</strong>：受水槽と高置水槽それぞれの容量・数・設置場所（屋上・地下ピットなど）を伝える</li>
          <li><strong>作業時間帯</strong>：営業時間中の断水を避けたい場合は、夜間・休日・早朝の割増の有無と率を確認する</li>
          <li><strong>搬入の条件</strong>：高層の建物で屋上に高置水槽がある場合は、機材の搬入経路やエレベーターの使用条件を事前に伝える</li>
          <li><strong>含まれるもの</strong>：水質検査、報告書、出張費・駐車場代、入居者への告知</li>
          <li><strong>登録と法定検査</strong>：登録の有無と登録番号。10m³超なら法定検査を誰が申し込むか</li>
        </ul>
        <p>確認項目の全体は<a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト｜見積り前に確認したい8項目</a>にまとめています。</p>
      </section>

      <div class="cl-cta">
        <h2>東京の受水槽清掃の業者探しなら</h2>
        <p>ロカサポが条件に合う清掃業者を探して<br/>最大5社ご紹介します（ご依頼者様は無料）。<br/>正式なお見積りは、選んだ業者から直接提示されます。</p>
        <a class="cta-btn-primary" href="/jusuisou-seisou/tokyo/">東京の清掃業者を探す</a>
      </div>

      <section id="faq" class="cl-section">
        <h2>よくある質問</h2>
        <dl class="cl-faq">
          {faqItems.map((f) => (<div class="cl-faq-item"><dt>{f.q}</dt><dd>{f.a}</dd></div>))}
        </dl>
      </section>

      <aside class="cl-related">
        <h2 class="cl-related-h">関連サービス・コラム</h2>
        <ul>
          <li><a href="/jusuisou-seisou/tokyo/">東京都の受水槽清掃</a></li>
          <li><a href="/column/jusuisou-gimu-check/">受水槽の義務チェック</a></li>
          <li><a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場</a></li>
          <li><a href="/column/jusuisou-seisou-gyosha-sentaku/">受水槽清掃の業者選びチェックリスト</a></li>
          <li><a href="/column/jusuisou-seisou-gyosha-osaka/">大阪で受水槽清掃の業者を選ぶ</a></li>
        </ul>
      </aside>

      <aside class="cl-glossary-block">
        <h2 class="cl-glossary-h">📖 この記事に出てくる主な用語</h2>
        <ul class="cl-glossary-list">
          <li><a href="/glossary/#kanni-senyou-suido">簡易専用水道</a></li>
          <li><a href="/glossary/#kenchiku-suiso-seisogyo">建築物飲料水貯水槽清掃業</a></li>
          <li><a href="/glossary/#tokutei-kenchikubutsu">特定建築物</a></li>
          <li><a href="/glossary/#koukasuisou">高架水槽</a></li>
        </ul>
        <p class="cl-glossary-more"><a href="/glossary/">施設管理用語集をすべて見る</a></p>
      </aside>
    </div>
  </article>
</BaseLayout>

