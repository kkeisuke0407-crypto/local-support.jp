---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ColumnCtaCard from '../../../components/ColumnCtaCard.astro';
import { site } from '../../../data/site';

const title = '業務用害虫駆除（PCO）完全ガイド｜法的義務・費用・業者選び・害虫別対策の総まとめ';
const description = '飲食店・食品工場・ホテル・マンション・倉庫などの業務用害虫駆除（PCO）を体系的に解説するハブ記事。HACCP・建築物衛生法の法的義務、費用相場と契約形態、ゴキブリ・ネズミ・トコジラミの害虫別対策、業種別ガイド、業者選びと地域別ガイドへの入口をまとめました。';
const canonical = `${site.domain}/column/pest-control-guide/`;
const published = '2026-06-29';
const modified = '2026-06-29';

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'コラム', item: `${site.domain}/column/` },
    { '@type': 'ListItem', position: 3, name: '業務用害虫駆除（PCO）完全ガイド', item: canonical },
  ],
});

const articleLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: published,
  dateModified: modified,
  inLanguage: 'ja-JP',
  url: canonical,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  wordCount: 5600,
  articleSection: '害虫駆除',
  keywords: '業務用害虫駆除,PCO,害虫駆除 業者,ゴキブリ駆除,ネズミ駆除,トコジラミ,HACCP,IPM,害虫駆除 費用,防除',
  author: { '@type': 'Person', name: site.author.name, url: site.domain + '/author/' },
  publisher: { '@id': `${site.domain}/#organization` },
  image: { '@type': 'ImageObject', url: `${site.domain}/og-pest-control.png`, width: 1200, height: 630 },
  about: { '@type': 'Service', name: '害虫駆除', serviceType: '建築物の害虫防除（PCO）' },
  citation: [
    { '@type': 'Legislation', name: '食品衛生法（HACCP制度化）', url: 'https://www.mhlw.go.jp/stf/seisakunitsuite/bunya/0000098735.html' },
    { '@type': 'Legislation', name: '建築物における衛生的環境の確保に関する法律（建築物衛生法）', url: 'https://laws.e-gov.go.jp/law/345AC0000000020' },
  ],
});

// クラスタ記事のItemList（ハブとしての構造化）
const clusterArticles = [
  { name: '害虫駆除の法的義務ガイド（建築物衛生法・食品衛生法HACCP）', url: `${site.domain}/column/pest-control-horei-gimu/` },
  { name: 'HACCP制度化で必須になった害虫対策ガイド', url: `${site.domain}/column/pest-control-haccp/` },
  { name: '飲食店の害虫駆除 頻度・法的義務 完全ガイド', url: `${site.domain}/column/pest-control-inshokuten-hindo-gimu/` },
  { name: '業務用害虫駆除（PCO）の費用相場', url: `${site.domain}/column/pest-control-hiyo-sohba/` },
  { name: '害虫駆除の定期契約とスポット駆除を徹底比較', url: `${site.domain}/column/pest-control-teiki-spot-hikaku/` },
  { name: '業務用ゴキブリ駆除の業者選び完全ガイド', url: `${site.domain}/column/pest-control-gokiburi-gyosha/` },
  { name: '飲食店のネズミ駆除 緊急対応の費用相場', url: `${site.domain}/column/pest-control-nezumi-inshokuten/` },
  { name: 'トコジラミ駆除 宿泊施設の対応マニュアル', url: `${site.domain}/column/pest-control-tokojirami-shukuhaku/` },
  { name: '食品工場の防虫設計 FSSC22000対応業者の選び方', url: `${site.domain}/column/pest-control-shokuhin-koujou-boumushi/` },
  { name: '倉庫・物流施設のIPM導入ガイド', url: `${site.domain}/column/pest-control-souko-butsuryu-ipm/` },
  { name: 'マンション管理組合の害虫駆除', url: `${site.domain}/column/pest-control-mansion-kanri-kumiai/` },
  { name: 'ペストコントロール協会の会員業者を見分ける方法', url: `${site.domain}/column/pest-control-kyokai-kaiin/` },
  { name: '福岡で害虫駆除業者を選ぶ完全ガイド', url: `${site.domain}/column/pest-control-gyosha-fukuoka/` },
  { name: '大阪で害虫駆除業者を選ぶ完全ガイド', url: `${site.domain}/column/pest-control-gyosha-osaka/` },
];

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '業務用害虫駆除 関連記事一覧',
  numberOfItems: clusterArticles.length,
  itemListElement: clusterArticles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: a.name,
    url: a.url,
  })),
});

const faqItems = [
  {
    q: '業務用害虫駆除（PCO）と家庭用の駆除は何が違いますか？',
    a: 'PCO（ペストコントロール）は、薬剤散布だけでなく「侵入させない・定着させない・早期に検知する」というIPM（総合的有害生物管理）に基づき、発生源と侵入経路を継続管理する点が家庭用と大きく異なります。さらに飲食店・食品工場ではHACCP対応の防除記録が必要になるため、記録を発行できる専門業者への委託が前提になります。',
  },
  {
    q: '害虫駆除に法的な義務はありますか？',
    a: '食品事業者は2021年6月から義務化されたHACCPの一般衛生管理として「そ族・昆虫対策」と記録が求められます。また建築物衛生法の特定建築物（延床3,000㎡以上で特定用途）は、ねずみ・昆虫等の生息状況調査を6か月以内ごとに1回、統一的に実施する義務があります。業種・施設により適用される制度が異なるため、自社がどれに該当するかの確認が出発点です。',
  },
  {
    q: '害虫駆除の費用はどのくらいかかりますか？',
    a: '業態・面積・契約形態・対象害虫で変わります。飲食店の定期モニタリング契約で1回あたり数千円〜、スポット駆除で1万円台〜、食品工場・大型施設の総合管理では月額数万〜数十万円が目安です。詳しくは費用相場の記事で業種別・契約形態別に整理しています。',
  },
  {
    q: 'どんな業者を選べばよいですか？',
    a: '①建築物ねずみ昆虫等防除業の登録、②有資格者の在籍、③IPM対応（薬剤散布だけでない）、④HACCP対応の報告書発行、⑤協会会員かどうか、を確認するのが基本です。会員かどうかは「足切り」的な目安の一つで、最終判断はIPM提案力・報告書の質・見積もりの明確さを総合的に見ます。',
  },
  {
    q: 'まず何から読めばよいですか？',
    a: '飲食店なら「飲食店の害虫駆除 頻度・法的義務」、コストを知りたいなら「費用相場」、業者を選ぶ段階なら「業務用ゴキブリ駆除の業者選び」または地域別ガイドが入口に向いています。本記事の各セクションから目的別に該当記事へ進めます。',
  },
];

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
});

const webPageLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': canonical,
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['.cl-quickanswer', '.cl-callout', '.cl-lead', '.cl-faq-item dt', '.cl-faq-item dd'],
  },
  primaryImageOfPage: { '@type': 'ImageObject', url: `${site.domain}/og-pest-control.png` },
});
---
<BaseLayout ogType="article" publishedTime={published} modifiedTime={modified}
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  ogImage={`${site.domain}/og-pest-control.png`}
  jsonLdBlocks={[breadcrumbLd, articleLd, faqLd, webPageLd, itemListLd]}
>
  <article class="cl-article">

    <header class="cl-header">
      <div class="sd-container">
        <nav class="cl-crumbs" aria-label="パンくず">
          <a href="/">トップ</a>
          <span aria-hidden="true">›</span>
          <a href="/column/">コラム</a>
          <span aria-hidden="true">›</span>
          <span>業務用害虫駆除（PCO）完全ガイド</span>
        </nav>
        <span class="cl-cat">害虫駆除</span>
        <h1 class="cl-title">業務用害虫駆除（PCO）完全ガイド｜法的義務・費用・業者選び・害虫別対策の総まとめ</h1>
        <p class="cl-lead">
          飲食店・食品工場・ホテル・マンション・倉庫などの<strong>業務用害虫駆除（PCO）</strong>は、「発生したら駆除する」ではなく<strong>法的義務・継続管理・記録までを含めた衛生管理</strong>です。このページは、害虫駆除に関する当サイトの記事を<strong>目的別に整理したハブ</strong>です。法的義務・費用・害虫別対策・業種別ガイド・業者選び・地域別ガイドへ、ここから必要な記事に進めます。※2026年6月時点の情報をもとに整理。
        </p>
        <div class="cl-meta">
          <time datetime={published}>公開：2026年6月29日</time>
          <span>最終更新：2026年6月29日</span>
          <span>執筆：<a href="/author/" class="cl-author-link">{site.author.name}</a>（{site.author.role}）</span>
        </div>
      </div>
    </header>

    <div class="sd-container cl-body">

      <div class="cl-quickanswer">
        <p class="cl-qa-q">Q. 業務用害虫駆除でまず押さえるべきことは？</p>
        <p class="cl-qa-a">A. <strong>①自社の業種・施設にかかる法的義務（HACCP／建築物衛生法）の確認、②IPM（侵入防止・環境整備・モニタリング）に基づく継続管理、③登録・資格・記録発行ができる業者の選定</strong>の3点。害虫駆除は「駆除して終わり」ではなく、記録まで含めた衛生管理。目的別に下記の各ガイドへ進んでください。</p>
        <p class="cl-qa-src">※食品衛生法（HACCP）・建築物衛生法、害虫管理の一般的知見をもとに整理</p>
      </div>

      <ColumnCtaCard serviceSlug="pest-control" serviceName="害虫駆除" variant="top" />

      <aside class="cl-toc" aria-label="目次">
        <h2 class="cl-toc-h">このガイドの構成</h2>
        <ol>
          <li><a href="#summary">3行サマリ</a></li>
          <li><a href="#basic">害虫駆除（PCO）の基本｜なぜ専門業者か</a></li>
          <li><a href="#legal">法的義務で押さえる（HACCP・建築物衛生法）</a></li>
          <li><a href="#cost">費用と契約形態</a></li>
          <li><a href="#pest">害虫の種類別対策（ゴキブリ・ネズミ・トコジラミ）</a></li>
          <li><a href="#industry">業種・施設別ガイド</a></li>
          <li><a href="#select">業者選びの基準</a></li>
          <li><a href="#area">地域別ガイド</a></li>
          <li><a href="#faq">よくある質問</a></li>
        </ol>
      </aside>

      <section id="summary" class="cl-section">
        <div class="cl-callout">
          <h2 class="cl-callout-h">この記事の結論（3行サマリ）</h2>
          <ul>
            <li><strong>害虫駆除は法的義務×継続管理×記録</strong>。HACCP・建築物衛生法のどれが自社に効くかをまず確認</li>
            <li><strong>薬剤散布よりIPM</strong>。侵入防止・環境整備・モニタリングを継続できる業者と定期契約するのが基本</li>
            <li><strong>業者選びは登録・資格・記録発行が土台</strong>。協会会員は目安の一つ。目的別に下記ガイドへ</li>
          </ul>
        </div>
      </section>

      <section id="basic" class="cl-section">
        <h2>害虫駆除（PCO）の基本｜なぜ専門業者か</h2>
        <p>業務施設の害虫対策は、市販の殺虫剤で個体を減らすだけでは根本解決になりません。PCO（ペストコントロール）が専門業者に委託される理由は主に3つです。</p>
        <ul>
          <li><strong>発生源・侵入経路の特定と封鎖</strong>：搬入物・排水・配管・隙間など、専門調査がないと根本原因を断てない</li>
          <li><strong>法令・記録対応</strong>：HACCP・建築物衛生法では「実施したこと」を記録として残す必要がある</li>
          <li><strong>薬剤の適正使用</strong>：食品施設での薬剤は養生・濃度・廃棄に専門知識が必要</li>
        </ul>
        <p>こうした管理の考え方の中心が<strong>IPM（総合的有害生物管理）</strong>です。「侵入させない・定着させない・早期に検知する」を組み合わせ、薬剤は最後の手段とします。IPMの実践は<a href="/column/pest-control-souko-butsuryu-ipm/">倉庫・物流施設のIPM導入ガイド</a>や<a href="/column/pest-control-shokuhin-koujou-boumushi/">食品工場の防虫設計ガイド</a>で具体的に解説しています。</p>
      </section>

      <section id="legal" class="cl-section">
        <h2>法的義務で押さえる（HACCP・建築物衛生法）</h2>
        <p>害虫駆除の「やるべき水準」は、自社の業種・施設にかかる法令で決まります。まずどの制度が該当するかを確認してください。</p>
        <div class="cl-answer-grid">
          <div>
            <h3>HACCP（食品事業者）</h3>
            <p>2021年6月から原則すべての食品事業者が対象。一般衛生管理の「そ族・昆虫対策」と防除記録が必要。</p>
            <p class="cl-grid-link"><a href="/column/pest-control-haccp/">→ HACCP害虫対策ガイド</a></p>
          </div>
          <div>
            <h3>飲食店の頻度・義務</h3>
            <p>業態別の標準頻度、保健所立入で確認される記録、食品衛生法上の位置づけを整理。</p>
            <p class="cl-grid-link"><a href="/column/pest-control-inshokuten-hindo-gimu/">→ 飲食店の頻度・法的義務</a></p>
          </div>
        </div>
        <p>建築物衛生法の特定建築物（延床3,000㎡以上で特定用途）は、ねずみ・昆虫等の生息状況調査を6か月以内ごとに1回、統一的に実施する義務があります。適用法令・登録業者・罰則・記録保存までの全体像は<a href="/column/pest-control-horei-gimu/">害虫駆除の法的義務ガイド（建築物衛生法・HACCP）</a>で詳しく解説しています。マンション・複合ビルの該当判定は<a href="/column/pest-control-mansion-kanri-kumiai/">マンション管理組合の害虫駆除</a>もご参照ください。</p>
      </section>

      <section id="cost" class="cl-section">
        <h2>費用と契約形態</h2>
        <p>害虫駆除のコストは、業態・面積・契約形態・対象害虫で変わります。費用の全体像と、定期契約とスポットの使い分けを押さえましょう。</p>
        <div class="cl-answer-grid">
          <div>
            <h3>費用相場</h3>
            <p>業種別・契約形態別の料金、月次モニタリング・スポット・大型施設の目安を整理。</p>
            <p class="cl-grid-link"><a href="/column/pest-control-hiyo-sohba/">→ 業務用害虫駆除の費用相場</a></p>
          </div>
          <div>
            <h3>定期契約 vs スポット</h3>
            <p>損益分岐点（年4回前後）、HACCP対応・監査有無による選び方、契約書チェック項目。</p>
            <p class="cl-grid-link"><a href="/column/pest-control-teiki-spot-hikaku/">→ 定期契約とスポットを徹底比較</a></p>
          </div>
        </div>
        <p>飲食店・食品施設など「発生させてはいけない」業態は、記録も残せる<strong>定期モニタリング契約が基本</strong>です。緊急の大量発生は初回スポット→定期移行が費用対効果の高い組み合わせです。</p>
      </section>

      <section id="pest" class="cl-section">
        <h2>害虫の種類別対策（ゴキブリ・ネズミ・トコジラミ）</h2>
        <p>害虫は種類ごとに行動・繁殖・対策手法が異なります。代表的な3種について、業務施設向けの対策をまとめています。</p>
        <div class="cl-answer-grid">
          <div>
            <h3>ゴキブリ</h3>
            <p>業務施設で最も相談が多い。発生源・侵入経路の封鎖とIPMで再発を抑える。業者選びの核心も解説。</p>
            <p class="cl-grid-link"><a href="/column/pest-control-gokiburi-gyosha/">→ 業務用ゴキブリ駆除の業者選び</a></p>
          </div>
          <div>
            <h3>ネズミ</h3>
            <p>飲食店での緊急対応の初動、保健所・営業停止リスク、侵入封鎖による再発防止まで。</p>
            <p class="cl-grid-link"><a href="/column/pest-control-nezumi-inshokuten/">→ 飲食店のネズミ駆除 緊急対応</a></p>
          </div>
          <div>
            <h3>トコジラミ</h3>
            <p>宿泊施設の発見時の初動・客室隔離、加熱処理と薬剤処理の違い、風評・賠償リスク対策。</p>
            <p class="cl-grid-link"><a href="/column/pest-control-tokojirami-shukuhaku/">→ トコジラミ駆除 宿泊施設マニュアル</a></p>
          </div>
        </div>
      </section>

      <section id="industry" class="cl-section">
        <h2>業種・施設別ガイド</h2>
        <p>同じ害虫対策でも、業種・施設により求められる水準と重点が異なります。自社の施設タイプから該当ガイドへ進んでください。</p>
        <div class="cl-table-wrap">
          <table class="cl-table">
            <caption>業種・施設別の害虫駆除ガイド</caption>
            <thead>
              <tr><th scope="col">施設タイプ</th><th scope="col">重点</th><th scope="col">該当ガイド</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">飲食店</th><td>HACCP記録・頻度・保健所対応</td><td><a href="/column/pest-control-inshokuten-hindo-gimu/">飲食店の害虫駆除 頻度・法的義務</a></td></tr>
              <tr><th scope="row">食品工場</th><td>FSSC22000・防虫設計・トレンド分析</td><td><a href="/column/pest-control-shokuhin-koujou-boumushi/">食品工場の防虫設計ガイド</a></td></tr>
              <tr><th scope="row">倉庫・物流</th><td>輸入貨物リスク・IPM・FSSC対応</td><td><a href="/column/pest-control-souko-butsuryu-ipm/">倉庫・物流施設のIPM導入</a></td></tr>
