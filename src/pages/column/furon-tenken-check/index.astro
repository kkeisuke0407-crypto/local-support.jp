.cl-table-wrap { overflow-x: auto; margin: 20px 0 24px; }
.cl-table { width: 100%; border-collapse: collapse; font-size: .87rem; }
.cl-table caption { caption-side: top; font-size: .78rem; color: var(--gray-500); text-align: left; margin-bottom: 8px; }
.cl-table th, .cl-table td { padding: 10px 14px; border: 1px solid var(--gray-200); text-align: left; line-height: 1.6; }
.cl-table thead th { background: var(--blue-light); color: var(--blue-dark); font-weight: 700; }
.cl-table tbody tr:nth-child(even) { background: #f9fafb; }
.cl-table tbody th[scope="row"] { background: #f3f4f6; font-weight: 700; white-space: nowrap; }
.cl-callout { background: var(--blue-light); border-left: 4px solid var(--blue); border-radius: 0 8px 8px 0; padding: 20px 24px; margin: 20px 0; }
