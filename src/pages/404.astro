---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { allServices } from '../data/services';

const title = `ページが見つかりません｜${site.name}`;
const description = '指定されたページが見つかりませんでした。URLをご確認いただくか、トップページからお探しください。';
const canonical = `${site.domain}/404/`;
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  noindex={true}
>
  <section class="e404-hero">
    <div class="sd-container">
      <p class="e404-code">404</p>
      <h1 class="e404-h1">ページが見つかりません</h1>
      <p class="e404-lead">
        お探しのページは移動・削除されたか、URLが正しくない可能性があります。<br />
        以下から目的のページをお探しください。
      </p>
      <a href="/" class="e404-btn">トップページへ戻る</a>
    </div>
  </section>

  <section class="sd-section section-white">
    <div class="sd-container e404-container">

      <div class="e404-block">
        <h2 class="e404-h2">サービスから探す</h2>
        <ul class="e404-svc-list">
          {allServices.map((s) => (
            <li>
              <a href={`/${s.slug}/`}>{s.serviceName}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="e404-block">
        <h2 class="e404-h2">コラム記事から探す</h2>
        <ul class="e404-link-list">
          <li><a href="/column/">コラム一覧を見る</a></li>
          <li><a href="/column/jusuisou-seisou-hiyo-sohba/">受水槽清掃の費用相場2026</a></li>
          <li><a href="/column/asbestos-hiyo-sohba/">アスベスト調査・除去の費用相場2026</a></li>
          <li><a href="/column/duct-hiyo-sohba/">ダクト清掃の費用相場2026</a></li>
          <li><a href="/column/shobo-setsubi-hiyo-sohba/">消防設備点検の費用相場2026</a></li>
          <li><a href="/column/grease-trap-hiyo-sohba/">グリストラップ清掃の費用相場2026</a></li>
          <li><a href="/column/shutter-hiyo-sohba/">シャッター点検・修理の費用相場2026</a></li>
          <li><a href="/column/aircon-business-hiyo-sohba/">業務用エアコン洗浄・修理の費用相場2026</a></li>
          <li><a href="/column/pest-control-hiyo-sohba/">業務用害虫駆除の費用相場2026</a></li>
          <li><a href="/column/signboard-inspection-hiyo-sohba/">看板点検の費用相場2026</a></li>
        </ul>
      </div>

      <div class="e404-block">
        <h2 class="e404-h2">サイト情報</h2>
        <ul class="e404-link-list">
          <li><a href="/flow/">ご利用の流れ</a></li>
          <li><a href="/author/">運営者プロフィール</a></li>
          <li><a href="/operator/">運営会社情報</a></li>
          <li><a href="/sitemap/">サイトマップ</a></li>
          <li><a href="/privacy/">プライバシーポリシー</a></li>
        </ul>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.e404-hero {
  background: linear-gradient(135deg, #1a3a5c 0%, #1a56db 100%);
  color: #fff;
  text-align: center;
  padding: 64px 20px 56px;
}
.e404-code {
  font-size: clamp(4rem, 12vw, 7rem);
  font-weight: 900;
  line-height: 1;
  opacity: .25;
  margin: 0 0 12px;
  letter-spacing: -.04em;
}
.e404-h1 {
  font-size: clamp(1.3rem, 4vw, 1.8rem);
  font-weight: 900;
  margin-bottom: 16px;
}
.e404-lead {
  font-size: .95rem;
  line-height: 1.85;
  opacity: .9;
  max-width: 560px;
  margin: 0 auto 28px;
}
.e404-btn {
  display: inline-block;
  background: #f59e0b;
  color: #1a1a1a;
  font-weight: 800;
  font-size: 1rem;
  padding: 14px 32px;
  border-radius: 8px;
  text-decoration: none;
}
.e404-btn:hover { background: #d97706; }
.e404-container { max-width: 860px; }
.e404-block { margin-bottom: 48px; }
.e404-h2 {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--gray-900);
  margin-bottom: 16px;
  padding-bottom: 8px;
  border-bottom: 2px solid var(--blue);
}
.e404-svc-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 8px 24px;
}
.e404-svc-list li a {
  display: block;
  background: var(--gray-100);
  border: 1px solid var(--gray-200);
  border-radius: 8px;
  padding: 12px 16px;
  font-size: .92rem;
  font-weight: 700;
  color: var(--blue);
  text-decoration: none;
}
.e404-svc-list li a:hover { background: var(--blue-light); }
.e404-link-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 8px;
}
.e404-link-list a {
  color: var(--blue);
  font-size: .93rem;
  text-decoration: underline;
}
.e404-link-list a:hover { opacity: .75; }
</style>
