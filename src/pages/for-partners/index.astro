---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, serviceIndex } from '../../data/site';

const title = '業者・施工会社の方へ｜ロカサポへの掲載・提携のご案内';
const description = '受水槽清掃・消防設備点検・アスベスト調査など、施設管理サービスを手がける業者の方向けに、ロカサポへの掲載・提携をご案内します。ロカサポでは、登録資格・許認可を確認した有資格業者だけを施設管理担当者にご紹介しています。';
const canonical = `${site.domain}/for-partners/`;

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: '業者・施工会社の方へ', item: canonical },
  ],
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '掲載に費用はかかりますか？', acceptedAnswer: { '@type': 'Answer', text: '初期登録は無料です。紹介料・成果報酬の料率は、サービス分野・対応エリア・登録時期にあわせて個別にご相談します。詳しくはお問い合わせください。' } },
    { '@type': 'Question', name: 'どんな業者が登録できますか？', acceptedAnswer: { '@type': 'Answer', text: '各サービス分野で必要な登録・国家資格・許認可をお持ちの業者が対象です。例えば、受水槽清掃なら「建築物飲料水貯水槽清掃業」の都道府県知事登録、消防設備点検なら消防設備士または消防設備点検資格者の在籍が必要です。' } },
    { '@type': 'Question', name: '対応エリアはどう決めますか？', acceptedAnswer: { '@type': 'Answer', text: '都道府県・市区町村単位で対応エリアを指定できます。複数の都道府県にまたがる対応も可能です。出張対応の可否や追加料金の条件も登録時にお知らせください。' } },
    { '@type': 'Question', name: '紹介の流れを教えてください。', acceptedAnswer: { '@type': 'Answer', text: '依頼者から見積依頼が入った時点で、対応可能な登録業者を最大3社まで選んでご紹介します。以降は依頼者と業者で直接やりとりしていただき、見積提示・契約も当事者間で進めていただきます。' } },
    { '@type': 'Question', name: '紹介後の報告・支払いはどう進みますか？', acceptedAnswer: { '@type': 'Answer', text: '成約の有無は月ごとに業者様からご報告いただきます。成果報酬型の場合は、その報告をもとに翌月末に請求書を発行します。細かい運用ルールは契約時にご説明します。' } },
    { '@type': 'Question', name: '途中で解約・休止できますか？', acceptedAnswer: { '@type': 'Answer', text: 'はい、月単位での休止・解約が可能です。1か月前にご連絡をお願いしています。違約金はかかりません。' } },
  ],
});

// 必要な資格・許認可の対応表
const qualifications = [
  { service: '受水槽清掃', slug: 'jusuisou-seisou', required: '建築物飲料水貯水槽清掃業（都道府県知事登録）' },
  { service: 'アスベスト調査・除去', slug: 'asbestos', required: '建築物石綿含有建材調査者、石綿作業主任者（除去工事）' },
  { service: 'ダクト清掃', slug: 'duct', required: '産業廃棄物収集運搬業（清掃廃棄物がある場合）' },
  { service: 'シャッター点検・修理', slug: 'shutter', required: '建築設備検査員・防火設備検査員（防火シャッター）' },
  { service: '消防設備点検', slug: 'shobo-setsubi', required: '消防設備士（甲種・乙種）、消防設備点検資格者' },
  { service: 'グリストラップ清掃', slug: 'grease-trap', required: '産業廃棄物収集運搬業（汚泥・廃油）' },
  { service: '業務用エアコン洗浄・修理', slug: 'aircon-business', required: '第一種冷媒フロン類取扱技術者、第一種フロン類充塡回収業者登録' },
  { service: '害虫駆除（業務用PCO）', slug: 'pest-control', required: '建築物ねずみ昆虫等防除業、ペストコントロール技術者' },
  { service: '看板・屋外広告物点検', slug: 'signboard-inspection', required: '屋外広告物点検技能講習修了者、電気工事士（電飾サイン）' },
];
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="業者・施工会社の方へ"
  jsonLdBlocks={[breadcrumbLd, faqLd]}
>
  <section class="fp-hero">
    <div class="sd-container">
      <nav class="fp-crumbs" aria-label="パンくず">
        <a href="/">トップ</a><span aria-hidden="true">›</span><span>業者・施工会社の方へ</span>
      </nav>
      <p class="fp-kicker">FOR PARTNERS</p>
      <h1 class="fp-h1">業者・施工会社の方へ<br/><span class="fp-h1-sub">— ロカサポへの掲載・提携のご案内</span></h1>
      <p class="fp-lead">
        ロカサポでは、<strong>登録資格・許認可を確認した有資格業者だけ</strong>を、施設管理担当者（マンション管理組合・ビル管理会社・店舗オーナー など）にご紹介しています。新規登録・提携のご相談を受け付け中です。
      </p>
      <div class="fp-cta-row">
        <a href="#apply" class="fp-cta-primary">提携のお問い合わせへ ↓</a>
        <a href="#flow" class="fp-cta-secondary">提携の流れを見る</a>
      </div>
    </div>
  </section>

  <section class="sd-section fp-section">
    <div class="sd-container fp-container">

      <h2 id="why" class="fp-h2">ロカサポと提携するメリット</h2>
      <div class="fp-merit-grid">
        <div class="fp-merit-card">
          <h3>依頼者の質が高い</h3>
          <p>マンション管理組合・ビル管理会社・店舗運営事業者が中心です。価格だけでなく、資格・実績・長く付き合えるかを重視する依頼者が多いのが特徴です。</p>
        </div>
        <div class="fp-merit-card">
          <h3>事前にふるい分け</h3>
          <p>依頼者からエリア・施設種別・緊急度を事前にうかがっているので、対応できる案件だけをご案内します。</p>
        </div>
        <div class="fp-merit-card">
          <h3>有資格者のみで差別化</h3>
          <p>登録には資格・許認可の確認が必須。無資格・無許可業者と同じ土俵に並ばないので、価格だけで比べられにくくなります。</p>
        </div>
        <div class="fp-merit-card">
          <h3>気軽に始められる</h3>
          <p>初期登録費用は無料。月単位で休止・解約でき、違約金もかかりません。</p>
        </div>
      </div>

      <h2 id="qualifications" class="fp-h2">対応サービスと必要な資格・許認可</h2>
      <p class="fp-desc">
        ロカサポでは、次の9分野で業者を募集しています。登録には、各分野で必要な資格・許認可をお持ちであることが条件です。
      </p>
      <div class="fp-table-wrap">
        <table class="fp-table">
          <thead>
            <tr>
              <th scope="col">サービス分野</th>
              <th scope="col">必要な資格・許認可（例）</th>
            </tr>
          </thead>
          <tbody>
            {qualifications.map((q) => (
              <tr>
                <th scope="row"><a href={`/${q.slug}/`}>{q.service}</a></th>
                <td>{q.required}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fp-note">
        上記以外の関連資格（建築士・電気工事士・防火管理者・施工管理技士 など）もプラス評価の対象です。お問い合わせのときにあわせてお知らせください。
      </p>

      <h2 id="flow" class="fp-h2">提携の流れ</h2>
      <ol class="fp-flow">
        <li>
          <span class="fp-flow-num">STEP 1</span>
          <h3>お問い合わせ</h3>
          <p>ページ下部のフォームから「種別：提携相談」を選んでご連絡ください。会社概要・対応サービス・対応エリアを簡単にご記入いただきます。</p>
        </li>
        <li>
          <span class="fp-flow-num">STEP 2</span>
          <h3>打ち合わせ・資格確認</h3>
          <p>営業日3日以内に運営からご返信します。電話またはオンライン会議で20〜30分ほどお話を伺い、必要な許認可・資格証を確認します。</p>
        </li>
        <li>
          <span class="fp-flow-num">STEP 3</span>
          <h3>契約・登録</h3>
          <p>登録条件・料率にご納得いただけたら、業者プロフィール（対応エリア・営業時間・得意分野 など）を登録します。所要期間は1〜2週間ほどです。</p>
        </li>
        <li>
          <span class="fp-flow-num">STEP 4</span>
          <h3>紹介スタート</h3>
          <p>依頼者から見積依頼が入り次第、対応エリア・サービス範囲をもとに最大3社をご紹介します。毎月の成約報告と請求処理もこちらで行います。</p>
        </li>
      </ol>

      <h2 id="faq" class="fp-h2">よくあるご質問</h2>
      <dl class="fp-faq">
        <div class="fp-faq-item">
          <dt>掲載に費用はかかりますか？</dt>
          <dd>初期登録は無料です。紹介料・成果報酬の料率は、サービス分野・対応エリア・登録時期にあわせて個別にご相談します。</dd>
        </div>
        <div class="fp-faq-item">
          <dt>個人事業主でも登録できますか？</dt>
          <dd>はい、必要な資格・許認可をお持ちであれば個人事業主の方も登録できます。</dd>
        </div>
        <div class="fp-faq-item">
          <dt>同業他社のサイトにも登録していますが、大丈夫ですか？</dt>
          <dd>問題ありません。他社サービスと併用していただいてかまいません。</dd>
        </div>
        <div class="fp-faq-item">
          <dt>紹介された案件を断ることはできますか？</dt>
          <dd>はい、対応不可や繁忙期などで断っていただくのは問題ありません。ただし、極端に断りが続くと紹介順位に影響することがあります。</dd>
        </div>
        <div class="fp-faq-item">
          <dt>紹介後にトラブルが起きたらどうなりますか？</dt>
          <dd>依頼者と業者の間で起きたトラブルについて、ロカサポは原則として直接の責任は負いません。ただし、業者側に重大な過失（無資格での作業や法令違反 など）があった場合は、登録解除を含めた対応を取ります。</dd>
        </div>
        <div class="fp-faq-item">
          <dt>業者プロフィールはどこまで公開されますか？</dt>
          <dd>依頼者にご紹介するときに、社名・対応エリア・得意分野・主な実績などをお伝えします。電話番号・メールなどの連絡先は、依頼を受けていただくことが決まったあとに共有されます。</dd>
        </div>
      </dl>

      <div id="apply" class="fp-apply">
        <h2>提携・登録のお問い合わせ</h2>
        <p>下のフォームから「種別：提携相談（業者・メディア）」を選んでお問い合わせください。</p>
        <a href="/#contact" class="fp-apply-btn">お問い合わせフォームへ →</a>
        <p class="fp-apply-note">通常、2〜3営業日以内にご返信します。</p>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.fp-hero { background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%); color: #fff; padding: 56px 0 48px; }
.fp-crumbs { font-size: .78rem; opacity: .85; margin-bottom: 16px; display: flex; gap: 6px; align-items: center; }
.fp-crumbs a { color: #fff; text-decoration: none; }
.fp-crumbs a:hover { text-decoration: underline; }
.fp-kicker { font-size: .78rem; font-weight: 800; letter-spacing: .14em; color: #93c5fd; margin-bottom: 12px; }
.fp-h1 { font-size: clamp(1.5rem, 3.4vw, 2.1rem); font-weight: 900; line-height: 1.4; margin-bottom: 16px; }
.fp-h1-sub { display: block; font-size: clamp(.95rem, 2vw, 1.15rem); font-weight: 600; color: #cbe1ff; margin-top: 6px; }
.fp-lead { font-size: .95rem; line-height: 1.85; opacity: .95; max-width: 760px; margin-bottom: 24px; }
.fp-lead strong { color: #fff; }
.fp-cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
.fp-cta-primary {
  display: inline-block;
  background: var(--accent, #f59e0b);
  color: #1a202c;
  font-weight: 800;
  font-size: 1rem;
  padding: 12px 28px;
  border-radius: 8px;
  text-decoration: none;
}
.fp-cta-primary:hover { opacity: .9; }
.fp-cta-secondary {
  display: inline-block;
  background: transparent;
  border: 1.5px solid rgba(255,255,255,.6);
  color: #fff;
  font-weight: 600;
  font-size: .95rem;
  padding: 11px 24px;
  border-radius: 8px;
  text-decoration: none;
}
.fp-cta-secondary:hover { background: rgba(255,255,255,.12); }

.fp-section { padding: 56px 0 64px; background: #fff; }
.fp-container { max-width: 880px; }

.fp-h2 {
  font-size: 1.35rem;
  font-weight: 900;
  color: var(--gray-900, #111827);
  border-bottom: 2px solid var(--blue-light, #dbeafe);
  padding-bottom: 8px;
  margin: 44px 0 18px;
  scroll-margin-top: 80px;
}
.fp-h2:first-of-type { margin-top: 0; }
.fp-desc { font-size: .92rem; line-height: 1.85; color: var(--gray-700, #374151); margin-bottom: 16px; }
.fp-note { font-size: .82rem; color: var(--gray-500, #6b7280); margin-top: 12px; font-style: italic; }

.fp-merit-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 16px;
  margin-bottom: 8px;
}
.fp-merit-card {
  background: var(--gray-100, #f3f4f6);
  border-radius: 10px;
  padding: 20px 22px;
}
.fp-merit-card h3 {
  font-size: 1rem;
  font-weight: 800;
  color: var(--gray-900, #111827);
  margin-bottom: 8px;
}
.fp-merit-card p { font-size: .88rem; line-height: 1.75; color: var(--gray-700, #374151); margin: 0; }

.fp-table-wrap { overflow-x: auto; margin: 16px 0; }
.fp-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.fp-table th, .fp-table td { padding: 12px 14px; border: 1px solid var(--gray-200, #e5e7eb); text-align: left; line-height: 1.65; }
.fp-table thead th { background: var(--blue-light, #dbeafe); color: var(--blue-dark, #1e3a8a); font-weight: 700; }
.fp-table tbody th[scope="row"] { background: var(--gray-100, #f3f4f6); font-weight: 700; white-space: nowrap; }
.fp-table tbody th a { color: var(--blue, #1d4ed8); text-decoration: underline; }

.fp-flow { list-style: none; padding: 0; margin: 18px 0 8px; display: grid; gap: 14px; }
.fp-flow li {
  background: #fff;
  border: 1px solid var(--gray-200, #e5e7eb);
  border-radius: 10px;
  padding: 18px 22px;
}
.fp-flow-num {
  display: inline-block;
  background: var(--blue, #1d4ed8);
  color: #fff;
  font-size: .72rem;
  font-weight: 800;
  letter-spacing: .08em;
  padding: 3px 10px;
  border-radius: 4px;
  margin-bottom: 8px;
}
.fp-flow h3 { font-size: 1.02rem; font-weight: 800; color: var(--gray-900, #111827); margin-bottom: 6px; }
.fp-flow p { font-size: .9rem; line-height: 1.85; color: var(--gray-700, #374151); margin: 0; }

.fp-faq { display: grid; gap: 12px; margin: 18px 0 8px; }
.fp-faq-item { border: 1px solid var(--gray-200, #e5e7eb); border-radius: 10px; overflow: hidden; }
.fp-faq-item dt { background: var(--gray-100, #f3f4f6); padding: 14px 18px; font-weight: 700; font-size: .94rem; color: var(--gray-900, #111827); }
.fp-faq-item dd { padding: 14px 18px; font-size: .88rem; line-height: 1.85; color: var(--gray-700, #374151); margin: 0; }

.fp-apply {
  background: linear-gradient(135deg, #1a3a5c 0%, #1a56db 100%);
  color: #fff;
  border-radius: 14px;
  padding: 32px 28px;
  text-align: center;
  margin-top: 48px;
  scroll-margin-top: 80px;
}
.fp-apply h2 { font-size: 1.2rem; font-weight: 900; margin-bottom: 10px; color: #fff; border: none; padding: 0; }
.fp-apply p { font-size: .92rem; opacity: .92; margin-bottom: 16px; }
.fp-apply-btn {
  display: inline-block;
  background: var(--accent, #f59e0b);
  color: #1a202c;
  font-weight: 800;
  font-size: 1rem;
  padding: 14px 36px;
  border-radius: 8px;
  text-decoration: none;
}
.fp-apply-btn:hover { opacity: .9; }
.fp-apply-note { margin-top: 14px; font-size: .82rem; opacity: .8; }

@media (max-width: 640px) {
  .fp-hero { padding: 40px 0 32px; }
  .fp-section { padding: 36px 0 48px; }
  .fp-h2 { font-size: 1.15rem; }
  .fp-cta-row { flex-direction: column; align-items: stretch; }
  .fp-cta-primary, .fp-cta-secondary { text-align: center; }
}
</style>
