---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { serviceCategories, getCategoryHref } from '../../data/serviceCategories';
import { serviceBySlug } from '../../data/services';

const title = `施設管理サービスのカテゴリ一覧｜${site.name}`;
const description = 'ロカサポで比較できる施設管理サービスを、法定点検・衛生清掃・修繕工事・エネルギー防犯の4カテゴリに整理しました。必要な点検・清掃・工事をカテゴリから探せます。';
const canonical = `${site.domain}/category/`;

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'カテゴリ一覧', item: canonical },
  ],
});

const itemListLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${site.name} 施設管理サービスカテゴリ一覧`,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: serviceCategories.length,
  itemListElement: serviceCategories.map((category, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: category.label,
    description: category.description,
    url: `${site.domain}${getCategoryHref(category.slug)}`,
  })),
});
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理サービスのカテゴリ一覧"
  jsonLdBlocks={[breadcrumbLd, itemListLd]}
>
  <section class="hero hero--simple">
    <div class="sd-container">
      <h1 class="hero-h1">施設管理サービスのカテゴリ一覧</h1>
      <p class="hero-sub-simple">点検・清掃・修繕・設備導入を目的別に整理しています</p>
    </div>
  </section>

  <section class="sd-section section-white">
    <div class="sd-container cat-container">
      <div class="cat-lead">
        <p>
          ロカサポでは、施設管理に必要なサービスを4つのカテゴリに整理しています。
          施設の状況・法令義務・設備トラブルの種類から、必要なサービスを選びやすくするためのカテゴリハブです。
        </p>
      </div>

      <div class="cat-grid">
        {serviceCategories.map((category) => {
          const services = category.serviceSlugs.map((slug) => serviceBySlug[slug]).filter(Boolean);
          return (
            <article class="cat-card">
              <div class="cat-card-head">
                <span>{services.length}分野</span>
                <h2><a href={getCategoryHref(category.slug)}>{category.label}</a></h2>
              </div>
              <p>{category.description}</p>
              <ul class="cat-service-list">
                {services.map((service) => (
                  <li><a href={`/${service.slug}/`}>{service.serviceName}</a></li>
                ))}
              </ul>
              <a class="cat-card-link" href={getCategoryHref(category.slug)}>このカテゴリを見る</a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-container { max-width: 1040px; }
  .cat-lead {
    max-width: 860px;
    margin: 0 auto 32px;
    padding: 20px 24px;
    border: 1px solid rgba(26, 86, 219, 0.16);
    border-radius: 16px;
    background: #f8fbff;
  }
  .cat-lead p { margin: 0; color: var(--gray-700); line-height: 1.9; }
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
  }
  .cat-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    border: 1px solid var(--gray-200);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.05);
  }
  .cat-card-head span {
    display: inline-flex;
    margin-bottom: 8px;
    color: var(--blue);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .06em;
  }
  .cat-card h2 { margin: 0; font-size: 1.2rem; line-height: 1.45; }
  .cat-card h2 a { color: var(--gray-900); text-decoration: none; }
  .cat-card h2 a:hover { color: var(--blue); }
  .cat-card p { margin: 0; color: var(--gray-700); line-height: 1.8; font-size: .92rem; }
  .cat-service-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }
  .cat-service-list a {
    display: block;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--gray-100);
    color: var(--blue);
    font-size: .9rem;
    font-weight: 700;
    text-decoration: none;
  }
  .cat-service-list a:hover { background: var(--blue-light); }
  .cat-card-link {
    margin-top: auto;
    color: var(--blue);
    font-weight: 800;
    text-decoration: none;
  }
  .cat-card-link:hover { text-decoration: underline; }
</style>
