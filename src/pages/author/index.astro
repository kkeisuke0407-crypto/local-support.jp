---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { columns } from '../../data/columns';

const title = `${site.author.name}について｜${site.name}`;
const description = `${site.name}の記事を作成している「${site.author.name}」の紹介ページ。扱っている分野、記事の作り方、情報の確認方法、訂正のご連絡先をまとめています。`;
const canonical = `${site.domain}/author/`;

const recent = columns.slice(0, 8);

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: `${site.author.name}について`, item: canonical },
  ],
});

const teamLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.domain}/author/#editorial`,
  name: site.author.name,
  description: site.author.role,
  url: canonical,
  parentOrganization: { '@id': `${site.domain}/#organization` },
});
---
<BaseLayout title={title} description={description} canonical={canonical} siteName={site.name} jsonLdBlocks={[breadcrumbLd, teamLd]}>
  <section class="hero hero--simple">
    <div class="sd-container">
      <h1 class="hero-h1">{site.author.name}について</h1>
      <p class="hero-sub-simple">{site.name}の記事を作成しているチームです</p>
    </div>
  </section>

  <section class="sd-section section-white">
    <div class="sd-container">
      <div class="author-profile">

        <div class="author-section">
          <h2 class="author-h2">どんな記事を作っているか</h2>
          <p class="author-policy-text">
            {site.name}は、施設の法定点検やメンテナンスの業者を、依頼者に代わって探す業者紹介サービスです。{site.author.name}は、業者を探す前に知っておきたいこと（点検の義務があるか、誰に頼めるか、報告はいつどこへ出すか、業者の選び方）を、施設の管理担当者やオーナー向けにまとめています。
          </p>
        </div>

        <div class="author-section">
          <h2 class="author-h2">主に扱っている分野</h2>
          <ul class="author-expertise-list">
            <li>消防設備点検・防火対象物点検（消防法）</li>
            <li>受水槽・貯水槽の清掃と検査（水道法・建築物衛生法）</li>
            <li>浄化槽の保守点検・清掃・法定検査（浄化槽法）</li>
            <li>特殊建築物の定期調査、昇降機・防火設備の定期検査（建築基準法）</li>
            <li>キュービクル（自家用電気工作物）の点検、フロン排出抑制法の点検</li>
            <li>飲食店・施設の害虫駆除、グリストラップ・ダクトの清掃</li>
          </ul>
        </div>

        <div class="author-section">
          <h2 class="author-h2">記事の作り方</h2>
          <ul class="author-policy-list">
            <li><strong>法令は原文で確認：</strong>点検の義務・頻度・資格の要件は、法令の条文と行政の公開資料で確認して書いています。</li>
            <li><strong>AIの利用：</strong>記事の下書きにAIを使っています。公開前に、法令の引用と固有名詞を確認しています。</li>
            <li><strong>費用相場は目安：</strong>掲載している費用相場は一般的な目安で、個別に調査・検証した数値ではありません（<a href="/research/methodology/">費用相場の目安について</a>）。</li>
            <li><strong>実務の反映：</strong>業者紹介の中で分かった一般的な注意点は、依頼者・業者が特定されない形で記事に反映しています。</li>
            <li><strong>中立性：</strong>特定の業者を優遇したランキングや評価は行いません。</li>
          </ul>
        </div>

        <div class="author-section">
          <h2 class="author-h2">最近の記事</h2>
          <ul class="author-article-list">
            {recent.map((c) => (
              <li><a href={c.href} class="author-article-link">{c.title}</a></li>
            ))}
          </ul>
          <p class="author-policy-text"><a href="/column/">記事の一覧を見る</a></p>
        </div>

        <div class="author-section">
          <h2 class="author-h2">誤りのご指摘・お問い合わせ</h2>
          <p class="author-policy-text">
            記事の誤りや古くなった情報にお気づきの場合は、support@local-support.jp までお知らせください。確認のうえ訂正し、最終更新日を改めます。
          </p>
          <table class="info-table">
            <tbody>
              <tr><th>メディア名</th><td>{site.name}</td></tr>
              <tr><th>URL</th><td><a href={site.domain}>{site.domain}</a></td></tr>
              <tr><th>運営組織</th><td>{site.org.legalName}</td></tr>
              <tr><th>編集方針</th><td><a href="/editorial-policy/">編集方針</a></td></tr>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<style>
.author-profile {
  max-width: 800px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 40px;
}

.author-card {
  display: flex;
  gap: 24px;
  align-items: flex-start;
  background: var(--gray-100, #f5f5f5);
  border-radius: 12px;
  padding: 28px;
}

.author-avatar {
  flex-shrink: 0;
}

.author-avatar-placeholder {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--primary, #1565c0);
  color: #fff;
  font-size: 2rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.author-card-body {
  flex: 1;
}

.author-name {
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0 0 4px;
  color: var(--gray-900, #111);
}

.author-role {
  font-size: 0.875rem;
  color: var(--primary, #1565c0);
  font-weight: 600;
  margin: 0 0 12px;
}

.author-bio {
  font-size: 0.9375rem;
  line-height: 1.75;
  color: var(--gray-700, #444);
  margin: 0;
}

.author-section {
  border-top: 2px solid var(--gray-200, #e0e0e0);
  padding-top: 28px;
}

.author-h2 {
  font-size: 1.1rem;
  font-weight: 700;
  margin: 0 0 16px;
  color: var(--gray-900, #111);
}

.author-expertise-list,
.author-policy-list {
  margin: 0;
  padding-left: 1.5em;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.author-expertise-list li,
.author-policy-list li {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--gray-700, #444);
}

.author-article-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.author-article-list li {
  border-left: 3px solid var(--primary, #1565c0);
  padding-left: 12px;
}

.author-article-link {
  color: var(--primary, #1565c0);
  text-decoration: none;
  font-size: 0.9375rem;
  line-height: 1.5;
}

.author-article-link:hover {
  text-decoration: underline;
}

.author-policy-text {
  font-size: 0.9375rem;
  color: var(--gray-700, #444);
  margin: 0 0 12px;
}

@media (max-width: 600px) {
  .author-card {
    flex-direction: column;
  }
}
</style>
