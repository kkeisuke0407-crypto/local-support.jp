---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { allServices } from '../../data/services';

const title = `ロカサポとは｜施設管理の一括見積比較サービス｜${site.name}`;
const description = `ロカサポは受水槽清掃・アスベスト調査・ダクト清掃・消防設備点検など27分野を47都道府県でつなぐB2B業者紹介プラットフォーム。資格・登録を確認した実績・信頼のある専門業者ネットワーク・運営会社・サービス特徴・選定基準をまとめました。`;
const canonical = `${site.domain}/about/`;
const serviceCount = allServices.length;

const breadcrumbLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'トップ', item: `${site.domain}/` },
    { '@type': 'ListItem', position: 2, name: 'ロカサポとは', item: canonical },
  ],
});

const aboutLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  url: canonical,
  name: title,
  description,
  inLanguage: 'ja-JP',
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.domain },
  mainEntity: {
    '@type': 'Organization',
    name: site.org.legalName,
    alternateName: site.name,
    url: site.domain,
    logo: { '@type': 'ImageObject', url: `${site.domain}/og-default.png`, width: 1200, height: 630 },
    foundingDate: '2025',
    description: `施設管理・設備メンテナンスの一括見積比較サービス。法定点検・衛生清掃・修繕工事・エネルギー設備・防犯設備など${serviceCount}分野を47都道府県で展開。`,
    areaServed: { '@type': 'Country', name: 'JP' },
    knowsAbout: allServices.map((s) => s.serviceName),
    member: {
      '@type': 'Person',
      name: site.author.name,
      jobTitle: site.author.role,
      url: `${site.domain}/author/`,
    },
  },
});

const faqLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'ロカサポとは何ですか？', acceptedAnswer: { '@type': 'Answer', text: `ロカサポは、施設管理・設備メンテナンスに必要な${serviceCount}分野の実績・信頼のある専門業者を、47都道府県の管理担当者に紹介する一括見積比較サービスです。運営はローカル情報局。` } },
    { '@type': 'Question', name: 'ロカサポの利用は無料ですか？', acceptedAnswer: { '@type': 'Answer', text: 'はい。ご相談・業者のご紹介・比較・お選びいただいた業者への連絡先の共有まで、ご依頼者様から費用をいただくことはありません。' } },
    { '@type': 'Question', name: 'ロカサポが紹介する業者の基準は？', acceptedAnswer: { '@type': 'Answer', text: 'ご依頼ごとに、対応エリア・対応の可否・必要な資格や登録・対応条件を、業者のWebサイトなどの公開情報と業者からの回答で確認し、比較ページに載せています。業者の品質を保証するものではありません。' } },
    { '@type': 'Question', name: 'ロカサポはどんな会社が運営していますか？', acceptedAnswer: { '@type': 'Answer', text: '「ローカル情報局」が運営しています。施設管理・設備メンテナンス領域に特化した情報メディア事業を行っており、運営者は施設管理情報担当の寺尾聡が務めています。詳細は運営会社情報ページに記載しています。' } },
    { '@type': 'Question', name: '紹介後にしつこい営業電話は来ませんか？', acceptedAnswer: { '@type': 'Answer', text: '業者にご依頼者様の連絡先をお伝えするのは、比較ページでお選びいただいた業者だけです。それまで業者から連絡が行くことはありません。万一、不適切な営業を受けた場合はご連絡ください。事実を確認し、その業者を以後ご紹介しないなどの対応をとります。' } },
  ],
});
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  siteName={site.name}
  logoSub="施設管理の一括見積比較"
  jsonLdBlocks={[breadcrumbLd, aboutLd, faqLd]}
>
  <section class="hero hero--simple">
    <div class="sd-container">
      <h1 class="hero-h1">ロカサポとは</h1>
      <p class="hero-sub-simple">施設管理の一括見積比較サービス・運営方針</p>
    </div>
  </section>

  <section class="sd-section section-white">
    <div class="sd-container ab-container">

      <div class="ab-quickanswer">
        <p class="ab-qa-q">Q. ロカサポはどんなサービス？</p>
        <p class="ab-qa-a">A. <strong>受水槽清掃・アスベスト調査・ダクト清掃など{serviceCount}分野の実績・信頼のある専門業者を、47都道府県の管理担当者と無料でつなぐB2B一括見積比較プラットフォーム</strong>です。運営はローカル情報局。ご依頼者様の費用は無料。業者に連絡先をお伝えするのは、お選びいただいた業者だけです。</p>
        <p class="ab-qa-src">※ 2026年6月時点のサービス概要</p>
      </div>

      <div class="ab-block">
        <h2 class="ab-h2">ロカサポが生まれた背景</h2>
        <p>
          施設管理の発注業務は、<strong>専門用語・法令義務・適正価格の判断が難しく</strong>、結果として情報を持つ業者側に主導権が偏りがちです。
        </p>
        <p>
          ロカサポは、<strong>業者探しと対応可否の確認を運営が代わりに行うこと</strong>、<strong>資格・登録や対応条件を並べて比べられること</strong>、<strong>選んだ業者以外から連絡が行かないこと</strong>の3点を軸に、施設管理担当者と専門業者をつなぐサービスとして立ち上がりました。
        </p>
      </div>

      <div class="ab-block">
        <h2 class="ab-h2">サービスの特徴</h2>
        <ul class="ab-feat-list">
          <li>
            <span class="ab-feat-num">01</span>
            <div>
              <strong>必要な資格・登録を確認してご紹介</strong>
              <p>建築物飲料水貯水槽清掃業の都道府県知事登録、建築物石綿含有建材調査者、消防設備士、防火設備検査員など、各サービスで必要な資格・登録を、業者の公開情報と回答で確認してからご紹介します。</p>
            </div>
          </li>
          <li>
            <span class="ab-feat-num">02</span>
            <div>
              <strong>同条件で最大5社を比較</strong>
              <p>1回のご依頼で、対応できる業者を最大5社ご紹介します。資格・実績・対応条件を一覧で比べられます。正式なお見積りは、お選びいただいた業者から直接提示されます。</p>
            </div>
          </li>
          <li>
            <span class="ab-feat-num">03</span>
            <div>
              <strong>選んだ業者からだけ連絡</strong>
              <p>業者にご依頼者様の連絡先をお伝えするのは、比較ページでお選びいただいた業者だけです。それ以外の業者から連絡が行くことはありません。</p>
            </div>
          </li>
          <li>
            <span class="ab-feat-num">04</span>
            <div>
              <strong>{serviceCount}分野・全国からご相談可能</strong>
              <p>法定点検・衛生清掃・店舗設備・修繕工事・エネルギー設備・防犯設備など{serviceCount}分野のご相談を、全国から受け付けています。地域や内容によっては、ご紹介できる業者が少ない場合があります。</p>
            </div>
          </li>
          <li>
            <span class="ab-feat-num">05</span>
            <div>
              <strong>運営者監修の業者選びコンテンツ</strong>
              <p>費用相場・法令義務・業者選びのチェックポイントを運営者監修のコラムで公開しています。施設管理担当者の発注業務をサポートします。</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="ab-block">
        <h2 class="ab-h2">サービスの基本情報</h2>
        <dl class="ab-stats">
          <div class="ab-stat">
            <dt>業者選定基準</dt>
            <dd>資格・登録を確認</dd>
            <p>必要な資格・登録を、業者の公開情報と回答で確認してご紹介</p>
          </div>
          <div class="ab-stat">
            <dt>対応サービス数</dt>
            <dd>27分野</dd>
            <p>施設管理に必要な法定点検・衛生・設備投資を網羅</p>
          </div>
          <div class="ab-stat">
            <dt>対応エリア</dt>
            <dd>全国47都道府県</dd>
            <p>全国からご相談を受け付け（地域により業者数に差があります）</p>
          </div>
          <div class="ab-stat">
            <dt>紹介社数</dt>
            <dd>最大5社</dd>
            <p>1回のご依頼で最大5社まで比較可能</p>
          </div>
        </dl>
      </div>

      <div class="ab-block">
        <h2 class="ab-h2">ご紹介の前に確認していること</h2>
        <ol class="ab-criteria">
          <li><strong>対応エリアと対応の可否</strong>：物件の所在地と依頼内容に対応できるかを、業者に直接確認します</li>
          <li><strong>必要な資格・登録</strong>：各サービスで法令上必要な資格・登録を、業者の公開情報と回答で確認します</li>
          <li><strong>対応条件</strong>：現地調査の要否と費用、対応できる時間帯、報告書の発行など、業者から回答のあった条件を比較ページに載せます</li>
          <li><strong>会社の所在地・連絡先</strong>：業者のWebサイトなどの公開情報で確認します</li>
        </ol>
        <p style="margin-top:12px">確認は、業者の公開情報と回答にもとづくものです。業者の品質や工事の結果を保証するものではありません。不適切な対応があった場合はご連絡ください。事実を確認し、その業者を以後ご紹介しないなどの対応をとります。</p>
      </div>

      <div class="ab-block">
        <h2 class="ab-h2">運営会社</h2>
        <table class="info-table">
          <tbody>
            <tr><th>サービス名</th><td>{site.name}（ロカサポ / local-support.jp）</td></tr>
            <tr><th>運営組織</th><td>{site.org.legalName}</td></tr>
            <tr><th>運営者</th><td><a href="/author/">{site.author.name}</a>（{site.author.role}）</td></tr>
            <tr><th>事業内容</th><td>施設管理・設備メンテナンス業者の紹介サービス（一括見積比較）</td></tr>
            <tr>
              <th>取扱サービス</th>
              <td>
                <ul class="ab-service-inline-list">
                  {allServices.map((s) => (
                    <li><a href={`/${s.slug}/`}>{s.serviceName}</a></li>
                  ))}
                </ul>
              </td>
            </tr>
            <tr><th>対応エリア</th><td>全国47都道府県</td></tr>
            <tr><th>料金</th><td>ご依頼者様は無料</td></tr>
          </tbody>
        </table>
        <p class="ab-link"><a href="/operator/">運営者情報の詳細はこちら</a></p>
      </div>

      <div class="ab-block">
        <h2 class="ab-h2">取扱サービス（{serviceCount}分野）</h2>
        <ul class="ab-svc-list">
          {allServices.map((s) => (
            <li><a href={`/${s.slug}/`}>{s.serviceName}</a></li>
          ))}
        </ul>
      </div>

      <div class="ab-block">
        <h2 class="ab-h2">よくある質問</h2>
        <div class="ab-faq">
          <div class="ab-faq-item">
            <dt>ロカサポの利用は本当に無料ですか？</dt>
            <dd>はい、ご依頼者様から費用をいただくことはありません。ご相談・業者のご紹介・比較・お選びいただいた業者への連絡先の共有まで、すべて無料です。</dd>
          </div>
          <div class="ab-faq-item">
            <dt>紹介業者から強引な営業を受けないか心配です</dt>
            <dd>業者にご依頼者様の連絡先をお伝えするのは、比較ページでお選びいただいた業者だけです。それ以外の業者から営業を受けることはありません。万一トラブルがあった場合はご連絡ください。事実を確認し、その業者を以後ご紹介しないなどの対応をとります。</dd>
          </div>
          <div class="ab-faq-item">
            <dt>業者の資格はどう確認していますか？</dt>
            <dd>各サービスで法令上必要な資格・登録（建築物飲料水貯水槽清掃業の都道府県知事登録、建築物石綿含有建材調査者、消防設備士など）を、業者のWebサイトや登録簿などの公開情報と、業者からの回答で確認しています。確認できた内容は比較ページに載せます。</dd>
          </div>
          <div class="ab-faq-item">
            <dt>都道府県によって対応できる業者は違いますか？</dt>
            <dd>はい、地域によって対応できる業者が異なります。業者の少ない地域や専門性の高い内容では、ご紹介できる業者が1〜2社にとどまる場合や、見つからない場合もあります。その場合も状況をご連絡します。</dd>
          </div>
        </div>
      </div>

      <div class="ab-cta">
        <h2>無料で施設管理業者を比較する</h2>
        <p>1分の入力で最大5社をご紹介します。完全無料・しつこい営業なし。</p>
        <div class="ab-cta-grid">
          {allServices.map((s) => (
            <a href={`/${s.slug}/`} class="ab-cta-btn">{s.serviceName}を比較</a>
          ))}
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.ab-container { max-width: 920px; }
.ab-quickanswer {
  background: #eef6ff;
  border: 1.5px solid #1a56db;
  border-radius: 10px;
  padding: 20px 24px;
  margin-bottom: 40px;
}
.ab-qa-q { font-size: .92rem; font-weight: 800; color: #1a3a5c; margin: 0 0 10px; }
.ab-qa-a { font-size: .96rem; line-height: 1.85; color: var(--gray-900); margin: 0 0 10px; }
.ab-qa-src { font-size: .76rem; color: var(--gray-500); margin: 0; }
.ab-block { margin-bottom: 48px; }
.ab-h2 {
  font-size: 1.2rem;
  font-weight: 900;
  color: var(--gray-900);
  margin-bottom: 18px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--blue);
}
.ab-block p { font-size: .94rem; line-height: 1.95; color: var(--gray-700); margin-bottom: 14px; }
.ab-feat-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
.ab-feat-list li { display: flex; gap: 18px; background: var(--gray-100); border: 1px solid var(--gray-200); border-radius: 10px; padding: 18px 22px; }
.ab-feat-num { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; height: 44px; background: var(--blue); color: #fff; font-weight: 900; border-radius: 50%; font-size: .92rem; }
.ab-feat-list strong { display: block; font-size: 1rem; font-weight: 800; color: var(--gray-900); margin-bottom: 6px; }
.ab-feat-list p { font-size: .9rem; line-height: 1.8; margin: 0; color: var(--gray-700); }
.ab-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin: 0 0 12px; }
.ab-stat { background: linear-gradient(135deg, #1a3a5c 0%, #1a56db 100%); color: #fff; border-radius: 10px; padding: 18px 22px; text-align: center; }
.ab-stat dt { font-size: .82rem; opacity: .85; margin-bottom: 6px; }
.ab-stat dd { font-size: 1.5rem; font-weight: 900; margin: 0 0 8px; }
.ab-stat p { font-size: .76rem; opacity: .85; margin: 0; color: #fff; line-height: 1.6; }
.ab-stats-note { font-size: .78rem; color: var(--gray-500); }
.ab-criteria { padding-left: 24px; display: grid; gap: 10px; }
.ab-criteria li { font-size: .94rem; line-height: 1.85; color: var(--gray-700); }
.info-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.info-table th, .info-table td { padding: 12px 16px; border: 1px solid var(--gray-200); text-align: left; }
.info-table th { background: var(--gray-100); width: 32%; font-weight: 700; }
.ab-link a { color: var(--blue); font-size: .9rem; text-decoration: underline; }
.ab-service-inline-list { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
.ab-service-inline-list a { display: inline-flex; align-items: center; border: 1px solid var(--gray-200); border-radius: 999px; padding: 6px 10px; color: var(--blue); background: var(--gray-100); font-size: .82rem; font-weight: 700; text-decoration: none; }
.ab-service-inline-list a:hover { background: var(--blue-light); }
.ab-svc-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; }
.ab-svc-list a { display: block; background: var(--gray-100); border: 1px solid var(--gray-200); border-radius: 8px; padding: 12px 16px; font-size: .92rem; font-weight: 700; color: var(--blue); text-decoration: none; }
.ab-svc-list a:hover { background: var(--blue-light); }
.ab-faq { display: grid; gap: 14px; }
.ab-faq-item { border: 1px solid var(--gray-200); border-radius: 10px; overflow: hidden; }
.ab-faq-item dt { background: var(--gray-100); padding: 14px 18px; font-weight: 700; font-size: .94rem; color: var(--gray-900); margin: 0; }
.ab-faq-item dd { padding: 14px 18px; font-size: .9rem; line-height: 1.85; color: var(--gray-700); margin: 0; }
.ab-cta { background: linear-gradient(135deg, #1a3a5c 0%, #1a56db 100%); color: #fff; padding: 36px 32px; border-radius: 14px; text-align: center; margin: 48px 0 0; }
.ab-cta h2 { font-size: 1.25rem; font-weight: 900; margin-bottom: 10px; }
.ab-cta p { font-size: .92rem; opacity: .92; margin-bottom: 22px; }
.ab-cta-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; }
.ab-cta-btn { display: block; background: rgba(255,255,255,.15); border: 1px solid rgba(255,255,255,.25); color: #fff; padding: 10px 14px; border-radius: 8px; font-size: .88rem; font-weight: 700; text-decoration: none; }
.ab-cta-btn:hover { background: rgba(255,255,255,.25); }
@media (max-width: 600px) {
  .ab-feat-list li { flex-direction: column; gap: 10px; }
}
</style>
