# Gmail SMTP credentials
# 1. Enable 2-Step Verification on the Google account
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Set values below
GMAIL_USER=your-primary-account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# From header (must be an alias of GMAIL_USER in Workspace)
FROM_NAME=ロカサポ事務局
FROM_EMAIL=info@local-support.jp

# Send limit per run
DAILY_LIMIT=10

# Seconds between sends (avoid burst → spam folder)
INTERVAL_SEC=30
