# Resend API key (HTTPS — works from any environment, no SMTP port needed)
# Get it from https://resend.com/api-keys
# (same key used by the contact form — Cloudflare Pages env var RESEND_API_KEY)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# From header — domain must be verified in Resend (local-support.jp already is)
FROM_NAME=ロカサポ事務局
FROM_EMAIL=info@local-support.jp

# Optional: where replies should go (leave blank to reply to FROM_EMAIL)
REPLY_TO=support@local-support.jp

# Send limit per run
DAILY_LIMIT=10

# Seconds between sends (avoid burst → spam folder)
INTERVAL_SEC=30
