# Search Console API 認証（必須）
# Google Cloud のサービスアカウント JSON キー全体を1行にして貼り付ける
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"local-support-gsc@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Search Console プロパティURL（末尾スラッシュ必須）
GSC_SITE_URL=https://local-support.jp/
