# Google OAuth2 認証情報
# Google Cloud Console → APIとサービス → 認証情報 → OAuth 2.0 クライアントID
# アプリケーションの種類：「デスクトップ アプリ」で作成
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# Search Console プロパティURL
# URL プレフィックス型: https://local-support.jp/
# ドメイン型（DNSで登録した場合）: sc-domain:local-support.jp
GSC_SITE_URL=sc-domain:local-support.jp
